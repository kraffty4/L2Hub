+	private static void matching() throws Exception
+	{
+		final Object pm = instance("PhantomPartyMatching");
+		final Method control = internal("PhantomPartyMatching", "control", List.class, long.class);
+		final boolean was = PhantomHuntersConfig.HUNTER_PARTY_MATCHING;
+		final List<Player> parked = new ArrayList<>();
+		Player partyLeader = null;
+		Player fakeLive = null;
+		Object fakeTemplate = null;
+		int liveRoom = -1;
+		try
+		{
+			// Без ключа: ни одного охотника в списке ожидающих.
+			PhantomHuntersConfig.HUNTER_PARTY_MATCHING = false;
+			tick(pm, control, pool());
+			check("matching: key off — no hunters waiting", waitingHunters().isEmpty());
+
+			// С ключом: до шести свободных охотников 10+ в списке.
+			PhantomHuntersConfig.HUNTER_PARTY_MATCHING = true;
+			tick(pm, control, pool());
+			final List<Player> waiting = waitingHunters();
+			note("matching: waiting " + names(waiting));
+			check("matching: 1..6 hunters waiting", !waiting.isEmpty() && (waiting.size() <= 6));
+			check("matching: waiting hunters are 10+ and not in a party", waiting.stream().allMatch(p -> (p.getLevel() >= 10) && !p.isInParty()));
+
+			// Пати из одних охотников: лидер держит комнату с уровнями лидер ± 3. Лидер остаётся на каче (комнату держит только он), второго — в Гиран.
+			final List<Player> pair = pick(2, p -> (p.getLevel() >= 20) && !waiting.contains(p) && PhantomHunterManager.getInstance().isHunting(p));
+			check("matching: two free hunters for a party", pair.size() == 2);
+			if (pair.size() < 2)
+			{
+				return;
+			}
+			parked.add(pair.get(1));
+			park(pair.get(1), GIRAN);
+			final Player leader = pair.get(0);
+			partyLeader = leader;
+			PhantomCompat.newParty(leader, PartyDistributionType.FINDERS_KEEPERS);
+			pair.get(1).joinParty(leader.getParty());
+			tick(pm, control, pool());
+			final PartyMatchRoom room = PartyMatchRoomList.getInstance().getPlayerRoom(leader);
+			check("matching: hunter party leader opened a room", room != null);
+			if (room != null)
+			{
+				note("matching: room '" + room.getTitle() + "' " + room.getMinLevel() + "-" + room.getMaxLevel() + ", leader " + leader.getLevel());
+				check("matching: room levels are leader +-3", (room.getMinLevel() == Math.max(1, leader.getLevel() - 3)) || (Math.abs(room.getMinLevel() - (leader.getLevel() - 3)) <= 1));
+			}
+			// Пати распалась — комната закрыта.
+			leader.leaveParty();
+			waitFor(5, () -> !leader.isInParty());
+			tick(pm, control, pool());
+			check("matching: party gone — room closed", (PartyMatchRoomList.getInstance().getPlayerRoom(leader) == null) && ((room == null) || (PartyMatchRoomList.getInstance().getRoom(room.getId()) == null)));
+
+			// Комната «живого»: охотник из пула, на время теста не фантом (клиента у него нет, пакеты уходят в никуда).
+			fakeLive = pick(1, p -> (p.getLevel() >= 30) && (p.getLevel() <= 70) && !waiting.contains(p) && !pair.contains(p)).stream().findFirst().orElse(null);
+			check("matching: a stand-in for a live player", fakeLive != null);
+			if (fakeLive == null)
+			{
+				return;
+			}
+			park(fakeLive, GIRAN);
+			fakeTemplate = phantoms().remove(fakeLive.getObjectId());
+			final int min = Math.max(1, fakeLive.getLevel() - 5);
+			final int max = fakeLive.getLevel() + 5;
+			liveRoom = PartyMatchRoomList.getInstance().getMaxId();
+			final PartyMatchRoom live = new PartyMatchRoom(liveRoom, "test room", 0, min, max, 12, fakeLive);
+			PartyMatchRoomList.getInstance().addPartyMatchRoom(liveRoom, live);
+			fakeLive.setPartyRoom(liveRoom);
+			tick(pm, control, pool());
+			// Задержка 20–90 с: обнулить и дать тик.
+			readyNow(pm, liveRoom);
+			tick(pm, control, pool());
+			final List<Player> joined = new ArrayList<>(live.getPartyMembers());
+			joined.remove(fakeLive);
+			note("matching: live room members " + names(joined));
+			check("matching: a hunter joined the live player's room", !joined.isEmpty());
+			check("matching: joined hunters fit the room levels", joined.stream().allMatch(p -> (p.getLevel() >= min) && (p.getLevel() <= max) && PhantomManager.getInstance().isPhantom(p)));
+			readyNow(pm, liveRoom);
+			tick(pm, control, pool());
+			final int afterTwo = live.getPartyMembers().size() - 1;
+			check("matching: not more than one join per tick and 2 at most (" + afterTwo + ")", (afterTwo <= 2) && (afterTwo >= joined.size()));
+			check("matching: joined hunters are within 5 levels of the owner", seated(pm).stream().allMatch(p -> Math.abs(p.getLevel() - live.getOwner().getLevel()) <= 5));
+
+			// Живой так и не позвал за 10 минут — охотники выходят из его комнаты.
+			final List<Player> first = seated(pm);
+			expireSeats(pm);
+			tick(pm, control, pool());
+			check("matching: not invited for 10 minutes — hunters left the live room (" + names(first) + ")", !first.isEmpty() && first.stream().noneMatch(p -> live.getPartyMembers().contains(p) || (p.getPartyRoom() != 0)));
+
+			// Ключ выключили — список, комнаты охотников и места в комнатах живых убраны.
+			readyNow(pm, liveRoom);
+			tick(pm, control, pool());
+			final List<Player> second = seated(pm);
+			PhantomHuntersConfig.HUNTER_PARTY_MATCHING = false;
+			tick(pm, control, pool());
