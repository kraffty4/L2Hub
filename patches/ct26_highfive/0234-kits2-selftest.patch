+	private static boolean waitFor(int seconds, BooleanSupplier done) throws InterruptedException
+	{
+		for (int i = 0; i < (seconds * 2); i++)
+		{
+			if (done.getAsBoolean())
+			{
+				return true;
+			}
+			Thread.sleep(500);
+		}
+		return done.getAsBoolean();
