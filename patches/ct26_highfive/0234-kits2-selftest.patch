+			}
+			if (liveRoom >= 0)
+			{
+				final PartyMatchRoom live = PartyMatchRoomList.getInstance().getRoom(liveRoom);
+				if (live != null)
+				{
+					for (Player member : new ArrayList<>(live.getPartyMembers()))
+					{
+						member.setPartyRoom(0);
+					}
+				}
+				PartyMatchRoomList.getInstance().deleteRoom(liveRoom);
+			}
+			if ((fakeLive != null) && (fakeTemplate != null))
