+	private static List<Player> waitingHunters()
+	{
+		final List<Player> out = new ArrayList<>();
+		for (Player player : PartyMatchWaitingList.getInstance().getPlayers())
+		{
+			if (PhantomManager.getInstance().isPhantom(player))
+			{
+				out.add(player);
+			}
+		}
+		return out;
+	}
+
+	private static void tick(Object target, Method control, List<Player> hunting) throws Exception
+	{
+		set(target, "_lastAt", 0L);
+		control.invoke(target, hunting, System.currentTimeMillis());
+	}
+
+	@SuppressWarnings("unchecked")
+	private static void readyNow(Object pm, int roomId) throws Exception
+	{
+		final Map<Integer, Long> ready = (Map<Integer, Long>) get(pm, "_liveRoomReadyAt");
+		if (ready.containsKey(roomId))
+		{
+			ready.put(roomId, 0L);
+		}
+	}
+
+	/** Охотники, сидящие в комнатах живых. */
+	private static List<Player> seated(Object pm)
+	{
+		final List<Player> out = new ArrayList<>();
+		for (Object id : ((Map<?, ?>) get(pm, "_liveSeats")).keySet())
+		{
+			final Player player = World.getPlayer((Integer) id);
+			if (player != null)
+			{
+				out.add(player);
+			}
+		}
+		return out;
+	}
+
+	/** Места в комнатах живых — как будто заняты 11 минут назад. */
+	@SuppressWarnings("unchecked")
+	private static void expireSeats(Object pm) throws Exception
+	{
+		final Map<Integer, Object> seats = (Map<Integer, Object>) get(pm, "_liveSeats");
+		final Class<?> seatClass = Class.forName(PKG + "PhantomPartyMatching$Seat");
+		final java.lang.reflect.Constructor<?> constructor = seatClass.getDeclaredConstructor(int.class, long.class);
+		constructor.setAccessible(true);
+		final Method roomId = seatClass.getDeclaredMethod("roomId");
+		roomId.setAccessible(true);
+		for (Map.Entry<Integer, Object> entry : seats.entrySet())
+		{
+			entry.setValue(constructor.newInstance(roomId.invoke(entry.getValue()), System.currentTimeMillis() - (11 * 60000L)));
+		}
+	}
