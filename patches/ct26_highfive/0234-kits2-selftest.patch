+			check("matching: key off — hunters left live rooms (" + names(second) + ")", seated(pm).isEmpty() && live.getPartyMembers().stream().noneMatch(p -> PhantomManager.getInstance().isPhantom(p)) && second.stream().allMatch(p -> p.getPartyRoom() == 0));
