+	/** Снять с охотников (иначе уйдёт качаться) и поставить на месте. */
+	private static void park(Player player, Location at) throws Exception
+	{
+		hunters().remove(player.getName().toLowerCase());
+		AutoPlayTaskManager.getInstance().stopAutoPlay(player);
+		player.stopMove(null);
+		player.abortAttack();
+		player.abortCast();
+		player.setTarget(null);
+		player.setInvul(true);
+		if (player.isSitting())
+		{
+			player.standUp();
+			Thread.sleep(3000);
+		}
+		player.teleToLocation(at);
+		Thread.sleep(1500);
+	}
