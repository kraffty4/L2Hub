+	private static void start()
+	{
+		if ((pool().size() < 100) && ((System.currentTimeMillis() - STARTED) < (7 * 60000L)))
+		{
+			ThreadPool.schedule(L2HubKits2Test::start, 15000);
+			return;
+		}
+		ThreadPool.execute(() ->
+		{
+			LOGGER.info(TAG + "hunters " + pool().size() + ", keys at start: rift " + PhantomHuntersConfig.HUNTER_RIFT + ", kamaloka " + PhantomHuntersConfig.HUNTER_KAMALOKA + ", matching " + PhantomHuntersConfig.HUNTER_PARTY_MATCHING + ", learning " + PhantomHuntersConfig.HUNTER_LEARNING + ", slang " + PhantomHuntersConfig.HUNTER_SLANG + ".");
+			// Разделы можно выбрать переменной L2HUBKITS2_ONLY (через запятую).
+			final String only = System.getenv("L2HUBKITS2_ONLY");
+			final List<String> wanted = (only == null) || only.isBlank() ? List.of("speech", "matching", "rift", "kamaloka", "learning") : List.of(only.toLowerCase().split(" *, *"));
