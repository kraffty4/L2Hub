+	/** Охотники в мире: фантомы без пати, лавки, ивента, инстанса и олимпиады. */
+	private static List<Player> pool()
+	{
+		final List<Player> out = new ArrayList<>();
+		for (Player player : World.getPlayers())
+		{
+			if (PhantomManager.getInstance().isPhantom(player) && isHunter(player) && !player.isDead() && !player.isTeleporting() && !player.isInParty() && !player.isInStoreMode() && !player.isRegisteredOnEvent() && !player.isInOlympiadMode() && (player.getInstanceId() == 0) && !player.isCursedWeaponEquipped())
+			{
+				out.add(player);
+			}
+		}
+		return out;
+	}
+
+	private static List<Player> pick(int count, java.util.function.Predicate<Player> test)
+	{
+		final List<Player> out = new ArrayList<>();
+		for (Player player : pool())
+		{
+			if (test.test(player))
+			{
+				out.add(player);
+			}
+		}
+		out.sort(Comparator.comparingInt(Player::getLevel).reversed());
+		return new ArrayList<>(out.subList(0, Math.min(count, out.size())));
+	}
