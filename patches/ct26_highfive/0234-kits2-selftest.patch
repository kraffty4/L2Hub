+	private static void kamaloka() throws Exception
+	{
+		final Object kama = instance("PhantomKamaloka");
+		final Method control = internal("PhantomKamaloka", "control", List.class, long.class);
+		final Method hallFor = internal("PhantomKamaloka", "hallFor", List.class);
+		final Method wentToday = internal("PhantomKamaloka", "wentToday", Player.class);
+		final Class<?> runClass = Class.forName(PKG + "PhantomKamaloka$Run");
+		final Method enter = internal("PhantomKamaloka", "enter", runClass, Player.class, long.class);
+		final Method teleport = internal("PhantomKamaloka", "teleport", Player.class);
+		final Method bossDown = internal("PhantomKamaloka", "bossDown", runClass, long.class);
+		final Method instanceTimes = internal("PhantomKamaloka", "instanceTimes", int.class);
+		final boolean was = PhantomHuntersConfig.HUNTER_KAMALOKA;
+		try
+		{
+			final List<Player> free = new ArrayList<>();
+			for (Player player : pool())
+			{
+				if (!player.isInsideZone(ZoneId.PEACE) && PhantomHunterManager.getInstance().isHunting(player) && !(Boolean) wentToday.invoke(null, player))
+				{
+					free.add(player);
+				}
+			}
+			final int hall = (Integer) hallFor.invoke(null, free);
+			check("kamaloka: a hall with 3+ free hunters (" + hall + ")", hall >= 0);
+			if (hall < 0)
+			{
+				return;
+			}
+
+			// Успех — только по новому откату инстанса (его ставит убийство босса): синтетический поход, откат ставим и убираем сами.
+			final Player probe = free.get(0);
+			final Object probeRun = newRun(runClass);
+			set(probeRun, "leaderId", probe.getObjectId());
+			final Map<?, ?> times = (Map<?, ?>) instanceTimes.invoke(null, probe.getObjectId());
+			check("kamaloka: instance lock API found", times != null);
+			if (times != null)
+			{
+				@SuppressWarnings("unchecked")
+				final Map<Integer, Object> before = (Map<Integer, Object>) get(probeRun, "before");
+				before.put(probe.getObjectId(), times);
+				final long now = System.currentTimeMillis();
+				check("kamaloka: no new instance lock — not a success", !(Boolean) bossDown.invoke(null, probeRun, now));
+				InstanceManager.getInstance().setInstanceTime(probe.getObjectId(), 999, now + 3600000L);
+				try
+				{
+					check("kamaloka: a new instance lock (boss down) — success", (Boolean) bossDown.invoke(null, probeRun, now));
+				}
+				finally
+				{
+					InstanceManager.getInstance().deleteInstanceTime(probe.getObjectId(), 999);
+				}
+			}
+
+			// Скрипт не пустил (лидер без пати) — день не сгорает.
+			final Player solo = free.get(free.size() - 1);
+			final Object soloRun = newRun(runClass);
+			set(soloRun, "leaderId", solo.getObjectId());
+			set(soloRun, "hall", hall);
+			final boolean soloEntered;
+			synchronized (kama)
+			{
+				soloEntered = (Boolean) enter.invoke(kama, soloRun, solo, System.currentTimeMillis());
+			}
+			check("kamaloka: refused entry does not burn the day", !soloEntered && (solo.getInstanceId() == 0) && !(Boolean) wentToday.invoke(null, solo));
+
+			// .kama go — только тому, кто в пати лидера: вступил и вышел — телепорта нет.
+			final Player host = free.get(0);
+			final Player guest = free.get(1);
+			final Object goRun = newRun(runClass);
+			set(goRun, "leaderId", host.getObjectId());
+			set(goRun, "hall", hall);
+			set(goRun, "gatherUntil", System.currentTimeMillis() + 60000L);
+			@SuppressWarnings("unchecked")
+			final Set<Integer> goPlayers = (Set<Integer>) get(goRun, "players");
+			goPlayers.add(guest.getObjectId());
+			final Location stood = guest.getLocation();
+			final String answer;
+			synchronized (kama)
+			{
+				set(kama, "_run", goRun);
+				try
+				{
+					answer = (String) teleport.invoke(kama, guest);
+				}
+				finally
+				{
+					set(kama, "_run", null);
+				}
+			}
+			check("kamaloka: .kama go needs the leader's party (" + answer + ")", (answer != null) && (guest.calculateDistance3D(stood) < 300) && !goPlayers.contains(guest.getObjectId()));
+
+			synchronized (kama)
+			{
+				PhantomHuntersConfig.HUNTER_KAMALOKA = false;
+				set(kama, "_nextAt", 0L);
+				control.invoke(kama, free, System.currentTimeMillis());
+				check("kamaloka: key off — no run", get(kama, "_run") == null);
+			}
+			final Object run;
+			synchronized (kama)
+			{
+				PhantomHuntersConfig.HUNTER_KAMALOKA = true;
+				set(kama, "_run", null);
+				set(kama, "_nextAt", 0L);
+				control.invoke(kama, free, System.currentTimeMillis());
+				run = get(kama, "_run");
+			}
+			check("kamaloka: key on — a run gathers", run != null);
+			if (run == null)
+			{
+				return;
+			}
+			final Player leader = World.getPlayer((Integer) get(run, "leaderId"));
+			@SuppressWarnings("unchecked")
+			final Set<Integer> ids = (Set<Integer>) get(run, "members");
+			final List<Player> team = new ArrayList<>();
+			team.add(leader);
+			for (int id : ids)
+			{
+				final Player member = World.getPlayer(id);
+				if (member != null)
+				{
+					team.add(member);
+				}
+			}
+			note("kamaloka: hall " + hall + ", team " + names(team));
+			check("kamaloka: party of 3+", (leader != null) && leader.isInParty() && (leader.getParty().getMemberCount() >= 3));
+			if ((leader == null) || !leader.isInParty())
+			{
+				return;
+			}
+			check("kamaloka: leader is the highest, the party within 5 levels of him", team.stream().allMatch(p -> (p.getLevel() <= leader.getLevel()) && ((leader.getLevel() - p.getLevel()) <= 5)));
+			check("kamaloka: the run leader is busy for other modules (raidOf)", "Kamaloka".equals(raidOf(leader)));
+			check("kamaloka: no Party Matching room for the run leader", noRoomFor(leader));
+			check("kamaloka: party gathered within 1000 of the leader", waitFor(20, () -> team.stream().allMatch(p -> p.calculateDistance3D(leader) < 1000)));
+			check("kamaloka: party entered the instance", waitFor(90, () -> team.stream().allMatch(p -> p.getInstanceId() != 0)));
+			check("kamaloka: everyone marked for today", team.stream().allMatch(p ->
+			{
+				try
+				{
+					return (Boolean) wentToday.invoke(null, p);
+				}
+				catch (Exception e)
+				{
+					return false;
+				}
+			}));
+			check("kamaloka: they fight inside", waitFor(90, () -> team.stream().anyMatch(p -> p.isInCombat() || p.isAutoPlaying())));
+			// Конец похода: инстанс закрыт (как по таймеру Камалоки).
+			final int instanceId = leader.getInstanceId();
+			if (instanceId != 0)
+			{
+				InstanceManager.getInstance().destroyInstance(instanceId);
+			}
+			check("kamaloka: run finished after the instance closed", waitFor(120, () -> get(kama, "_run") == null));
+			check("kamaloka: everyone out of the instance and the party", waitFor(120, () -> team.stream().allMatch(p -> (p.getInstanceId() == 0) && !p.isInParty())));
+			check("kamaloka: everyone is a hunter again", waitFor(120, () -> team.stream().allMatch(L2HubKits2Test::isHunter)));
+			// Второй раз за день те же не идут.
+			synchronized (kama)
+			{
+				set(kama, "_nextAt", 0L);
+				control.invoke(kama, team, System.currentTimeMillis());
+				check("kamaloka: same hunters do not go twice a day", get(kama, "_run") == null);
+			}
+		}
+		finally
+		{
+			PhantomHuntersConfig.HUNTER_KAMALOKA = was;
+		}
+	}
