+	private static Object choice(Class<?> choiceClass, Player player, String decision, long at, long tracked, Map<String, Long> where) throws Exception
+	{
+		final Class<?> decisionClass = Class.forName(PKG + "PhantomHunterStrategy$Decision");
+		Object value = null;
+		for (Object constant : decisionClass.getEnumConstants())
+		{
+			if (((Enum<?>) constant).name().equals(decision))
+			{
+				value = constant;
+			}
+		}
+		final java.lang.reflect.Constructor<?> constructor = choiceClass.getDeclaredConstructor(decisionClass, int.class, String.class, String.class, String.class, long.class);
+		constructor.setAccessible(true);
+		final Object choice = constructor.newInstance(value, 30, "", "", null, at);
+		final Method start = choiceClass.getDeclaredMethod("start", Player.class, long.class);
+		start.setAccessible(true);
+		start.invoke(choice, player, at);
+		set(choice, "tracked", tracked);
+		set(choice, "done", true);
+		set(choice, "ok", true);
+		@SuppressWarnings("unchecked")
+		final Map<String, Long> map = (Map<String, Long>) get(choice, "where");
+		map.putAll(where);
+		return choice;
+	}
+
+	private static Object memory(Object learning, Player player) throws Exception
+	{
+		final Method memory = learning.getClass().getDeclaredMethod("memory", Player.class);
+		memory.setAccessible(true);
+		return memory.invoke(learning, player);
+	}
+
+	private static int attempts(Object learning, Player player, String part, String key) throws Exception
+	{
+		final Object lesson = ((Map<?, ?>) get(memory(learning, player), part)).get(key);
+		return lesson == null ? 0 : (Integer) get(lesson, "attempts");
+	}
+
+	private static long pair(Player hunter, Player player)
+	{
+		return ((long) hunter.getObjectId() << 32) | (player.getObjectId() & 0xffffffffL);
+	}
+
+	@SuppressWarnings("unchecked")
+	private static void pending(Object learning, Player hunter, Player player, String spot) throws Exception
+	{
+		final Class<?> pendingClass = Class.forName(PKG + "PhantomLearning$Pending");
+		final java.lang.reflect.Constructor<?> constructor = pendingClass.getDeclaredConstructor(String.class, long.class);
+		constructor.setAccessible(true);
+		((Map<Long, Object>) get(learning, "_questions")).put(pair(hunter, player), constructor.newInstance(spot, System.currentTimeMillis() + 120000));
+	}
