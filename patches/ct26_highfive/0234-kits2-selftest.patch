+			observe.invoke(learning, hunter, choice(choiceClass, hunter, "HUNT", at++, 4 * 3600000L, Map.of(spot, 4 * 3600000L)));
+			check("learning: a 4-hour decision is not remembered", attempts(learning, hunter, "actions", "HUNT") == 1);
+			observe.invoke(learning, hunter, choice(choiceClass, hunter, "HUNT", at++, 3 * 60000L, Map.of(spot, 3 * 60000L)));
