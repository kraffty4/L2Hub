diff --git a/java/org/l2jmobius/gameserver/entity/actor/Attackable.java b/java/org/l2jmobius/gameserver/entity/actor/Attackable.java
index 9480d4b..7b1a8c7 100644
--- a/java/org/l2jmobius/gameserver/entity/actor/Attackable.java
