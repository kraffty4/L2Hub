@@ -67,6 +67,7 @@ import org.l2jmobius.gameserver.managers.CursedWeaponsManager;
 import org.l2jmobius.gameserver.managers.EventDropManager;
 import org.l2jmobius.gameserver.managers.PcCafePointsManager;
 import org.l2jmobius.gameserver.managers.WalkingManager;
+import org.l2jmobius.gameserver.mechanics.effects.EffectType;
 import org.l2jmobius.gameserver.mechanics.events.EventDispatcher;
 import org.l2jmobius.gameserver.mechanics.events.EventType;
 import org.l2jmobius.gameserver.mechanics.events.holders.actor.npc.attackable.OnAttackableAggroRangeEnter;
@@ -811,6 +812,17 @@ public class Attackable extends Npc
 		return 1 + (ratio / 100.0);
 	}
 	
+	/**
+	 * L2Hub: хейт за скилл с отрицательными очками. Провокация (эффект GetAgro: Aggression, Aura of Hate и другие) по TauntTakesTopHate поднимает хейт кастующего до самого большого на мобе, сверху идут очки скилла: иначе её перекрывают несколько ударов дамагера, и моб возвращается к нему (docs/PHANTOMS.md, раздел 4.115).
+	 * @param attacker кто кастует
+	 * @param skill скилл
+	 */
+	public void addSkillHate(Creature attacker, Skill skill)
+	{
+		final long gap = NpcConfig.TAUNT_TAKES_TOP_HATE && skill.hasEffectType(EffectType.AGGRESSION) ? getHating(getMostHated()) - getHating(attacker) : 0;
+		addDamageHate(attacker, 0, Math.max(gap, 0) - skill.getEffectPoint());
+	}
+	
 	/**
 	 * Adds damage and hate to the attacker aggression list for this character.
 	 * @param attacker The Creature that gave damages to this Attackable
