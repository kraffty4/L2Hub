+			sb.append(skill.getName()).append(": mp ").append(skill.getMpInitialConsume() + skill.getMpConsume()).append(", disabled ").append(hunter.isSkillDisabled(skill)).append(", condition ").append(skill.checkCondition(hunter, hunter.getTarget(), false)).append("; ");
+		}
+		return sb.toString();
+	}
