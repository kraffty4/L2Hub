+	private static void loot(String what, boolean foreign, boolean respectful) throws Exception
+	{
+		stand(_hero, 0, 0);
+		stand(_other, 0, 240);
+		Thread.sleep(3500);
+		final Monster mob = spawn(_plainMob, 120, 0);
+		mob.addDamageHate(_hero, 0, 1000);
+		mob.getAI().setIntentionAttack(_hero);
+		Thread.sleep(1500);
+		final Item item = drop(mob, foreign);
+		play(respectful);
+		_hero.getAutoPlaySettings().setPickup(true);
