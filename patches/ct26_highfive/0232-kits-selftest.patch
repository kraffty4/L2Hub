+	// ---------- Петы ----------
+
+	private static long _clock = System.currentTimeMillis() + 600000;
+
+	/** Время для тика петов: каждый вызов на 10 с позже прошлого, чтобы тик не упирался в свою паузу. */
+	private static long next()
+	{
+		_clock += 10001;
+		return _clock;
+	}
