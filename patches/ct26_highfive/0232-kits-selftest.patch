+			// Разделы можно выбрать переменной L2HUBKITS_ONLY (через запятую).
+			final String only = System.getenv("L2HUBKITS_ONLY");
+			final List<String> wanted = (only == null) || only.isBlank() ? List.of("spoil", "pets", "craft") : List.of(only.toLowerCase().split(" *, *"));
+			if (wanted.contains("spoil"))
+			{
+				section("spoil", L2HubKitsTest::spoil);
+			}
+			if (wanted.contains("pets"))
+			{
+				section("pets", L2HubKitsTest::pets);
+			}
+			if (wanted.contains("craft"))
+			{
+				section("craft", L2HubKitsTest::craft);
+			}
+			LOGGER.info(TAG + "done: " + _ok + " ok, " + _wrong + " wrong.");
+		});
