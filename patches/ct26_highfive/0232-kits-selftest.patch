+		final Method open = internal("PhantomCraft", "openWorkshop", Player.class);
+		final boolean was = PhantomHuntersConfig.HUNTER_CRAFT;
+		PhantomHuntersConfig.HUNTER_CRAFT = true;
+		final Player crafter = best(p ->
+		{
+			try
+			{
+				return (boolean) wants.invoke(null, p);
+			}
+			catch (Exception e)
+			{
+				return false;
+			}
+		});
+		PhantomHuntersConfig.HUNTER_CRAFT = was;
+		check("craft: found a crafter who wants a workshop", crafter != null);
+		if (crafter == null)
+		{
+			return;
+		}
+		note("craft: " + crafter.getName() + " (" + crafter.getLevel() + " " + crafter.getPlayerClass().name() + "), Create Item " + crafter.getSkillLevel(172));
+		final Player buyer = best(p -> (p != crafter) && !p.isInStoreMode());
+		try
+		{
+			park(crafter, GIRAN);
+			park(buyer, new Location(GIRAN.getX() + 60, GIRAN.getY() + 30, GIRAN.getZ()));
+
+			PhantomHuntersConfig.HUNTER_CRAFT = false;
+			check("craft: key off, no workshop", !(boolean) open.invoke(null, crafter) && (crafter.getPrivateStoreType() == PrivateStoreType.NONE));
+
+			PhantomHuntersConfig.HUNTER_CRAFT = true;
+			final boolean opened = (boolean) open.invoke(null, crafter);
+			final Map<Integer, ManufactureItem> list = crafter.getManufactureItems();
+			check("craft: the workshop opens as a Mobius manufacture store, " + list.size() + " recipes", opened && (crafter.getPrivateStoreType() == PrivateStoreType.MANUFACTURE) && !list.isEmpty() && (list.size() <= PhantomHuntersConfig.HUNTER_CRAFT_RECIPES));
+			if (!opened || list.isEmpty())
+			{
+				return;
+			}
+			boolean fees = true;
+			boolean known = true;
+			RecipeList order = null;
+			for (ManufactureItem item : list.values())
+			{
+				fees &= item.getCost() >= 100;
+				known &= crafter.hasRecipeList(item.getRecipeId());
+				final RecipeList recipe = RecipeData.getInstance().getRecipeList(item.getRecipeId());
+				if ((recipe != null) && ((order == null) || (recipe.getSuccessRate() > order.getSuccessRate())))
+				{
+					order = recipe;
+				}
+			}
+			check("craft: every fee is at least 100 and every recipe is in the crafter's book", fees && known);
+			check("craft: found a recipe to order", order != null);
+			if (order == null)
+			{
+				return;
+			}
+
+			// Заказ без клиентов с обеих сторон: материалы и плата у заказчика, MP у мастера.
+			final long fee = list.get(order.getId()).getCost();
+			for (var need : order.getRecipes())
+			{
+				buyer.addItem(ItemProcessType.NONE, need.getItemId(), need.getQuantity(), null, false);
+			}
+			buyer.addAdena(ItemProcessType.NONE, fee + 1000, null, false);
+			crafter.setCurrentMp(crafter.getMaxMp());
+			final long buyerAdena = buyer.getAdena();
+			final long crafterAdena = crafter.getAdena();
+			final RecipeList made = order;
+			final long productBefore = count(buyer, order.getItemId()) + (order.getRareItemId() > 0 ? count(buyer, order.getRareItemId()) : 0);
+			final long materialsBefore = count(buyer, order.getRecipes()[0].getItemId());
+			final Map<Integer, Long> bagBefore = bag(buyer);
+			final double mpBefore = crafter.getCurrentMp();
+			RecipeManager.getInstance().requestManufactureItem(crafter, order.getId(), buyer);
+			waitFor(10, () -> (count(buyer, made.getItemId()) + (made.getRareItemId() > 0 ? count(buyer, made.getRareItemId()) : 0)) > productBefore);
+			final long productAfter = count(buyer, order.getItemId()) + (order.getRareItemId() > 0 ? count(buyer, order.getRareItemId()) : 0);
+			note("craft: buyer " + buyer.getName() + ", order " + order.getRecipeName() + " (product " + order.getItemId() + ", rare " + order.getRareItemId() + ", success " + order.getSuccessRate() + "%), fee " + fee + "; buyer adena " + buyerAdena + " -> " + buyer.getAdena() + ", crafter adena " + crafterAdena + " -> " + crafter.getAdena() + ", crafter MP " + (int) mpBefore + " -> " + (int) crafter.getCurrentMp() + ", product " + productBefore + " -> " + productAfter);
+			note("craft: buyer's bag changed " + diff(bagBefore, bag(buyer)) + ", crafter's bag has product " + count(crafter, order.getItemId()));
+			check("craft: the materials are used up", count(buyer, order.getRecipes()[0].getItemId()) < materialsBefore);
+			check("craft: the fee went from the buyer to the crafter", (buyer.getAdena() == (buyerAdena - fee)) && (crafter.getAdena() == (crafterAdena + fee)));
+			if (order.getSuccessRate() >= 100)
+			{
+				check("craft: the buyer got the item", productAfter > productBefore);
+			}
+			check("craft: the crafter still sits in the workshop, in the world", (crafter.getPrivateStoreType() == PrivateStoreType.MANUFACTURE) && (World.getPlayer(crafter.getObjectId()) == crafter));
+		}
+		finally
+		{
+			PhantomHuntersConfig.HUNTER_CRAFT = was;
+			crafter.setInvul(false);
+			if (buyer != null)
+			{
+				buyer.setInvul(false);
+			}
+		}
+	}
+
+	private static Map<Integer, Long> bag(Player player)
+	{
+		final Map<Integer, Long> out = new java.util.TreeMap<>();
+		for (Item item : player.getInventory().getItems())
+		{
+			out.merge(item.getId(), item.getCount(), Long::sum);
+		}
+		return out;
+	}
+
+	private static String diff(Map<Integer, Long> before, Map<Integer, Long> after)
+	{
+		final StringBuilder sb = new StringBuilder();
+		final java.util.Set<Integer> ids = new java.util.TreeSet<>(before.keySet());
+		ids.addAll(after.keySet());
+		for (int id : ids)
+		{
+			final long delta = after.getOrDefault(id, 0L) - before.getOrDefault(id, 0L);
+			if (delta != 0)
+			{
+				sb.append(' ').append(id).append(delta > 0 ? "+" : "").append(delta);
+			}
+		}
+		return sb.length() == 0 ? "nothing" : sb.toString().trim();
+	}
+
+	private static long count(Player player, int itemId)
+	{
+		final Item item = player.getInventory().getItemByItemId(itemId);
+		return item == null ? 0 : player.getInventory().getInventoryItemCount(itemId, -1);
+	}
+
+	// ---------- Общее ----------
+
+	/** Охотники в мире: фантомы без пати, лавки, ивента, инстанса и олимпиады. */
+	private static List<Player> pool()
+	{
+		final List<Player> out = new ArrayList<>();
+		for (Player player : World.getPlayers())
+		{
+			if (PhantomManager.getInstance().isPhantom(player) && !player.isDead() && !player.isTeleporting() && !player.isInParty() && !player.isInStoreMode() && !player.isRegisteredOnEvent() && !player.isInOlympiadMode() && (player.getInstanceId() == 0) && !player.isCursedWeaponEquipped())
+			{
+				out.add(player);
+			}
+		}
+		return out;
+	}
+
+	/** Самый высокий по уровню из годных. */
+	private static Player best(Predicate<Player> test)
+	{
+		Player best = null;
+		for (Player player : pool())
+		{
+			if (test.test(player) && ((best == null) || (player.getLevel() > best.getLevel())))
+			{
+				best = player;
+			}
+		}
+		return best;
+	}
+
+	/** Снять с охотников (иначе уйдёт качаться) и поставить на месте. */
+	private static void park(Player player, Location at) throws Exception
+	{
+		hunters().remove(player.getName().toLowerCase());
+		AutoPlayTaskManager.getInstance().stopAutoPlay(player);
+		player.stopMove(null);
+		player.abortAttack();
+		player.abortCast();
+		player.setTarget(null);
+		player.setInvul(true);
+		if (player.isSitting())
+		{
+			player.standUp();
+			Thread.sleep(3000);
+		}
+		player.teleToLocation(at);
+		Thread.sleep(1500);
+	}
+
+	private static Map<?, ?> hunters() throws Exception
+	{
+		final Field field = PhantomHunterManager.class.getDeclaredField("_hunters");
+		field.setAccessible(true);
+		return (Map<?, ?>) field.get(PhantomHunterManager.getInstance());
+	}
+
+	private static Method internal(String className, String name, Class<?>... args) throws Exception
+	{
+		final Method method = Class.forName("org.l2jmobius.gameserver.managers.phantom." + className).getDeclaredMethod(name, args);
+		method.setAccessible(true);
+		return method;
+	}
+
+	private static boolean waitFor(int seconds, BooleanSupplier done) throws InterruptedException
+	{
+		for (int i = 0; i < (seconds * 2); i++)
+		{
+			if (done.getAsBoolean())
+			{
+				return true;
+			}
+			Thread.sleep(500);
+		}
+		return done.getAsBoolean();
+	}
+
+	private static void section(String name, Section body)
+	{
+		try
+		{
+			body.run();
+		}
+		catch (Throwable e)
+		{
+			_wrong++;
+			LOGGER.log(Level.WARNING, TAG + "WRONG " + name + " failed: " + e, e);
+		}
+	}
+
+	private static void check(String what, boolean good)
+	{
+		if (good)
+		{
+			_ok++;
+			LOGGER.info(TAG + "ok " + what);
+		}
+		else
+		{
+			_wrong++;
+			LOGGER.warning(TAG + "WRONG " + what);
+		}
+	}
+
+	private static void note(String what)
+	{
+		LOGGER.info(TAG + "note " + what);
+	}
