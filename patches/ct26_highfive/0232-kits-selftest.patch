+	// ---------- Спойл ----------
+
+	private static void spoil() throws Exception
+	{
+		final Method tick = internal("PhantomSpoil", "tick", Player.class, long.class);
+		// Шанс Spoil на H5 считается от магического уровня скилла (CalculateMagicSuccessBySkillMagicLevel): берём охотника с самым высоким Spoil.
+		Player dwarf = null;
+		for (Player player : pool())
+		{
+			if ((player.getKnownSkill(SPOIL) != null) && (player.getKnownSkill(SWEEPER) != null) && ((dwarf == null) || ((player.getSkillLevel(SPOIL) * 1000) + player.getLevel()) > ((dwarf.getSkillLevel(SPOIL) * 1000) + dwarf.getLevel())))
+			{
+				dwarf = player;
+			}
+		}
+		check("spoil: found a hunter with Spoil and Sweeper", dwarf != null);
+		if (dwarf == null)
+		{
+			return;
+		}
+		final Player weak = best(p -> (p.getKnownSkill(SPOIL) != null) && ((p.getKnownSkill(SPOIL).getMagicLevel() + 10) < p.getLevel()));
+		note("spoil: " + dwarf.getName() + " (" + dwarf.getLevel() + " " + dwarf.getPlayerClass().name() + "), Spoil " + dwarf.getSkillLevel(SPOIL) + ", magic level " + dwarf.getKnownSkill(SPOIL).getMagicLevel());
+		final boolean was = PhantomHuntersConfig.HUNTER_SPOIL;
+		try
+		{
+			spoiler(tick, dwarf);
+			if (weak != null)
+			{
+				weakSpoiler(tick, weak);
+			}
+		}
+		finally
+		{
+			PhantomHuntersConfig.HUNTER_SPOIL = was;
+			dwarf.setTarget(null);
+			dwarf.setInvul(false);
+			if (weak != null)
+			{
+				weak.setTarget(null);
+				weak.setInvul(false);
+			}
+		}
+	}
+
+	/** Гном со Spoil намного ниже уровня мобов (ремесленники держат Spoil 1): впустую не кастует. */
+	private static void weakSpoiler(Method tick, Player weak) throws Exception
+	{
+		final Monster mob = spoilMob(weak.getLevel());
+		if (mob == null)
+		{
+			note("spoil: no mob near " + weak.getName() + "'s level, the weak spoiler is not checked");
+			return;
+		}
+		park(weak, mob.getLocation());
+		weak.setTarget(mob);
+		mob.setCurrentHp(mob.getMaxHp());
+		weak.setCurrentMp(weak.getMaxMp());
+		PhantomHuntersConfig.HUNTER_SPOIL = true;
+		final boolean cast = (boolean) tick.invoke(null, weak, System.currentTimeMillis());
+		waitFor(10, () -> !weak.isCastingNow());
+		check("spoil: " + weak.getName() + " (" + weak.getLevel() + " " + weak.getPlayerClass().name() + ", Spoil " + weak.getSkillLevel(SPOIL) + ", magic level " + weak.getKnownSkill(SPOIL).getMagicLevel() + ") does not waste Spoil on a level " + mob.getLevel() + " mob", !cast);
+	}
+
+	private static void spoiler(Method tick, Player dwarf) throws Exception
+	{
+		{
+			Monster mob = spoilMob(Math.min(dwarf.getLevel(), dwarf.getKnownSkill(SPOIL).getMagicLevel() + 3));
+			check("spoil: found a mob with a spoil list near the hunter's level", mob != null);
+			if (mob == null)
+			{
+				return;
+			}
+			park(dwarf, mob.getLocation());
+			dwarf.setTarget(mob);
+			mob.setCurrentHp(mob.getMaxHp());
+
+			PhantomHuntersConfig.HUNTER_SPOIL = false;
+			final boolean off = (boolean) tick.invoke(null, dwarf, System.currentTimeMillis());
+			check("spoil: key off, no cast", !off && !dwarf.isCastingNow());
+
+			// Спойл, потом смерть моба: предметы спойла выпадают по шансу, с пустого трупа свипать нечего — тогда следующий моб.
+			PhantomHuntersConfig.HUNTER_SPOIL = true;
+			int casts = 0;
+			int spoils = 0;
+			Monster spoiled = null;
+			for (int mobs = 0; (mobs < 6) && (spoiled == null); mobs++)
+			{
+				if (mobs > 0)
+				{
+					mob = spoilMob(Math.min(dwarf.getLevel(), dwarf.getKnownSkill(SPOIL).getMagicLevel() + 3));
+					if (mob == null)
+					{
+						break;
+					}
+					park(dwarf, mob.getLocation());
+					dwarf.setTarget(mob);
+				}
+				for (int tries = 0; (tries < 2) && !mob.isSpoiled(); tries++)
+				{
+					dwarf.setCurrentMp(dwarf.getMaxMp());
+					mob.setCurrentHp(mob.getMaxHp());
+					if ((boolean) tick.invoke(null, dwarf, System.currentTimeMillis()))
+					{
+						casts++;
+						waitFor(10, () -> !dwarf.isCastingNow());
+					}
+					Thread.sleep(600);
+				}
+				if (!mob.isSpoiled() || (mob.getSpoilerObjectId() != dwarf.getObjectId()))
+				{
+					continue;
+				}
+				spoils++;
+				final Monster dying = mob;
+				dying.reduceCurrentHp(dying.getCurrentHp() + 1, dwarf, null);
+				if (waitFor(5, dying::isDead) && dying.isSweepActive())
+				{
+					spoiled = dying;
+				}
+				else
+				{
+					note("spoil: " + dying.getName() + " (" + dying.getLevel() + ") died spoiled, but no spoil item rolled");
+				}
+			}
+			check("spoil: targets are spoiled by the hunter (" + spoils + " spoiled, " + casts + " casts)", spoils > 0);
+			check("spoil: a spoiled mob died with a sweep ready", spoiled != null);
+			if (spoiled == null)
+			{
+				return;
+			}
+
+			final Monster corpse = spoiled;
+			final Map<Integer, Long> bagBefore = bag(dwarf);
+			note("spoil: before the sweep — distance " + (int) dwarf.calculateDistance3D(corpse) + ", bag " + dwarf.getInventory().getSize() + "/" + dwarf.getInventoryLimit() + " slots, load " + dwarf.getCurrentLoad() + "/" + dwarf.getMaxLoad() + ", MP " + (int) dwarf.getCurrentMp());
+			// Sweeper бьёт с 20: охотник сначала подходит к трупу, на это даём время, тик — до трёх раз.
+			boolean swept = false;
+			for (int i = 0; (i < 3) && corpse.isSweepActive(); i++)
+			{
+				dwarf.setCurrentMp(dwarf.getMaxMp());
+				final boolean cast = (boolean) tick.invoke(null, dwarf, System.currentTimeMillis());
+				swept |= cast;
+				waitFor(12, () -> !corpse.isSweepActive());
+				note("spoil: sweep try " + (i + 1) + ": tick " + cast + ", distance " + (int) dwarf.calculateDistance3D(corpse) + ", casting " + dwarf.isCastingNow() + ", sweep left " + corpse.isSweepActive());
+			}
+			check("spoil: the hunter sweeps its own corpse", swept && !corpse.isSweepActive());
+			// Заряды за время ожидания тоже тратятся, поэтому смотрим не сумму, а что прибыло.
+			final Map<Integer, Long> bagAfter = bag(dwarf);
+			boolean gained = false;
+			for (Map.Entry<Integer, Long> entry : bagAfter.entrySet())
+			{
+				gained |= (entry.getKey() != 57) && (entry.getValue() > bagBefore.getOrDefault(entry.getKey(), 0L));
+			}
+			check("spoil: sweep materials in the bag (" + diff(bagBefore, bagAfter) + ")", gained);
+		}
+	}
+
+	private static Monster spoilMob(int level)
+	{
+		final List<Monster> mobs = new ArrayList<>();
+		for (WorldObject object : World.getVisibleObjects())
+		{
+			if ((object instanceof Monster) && (object.getInstanceId() == 0))
+			{
+				final Monster mob = (Monster) object;
+				if (!mob.isDead() && !mob.isRaid() && !mob.isChampion() && !mob.isMinion() && !mob.isSpoiled() && !mob.isInsideZone(ZoneId.PEACE) && (mob.getTemplate().getSpoilList() != null) && !mob.getTemplate().getSpoilList().isEmpty() && (Math.abs(mob.getLevel() - level) <= 3))
+				{
+					mobs.add(mob);
+				}
+			}
+		}
+		Collections.shuffle(mobs);
+		return mobs.isEmpty() ? null : mobs.get(0);
+	}
+
+	private static long items(Player player)
+	{
+		long total = 0;
+		for (Item item : player.getInventory().getItems())
+		{
+			if (item.getId() != 57)
+			{
+				total += item.getCount();
+			}
+		}
+		return total;
+	}
