+	private static void pets() throws Exception
+	{
+		final Method wants = internal("PhantomPets", "wantsPet", Player.class);
+		final Predicate<Player> petOwner = p ->
+		{
+			try
+			{
+				return (boolean) wants.invoke(null, p) && (p.getSummon() == null) && !p.isMounted() && (p.getLevel() >= 15);
+			}
+			catch (Exception e)
+			{
+				return false;
+			}
+		};
+		final Player rider = best(p -> petOwner.test(p) && (p.getLevel() >= 55));
+		final Player walker = best(p -> petOwner.test(p) && (p.getLevel() < 55) && (p != rider));
+		check("pets: found pet owners, strider " + (rider == null ? "-" : rider.getName() + " " + rider.getLevel()) + ", pet " + (walker == null ? "-" : walker.getName() + " " + walker.getLevel()), (rider != null) || (walker != null));
+		final boolean was = PhantomHuntersConfig.HUNTER_PETS;
+		try
+		{
+			if (walker != null)
+			{
+				petOwner(walker, false);
+			}
+			if (rider != null)
+			{
+				petOwner(rider, true);
+			}
+		}
+		finally
+		{
+			PhantomHuntersConfig.HUNTER_PETS = was;
+			if (rider != null)
+			{
+				rider.setInvul(false);
+			}
+			if (walker != null)
+			{
+				walker.setInvul(false);
+			}
+		}
+	}
+
+	private static void petOwner(Player owner, boolean strider) throws Exception
+	{
+		final Method tick = internal("PhantomPets", "tick", Player.class, boolean.class, long.class);
+		final Method collarFor = internal("PhantomPets", "collarFor", Player.class);
+		final Method junk = internal("PhantomHunterOutfit", "junk", Player.class, Item.class);
+		final String who = "pets " + owner.getName() + " (" + owner.getLevel() + " " + owner.getPlayerClass().name() + "): ";
+		final int collarId = (int) collarFor.invoke(null, owner);
+		final int foodId = collarId == 2375 ? 2515 : strider ? 5168 : 4038;
+		park(owner, new Location(GIRAN.getX() - 80, GIRAN.getY() + (strider ? 60 : -60), GIRAN.getZ()));
+		owner.addAdena(ItemProcessType.NONE, 50000000, null, false);
+
+		PhantomHuntersConfig.HUNTER_PETS = false;
+		tick.invoke(null, owner, true, next());
+		check(who + "key off, no collar and no pet", (count(owner, collarId) == 0) && (owner.getSummon() == null));
+
+		// Ошейник, корм и призыв: каст призыва идёт несколько секунд, бой его срывает — до трёх попыток.
+		PhantomHuntersConfig.HUNTER_PETS = true;
+		for (int i = 0; (i < 3) && (owner.getSummon() == null); i++)
+		{
+			waitFor(20, () -> !owner.isInCombat());
+			tick.invoke(null, owner, true, next());
+			waitFor(15, () -> owner.getSummon() != null);
+		}
+		note(who + "collar " + collarId + " x" + count(owner, collarId) + ", food " + foodId + " x" + count(owner, foodId) + ", adena " + owner.getAdena());
+		check(who + "bought the collar and food in town", (count(owner, collarId) == 1) && (count(owner, foodId) >= 3));
+		final Summon summoned = owner.getSummon();
+		check(who + "the pet is summoned", (summoned instanceof Pet) && !summoned.isDead());
+		if (!(summoned instanceof Pet))
+		{
+			return;
+		}
+		final Pet pet = (Pet) summoned;
+
+		// Голодный пет: хозяин кормит из сумки.
+		final long food = count(owner, foodId);
+		pet.setCurrentFed(pet.getMaxFed() / 4);
+		tick.invoke(null, owner, false, next());
+		check(who + "a hungry pet is fed, " + food + " -> " + count(owner, foodId) + " food", (pet.getCurrentFed() >= (pet.getMaxFed() * 0.9)) && (count(owner, foodId) == (food - 1)));
+
+		// Продажа хлама в городе не должна забирать ошейник и корм.
+		final Item collar = owner.getInventory().getItemByItemId(collarId);
+		final Item meal = owner.getInventory().getItemByItemId(foodId);
+		check(who + "town junk sale keeps the collar", (collar != null) && !(boolean) junk.invoke(null, owner, collar));
+		check(who + "town junk sale keeps the pet food", (meal != null) && !(boolean) junk.invoke(null, owner, meal));
+
+		if (strider)
+		{
+			// Страйдер ходит рядом: в городе охотник не садится верхом, оружие в руках, городская закупка не берёт новое.
+			final Class<?> data = Class.forName("org.l2jmobius.gameserver.managers.phantom.PhantomData");
+			final Object template = data.getMethod("getTemplate", String.class).invoke(data.getMethod("getInstance").invoke(null), owner.getName());
+			final Method buyGear = internal("PhantomHunterOutfit", "buyGear", Player.class, Class.forName("org.l2jmobius.gameserver.managers.phantom.PhantomTemplate"), long.class, boolean.class);
+			note(who + "town shopping before: " + buyGear.invoke(null, owner, template, 0L, false));
+			final Item weapon = owner.getInventory().getPaperdollItem(Inventory.PAPERDOLL_RHAND);
+			tick.invoke(null, owner, true, next());
+			final Item hands = owner.getInventory().getPaperdollItem(Inventory.PAPERDOLL_RHAND);
+			check(who + "no riding in town, the weapon stays in hand (" + (weapon == null ? "none" : weapon.getName()) + " -> " + (hands == null ? "none" : hands.getName()) + ")", !owner.isMounted() && (weapon != null) && (hands != null) && (hands.getObjectId() == weapon.getObjectId()) && (owner.getSummon() != null));
+			final Object bought = buyGear.invoke(null, owner, template, 0L, false);
+			check(who + "town shopping after the pet tick buys nothing new (" + bought + ")", ((List<?>) bought).isEmpty());
+		}
+
+		// Мёртвый пет: хозяин поднимает и отзывает его, ошейник при нём, следующий тик зовёт снова.
+		final Summon alive = owner.getSummon();
+		if (alive == null)
+		{
+			note(who + "no pet before the death check");
+			return;
+		}
+		alive.reduceCurrentHp(alive.getCurrentHp() + 1, owner, null);
+		check(who + "the pet died", waitFor(5, alive::isDead));
+		tick.invoke(null, owner, false, next());
+		final Summon after = owner.getSummon();
+		check(who + "a dead pet does not stay with the owner (" + (after == null ? "none" : after.isDead() ? "dead corpse" : "alive") + "), collar x" + count(owner, collarId), ((after == null) || !after.isDead()) && (count(owner, collarId) == 1));
+		for (int i = 0; (i < 3) && (owner.getSummon() == null); i++)
+		{
+			waitFor(20, () -> !owner.isInCombat());
+			tick.invoke(null, owner, false, next());
+			waitFor(15, () -> owner.getSummon() != null);
+		}
+		check(who + "the pet comes back after the death", (owner.getSummon() != null) && !owner.getSummon().isDead());
+	}
