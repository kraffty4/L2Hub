@@ -140,3 +140,25 @@ HunterInitiativeAnswerWait = 120
 
 # Говорили меньше стольких секунд назад — первым не заговаривает: разговор только что был.
 HunterInitiativeRecentTalk = 1800
+
+# ---------------------------------------------------------------------------
+# Тишина в округе и настроение (docs/PHANTOMS.md, раздел 4.10; приёмы L2Solo).
+# Непрошеные реплики охотников вслух — мысль стратега, «о, опять ты» обидчику, встрял в чужую реплику, заговорил
+# первым — ждут тишины: после любой реплики фантома вслух рядом (в пределах слышимости общего чата) другие молчат.
+# Ответы игроку и реплики на его действия (напал, убил) не ждут, но тоже считаются: следом никто не встревает.
+# ---------------------------------------------------------------------------
+
+# После любой реплики фантома вслух другие фантомы рядом не говорят непрошеного столько секунд. 0 — выключить.
+HunterChatQuiet = 45
+
+# Сам говоривший — следующая непрошеная реплика не раньше, чем через столько секунд.
+HunterChatSpeakerGap = 120
+
+# Одна и та же тема (мысль вслух, обидчик мимо, встрял, заговорил первым) рядом — не чаще раза в столько секунд.
+HunterChatTopicGap = 300
+
+# Настроение охотника из его состояния, без модели: устал (мало HP или MP, сидит), настороже (недавно напали или
+# убили), занят делом, скучает (афк, нет мобов), хочет поболтать (болтун). Усталый и настороженный не встревают;
+# первым усталый не заговаривает, настороженный — только со знакомыми, занятый — вдвое реже, скучающий — в 1,5 раза
+# чаще. Мозги знают настроение и говорят в нём.
+HunterMood = True
