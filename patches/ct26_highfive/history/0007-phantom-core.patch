diff --git a/java/org/l2jmobius/gameserver/managers/phantom/PhantomData.java b/java/org/l2jmobius/gameserver/managers/phantom/PhantomData.java
new file mode 100644
index 0000000..a2ac66c
--- /dev/null
+++ b/java/org/l2jmobius/gameserver/managers/phantom/PhantomData.java
@@ -0,0 +1,104 @@
+package org.l2jmobius.gameserver.managers.phantom;
+
+import java.io.File;
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.Collections;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.logging.Logger;
+
+import org.w3c.dom.Document;
+
+import org.l2jmobius.commons.util.IXmlReader;
+import org.l2jmobius.gameserver.data.xml.PlayerTemplateData;
+import org.l2jmobius.gameserver.entity.Location;
+import org.l2jmobius.gameserver.util.StatSet;
+
+/**
+ * L2Hub: напарники-фантомы из data/L2HubPhantoms.xml (пишет tools/fake_players.py).
+ */
+public class PhantomData implements IXmlReader
+{
+	private static final Logger LOGGER = Logger.getLogger(PhantomData.class.getName());
+
+	private volatile Map<String, PhantomTemplate> _templates = Collections.emptyMap();
+	private Map<String, PhantomTemplate> _loading;
+
+	protected PhantomData()
+	{
+		load();
+	}
+
+	@Override
+	public synchronized void load()
+	{
+		_loading = new LinkedHashMap<>();
+		parseDatapackFile("data/L2HubPhantoms.xml");
+		_templates = Collections.unmodifiableMap(_loading);
+		_loading = null;
+		LOGGER.info(getClass().getSimpleName() + ": Loaded " + _templates.size() + " phantom companions.");
+	}
+
+	@Override
+	public void parseDocument(Document document, File file)
+	{
+		forEach(document, "list", listNode -> forEach(listNode, "phantom", phantomNode ->
+		{
+			final StatSet set = new StatSet(parseAttributes(phantomNode));
+			final String name = set.getString("name");
+			try
+			{
+				final String[] classIds = set.getString("classes").split(",");
+				final int[] classes = new int[classIds.length];
+				for (int i = 0; i < classIds.length; i++)
+				{
+					classes[i] = Integer.parseInt(classIds[i].strip());
+					if (PlayerTemplateData.getInstance().getTemplate(classes[i]) == null)
+					{
+						throw new IllegalArgumentException("нет шаблона класса " + classes[i]);
+					}
+				}
+
+				final List<PhantomTemplate.Gear> gear = new ArrayList<>();
+				forEach(phantomNode, "gear", gearNode ->
+				{
+					final StatSet g = new StatSet(parseAttributes(gearNode));
+					gear.add(new PhantomTemplate.Gear(g.getString("grade"), g.getInt("minLevel"), g.getInt("rhand", 0), g.getInt("lhand", 0), g.getInt("head", 0), g.getInt("chest", 0), g.getInt("legs", 0), g.getInt("gloves", 0), g.getInt("feet", 0), g.getInt("shots", 0)));
+				});
+
+				final PhantomTemplate template = new PhantomTemplate(name, PhantomTemplate.Role.valueOf(set.getString("role")), set.getBoolean("female"), (byte) set.getInt("face"), (byte) set.getInt("hairStyle"), (byte) set.getInt("hairColor"), classes, new Location(set.getInt("x"), set.getInt("y"), set.getInt("z")), gear);
+				_loading.put(name.toLowerCase(), template);
+			}
+			catch (Exception e)
+			{
+				LOGGER.warning(getClass().getSimpleName() + ": Skipped phantom " + name + ": " + e.getMessage());
+			}
+		}));
+	}
+
+	/**
+	 * @param name имя напарника (без учёта регистра)
+	 * @return напарник или {@code null}
+	 */
+	public PhantomTemplate getTemplate(String name)
+	{
+		return name == null ? null : _templates.get(name.toLowerCase());
+	}
+
+	public Collection<PhantomTemplate> getTemplates()
+	{
+		return _templates.values();
+	}
+
+	public static PhantomData getInstance()
+	{
+		return SingletonHolder.INSTANCE;
+	}
+
+	private static class SingletonHolder
+	{
+		protected static final PhantomData INSTANCE = new PhantomData();
+	}
+}
diff --git a/java/org/l2jmobius/gameserver/managers/phantom/PhantomManager.java b/java/org/l2jmobius/gameserver/managers/phantom/PhantomManager.java
new file mode 100644
index 0000000..986eb89
--- /dev/null
+++ b/java/org/l2jmobius/gameserver/managers/phantom/PhantomManager.java
@@ -0,0 +1,340 @@
+package org.l2jmobius.gameserver.managers.phantom;
+
+import java.security.SecureRandom;
+import java.sql.Connection;
+import java.sql.PreparedStatement;
+import java.sql.ResultSet;
+import java.util.ArrayList;
+import java.util.Base64;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.logging.Level;
+import java.util.logging.Logger;
+
+import org.l2jmobius.commons.database.DatabaseFactory;
+import org.l2jmobius.gameserver.config.PlayerConfig;
+import org.l2jmobius.gameserver.config.custom.PhantomsConfig;
+import org.l2jmobius.gameserver.data.sql.CharInfoTable;
+import org.l2jmobius.gameserver.data.xml.PlayerTemplateData;
+import org.l2jmobius.gameserver.entity.Location;
+import org.l2jmobius.gameserver.entity.World;
+import org.l2jmobius.gameserver.entity.actor.Player;
+import org.l2jmobius.gameserver.entity.actor.appearance.PlayerAppearance;
+import org.l2jmobius.gameserver.entity.actor.templates.PlayerTemplate;
+import org.l2jmobius.gameserver.managers.GlobalVariablesManager;
+import org.l2jmobius.gameserver.network.Disconnection;
+import org.l2jmobius.gameserver.taskmanagers.AutoPlayTaskManager;
+
+/**
+ * L2Hub: фантомы — настоящие персонажи игроков без клиента (напарники).<br>
+ * Приём тот же, что у Mobius для офлайн-игроков после рестарта ({@code OfflinePlayTable.restoreOfflinePlayers}): {@link Player#load}, вход в мир через {@code spawnMe}, {@code setOfflinePlay(true)} и
+ * {@code setOnlineStatus(true, true)}. Персонажи живут на аккаунте {@link PhantomsConfig#PHANTOM_ACCOUNT}; вход под ним закрыт баном в таблице accounts.<br>
+ * Кто из фантомов в мире, хранится в глобальной переменной {@value #ACTIVE_VARIABLE}: после рестарта они поднимаются на своих местах.
+ */
+public class PhantomManager
+{
+	private static final Logger LOGGER = Logger.getLogger(PhantomManager.class.getName());
+
+	private static final String ACTIVE_VARIABLE = "L2HubPhantomsActive";
+	private static final String FIND_CHARACTER = "SELECT charId FROM characters WHERE char_name=? AND account_name=?";
+	private static final String BAN_ACCOUNT = "INSERT INTO accounts (login, password, accessLevel) VALUES (?, ?, -1) ON DUPLICATE KEY UPDATE accessLevel = -1";
+
+	/** Фантомы в мире: objectId → напарник. */
+	private final Map<Integer, PhantomTemplate> _phantoms = new ConcurrentHashMap<>();
+
+	protected PhantomManager()
+	{
+	}
+
+	/**
+	 * Вызывается при старте сервера, когда мир уже загружен: закрывает вход под аккаунтом фантомов и поднимает тех, кто был в мире.
+	 */
+	public void onServerStart()
+	{
+		if (!PhantomsConfig.PHANTOMS_ENABLED)
+		{
+			LOGGER.info(getClass().getSimpleName() + ": Disabled.");
+			return;
+		}
+
+		PhantomData.getInstance();
+		if (PhantomsConfig.PHANTOM_BAN_ACCOUNT_LOGIN)
+		{
+			banLogin();
+		}
+
+		if (PhantomsConfig.PHANTOM_RESTORE_ON_STARTUP)
+		{
+			restore();
+		}
+	}
+
+	/**
+	 * @param player игрок
+	 * @return {@code true}, если это фантом в мире
+	 */
+	public boolean isPhantom(Player player)
+	{
+		return (player != null) && _phantoms.containsKey(player.getObjectId());
+	}
+
+	/**
+	 * @param template напарник
+	 * @return его фантом в мире или {@code null}
+	 */
+	public Player getPhantom(PhantomTemplate template)
+	{
+		final Player player = World.getPlayer(template.getName());
+		return isPhantom(player) ? player : null;
+	}
+
+	/**
+	 * Ставит напарника в точку: создаёт персонажа при первом вызове, подтягивает до уровня (профа, скиллы, шмот грейда) и вводит в мир. Если он уже в мире — пересобирает и переставляет.
+	 * @param template напарник
+	 * @param location куда поставить
+	 * @param requestedLevel уровень
+	 * @return фантом или {@code null}, если не вышло (причина — в логе)
+	 */
+	public synchronized Player spawn(PhantomTemplate template, Location location, int requestedLevel)
+	{
+		final int level = Math.max(1, Math.min(requestedLevel, PlayerConfig.PLAYER_MAXIMUM_LEVEL - 1));
+		Player phantom = getPhantom(template);
+		if (phantom != null)
+		{
+			PhantomOutfit.build(phantom, template, level);
+			phantom.storeMe();
+			phantom.setHeading(location.getHeading());
+			phantom.teleToLocation(location, false);
+			phantom.broadcastUserInfo();
+			setActive(template.getName(), true);
+			return phantom;
+		}
+
+		if (World.getPlayer(template.getName()) != null)
+		{
+			LOGGER.warning(getClass().getSimpleName() + ": " + template.getName() + " is online as a real player, phantom not spawned.");
+			return null;
+		}
+
+		phantom = loadOrCreate(template);
+		if (phantom == null)
+		{
+			return null;
+		}
+
+		phantom.setOnlineStatus(true, false);
+		PhantomOutfit.build(phantom, template, level);
+		phantom.storeMe();
+		enterWorld(phantom, template, location);
+		setActive(template.getName(), true);
+		return phantom;
+	}
+
+	/**
+	 * Убирает напарника из мира. Персонаж остаётся в базе со своим уровнем и скиллами.
+	 * @param template напарник
+	 * @return {@code true}, если он был в мире
+	 */
+	public synchronized boolean despawn(PhantomTemplate template)
+	{
+		setActive(template.getName(), false);
+		final Player phantom = getPhantom(template);
+		if (phantom == null)
+		{
+			return false;
+		}
+
+		_phantoms.remove(phantom.getObjectId());
+		if (phantom.isAutoPlaying())
+		{
+			AutoPlayTaskManager.getInstance().stopAutoPlay(phantom);
+		}
+		Disconnection.of(phantom).storeAndDelete();
+		LOGGER.info(getClass().getSimpleName() + ": Despawned " + template.getName() + ".");
+		return true;
+	}
+
+	private void restore()
+	{
+		int restored = 0;
+		for (String name : getActiveNames())
+		{
+			final PhantomTemplate template = PhantomData.getInstance().getTemplate(name);
+			if (template == null)
+			{
+				LOGGER.warning(getClass().getSimpleName() + ": Active phantom " + name + " is not in L2HubPhantoms.xml, dropped.");
+				setActive(name, false);
+				continue;
+			}
+
+			try
+			{
+				final boolean existed = findCharId(template.getName()) > 0;
+				final Player phantom = loadOrCreate(template);
+				if (phantom == null)
+				{
+					continue;
+				}
+
+				phantom.setOnlineStatus(true, false);
+				final Location location;
+				if (existed && ((phantom.getX() != 0) || (phantom.getY() != 0)))
+				{
+					phantom.restoreEffects();
+					PhantomOutfit.refresh(phantom, template);
+					location = new Location(phantom.getX(), phantom.getY(), phantom.getZ(), phantom.getHeading());
+				}
+				else
+				{
+					PhantomOutfit.build(phantom, template, PhantomsConfig.PHANTOM_DEFAULT_LEVEL);
+					phantom.storeMe();
+					location = template.getHome();
+				}
+				enterWorld(phantom, template, location);
+				restored++;
+			}
+			catch (Exception e)
+			{
+				LOGGER.log(Level.WARNING, getClass().getSimpleName() + ": Could not restore phantom " + name + ".", e);
+			}
+		}
+		LOGGER.info(getClass().getSimpleName() + ": Restored " + restored + " phantoms.");
+	}
+
+	/**
+	 * Персонаж напарника из базы, а при первом вызове — новый: создаётся так же, как в {@code CharacterCreate}, сохраняется и загружается обратно полным {@link Player#load}.
+	 */
+	private Player loadOrCreate(PhantomTemplate template)
+	{
+		int charId = findCharId(template.getName());
+		if (charId <= 0)
+		{
+			if (CharInfoTable.getInstance().doesCharNameExist(template.getName()))
+			{
+				LOGGER.warning(getClass().getSimpleName() + ": Name " + template.getName() + " is taken by a character of another account, phantom not created.");
+				return null;
+			}
+
+			final PlayerTemplate playerTemplate = PlayerTemplateData.getInstance().getTemplate(template.getStartClassId());
+			final Player created = Player.create(playerTemplate, PhantomsConfig.PHANTOM_ACCOUNT, template.getName(), new PlayerAppearance(template.getFace(), template.getHairColor(), template.getHairStyle(), template.isFemale()));
+			if (created == null)
+			{
+				LOGGER.warning(getClass().getSimpleName() + ": Could not create character " + template.getName() + ".");
+				return null;
+			}
+
+			// Как в CharacterCreate: полные бары до сохранения, иначе Player.load поднимет персонажа трупом (curHp = 0).
+			created.setCurrentHp(created.getMaxHp());
+			created.setCurrentMp(created.getMaxMp());
+			created.setCurrentCp(created.getMaxCp());
+			final Location home = template.getHome();
+			created.setXYZInvisible(home.getX(), home.getY(), home.getZ());
+			created.setTitle("");
+			created.setOnlineStatus(true, false);
+			Disconnection.of(created).storeAndDelete();
+			charId = created.getObjectId();
+			LOGGER.info(getClass().getSimpleName() + ": Created phantom character " + template.getName() + " (" + charId + ").");
+		}
+
+		final Player phantom = Player.load(charId);
+		if (phantom == null)
+		{
+			LOGGER.warning(getClass().getSimpleName() + ": Could not load phantom character " + template.getName() + " (" + charId + ").");
+		}
+		return phantom;
+	}
+
+	/**
+	 * Вход в мир по образцу {@code OfflinePlayTable.restoreOfflinePlayers}: клиента нет и не будет. {@code setOfflinePlay(true)} нужен, чтобы AutoPlay не принял фантома за офлайн-торговца.
+	 */
+	private void enterWorld(Player phantom, PhantomTemplate template, Location location)
+	{
+		_phantoms.put(phantom.getObjectId(), template);
+		phantom.setHeading(location.getHeading());
+		phantom.spawnMe(location.getX(), location.getY(), location.getZ());
+		phantom.setOfflinePlay(true);
+		phantom.setOnlineStatus(true, true);
+		phantom.setRunning();
+		phantom.broadcastUserInfo();
+		LOGGER.info(getClass().getSimpleName() + ": " + template.getName() + " entered the world at " + location.getX() + ", " + location.getY() + ", " + location.getZ() + ".");
+	}
+
+	private int findCharId(String name)
+	{
+		try (Connection con = DatabaseFactory.getConnection();
+			PreparedStatement ps = con.prepareStatement(FIND_CHARACTER))
+		{
+			ps.setString(1, name);
+			ps.setString(2, PhantomsConfig.PHANTOM_ACCOUNT);
+			try (ResultSet rs = ps.executeQuery())
+			{
+				return rs.next() ? rs.getInt("charId") : 0;
+			}
+		}
+		catch (Exception e)
+		{
+			LOGGER.log(Level.WARNING, getClass().getSimpleName() + ": Could not look up " + name + ".", e);
+			return 0;
+		}
+	}
+
+	/**
+	 * Закрывает вход под аккаунтом фантомов: строка в accounts с accessLevel = -1 (логин отвечает ACCOUNT_BANNED). Пароль — случайный, его никто не знает.
+	 */
+	private void banLogin()
+	{
+		final byte[] secret = new byte[24];
+		new SecureRandom().nextBytes(secret);
+		try (Connection con = DatabaseFactory.getConnection();
+			PreparedStatement ps = con.prepareStatement(BAN_ACCOUNT))
+		{
+			ps.setString(1, PhantomsConfig.PHANTOM_ACCOUNT);
+			ps.setString(2, Base64.getEncoder().encodeToString(secret));
+			ps.executeUpdate();
+		}
+		catch (Exception e)
+		{
+			LOGGER.warning(getClass().getSimpleName() + ": Could not ban login of account " + PhantomsConfig.PHANTOM_ACCOUNT + ": " + e.getMessage());
+		}
+	}
+
+	/**
+	 * @return имена напарников, которые были в мире (в порядке появления)
+	 */
+	public List<String> getActiveNames()
+	{
+		final List<String> names = new ArrayList<>();
+		for (String name : GlobalVariablesManager.getInstance().getString(ACTIVE_VARIABLE, "").split(";"))
+		{
+			if (!name.isBlank())
+			{
+				names.add(name.strip());
+			}
+		}
+		return names;
+	}
+
+	private synchronized void setActive(String name, boolean active)
+	{
+		final Set<String> names = new LinkedHashSet<>(getActiveNames());
+		final boolean changed = active ? names.add(name) : names.remove(name);
+		if (changed)
+		{
+			GlobalVariablesManager.getInstance().set(ACTIVE_VARIABLE, String.join(";", names));
+			GlobalVariablesManager.getInstance().storeMe();
+		}
+	}
+
+	public static PhantomManager getInstance()
+	{
+		return SingletonHolder.INSTANCE;
+	}
+
+	private static class SingletonHolder
+	{
+		protected static final PhantomManager INSTANCE = new PhantomManager();
+	}
+}
diff --git a/java/org/l2jmobius/gameserver/managers/phantom/PhantomOutfit.java b/java/org/l2jmobius/gameserver/managers/phantom/PhantomOutfit.java
new file mode 100644
index 0000000..3b06601
--- /dev/null
+++ b/java/org/l2jmobius/gameserver/managers/phantom/PhantomOutfit.java
@@ -0,0 +1,184 @@
+package org.l2jmobius.gameserver.managers.phantom;
+
+import java.util.ArrayList;
+import java.util.logging.Logger;
+
+import org.l2jmobius.gameserver.config.custom.PhantomsConfig;
+import org.l2jmobius.gameserver.data.xml.ExperienceData;
+import org.l2jmobius.gameserver.entity.actor.Player;
+import org.l2jmobius.gameserver.entity.item.enums.ItemProcessType;
+import org.l2jmobius.gameserver.entity.item.instance.Item;
+import org.l2jmobius.gameserver.entity.itemcontainer.Inventory;
+import org.l2jmobius.gameserver.mechanics.skill.Skill;
+
+/**
+ * L2Hub: сборка фантома под уровень — опыт, профессия ветки, скиллы, шмот своего грейда и BSS.<br>
+ * Вызывается до входа в мир (тогда первый CharInfo уже показывает шмот) или для фантома в мире.
+ */
+final class PhantomOutfit
+{
+	private static final Logger LOGGER = Logger.getLogger(PhantomOutfit.class.getName());
+
+	private PhantomOutfit()
+	{
+	}
+
+	/**
+	 * Полная сборка: уровень, класс и скиллы (если уровень или класс меняются), шмот заново, BSS, полные бары.
+	 * @param player фантом
+	 * @param template напарник
+	 * @param level уровень, до которого его подтянуть
+	 */
+	static void build(Player player, PhantomTemplate template, int level)
+	{
+		// Стопка BSS даёт перегруз, а с перегрузом 4-й степени фантом не может сдвинуться с места.
+		player.setDietMode(true);
+		revive(player);
+
+		final int classId = template.getClassId(level);
+		final boolean relearn = (player.getLevel() != level) || (player.getPlayerClass().getId() != classId) || player.getAllSkills().isEmpty();
+
+		// Сначала снять и уничтожить старый шмот: его скиллы не должны пережить пересборку.
+		player.getInventory().destroyAllItems(ItemProcessType.DESTROY, player, null);
+		player.getAutoSoulShot().clear();
+
+		setLevel(player, level);
+		if (relearn)
+		{
+			relearn(player, classId);
+		}
+
+		dress(player, template.getGear(level));
+		refill(player, template.getGear(level));
+		fullBars(player);
+		LOGGER.info("PhantomOutfit: " + player.getName() + " is level " + player.getLevel() + " " + player.getPlayerClass().name() + ", " + player.getAllSkills().size() + " skills" + (relearn ? " (relearned)" : "") + ".");
+	}
+
+	/**
+	 * Лёгкое обновление после рестарта: шмот и скиллы уже в базе, а регистрация BSS и вес — только в памяти.
+	 * @param player фантом
+	 * @param template напарник
+	 */
+	static void refresh(Player player, PhantomTemplate template)
+	{
+		player.setDietMode(true);
+		revive(player);
+		final PhantomTemplate.Gear gear = template.getGear(player.getLevel());
+		if (player.getInventory().getPaperdollItem(Inventory.PAPERDOLL_RHAND) == null)
+		{
+			dress(player, gear);
+		}
+		refill(player, gear);
+		fullBars(player);
+	}
+
+	/**
+	 * Мёртвому HP и MP не выставляются ({@code CreatureStatus} молча пропускает), а {@link Player#load} считает мёртвым любого с curHp &lt; 0.5 в базе. Поэтому перед сборкой фантома поднимаем: в мире — честным ресом с пакетом,
+	 * до входа в мир — просто снимаем флаг.
+	 */
+	private static void revive(Player player)
+	{
+		if (!player.isDead())
+		{
+			return;
+		}
+
+		if (player.isSpawned())
+		{
+			player.doRevive();
+		}
+		else
+		{
+			player.setDead(false);
+		}
+	}
+
+	private static void setLevel(Player player, int level)
+	{
+		final long current = player.getExp();
+		final long wanted = ExperienceData.getInstance().getExpForLevel(level);
+		if (current > wanted)
+		{
+			player.getStat().setLevel((byte) level);
+			player.removeExpAndSp(current - wanted, 0, false);
+		}
+		else if (current < wanted)
+		{
+			player.addExpAndSp(wanted - current, 0);
+		}
+
+		if (player.getLevel() != level)
+		{
+			LOGGER.warning("PhantomOutfit: " + player.getName() + " stopped at level " + player.getLevel() + " instead of " + level + ".");
+		}
+	}
+
+	/**
+	 * Скиллы заново: всё старое снять, выставить класс ветки, выучить всё доступное классу на этом уровне.
+	 */
+	private static void relearn(Player player, int classId)
+	{
+		for (Skill skill : new ArrayList<>(player.getAllSkills()))
+		{
+			player.removeSkill(skill, true, true);
+		}
+
+		if (player.getPlayerClass().getId() != classId)
+		{
+			player.setPlayerClass(classId);
+		}
+		player.setBaseClass(classId);
+		player.giveAvailableSkills(true, true, true);
+	}
+
+	private static void dress(Player player, PhantomTemplate.Gear gear)
+	{
+		if (gear == null)
+		{
+			return;
+		}
+
+		for (int itemId : gear.items())
+		{
+			if (itemId <= 0)
+			{
+				continue;
+			}
+
+			final Item item = player.getInventory().addItem(ItemProcessType.REWARD, itemId, 1, player, null);
+			if ((item != null) && item.isEquipable())
+			{
+				player.getInventory().equipItem(item);
+			}
+			else
+			{
+				LOGGER.warning("PhantomOutfit: " + player.getName() + " could not equip item " + itemId + ".");
+			}
+		}
+		player.refreshOverloaded();
+		player.refreshExpertisePenalty();
+	}
+
+	private static void refill(Player player, PhantomTemplate.Gear gear)
+	{
+		if ((gear == null) || (gear.shots <= 0))
+		{
+			return;
+		}
+
+		final Item shots = player.getInventory().getItemByItemId(gear.shots);
+		final long have = shots == null ? 0 : shots.getCount();
+		if (have < PhantomsConfig.PHANTOM_SHOT_COUNT)
+		{
+			player.getInventory().addItem(ItemProcessType.REWARD, gear.shots, PhantomsConfig.PHANTOM_SHOT_COUNT - have, player, null);
+		}
+		player.addAutoSoulShot(gear.shots);
+		player.rechargeShots(true, true);
+	}
+
+	private static void fullBars(Player player)
+	{
+		player.setCurrentHpMp(player.getMaxHp(), player.getMaxMp());
+		player.setCurrentCp(player.getMaxCp());
+	}
+}
diff --git a/java/org/l2jmobius/gameserver/managers/phantom/PhantomTemplate.java b/java/org/l2jmobius/gameserver/managers/phantom/PhantomTemplate.java
new file mode 100644
index 0000000..1f1c69d
--- /dev/null
+++ b/java/org/l2jmobius/gameserver/managers/phantom/PhantomTemplate.java
@@ -0,0 +1,183 @@
+package org.l2jmobius.gameserver.managers.phantom;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.Comparator;
+import java.util.List;
+
+import org.l2jmobius.gameserver.entity.Location;
+
+/**
+ * L2Hub: описание напарника-фантома из data/L2HubPhantoms.xml.<br>
+ * Уровень у напарника не фиксирован: класс и шмот выбираются по уровню, до которого его подтягивают.
+ */
+public class PhantomTemplate
+{
+	/** Смены профессии: с какого уровня берётся следующий класс ветки. */
+	private static final int[] CLASS_TIER_LEVELS =
+	{
+		20,
+		40,
+		76
+	};
+
+	public enum Role
+	{
+		HEALER,
+		BUFFER,
+		TANK,
+		DAMAGE
+	}
+
+	/**
+	 * Шмот одного грейда: надевается с minLevel. Ноль — слот пустой.
+	 */
+	public static class Gear
+	{
+		public final String grade;
+		public final int minLevel;
+		public final int rhand;
+		public final int lhand;
+		public final int head;
+		public final int chest;
+		public final int legs;
+		public final int gloves;
+		public final int feet;
+		public final int shots;
+
+		public Gear(String grade, int minLevel, int rhand, int lhand, int head, int chest, int legs, int gloves, int feet, int shots)
+		{
+			this.grade = grade;
+			this.minLevel = minLevel;
+			this.rhand = rhand;
+			this.lhand = lhand;
+			this.head = head;
+			this.chest = chest;
+			this.legs = legs;
+			this.gloves = gloves;
+			this.feet = feet;
+			this.shots = shots;
+		}
+
+		public int[] items()
+		{
+			return new int[]
+			{
+				chest,
+				legs,
+				head,
+				gloves,
+				feet,
+				rhand,
+				lhand
+			};
+		}
+	}
+
+	private final String _name;
+	private final Role _role;
+	private final boolean _female;
+	private final byte _face;
+	private final byte _hairStyle;
+	private final byte _hairColor;
+	private final int[] _classes;
+	private final Location _home;
+	private final List<Gear> _gear;
+
+	public PhantomTemplate(String name, Role role, boolean female, byte face, byte hairStyle, byte hairColor, int[] classes, Location home, List<Gear> gear)
+	{
+		_name = name;
+		_role = role;
+		_female = female;
+		_face = face;
+		_hairStyle = hairStyle;
+		_hairColor = hairColor;
+		_classes = classes;
+		_home = home;
+		final List<Gear> sorted = new ArrayList<>(gear);
+		sorted.sort(Comparator.comparingInt(g -> g.minLevel));
+		_gear = Collections.unmodifiableList(sorted);
+	}
+
+	public String getName()
+	{
+		return _name;
+	}
+
+	public Role getRole()
+	{
+		return _role;
+	}
+
+	public boolean isFemale()
+	{
+		return _female;
+	}
+
+	public byte getFace()
+	{
+		return _face;
+	}
+
+	public byte getHairStyle()
+	{
+		return _hairStyle;
+	}
+
+	public byte getHairColor()
+	{
+		return _hairColor;
+	}
+
+	/**
+	 * @return стартовый класс ветки (из него создаётся персонаж)
+	 */
+	public int getStartClassId()
+	{
+		return _classes[0];
+	}
+
+	/**
+	 * @param level уровень персонажа
+	 * @return класс ветки, положенный на этом уровне
+	 */
+	public int getClassId(int level)
+	{
+		int tier = 0;
+		while ((tier < CLASS_TIER_LEVELS.length) && (level >= CLASS_TIER_LEVELS[tier]))
+		{
+			tier++;
+		}
+		return _classes[Math.min(tier, _classes.length - 1)];
+	}
+
+	/**
+	 * @param level уровень персонажа
+	 * @return шмот самого высокого грейда, доступного на этом уровне, или {@code null}
+	 */
+	public Gear getGear(int level)
+	{
+		Gear result = null;
+		for (Gear gear : _gear)
+		{
+			if (gear.minLevel <= level)
+			{
+				result = gear;
+			}
+		}
+		return result;
+	}
+
+	public List<Gear> getAllGear()
+	{
+		return _gear;
+	}
+
+	/**
+	 * @return точка у гейткипера Гирана: здесь появляется новый фантом, если его поднимают без GM рядом
+	 */
+	public Location getHome()
+	{
+		return _home;
+	}
+}
