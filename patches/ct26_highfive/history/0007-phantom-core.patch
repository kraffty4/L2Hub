new file mode 100644
index 0000000..ee68588
--- /dev/null
+++ b/dist/game/config/Custom/Phantoms.ini
@@ -0,0 +1,26 @@
+# ---------------------------------------------------------------------------
+# Фантомы (L2Hub)
+# ---------------------------------------------------------------------------
+# Фантом — настоящий персонаж игрока без клиента: свой класс, скиллы, шмот и уровень.
+# Напарники описаны в data/L2HubPhantoms.xml (пишет tools/fake_players.py), характеры для мозгов —
+# в data/L2HubFakePersonas.json. Управление GM: //phantom list | spawn | despawn | reload.
+
+# Включить фантомов.
+EnablePhantoms = True
+
+# Аккаунт, на котором живут персонажи фантомов (в списках лаунчера они не показываются).
+PhantomAccount = l2hub_phantom
+
+# Закрыть вход под аккаунтом фантомов: при старте сервера строка аккаунта в таблице accounts
+# получает accessLevel = -1 (бан), иначе при AutoCreateAccounts любой зашёл бы их персонажами.
+PhantomBanAccountLogin = True
+
+# Поднимать после рестарта фантомов, которые были в мире, на их местах.
+PhantomRestoreOnStartup = True
+
+# Уровень нового фантома, если его поднимают при старте сервера, а персонажа ещё нет
+# (//phantom spawn берёт уровень из команды или уровень GM).
+PhantomDefaultLevel = 40
+
+# Сколько зарядов BSS выдавать фантому при сборке и подкладывать при восстановлении.
+PhantomShotCount = 5000
