+	private static void noticeGrudges(Player player)
+	{
+		final String grudges = player.getVariables().getString(GRUDGE_VARIABLE, "");
+		if (grudges.isEmpty())
+		{
+			return;
+		}
+
+		for (Player other : World.getVisibleObjectsInRange(player, Player.class, 700))
+		{
+			if (PhantomManager.getInstance().isPhantom(other) || other.isInvisible())
+			{
+				continue;
+			}
+
+			final int count = grudge(player, other);
+			if (count > 0)
+			{
+				PhantomChat.getInstance().hunterEvent(player, other, "GRUDGE", "мимо проходит " + describe(other) + ", который убивал тебя (" + count + " раз) — ты его узнал", "о, опять ты...", 900000);
+			}
+		}
+	}
+
+	/**
+	 * Обиды охотника — переменная персонажа {@value #GRUDGE_VARIABLE}: «objectId:сколько раз убил;...».
+	 * @return сколько раз этот игрок убивал охотника
+	 */
+	static int grudge(Player hunter, Player other)
+	{
+		for (String entry : hunter.getVariables().getString(GRUDGE_VARIABLE, "").split(";"))
+		{
+			final String[] parts = entry.split(":");
+			if ((parts.length == 2) && parts[0].equals(String.valueOf(other.getObjectId())))
+			{
+				return Integer.parseInt(parts[1]);
+			}
+		}
+		return 0;
+	}
+
+	private static int addGrudge(Player hunter, Player other)
+	{
+		final List<String> entries = new ArrayList<>();
+		int count = 1;
+		for (String entry : hunter.getVariables().getString(GRUDGE_VARIABLE, "").split(";"))
+		{
+			final String[] parts = entry.split(":");
+			if (parts.length != 2)
+			{
+				continue;
+			}
+
+			if (parts[0].equals(String.valueOf(other.getObjectId())))
+			{
+				count = Integer.parseInt(parts[1]) + 1;
+			}
+			else
+			{
+				entries.add(entry);
+			}
+		}
+		entries.add(0, other.getObjectId() + ":" + count);
+		hunter.getVariables().set(GRUDGE_VARIABLE, String.join(";", entries.subList(0, Math.min(entries.size(), 20))));
+		hunter.getVariables().storeMe();
+		return count;
+	}
+
+	private static Player actingPlayer(Creature creature)
+	{
+		if (creature instanceof Player)
+		{
+			return (Player) creature;
+		}
+		if (creature instanceof Summon)
+		{
+			return ((Summon) creature).getOwner();
+		}
+		return null;
+	}
+
+	private static String describe(Player other)
