+	/**
+	 * «Паровозик» (патч 0029): охотник качается сам родным AutoPlay, как на споте — свои цели (дальний поиск), скиллы AutoUse, подбор; маг под ударами отмахивается.
+	 * В пати AutoPlay не тянется за лидером ({@code AssistLeader = False}). Владелец отстал дальше {@link #LEAD_WAIT} — новых мобов не берёт, идёт к нему;
+	 * отстал дальше {@code PhantomCatchUpRange} — телепорт к нему (как у всех напарников, в {@link #think}).
+	 */
+	private static void lead(Player phantom, Player owner)
+	{
+		if (phantom.calculateDistance2D(owner) > LEAD_WAIT)
+		{
+			if (phantom.isAutoPlaying())
+			{
+				AutoPlayTaskManager.getInstance().stopAutoPlay(phantom);
+			}
+			if (!phantom.isAttackingNow() && !phantom.isCastingNow() && !phantom.isMoving())
+			{
+				phantom.setRunning();
+				phantom.getAI().setIntentionMoveTo(new Location(owner.getX(), owner.getY(), owner.getZ()));
+			}
+			return;
+		}
+
+		// Цель далеко от владельца — опыт пати мимо: пусть AutoPlay возьмёт ближе.
+		final WorldObject target = phantom.getTarget();
+		if ((target instanceof Monster) && !phantom.isAttackingNow() && !phantom.isCastingNow() && (owner.calculateDistance2D(target) > LEAD_TARGET_RANGE))
+		{
+			phantom.setTarget(null);
+		}
+
+		if (!phantom.isAutoPlaying())
+		{
+			if (phantom.isSitting())
+			{
+				phantom.standUp();
+			}
+			phantom.getAutoPlaySettings().setNextTargetMode(1); // мобы
+			AutoPlayTaskManager.getInstance().startAutoPlay(phantom);
+			AutoUseTaskManager.getInstance().startAutoUseTask(phantom);
+		}
+		PhantomHunterOutfit.syncMelee(phantom);
+	}
