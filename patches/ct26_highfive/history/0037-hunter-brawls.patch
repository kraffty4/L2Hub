diff --git a/dist/game/config/Custom/PhantomHunters.ini b/dist/game/config/Custom/PhantomHunters.ini
index 5315263..7ff1ad1 100644
--- a/dist/game/config/Custom/PhantomHunters.ini
+++ b/dist/game/config/Custom/PhantomHunters.ini
@@ -216,3 +216,28 @@ HunterPartyChanceFriend = 80
 
 # Сколько минут живёт пати охотников «от,до» — у каждой своё.
 HunterPartyMinutes = 20,60
+
+# Махач охотников-врагов (docs/PHANTOMS.md, раздел 4.20). Повод — новая обида (отжал моба) или встреча врагов; дальше
+# порог «невозможно терпеть», оценка и бросок. Боты боятся ПК: зачинщик бьёт, только если второй сравним по уровню и при
+# здоровье, — тот ответит и флаганётся, будет ПвП без кармы; не ответил за 6 с или почти умер без флага — зачинщик
+# отходит со словами. Угрозы, ответы и итог — вслух в белом чате, если рядом живой игрок.
+HunterBrawls = True
+
+# Обида, с которой «невозможно терпеть»: 5 — например, убил (3) и дважды отжал моба, или пять раз отжал.
+HunterBrawlGrudge = 5
+
+# Шанс (%) сорваться при поводе; одна пара дерётся не чаще раза в столько секунд.
+HunterBrawlChance = 50
+HunterBrawlCooldown = 3600
+
+# На сильного не лезет, слабого не бьёт: разница уровней — не больше стольких.
+HunterBrawlLevelGap = 3
+
+# Драться только при живом зрителе рядом (в 2000): драка должна быть видна.
+HunterBrawlWitness = True
+
+# Предъява за моба: обиженный говорит отжавшему, тот отвечает по броску × вспыльчивость (temper в data/L2HubPhantoms.xml:
+# 1,5 — горячие, 0,5 — мягкие; врагу хамят охотнее, другу реже). «Сорян» — уходит ногами на другой спот, и это гасит
+# «отжал моба»; «пнх» — ещё минус очко, может начаться махач. Решает сервер всегда, вслух — при живом зрителе.
+# Шанс (%) ответить «пнх» у обычного охотника:
+HunterContestRudeChance = 40
