@@ -18,6 +18,9 @@ HuntersResetId = 0
 
 # Самопроверка без клиента (для разработки): LFM — охотник «кричит» «лфм нужен дд», откликнувшийся приходит,
 # принимает инвайт, минуту ходит в пати и возвращается на кач; шаги — в логе с пометкой SelfTest.
+# STRATEGY — 10 минут мозги-стратег думает и без живых игроков: все охотники на спотах спрашивают модель
+# в ближайшие 3 минуты (в пределах HunterStrategyPerMinute); первый ответ — нарочно мусор (проверка отката
+# на правила), следующие шесть — случайный вариант без модели (проверка выполнения), остальные — модель.
 # Выполняется один раз — когда меняется HuntersSelfTestId.
 HuntersSelfTest =
 HuntersSelfTestId = 0
@@ -59,3 +62,25 @@ HunterLfm = True
 
 # Больше стольких охотников на один спот не ставится, пока есть свободные споты того же уровня.
 HuntersPerSpot = 2
+
+# ---------------------------------------------------------------------------
+# Мозги-стратег (docs/PHANTOMS.md, раздел 4.3): охотник на споте время от времени спрашивает модель
+# (сервис мозгов launcher/l2hub/brain.py, та модель, что выбрана в лаунчере), что делать дальше: качаться,
+# сменить спот выше или ниже, сходить в город, сесть в лавку, поискать пати, отдохнуть в городе.
+# Модель не ответила, ответила мусором или бюджет исчерпан — охотник живёт по правилам, как без стратега.
+# ---------------------------------------------------------------------------
+HunterStrategy = True
+
+# Когда думать: WITH_PLAYERS — только пока в игре есть живой игрок (без игроков — правила, запросы не тратятся);
+# ALWAYS — всегда.
+HunterStrategyWhen = WITH_PLAYERS
+
+# Сколько решений в час на одного охотника. Промежуток между решениями случайный — от половины до полутора
+# среднего (при 6 — от 5 до 15 минут), у каждого охотника свой.
+HunterStrategyPerHour = 6
+
+# Не больше стольких запросов стратега в минуту на всех охотников; сверх — решают правила.
+HunterStrategyPerMinute = 6
+
+# С такой вероятностью (%) охотник говорит свою мысль вслух в общий чат рядом — если рядом есть живой игрок.
+HunterStrategySayChance = 20
