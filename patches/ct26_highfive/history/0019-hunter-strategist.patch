+	private boolean strategy(Hunter hunter, Player player, long now)
+	{
+		final Choice choice = hunter.choice;
+		if (choice != null)
+		{
+			if ((now - choice.at) > PhantomHunterStrategy.CHOICE_TTL)
+			{
+				hunter.choice = null;
