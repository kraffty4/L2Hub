+						sayNear(second, text, "say");
+						LOGGER.info(PhantomBanter.class.getSimpleName() + ": " + second.getName() + " -> " + first.getName() + ": «" + text + "»");
+					}
+				}, () ->
+				{
+					// Мозги недоступны — второй молчит.
+				});
+			}, Rnd.get(2000, 5000));
+		}, () ->
+		{
+			// Мозги недоступны — тишина.
