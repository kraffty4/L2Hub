new file mode 100644
index 0000000..a24c3d2
--- /dev/null
+++ b/dist/game/data/scripts/handlers/bypass/communityboard/L2HubBoard.java
@@ -0,0 +1,426 @@
+package handlers.bypass.communityboard;
+
+import java.util.List;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+
+import org.l2jmobius.gameserver.cache.HtmCache;
+import org.l2jmobius.gameserver.config.custom.CommunityBoardConfig;
+import org.l2jmobius.gameserver.config.custom.PhantomsConfig;
+import org.l2jmobius.gameserver.data.SchemeBufferTable;
+import org.l2jmobius.gameserver.data.xml.MultisellData;
+import org.l2jmobius.gameserver.data.xml.SkillData;
+import org.l2jmobius.gameserver.entity.actor.Creature;
+import org.l2jmobius.gameserver.entity.actor.Player;
+import org.l2jmobius.gameserver.entity.actor.holders.npc.BuffSkillHolder;
+import org.l2jmobius.gameserver.entity.item.enums.ItemProcessType;
+import org.l2jmobius.gameserver.entity.zone.ZoneId;
+import org.l2jmobius.gameserver.handler.CommunityBoardHandler;
+import org.l2jmobius.gameserver.handler.IParseBoardHandler;
+import org.l2jmobius.gameserver.managers.phantom.PhantomUi;
+import org.l2jmobius.gameserver.mechanics.skill.Skill;
+
+/**
+ * L2Hub: доска Alt+B — баффер, GM-шоп и напарники.
+ * <ul>
+ * <li>_bbshubbuff [категория] — баффер из SchemeBufferSkills.xml (как городской баффер схем): категории, по одному бафу, наборы воину и магу (FIGHTER_GROUP, MAGE_GROUP), себе или питомцу; хил и снять бафы</li>
+ * <li>_bbshubshop [страница] — GM-шоп из страниц NPC GM-шопа (html/merchant/&lt;CommunityShopNpc&gt;*.htm) с переписанными кнопками; мультиселлы — MultisellData.separateAndSendFromBoard</li>
+ * <li>_bbshubbuddy [действие имя] — окно напарников ({@link PhantomUi})</li>
+ * </ul>
+ */
+public class L2HubBoard implements IParseBoardHandler
+{
+	private static final String NAVIGATION_PATH = "data/html/CommunityBoard/Custom/navigation.html";
+	private static final String BUFF = "_bbshubbuff";
+	private static final String SHOP = "_bbshubshop";
+	private static final String BUDDY = "_bbshubbuddy";
+	private static final String[] COMMANDS =
+	{
+		BUFF,
+		SHOP,
+		BUDDY
+	};
+
+	private static final Pattern NPC_CHAT = Pattern.compile("bypass (?:-h )?npc_%objectId%_Chat (\\d+)");
+	private static final Pattern NPC_MULTISELL = Pattern.compile("bypass (?:-h )?npc_%objectId%_multisell (\\d+)");
+	private static final Pattern BODY = Pattern.compile("(?is)<body[^>]*>(.*)</body>");
+	private static final Pattern TITLE = Pattern.compile("(?is)<title>.*?</title>");
+	private static final int ICONS_PER_ROW = 10;
+
+	@Override
+	public String[] getCommandList()
+	{
+		return COMMANDS;
+	}
+
+	@Override
+	public boolean onCommand(String command, Player player)
+	{
+		final String[] args = command.strip().split("\\s+");
+		final String html;
+		if (args[0].equalsIgnoreCase(BUFF))
+		{
+			html = buffer(player, args);
+		}
+		else if (args[0].equalsIgnoreCase(SHOP))
+		{
+			html = shop(player, args);
+		}
+		else if (args[0].equalsIgnoreCase(BUDDY))
+		{
+			html = buddy(player, args);
+		}
+		else
+		{
+			return false;
+		}
+
+		if (html != null)
+		{
+			CommunityBoardHandler.separateAndSend(html, player);
+		}
+		return false;
+	}
+
+	// ---------- Баффер ----------
+
+	/**
+	 * _bbshubbuff [категория] | set fighter|mage [pet] | one &lt;id&gt; &lt;категория&gt; [pet] | heal &lt;категория&gt; | cancel &lt;категория&gt;
+	 */
+	private static String buffer(Player player, String[] args)
+	{
+		final SchemeBufferTable table = SchemeBufferTable.getInstance();
+		final List<String> types = table.getSkillTypes();
+		String category = types.isEmpty() ? "" : types.get(0);
+		final String action = args.length > 1 ? args[1].toLowerCase() : "";
+		switch (action)
+		{
+			case "set":
+			{
+				if (canUse(player))
+				{
+					final boolean pet = (args.length > 3) && args[3].equalsIgnoreCase("pet");
+					final String group = (args.length > 2) && args[2].equalsIgnoreCase("mage") ? "MAGE_GROUP" : "FIGHTER_GROUP";
+					final Creature target = pet ? player.getSummon() : player;
+					if (target == null)
+					{
+						player.sendMessage("У тебя нет питомца.");
+					}
+					else
+					{
+						int count = 0;
+						for (int skillId : table.getSkillsIdsByType(group))
+						{
+							if (apply(player, target, table.getAvailableBuff(group, skillId)))
+							{
+								count++;
+							}
+						}
+						player.sendMessage("Бафы наложены: " + count + ".");
+					}
+				}
+				break;
+			}
+			case "one":
+			{
+				category = args.length > 3 ? args[3] : category;
+				if (canUse(player) && (args.length > 2))
+				{
+					final boolean pet = (args.length > 4) && args[4].equalsIgnoreCase("pet");
+					final Creature target = pet ? player.getSummon() : player;
+					final BuffSkillHolder holder = table.getAvailableBuff(category, parseInt(args[2]));
+					if (target == null)
+					{
+						player.sendMessage("У тебя нет питомца.");
+					}
+					else if ((holder == null) || !table.getSkillsIdsByType(category).contains(holder.getId()))
+					{
+						player.sendMessage("Такого бафа у баффера нет.");
+					}
+					else if (pay(player, holder.getPrice()))
+					{
+						apply(player, target, holder);
+					}
+				}
+				break;
+			}
+			case "heal":
+			{
+				category = args.length > 2 ? args[2] : category;
+				if (canUse(player))
+				{
+					player.setCurrentHpMp(player.getMaxHp(), player.getMaxMp());
+					player.setCurrentCp(player.getMaxCp());
+					if (player.hasSummon())
+					{
+						player.getSummon().setCurrentHpMp(player.getSummon().getMaxHp(), player.getSummon().getMaxMp());
+					}
+					player.sendMessage("HP, MP и CP восстановлены.");
+				}
+				break;
+			}
+			case "cancel":
+			{
+				category = args.length > 2 ? args[2] : category;
+				if (canUse(player))
+				{
+					player.getEffectList().stopAllBuffs(true, false);
+					player.getEffectList().stopAllDances(true);
+					player.sendMessage("Бафы сняты.");
+				}
+				break;
+			}
+			default:
+			{
+				if (args.length > 1)
+				{
+					category = args[1];
+				}
+				break;
+			}
+		}
+		return page(player, "Баффер", bufferContent(player, table, types, category));
+	}
+
+	private static String bufferContent(Player player, SchemeBufferTable table, List<String> types, String category)
+	{
+		final StringBuilder sb = new StringBuilder(12288);
+		sb.append("<table width=520><tr>");
+		sb.append("<td align=center>").append(button("Воину — всё", BUFF + " set fighter", 120)).append("</td>");
+		sb.append("<td align=center>").append(button("Магу — всё", BUFF + " set mage", 120)).append("</td>");
+		sb.append("<td align=center>").append(button("Хил", BUFF + " heal " + category, 120)).append("</td>");
+		sb.append("<td align=center>").append(button("Снять бафы", BUFF + " cancel " + category, 120)).append("</td>");
+		sb.append("</tr>");
+		if (player.hasSummon())
+		{
+			sb.append("<tr><td align=center>").append(button("Питомцу: воин", BUFF + " set fighter pet", 120)).append("</td>");
+			sb.append("<td align=center>").append(button("Питомцу: маг", BUFF + " set mage pet", 120)).append("</td><td></td><td></td></tr>");
+		}
+		sb.append("</table><br>");
+
+		sb.append("<table width=520><tr>");
+		int column = 0;
+		for (String type : types)
+		{
+			if ((column > 0) && ((column % 6) == 0))
+			{
+				sb.append("</tr><tr>");
+			}
+			sb.append("<td align=center>").append(button(type.equalsIgnoreCase(category) ? "[" + categoryName(type) + "]" : categoryName(type), BUFF + " " + type, 80)).append("</td>");
+			column++;
+		}
+		sb.append("</tr></table><br>");
+
+		sb.append("<font color=\"LEVEL\">").append(categoryName(category)).append("</font> — нажми на иконку, чтобы наложить баф").append(player.hasSummon() ? " (ниже — питомцу)" : "").append("<br1>");
+		sb.append(iconGrid(table, category, ""));
+		if (player.hasSummon())
+		{
+			sb.append("<br><font color=\"B09878\">Питомцу</font><br1>").append(iconGrid(table, category, " pet"));
+		}
+		return sb.toString();
+	}
+
+	private static String iconGrid(SchemeBufferTable table, String category, String suffix)
+	{
+		final StringBuilder sb = new StringBuilder(6144);
+		sb.append("<table cellspacing=4><tr>");
+		int column = 0;
+		for (int skillId : table.getSkillsIdsByType(category))
+		{
+			if ((column > 0) && ((column % ICONS_PER_ROW) == 0))
+			{
+				sb.append("</tr><tr>");
+			}
+			sb.append("<td width=32 height=32 background=\"").append(icon(skillId)).append("\"><button value=\" \" action=\"bypass ").append(BUFF).append(" one ").append(skillId).append(' ').append(category).append(suffix).append("\" width=32 height=32 back=\"L2UI_CT1.ItemWindow_DF_Frame_Down\" fore=\"L2UI_CT1.ItemWindow_DF_Frame\"></td>");
+			column++;
+		}
+		return sb.append("</tr></table>").toString();
+	}
+
+	private static boolean apply(Player player, Creature target, BuffSkillHolder holder)
+	{
+		if (holder == null)
+		{
+			return false;
+		}
+
+		final Skill skill = SkillData.getInstance().getSkill(holder.getId(), holder.getLevel());
+		if (skill == null)
+		{
+			return false;
+		}
+
+		skill.applyEffects(player, target);
+		return true;
+	}
+
+	private static boolean pay(Player player, int price)
+	{
+		return (price <= 0) || player.reduceAdena(ItemProcessType.FEE, price, player, true);
+	}
+
+	/**
+	 * Как у доски Mobius: в бою, на олимпиаде, в осаде, с PvP-флагом, мёртвым или с кармой — нельзя.
+	 */
+	private static boolean canUse(Player player)
+	{
+		if (CommunityBoardConfig.COMMUNITYBOARD_KARMA_DISABLED && (player.getKarma() > 0))
+		{
+			player.sendMessage("С кармой доской пользоваться нельзя.");
+			return false;
+		}
+
+		if (CommunityBoardConfig.COMMUNITYBOARD_COMBAT_DISABLED && (player.isCastingNow() || player.isInCombat() || player.isInDuel() || player.isInOlympiadMode() || player.isInsideZone(ZoneId.SIEGE) || player.isInsideZone(ZoneId.PVP) || (player.getPvpFlag() > 0) || player.isAlikeDead() || player.isOnEvent() || player.isInStoreMode()))
+		{
+			player.sendMessage("Сейчас нельзя: ты в бою, мёртв или на событии.");
+			return false;
+		}
+
+		if (CommunityBoardConfig.COMMUNITYBOARD_PEACE_ONLY && !player.isInsideZone(ZoneId.PEACE))
+		{
+			player.sendMessage("Доской можно пользоваться только в мирной зоне.");
+			return false;
+		}
+		return true;
+	}
+
+	private static String categoryName(String type)
+	{
+		switch (type.toLowerCase())
+		{
+			case "buffs":
+			{
+				return "Бафы";
+			}
+			case "dances":
+			{
+				return "Танцы";
+			}
+			case "songs":
+			{
+				return "Песни";
+			}
+			case "chants":
+			{
+				return "Чанты";
+			}
+			case "special":
+			{
+				return "Особые";
+			}
+			case "resist":
+			{
+				return "Резисты";
+			}
+			default:
+			{
+				return type;
+			}
+		}
+	}
+
+	private static String icon(int skillId)
+	{
+		return skillId < 1000 ? String.format("icon.skill%04d", skillId) : "icon.skill" + skillId;
+	}
+
+	// ---------- GM-шоп ----------
+
+	/**
+	 * _bbshubshop [страница] | ms &lt;мультиселл&gt; &lt;страница&gt;
+	 */
+	private static String shop(Player player, String[] args)
+	{
+		int pageId = 0;
+		if ((args.length > 3) && args[1].equalsIgnoreCase("ms"))
+		{
+			pageId = parseInt(args[3]);
+			if (canUse(player))
+			{
+				MultisellData.getInstance().separateAndSendFromBoard(parseInt(args[2]), player);
+			}
+		}
+		else if (args.length > 1)
+		{
+			pageId = parseInt(args[1]);
+		}
+
+		final int npcId = CommunityBoardConfig.COMMUNITY_SHOP_NPC;
+		String htm = HtmCache.getInstance().getHtm(player, "data/html/merchant/" + npcId + (pageId > 0 ? "-" + pageId : "") + ".htm");
+		if (htm == null)
+		{
+			htm = HtmCache.getInstance().getHtm(player, "data/html/merchant/" + npcId + ".htm");
+			pageId = 0;
+		}
+		if (htm == null)
+		{
+			return page(player, "GM-шоп", "Нет страниц GM-шопа (NPC " + npcId + ").");
+		}
+
+		final Matcher body = BODY.matcher(htm);
+		String content = TITLE.matcher(body.find() ? body.group(1) : htm).replaceAll("");
+		content = NPC_CHAT.matcher(content).replaceAll("bypass " + SHOP + " $1");
+		content = NPC_MULTISELL.matcher(content).replaceAll("bypass " + SHOP + " ms $1 " + pageId);
+		if (pageId > 0)
+		{
+			content = button("В начало GM-шопа", SHOP, 150) + "<br>" + content;
+		}
+		return page(player, "GM-шоп", content);
+	}
+
+	// ---------- Напарники ----------
+
+	/**
+	 * _bbshubbuddy [действие имя]
+	 */
+	private static String buddy(Player player, String[] args)
+	{
+		if (!PhantomsConfig.PHANTOMS_ENABLED)
+		{
+			return page(player, "Напарники", "Напарники выключены (EnablePhantoms в Phantoms.ini).");
+		}
+
+		if (args.length > 1)
+		{
+			final String error = PhantomUi.handle(player, args[1], args.length > 2 ? args[2] : null);
+			if (error != null)
+			{
+				player.sendMessage(error);
+			}
+		}
+		return page(player, "Напарники", PhantomUi.render(player, "bypass " + BUDDY));
+	}
+
+	// ---------- Общее ----------
+
+	/**
+	 * Страница доски в общем оформлении: навигация слева, справа заголовок и содержимое.
+	 */
+	private static String page(Player player, String title, String content)
+	{
+		final String navigation = HtmCache.getInstance().getHtm(player, NAVIGATION_PATH);
+		return "<html><body><table width=700><tr><td height=10></td></tr></table><table width=20><tr><td valign=top>" + (navigation != null ? navigation : "") + "</td><td valign=top><center>" //
+			+ "<table border=0 cellpadding=0 cellspacing=0 width=555 background=\"L2UI_CT1.Windows_DF_TooltipBG\">" //
+			+ "<tr><td height=15></td></tr><tr><td align=center><font name=\"hs12\" color=\"CDB67F\">" + title + "</font></td></tr>" //
+			+ "<tr><td><center><img src=\"L2UI.SquareGray\" width=200 height=1></center></td></tr><tr><td height=10></td></tr>" //
+			+ "<tr><td align=center>" + content + "</td></tr><tr><td height=15></td></tr></table>" //
+			+ "</center></td></tr></table></body></html>";
+	}
+
+	private static String button(String label, String action, int width)
+	{
+		return "<button value=\"" + label + "\" action=\"bypass " + action + "\" width=" + width + " height=25 back=\"L2UI_CT1.Button_DF_Down\" fore=\"L2UI_CT1.Button_DF\">";
+	}
+
+	private static int parseInt(String value)
+	{
+		try
+		{
+			return Integer.parseInt(value);
+		}
+		catch (NumberFormatException e)
+		{
+			return 0;
+		}
+	}
+}
