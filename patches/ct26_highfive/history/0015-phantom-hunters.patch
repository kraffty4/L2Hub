@@ -0,0 +1,29 @@
+# ---------------------------------------------------------------------------
+# Охотники-фантомы (L2Hub)
+# ---------------------------------------------------------------------------
+# Фермеры (Кузя, Вован, ЛунаТик и др.) — настоящие игроки без клиента: начинают с 1 уровня в стартовой деревне
+# своей расы, сами качаются на спотах своего уровня (data/L2HubHuntSpots.xml), умирают, возвращаются, меняют профессию.
+# Сервер перечитывает этот файл на ходу, когда он меняется: режим и сброс ставит лаунчер L2Hub (вкладка «Фантомы»).
+
+# Когда живут охотники:
+#   OFF — их нет в мире;
+#   ALWAYS — всегда, пока запущен сервер (качаются и без тебя);
+#   WITH_PLAYERS — только пока в игре есть живой игрок (уходят через HuntersIdleTimeout после последнего).
+HuntersMode = ALWAYS
+
+# Сброс прогресса: имена через запятую или ALL. Охотник удаляется из базы и появляется заново с 1 уровня.
+# Выполняется один раз — когда меняется HuntersResetId (лаунчер увеличивает его на 1).
+HuntersReset =
+HuntersResetId = 0
+
+# Режим WITH_PLAYERS: через столько секунд после выхода последнего живого игрока охотники уходят из мира.
+HuntersIdleTimeout = 300
+
+# Сколько секунд лежит убитый охотник, прежде чем вернуться в город.
+HunterRespawnDelay = 20
+
+# Сосов своего грейда у охотника не меньше этого (добираются сами).
+HunterShotCount = 2000
+
+# Больше стольких охотников на один спот не ставится, пока есть свободные споты того же уровня.
+HuntersPerSpot = 2
