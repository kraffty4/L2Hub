--- /dev/null
+++ b/java/org/l2jmobius/gameserver/config/custom/PhantomHuntersConfig.java
@@ -0,0 +1,33 @@
+package org.l2jmobius.gameserver.config.custom;
+
+import org.l2jmobius.commons.util.ConfigReader;
+
+/**
+ * L2Hub: охотники-фантомы (config/Custom/PhantomHunters.ini). Сервер перечитывает файл на ходу, когда он меняется: режим и сброс прогресса ставит лаунчер L2Hub.
+ */
+public class PhantomHuntersConfig
+{
+	// File
+	public static final String PHANTOM_HUNTERS_CONFIG_FILE = "./config/Custom/PhantomHunters.ini";
+
+	// Constants
+	public static String HUNTERS_MODE;
+	public static String HUNTERS_RESET;
+	public static int HUNTERS_RESET_ID;
+	public static int HUNTERS_IDLE_TIMEOUT;
+	public static int HUNTER_RESPAWN_DELAY;
+	public static int HUNTER_SHOT_COUNT;
+	public static int HUNTERS_PER_SPOT;
+
+	public static void load()
+	{
+		final ConfigReader config = new ConfigReader(PHANTOM_HUNTERS_CONFIG_FILE);
+		HUNTERS_MODE = config.getString("HuntersMode", "ALWAYS").strip().toUpperCase();
+		HUNTERS_RESET = config.getString("HuntersReset", "").strip();
+		HUNTERS_RESET_ID = config.getInt("HuntersResetId", 0);
+		HUNTERS_IDLE_TIMEOUT = config.getInt("HuntersIdleTimeout", 300);
+		HUNTER_RESPAWN_DELAY = config.getInt("HunterRespawnDelay", 20);
+		HUNTER_SHOT_COUNT = config.getInt("HunterShotCount", 2000);
+		HUNTERS_PER_SPOT = config.getInt("HuntersPerSpot", 2);
+	}
+}
diff --git a/java/org/l2jmobius/gameserver/managers/phantom/HuntSpotData.java b/java/org/l2jmobius/gameserver/managers/phantom/HuntSpotData.java
new file mode 100644
index 0000000..01a3f21
--- /dev/null
+++ b/java/org/l2jmobius/gameserver/managers/phantom/HuntSpotData.java
@@ -0,0 +1,93 @@
+package org.l2jmobius.gameserver.managers.phantom;
+
+import java.io.File;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+import java.util.logging.Logger;
+
+import org.w3c.dom.Document;
+
+import org.l2jmobius.commons.util.IXmlReader;
+import org.l2jmobius.gameserver.entity.Location;
+import org.l2jmobius.gameserver.util.StatSet;
+
+/**
+ * L2Hub: споты охотников-фантомов из data/L2HubHuntSpots.xml (пишет tools/fake_players.py): группы спавна мобов с узким разбросом уровней.
+ */
+public class HuntSpotData implements IXmlReader
+{
+	private static final Logger LOGGER = Logger.getLogger(HuntSpotData.class.getName());
+
+	/**
+	 * Спот: уровень мобов (медиана и разброс), регион (папка спавнов), точка входа по геодате и радиус охоты.
+	 */
+	public static class HuntSpot
+	{
+		public final int level;
+		public final int min;
+		public final int max;
+		public final String region;
+		public final String name;
+		public final Location entry;
+		public final int radius;
+		public final int mobs;
+
+		HuntSpot(StatSet set)
+		{
+			level = set.getInt("level");
+			min = set.getInt("min");
+			max = set.getInt("max");
+			region = set.getString("region");
+			name = set.getString("name");
+			entry = new Location(set.getInt("x"), set.getInt("y"), set.getInt("z"));
+			radius = set.getInt("radius");
+			mobs = set.getInt("mobs");
+		}
+
+		@Override
+		public String toString()
+		{
+			return name + " (" + region + ", мобы " + min + "-" + max + ")";
+		}
+	}
+
+	private volatile List<HuntSpot> _spots = Collections.emptyList();
+	private List<HuntSpot> _loading;
+
+	protected HuntSpotData()
+	{
+		load();
+	}
+
+	@Override
+	public synchronized void load()
+	{
+		_loading = new ArrayList<>();
+		parseDatapackFile("data/L2HubHuntSpots.xml");
+		_spots = Collections.unmodifiableList(_loading);
+		_loading = null;
+		LOGGER.info(getClass().getSimpleName() + ": Loaded " + _spots.size() + " hunting spots.");
+	}
+
+	@Override
+	public void parseDocument(Document document, File file)
+	{
+		forEach(document, "list", listNode -> forEach(listNode, "spot", spotNode -> _loading.add(new HuntSpot(new StatSet(parseAttributes(spotNode))))));
+	}
+
+	public List<HuntSpot> getSpots()
+	{
+		return _spots;
+	}
+
+	public static HuntSpotData getInstance()
+	{
+		return SingletonHolder.INSTANCE;
+	}
+
+	private static class SingletonHolder
+	{
+		protected static final HuntSpotData INSTANCE = new HuntSpotData();
+	}
+}
