@@ -0,0 +1,164 @@
+package org.l2jmobius.gameserver.managers.phantom;
+
+import java.util.ArrayList;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Set;
+
+import org.l2jmobius.gameserver.config.custom.PhantomHuntersConfig;
+import org.l2jmobius.gameserver.entity.actor.Player;
+import org.l2jmobius.gameserver.entity.actor.holders.player.AutoPlaySettingsHolder;
+import org.l2jmobius.gameserver.entity.actor.holders.player.AutoUseSettingsHolder;
+import org.l2jmobius.gameserver.entity.item.enums.ItemProcessType;
+import org.l2jmobius.gameserver.entity.item.instance.Item;
+import org.l2jmobius.gameserver.entity.itemcontainer.Inventory;
+import org.l2jmobius.gameserver.mechanics.effects.EffectType;
+import org.l2jmobius.gameserver.mechanics.skill.Skill;
+import org.l2jmobius.gameserver.mechanics.skill.targets.TargetType;
+
+/**
+ * L2Hub: профессия, скиллы и снаряжение охотника — как у живого игрока: инвентарь (лут, адена) не трогается.<br>
+ * Профессия ветки — на 20, 40 и 76; новые скиллы — после каждого уровня (старые остаются); шмот — при смене грейда (меняется только свой набор); сосы своего грейда добираются до {@link PhantomHuntersConfig#HUNTER_SHOT_COUNT}.
+ */
+final class PhantomHunterOutfit
+{
+	/** Автоатака в AutoUse (как в AutoPlayTaskManager): без неё AutoPlay считает игрока кастером и не бьёт оружием. */
+	private static final Integer AUTO_ATTACK_ACTION = 2;
+	private static final Set<TargetType> ATTACK_TARGETS = Set.of(TargetType.ONE, TargetType.AREA, TargetType.FRONT_AREA, TargetType.AURA, TargetType.FRONT_AURA, TargetType.BEHIND_AREA, TargetType.BEHIND_AURA);
+
+	private PhantomHunterOutfit()
+	{
+	}
+
+	/**
+	 * После входа в мир и после каждого нового уровня.
+	 * @param player охотник
+	 * @param template его описание
+	 */
+	static void update(Player player, PhantomTemplate template)
+	{
+		// Лут и сосы весят: с перегрузом 4-й степени охотник встанет столбом.
+		player.setDietMode(true);
+		final int classId = template.getClassId(player.getLevel());
+		if (player.getPlayerClass().getId() != classId)
+		{
+			player.setPlayerClass(classId);
+			player.setBaseClass(classId);
+		}
+		player.giveAvailableSkills(true, true, true);
+
+		final PhantomTemplate.Gear gear = template.getGear(player.getLevel());
+		upgradeGear(player, template, gear);
+		refillShots(player, gear);
+		setupCombat(player);
+	}
+
+	/**
+	 * Шмот своего грейда: уже надет — ничего; иначе снять и уничтожить надетые вещи своего набора (других грейдов) и надеть новые. Остальное (лут) не трогается.
+	 */
+	private static void upgradeGear(Player player, PhantomTemplate template, PhantomTemplate.Gear gear)
+	{
+		if (gear == null)
+		{
+			return;
+		}
+
+		final Item weapon = player.getInventory().getPaperdollItem(Inventory.PAPERDOLL_RHAND);
+		if ((weapon != null) && (weapon.getId() == gear.rhand))
+		{
+			return;
+		}
+
+		final Set<Integer> own = new HashSet<>();
+		for (PhantomTemplate.Gear any : template.getAllGear())
+		{
+			for (int itemId : any.items())
+			{
+				if (itemId > 0)
+				{
+					own.add(itemId);
+				}
+			}
+		}
+
+		for (Item item : new ArrayList<>(player.getInventory().getPaperdollItems()))
+		{
+			if (own.contains(item.getId()))
+			{
+				player.getInventory().unEquipItemInSlot(item.getLocationSlot());
+				player.destroyItem(ItemProcessType.DESTROY, item, player, false);
+			}
+		}
+
+		PhantomOutfit.dress(player, gear);
+	}
+
+	private static void refillShots(Player player, PhantomTemplate.Gear gear)
+	{
+		player.getAutoSoulShot().clear();
+		if ((gear == null) || (gear.shots <= 0))
+		{
+			return;
+		}
+
+		final Item shots = player.getInventory().getItemByItemId(gear.shots);
+		final long have = shots == null ? 0 : shots.getCount();
+		if (have < (PhantomHuntersConfig.HUNTER_SHOT_COUNT / 2))
+		{
+			player.getInventory().addItem(ItemProcessType.REWARD, gear.shots, PhantomHuntersConfig.HUNTER_SHOT_COUNT - have, player, null);
+		}
+		player.addAutoSoulShot(gear.shots);
+		player.rechargeShots(true, true);
+	}
+
+	/**
+	 * Сосы своего грейда — раз в несколько минут, между уровнями тоже тратятся.
+	 * @param player охотник
+	 * @param template его описание
+	 */
+	static void refillShots(Player player, PhantomTemplate template)
+	{
+		refillShots(player, template.getGear(player.getLevel()));
+	}
+
+	/**
+	 * AutoPlay и AutoUse: цель — мобы рядом, не отбивать чужих мобов, подбирать лут; два-три самых сильных атакующих скилла класса. Воин бьёт ещё и оружием; кастер без атакующих скиллов (хилер) — тоже.
+	 */
+	private static void setupCombat(Player player)
+	{
+		final List<Skill> attacks = new ArrayList<>();
+		for (Skill skill : player.getAllSkills())
+		{
+			if (!skill.isActive() || skill.isToggle() || (skill.getItemConsumeCount() > 0) || (skill.getChargeConsumeCount() > 0) || !ATTACK_TARGETS.contains(skill.getTargetType()))
+			{
+				continue;
+			}
+
+			if (skill.hasEffectType(EffectType.PHYSICAL_ATTACK, EffectType.MAGICAL_ATTACK, EffectType.HP_DRAIN, EffectType.DEATH_LINK, EffectType.PHYSICAL_ATTACK_HP_LINK))
+			{
+				attacks.add(skill);
+			}
+		}
+		attacks.sort((a, b) -> Double.compare(b.getPower(), a.getPower()));
+
+		final boolean caster = player.isMageClass() && !attacks.isEmpty();
+		final AutoUseSettingsHolder use = player.getAutoUseSettings();
+		use.getAutoSkills().clear();
+		use.getAutoActions().clear();
+		use.resetSkillOrder();
+		if (!caster)
+		{
+			use.getAutoActions().add(AUTO_ATTACK_ACTION);
+		}
+		for (int i = 0; i < Math.min(caster ? 3 : 2, attacks.size()); i++)
+		{
+			use.getAutoSkills().add(attacks.get(i).getId());
+		}
+
+		final AutoPlaySettingsHolder play = player.getAutoPlaySettings();
+		play.setNextTargetMode(1); // мобы
+		play.setShortRange(true);
+		play.setRespectfulHunting(true);
+		play.setPickup(true);
+	}
+}
