diff --git a/dist/game/data/scripts/handlers/chat/commands/voiced/Buddy.java b/dist/game/data/scripts/handlers/chat/commands/voiced/Buddy.java
new file mode 100644
index 0000000..70be3d9
--- /dev/null
+++ b/dist/game/data/scripts/handlers/chat/commands/voiced/Buddy.java
@@ -0,0 +1,189 @@
+package handlers.chat.commands.voiced;
+
+import org.l2jmobius.gameserver.config.custom.PhantomsConfig;
+import org.l2jmobius.gameserver.entity.actor.Player;
+import org.l2jmobius.gameserver.handler.IVoicedCommandHandler;
+import org.l2jmobius.gameserver.managers.phantom.PhantomCompanionManager;
+import org.l2jmobius.gameserver.managers.phantom.PhantomCompanionManager.Mode;
+import org.l2jmobius.gameserver.managers.phantom.PhantomData;
+import org.l2jmobius.gameserver.managers.phantom.PhantomManager;
+import org.l2jmobius.gameserver.managers.phantom.PhantomTemplate;
+import org.l2jmobius.gameserver.network.serverpackets.NpcHtmlMessage;
+
+/**
+ * L2Hub: напарники-фантомы.
+ * <ul>
+ * <li>.buddy — окно: кто есть, где он, кнопки</li>
+ * <li>.buddy summon &lt;имя|роль&gt; — позвать к себе, подтянуть до своего уровня; затем пригласить в пати</li>
+ * <li>.buddy dismiss &lt;имя|роль&gt; — отпустить (уходит из мира)</li>
+ * <li>.buddy assist|follow|stay &lt;имя|роль&gt; — режим: бьёт твою цель / только защищается / стоит на месте</li>
+ * </ul>
+ */
+public class Buddy implements IVoicedCommandHandler
+{
+	private static final String[] VOICED_COMMANDS =
+	{
+		"buddy"
+	};
+
+	private static final String BUTTON = "<button value=\"%s\" action=\"bypass voice .buddy %s %s\" width=85 height=21 back=\"L2UI_CT1.Button_DF_Down\" fore=\"L2UI_CT1.Button_DF\">";
+
+	@Override
+	public boolean onCommand(String command, Player player, String params)
+	{
+		if (!PhantomsConfig.PHANTOMS_ENABLED)
+		{
+			player.sendMessage("Напарники выключены (EnablePhantoms в Phantoms.ini).");
+			return false;
+		}
+
+		if ((params != null) && !params.isBlank())
+		{
+			final String[] args = params.strip().split("\\s+");
+			final PhantomTemplate template = args.length > 1 ? find(args[1]) : null;
+			if (template == null)
+			{
+				player.sendMessage("Нет такого напарника. Список — .buddy");
+			}
+			else
+			{
+				final PhantomCompanionManager companions = PhantomCompanionManager.getInstance();
+				final String error;
+				switch (args[0].toLowerCase())
+				{
+					case "summon":
+					{
+						error = companions.summon(player, template);
+						break;
+					}
+					case "dismiss":
+					{
+						error = companions.dismiss(player, template);
+						break;
+					}
+					case "assist":
+					{
+						error = companions.setMode(player, template, Mode.ASSIST);
+						break;
+					}
+					case "follow":
+					{
+						error = companions.setMode(player, template, Mode.FOLLOW);
+						break;
+					}
+					case "stay":
+					{
+						error = companions.setMode(player, template, Mode.STAY);
+						break;
+					}
+					default:
+					{
+						error = "Не понял: " + args[0] + ". Можно summon, dismiss, assist, follow, stay.";
+						break;
+					}
+				}
+
+				if (error != null)
+				{
+					player.sendMessage(error);
+				}
+			}
+		}
+
+		showWindow(player);
+		return true;
+	}
+
+	/**
+	 * Имя напарника или его роль (healer, buffer).
+	 */
+	private static PhantomTemplate find(String key)
+	{
+		final PhantomTemplate byName = PhantomData.getInstance().getTemplate(key);
+		if (byName != null)
+		{
+			return byName;
+		}
+
+		for (PhantomTemplate template : PhantomData.getInstance().getTemplates())
+		{
+			if (template.getRole().name().equalsIgnoreCase(key))
+			{
+				return template;
+			}
+		}
+		return null;
+	}
+
+	private static void showWindow(Player player)
+	{
+		final StringBuilder sb = new StringBuilder(4096);
+		sb.append("<html><title>Напарники</title><body><center>");
+		for (PhantomTemplate template : PhantomData.getInstance().getTemplates())
+		{
+			final String name = template.getName();
+			final Player phantom = PhantomManager.getInstance().getPhantom(template);
+			sb.append("<table width=280><tr><td width=280><font color=\"LEVEL\">").append(name).append("</font> — ").append(roleName(template.getRole()));
+			if (phantom != null)
+			{
+				sb.append(", ").append(phantom.getLevel()).append(" ").append(className(phantom));
+			}
+			sb.append("</td></tr><tr><td width=280><font color=\"B09878\">").append(PhantomCompanionManager.getInstance().describe(player, template)).append("</font></td></tr></table>");
+			sb.append("<table width=280><tr><td>").append(String.format(BUTTON, "Позвать", "summon", name)).append("</td><td>").append(String.format(BUTTON, "Отпустить", "dismiss", name)).append("</td><td></td></tr>");
+			if (PhantomCompanionManager.getInstance().isPartiedWith(player, template))
+			{
+				sb.append("<tr><td>").append(String.format(BUTTON, "Бей мою цель", "assist", name)).append("</td><td>").append(String.format(BUTTON, "За мной", "follow", name)).append("</td><td>").append(String.format(BUTTON, "Стой", "stay", name)).append("</td></tr>");
+			}
+			sb.append("</table><br>");
+		}
+		sb.append("<font color=\"808080\">Позвал — пригласи в пати: /invite имя. Напарник идёт следом, бьёт твою цель, когда ты в бою, защищает пати, а отставшего телепортирует к тебе. Опыт и лут — тебе.</font>");
+		sb.append("</center></body></html>");
+		player.sendPacket(new NpcHtmlMessage(sb.toString()));
+	}
+
+	private static String roleName(PhantomTemplate.Role role)
+	{
+		switch (role)
+		{
+			case HEALER:
+			{
+				return "хилер";
+			}
+			case BUFFER:
+			{
+				return "баффер";
+			}
+			case TANK:
+			{
+				return "танк";
+			}
+			default:
+			{
+				return "дамагер";
+			}
+		}
+	}
+
+	/**
+	 * BISHOP → Bishop, ELVEN_ELDER → Elven Elder.
+	 */
+	private static String className(Player phantom)
+	{
+		final StringBuilder sb = new StringBuilder();
+		for (String word : phantom.getPlayerClass().name().split("_"))
+		{
+			if (sb.length() > 0)
+			{
+				sb.append(' ');
+			}
+			sb.append(word.charAt(0)).append(word.substring(1).toLowerCase());
+		}
+		return sb.toString();
+	}
+
+	@Override
+	public String[] getCommandList()
+	{
+		return VOICED_COMMANDS;
+	}
+}
