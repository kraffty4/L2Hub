diff --git a/dist/game/config/Custom/PhantomParty.ini b/dist/game/config/Custom/PhantomParty.ini
new file mode 100644
index 0000000..bdf4ead
--- /dev/null
+++ b/dist/game/config/Custom/PhantomParty.ini
@@ -0,0 +1,23 @@
+# ---------------------------------------------------------------------------
+# Фантомы в пати (L2Hub)
+# ---------------------------------------------------------------------------
+# Напарник: .buddy -> «Позвать», затем пригласить в пати (/invite имя). В пати он идёт следом,
+# бьёт цель владельца, защищает себя и пати, отставшего телепортирует к владельцу.
+
+# Фантом в пати берёт долю опыта и SP. False — весь опыт живым игрокам, как будто фантома нет.
+PhantomPartyExpShare = False
+
+# Фантому может выпасть предмет при случайном и поочерёдном распределении и достаётся доля адены.
+PhantomPartyLootShare = False
+
+# Отстал от владельца дальше этого (игровые единицы) — телепорт к нему.
+PhantomCatchUpRange = 2000
+
+# Бьёт цель владельца, если она не дальше этого от владельца и владелец в бою.
+PhantomAssistRange = 1500
+
+# Защищает себя, владельца и пати от мобов в этом радиусе от себя.
+PhantomDefendRange = 900
+
+# Сколько секунд ждать вышедшего из игры владельца, потом напарник уходит из мира.
+PhantomOwnerLogoutGrace = 60
