+		sb.append("<table width=520><tr><td width=90><font color=\"LEVEL\">Имя</font></td><td width=30><font color=\"LEVEL\">Ур.</font></td><td width=105><font color=\"LEVEL\">Класс</font></td><td width=210><font color=\"LEVEL\">Где и что делает</font></td><td width=85></td></tr></table>");
+		sb.append("<img src=\"L2UI.SquareGray\" width=520 height=1>");
+		for (HunterView view : list.subList(current * BOARD_PAGE, Math.min(list.size(), (current + 1) * BOARD_PAGE)))
+		{
+			final Player hunter = view.player;
+			final Location target = destination(view);
+			sb.append("<table width=520><tr><td width=90>").append(hunter.getName()).append("</td><td width=30>").append(hunter.getLevel()).append("</td><td width=105>").append(PhantomUi.className(hunter)).append("</td>");
+			sb.append("<td width=210><font color=\"").append(phaseColor(view.phase)).append("\">").append(doing(view, true)).append("</font></td><td width=85>");
+			if (target != null)
+			{
+				sb.append(boardButton(view.phase.equals("STORE") || view.phase.equals("TOWN") ? "К нему" : "На спот", bypass + " go " + hunter.getName() + " " + tab.name().toLowerCase() + " " + current, 80));
