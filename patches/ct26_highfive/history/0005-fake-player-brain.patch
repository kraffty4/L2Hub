+import org.l2jmobius.gameserver.entity.World;
 import org.l2jmobius.gameserver.entity.actor.Npc;
 import org.l2jmobius.gameserver.entity.actor.Player;
 import org.l2jmobius.gameserver.entity.spawns.Spawn;
@@ -88,8 +89,104 @@ public class FakePlayerChatManager implements IXmlReader
 	
 	public void manageChat(Player player, String fpcName, String message)
 	{
+		// L2Hub: шёпот сначала уходит в мозги фейков, заготовки — запасной вариант.
+		final Npc npc = FakePlayersConfig.FAKE_PLAYER_BRAIN ? getFakePlayer(fpcName) : null;
+		if (npc != null)
+		{
+			FakePlayerBrain.getInstance().ask(player, npc, "whisper", message, reply -> sendChat(player, fpcName, reply), () -> ThreadPool.schedule(() -> manageResponce(player, fpcName, message), Rnd.get(MIN_DELAY, MAX_DELAY)));
+			return;
+		}
+
 		ThreadPool.schedule(() -> manageResponce(player, fpcName, message), Rnd.get(MIN_DELAY, MAX_DELAY));
 	}
+
+	/**
+	 * L2Hub: фейк рядом отвечает в общий чат, если игрок назвал его по имени. Отвечает ближайший из названных.
+	 * @param player игрок
+	 * @param message что он сказал в общий чат
+	 */
+	public void manageSay(Player player, String message)
+	{
+		if (!FakePlayersConfig.FAKE_PLAYER_BRAIN || (FakePlayersConfig.FAKE_PLAYER_BRAIN_SAY_RANGE <= 0))
+		{
+			return;
+		}
+
+		final String text = message.toLowerCase();
+		Npc nearest = null;
+		double nearestDistance = Double.MAX_VALUE;
+		for (Npc npc : World.getVisibleObjectsInRange(player, Npc.class, FakePlayersConfig.FAKE_PLAYER_BRAIN_SAY_RANGE))
+		{
+			if (!npc.isFakePlayer() || !FakePlayerData.getInstance().isTalkable(npc.getName()) || !isAddressed(text, npc))
+			{
+				continue;
+			}
+
+			final double distance = npc.calculateDistance2D(player);
+			if (distance < nearestDistance)
+			{
+				nearest = npc;
+				nearestDistance = distance;
+			}
+		}
+
+		if (nearest != null)
+		{
+			final Npc npc = nearest;
+			FakePlayerBrain.getInstance().ask(player, npc, "say", message, reply -> say(npc, reply), () ->
+			{
+			});
+		}
+	}
+
+	/**
+	 * Обращение по имени фейка или по одному из его прозвищ: параметр NPC aliases, через «;» (например «ева;эви»).
+	 */
+	private static boolean isAddressed(String text, Npc npc)
+	{
+		if (mentions(text, npc.getName().toLowerCase()))
+		{
+			return true;
+		}
+
+		for (String alias : npc.getTemplate().getParameters().getString("aliases", "").toLowerCase().split(";"))
+		{
+			if (!alias.isBlank() && mentions(text, alias.strip()))
+			{
+				return true;
+			}
+		}
+		return false;
+	}
+
+	private static boolean mentions(String text, String name)
+	{
+		int index = text.indexOf(name);
+		while (index >= 0)
+		{
+			final int end = index + name.length();
+			final boolean startOk = (index == 0) || !Character.isLetterOrDigit(text.charAt(index - 1));
+			final boolean endOk = (end == text.length()) || !Character.isLetterOrDigit(text.charAt(end));
+			if (startOk && endOk)
+			{
+				return true;
+			}
+			index = text.indexOf(name, index + 1);
+		}
+		return false;
+	}
+
+	private static Npc getFakePlayer(String fpcName)
+	{
+		final Spawn spawn = SpawnTable.getInstance().getAnySpawn(FakePlayerData.getInstance().getNpcIdByName(fpcName));
+		return spawn != null ? spawn.getLastSpawn() : null;
+	}
+
+	private static void say(Npc npc, String text)
+	{
+		final CreatureSay cs = new CreatureSay(npc, ChatType.GENERAL, npc.getName(), text);
+		World.forEachVisibleObjectInRange(npc, Player.class, 1250, player -> player.sendPacket(cs));
+	}
 	
 	public void manageChat(Player player, String fpcName, String message, int minDelay, int maxDelay)
 	{
