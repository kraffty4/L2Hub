 # чаще. Мозги знают настроение и говорят в нём.
 HunterMood = True
+
+# ---------------------------------------------------------------------------
+# Отношения охотников к живым игрокам (docs/PHANTOMS.md, раздел 4.13; приём L2Solo).
+# Обида: убил +3, напал +1. Благодарность: хилил раненого (меньше 40 % HP) в бою +1, реснул +3, убил моба, который
+# добивал охотника, +2, качались в пати +1 за каждые 30 минут (до +3 за пати). Одинаковое событие на пару — не чаще
+# раза в 30 минут, «убил» — каждый раз. Враг — обида не меньше HunterRelationEnemy и больше благодарности: охотник
+# не берёт его в пати и не идёт на его «лфм», первым не заговаривает, узнаёт («о, опять ты…»). Друг — благодарность
+# от 3 и больше обиды: заговаривает первым чаще (до ×2). Помириться можно: добро перевешивает, обида остывает.
+# ---------------------------------------------------------------------------
+HunterRelations = True
+
+# Обида и благодарность остывают вдвое за столько часов игры охотника (пока сервер выключен — не остывают). 0 — не остывают.
+HunterRelationHalfLife = 72
+
+# С такой обиды (и если она больше благодарности) игрок — враг. 3 — одно убийство или три нападения.
+HunterRelationEnemy = 3
