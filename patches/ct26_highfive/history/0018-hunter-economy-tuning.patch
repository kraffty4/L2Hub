diff --git a/dist/game/config/Custom/PhantomHunters.ini b/dist/game/config/Custom/PhantomHunters.ini
index bbc7212..5f76f05 100644
--- a/dist/game/config/Custom/PhantomHunters.ini
+++ b/dist/game/config/Custom/PhantomHunters.ini
@@ -16,6 +16,12 @@ HuntersMode = ALWAYS
 HuntersReset =
 HuntersResetId = 0
 
+# Самопроверка без клиента (для разработки): LFM — охотник «кричит» «лфм нужен дд», откликнувшийся приходит,
+# принимает инвайт, минуту ходит в пати и возвращается на кач; шаги — в логе с пометкой SelfTest.
+# Выполняется один раз — когда меняется HuntersSelfTestId.
+HuntersSelfTest =
+HuntersSelfTestId = 0
+
 # Режим WITH_PLAYERS: через столько секунд после выхода последнего живого игрока охотники уходят из мира.
 HuntersIdleTimeout = 300
 
@@ -31,6 +37,9 @@ HunterShotCount = 2000
 # Запас стрел или болтов у лучников (покупаются первыми: без них лук не стреляет).
 HunterAmmoCount = 3000
 
+# Запас хилок своего уровня (на банки — не больше четверти адены); AutoUse пьёт их на 40 % HP.
+HunterPotionCount = 30
+
 # Плата за телепорт в город и обратно с 40 уровня (до 40 — бесплатно, как у новичков).
 HunterTeleportFee = 15000
 
