diff --git a/dist/game/config/Custom/PhantomHunters.ini b/dist/game/config/Custom/PhantomHunters.ini
index 30056bb..7dc9296 100644
--- a/dist/game/config/Custom/PhantomHunters.ini
+++ b/dist/game/config/Custom/PhantomHunters.ini
@@ -105,3 +105,38 @@ HunterStrategyPerMinute = 6
 
 # С такой вероятностью (%) охотник говорит свою мысль вслух в общий чат рядом — если рядом есть живой игрок.
 HunterStrategySayChance = 20
+
+# ---------------------------------------------------------------------------
+# Охотник заговаривает первым (docs/PHANTOMS.md, раздел 4.9): заметил живого игрока рядом — иногда сам
+# здоровается или говорит что-то по ситуации в общий чат. Знакомым (кто уже писал ему) — чаще, незнакомым — редко;
+# болтуны чаще, молчуны реже (social в data/L2HubPhantoms.xml). Решают правила сервера, модель только пишет фразу;
+# мозги недоступны — охотник молчит и качается дальше.
+# ---------------------------------------------------------------------------
+HunterInitiative = True
+
+# На каком расстоянии охотник замечает игрока. Игрок должен побыть рядом пару секунд: пролёт мимо и телепорт не в счёт.
+HunterInitiativeRange = 600
+
+# Шанс (%) заговорить при встрече со знакомым и с незнакомым; умножается на общительность охотника.
+HunterInitiativeChanceKnown = 30
+HunterInitiativeChanceStranger = 4
+
+# Один охотник заговаривает первым не чаще раза в столько секунд — с кем угодно.
+HunterInitiativeHunterCooldown = 1800
+
+# С одним и тем же игроком один охотник заговаривает первым не чаще раза в столько секунд (переживает рестарт).
+HunterInitiativePairCooldown = 21600
+
+# К одному игроку любой охотник — не чаще раза в столько секунд: двое разом не здороваются. Столько же после
+# неудачного броска эта пара не бросает снова, даже если игрок отошёл и вернулся.
+HunterInitiativePlayerGap = 600
+
+# Не больше стольких обращений первым к одному игроку за час (от всех охотников).
+HunterInitiativePlayerPerHour = 3
+
+# Столько секунд охотник ждёт ответа. Игрок не ответил — этот охотник больше не заговаривает с ним первым,
+# пока игрок сам ему не напишет.
+HunterInitiativeAnswerWait = 120
+
+# Говорили меньше стольких секунд назад — первым не заговаривает: разговор только что был.
+HunterInitiativeRecentTalk = 1800
