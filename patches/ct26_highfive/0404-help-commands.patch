diff --git a/dist/game/data/scripts/handlers/bypass/communityboard/L2HubHelp.java b/dist/game/data/scripts/handlers/bypass/communityboard/L2HubHelp.java
new file mode 100644
index 0000000..f4f85bb
--- /dev/null
+++ b/dist/game/data/scripts/handlers/bypass/communityboard/L2HubHelp.java
@@ -0,0 +1,140 @@
+package handlers.bypass.communityboard;
+
+import org.l2jmobius.gameserver.entity.actor.Player;
+import org.l2jmobius.gameserver.handler.IVoicedCommandHandler;
+import org.l2jmobius.gameserver.handler.VoicedCommandHandler;
+import org.l2jmobius.gameserver.network.serverpackets.ShowBoard;
+
+/**
+ * L2Hub: все команды сервера в одном окне — кнопка «Команды» на доске Alt+B и команда {@code .help} ({@code handlers.chat.commands.voiced.Help}).
+ * <ul>
+ * <li>_bbshubhelp — список по разделам. Команда в списке, только если её обработчик зарегистрирован: выключенная в настройках не показывается.</li>
+ * <li>_bbshubhelp run &lt;команда&gt; — выполнить команду без аргументов: доска закрывается, как перед окном автобоя ({@link L2HubBoard#play}), дальше отвечает сама команда.</li>
+ * </ul>
+ * Админские строки — только GM.
+ */
+public final class L2HubHelp
+{
+	public static final String COMMAND = "_bbshubhelp";
+
+	/** Раздел, команда (без точки), что делает, можно ли выполнить кнопкой без аргументов. Пустая команда — заголовок раздела. */
+	private static final String[][] COMMANDS =
+	{
+		{ "Бой", "", "", "" },
+		{ "", "play", "окно автобоя: настройки, пуск и стоп. Ярлык «Автобой» на панели — то же одной кнопкой", "run" },
+		{ "", "autopots", "автопоты: какие банки и с какого процента", "run" },
+		{ "", "apon", "включить автопоты (.apoff — выключить)", "run" },
+		{ "", "expoff", "не получать опыт (.expon — снова получать)", "" },
+		{ "Ивенты и мир", "", "", "" },
+		{ "", "events", "ивенты, поручения, кошелёк и магазин коинов", "run" },
+		{ "", "daily", "поручения дня (.weekly — недели)", "run" },
+		{ "", "raid", "рейд охотников: кого бьют, где сбор (.raid join — в пати)", "run" },
+		{ "", "kama", "охотники идут в Камалоку (.kama join — в пати)", "run" },
+		{ "", "rift", "охотники идут в Rift (.rift join — в пати)", "run" },
+		{ "", "hunters", "кто из охотников где, телепорт к ним", "run" },
+		{ "", "clans", "кланы охотников и кто набирает", "run" },
+		{ "", "online", "сколько людей в игре", "run" },
+		{ "", "hellbound", "уровень Хеллбаунда", "run" },
+		{ "Персонаж", "", "", "" },
+		{ "", "buddy", "напарники: позвать, отпустить, настроить", "run" },
+		{ "", "offline", "оставить лавку или крафт в офлайне", "" },
+		{ "", "offlineplay", "оставить автобой в офлайне", "" },
+		{ "", "bank", "адена в слитки и обратно (.deposit, .withdraw)", "run" },
+		{ "", "lang", "язык сервера", "" },
+		{ "", "premium", "срок премиума", "run" },
+		{ "", "changepassword", "сменить пароль учётки", "" },
+		{ "", "engage", "свадьба: .engage, .gotolove, .divorce", "" }
+	};
+	/** Команды клиента, не сервера: работают всегда. */
+	private static final String[][] CLIENT =
+	{
+		{ "/unstuck", "выбраться, если застрял в текстурах" },
+		{ "/partymatching", "поиск пати (Alt+P на этом клиенте не привязан)" },
+		{ "/loc", "где ты: координаты" },
+		{ "/time", "игровое время" },
+		{ "/instancezone", "откаты инстансов" }
+	};
+	private static final String[][] ADMIN =
+	{
+		{ "//admin", "панель GM" },
+		{ ".banchat <ник> [мин]", "запрет чата (.unbanchat — снять)" },
+		{ ".clans reset", "распустить все кланы охотников" }
+	};
+
+	private L2HubHelp()
+	{
+	}
+
+	public static String content(Player player, String[] args)
+	{
+		if ((args.length > 2) && args[1].equalsIgnoreCase("run") && run(player, args[2]))
+		{
+			return null; // доска закрыта, отвечает команда
+		}
+
+		final StringBuilder sb = new StringBuilder(6144);
+		sb.append("<br><font color=\"909090\">").append(L2HubBoard.tr("Команды пишутся в чат с точкой: .play, .help. Кнопка «Выполнить» делает то же без чата.")).append("</font><br>");
+		final StringBuilder section = new StringBuilder();
+		String title = null;
+		for (String[] row : COMMANDS)
+		{
+			if (row[1].isEmpty())
+			{
+				flush(sb, title, section);
+				title = row[0];
+				continue;
+			}
+			if (VoicedCommandHandler.getInstance().getHandler(row[1]) == null)
+			{
+				continue; // выключена в настройках
+			}
+			section.append("<tr><td width=110><font color=\"CDB67F\">.").append(row[1]).append("</font></td><td width=310>").append(L2HubBoard.tr(row[2])).append("</td><td width=100 align=center>");
+			section.append(row[3].isEmpty() ? "" : L2HubBoard.button(L2HubBoard.tr("Выполнить"), COMMAND + " run " + row[1], 90)).append("</td></tr>");
+		}
+		flush(sb, title, section);
+
+		for (String[] row : CLIENT)
+		{
+			section.append("<tr><td width=110><font color=\"CDB67F\">").append(row[0]).append("</font></td><td width=410>").append(L2HubBoard.tr(row[1])).append("</td></tr>");
+		}
+		flush(sb, L2HubBoard.tr("Клиент"), section);
+		if (player.isGM())
+		{
+			for (String[] row : ADMIN)
+			{
+				section.append("<tr><td width=150><font color=\"CDB67F\">").append(row[0].replace("<", "&lt;").replace(">", "&gt;")).append("</font></td><td width=370>").append(L2HubBoard.tr(row[1])).append("</td></tr>");
+			}
+			flush(sb, L2HubBoard.tr("GM"), section);
+		}
+		return sb.append("<font color=\"909090\">").append(L2HubBoard.tr("Остальное — кнопками слева: баффер, GM-шоп, телепорт, ивенты.")).append("</font>").toString();
+	}
+
+	private static void flush(StringBuilder sb, String title, StringBuilder section)
+	{
+		if ((title != null) && (section.length() > 0))
+		{
+			sb.append("<br><font color=\"LEVEL\">").append(L2HubBoard.tr(title)).append("</font><br1><table width=520 cellpadding=2 cellspacing=0>").append(section).append("</table>");
+		}
+		section.setLength(0);
+	}
+
+	/**
+	 * @return команда выполнена; {@code false} — её нет или кнопкой её не выполнить
+	 */
+	private static boolean run(Player player, String command)
+	{
+		boolean runnable = false;
+		for (String[] row : COMMANDS)
+		{
+			runnable |= row[1].equalsIgnoreCase(command) && !row[3].isEmpty();
+		}
+		final IVoicedCommandHandler handler = runnable ? VoicedCommandHandler.getInstance().getHandler(command) : null;
+		if (handler == null)
+		{
+			return false;
+		}
+		player.sendPacket(new ShowBoard());
+		handler.onCommand(command.toLowerCase(java.util.Locale.ROOT), player, null);
+		return true;
+	}
+}
