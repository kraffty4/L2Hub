new file mode 100644
index 0000000..f3ae9a3
--- /dev/null
+++ b/dist/game/data/scripts/handlers/chat/commands/voiced/Help.java
@@ -0,0 +1,61 @@
+package handlers.chat.commands.voiced;
+
+import org.l2jmobius.commons.threads.ThreadPool;
+import org.l2jmobius.gameserver.entity.actor.Player;
+import org.l2jmobius.gameserver.handler.CommunityBoardHandler;
+import org.l2jmobius.gameserver.handler.IVoicedCommandHandler;
+import org.l2jmobius.gameserver.managers.phantom.PhantomManager;
+import org.l2jmobius.gameserver.mechanics.events.Containers;
+import org.l2jmobius.gameserver.mechanics.events.EventType;
+import org.l2jmobius.gameserver.mechanics.events.holders.actor.player.OnPlayerLogin;
+import org.l2jmobius.gameserver.mechanics.events.listeners.ConsumerEventListener;
+
+import handlers.bypass.communityboard.L2HubHelp;
+
+/**
+ * L2Hub: {@code .help} (и {@code .commands}) — окно со всеми командами сервера, то же, что кнопка «Команды» на доске Alt+B ({@link L2HubHelp}).
+ * При входе в игру — одна строка в системный чат, где искать команды.
+ */
+public class Help implements IVoicedCommandHandler
+{
+	private static final String[] VOICED_COMMANDS =
+	{
+		"help",
+		"commands"
+	};
+	/** Клиент ещё грузит мир: раньше строка потеряется среди приветствий сервера. */
+	private static final long HINT_DELAY = 6000;
+
+	public Help()
+	{
+		Containers.Global().addListener(new ConsumerEventListener(Containers.Global(), EventType.ON_PLAYER_LOGIN, (OnPlayerLogin event) -> hint(event.getPlayer()), this));
+	}
+
+	private static void hint(Player player)
+	{
+		if ((player == null) || PhantomManager.getInstance().isPhantom(player))
+		{
+			return;
+		}
+		ThreadPool.schedule(() ->
+		{
+			if (player.isOnline())
+			{
+				player.sendMessage("en".equals(org.l2jmobius.gameserver.config.custom.L2HubWorldConfig.LANGUAGE) ? "All server commands: type .help or open Alt+B → Commands." : "Все команды сервера: напиши .help или открой Alt+B → «Команды».");
+			}
+		}, HINT_DELAY);
+	}
+
+	@Override
+	public boolean onCommand(String command, Player player, String params)
+	{
+		CommunityBoardHandler.getInstance().handleParseCommand(L2HubHelp.COMMAND, player);
+		return true;
+	}
+
+	@Override
+	public String[] getCommandList()
+	{
+		return VOICED_COMMANDS;
+	}
+}
