+package org.l2jmobius.gameserver.entity.item;
+
+import java.io.IOException;
+import java.io.Reader;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.Properties;
+import java.util.logging.Logger;
+
+import org.l2jmobius.gameserver.entity.item.instance.Item;
+import org.l2jmobius.gameserver.entity.item.type.CrystalType;
+import org.l2jmobius.gameserver.entity.item.type.WeaponType;
+
+/**
+ * L2Hub: постоянные PvP-вещи (не геройские, не квестовые, без срока) — передача, продажа, склад, почта и атрибут,
+ * каждое своим ключом в config/Custom/PvpItemPermissions.ini. Все ключи по умолчанию False: штатные запреты Mobius.
+ * Атрибут — только S, S80 и S84, оружие и шесть частей брони, без уже вставленного атрибута.
+ * Перенос из патча 0512 сопровождающего Эпилога (классы PvpItemPermissions и PvpAttributes).
+ */
+public final class PvpItemPermissions
+{
+	private static final Logger LOGGER = Logger.getLogger(PvpItemPermissions.class.getName());
+	private static final String FILE = "./config/Custom/PvpItemPermissions.ini";
+
+	private static final class Settings
+	{
+		static final Properties VALUES = load();
+		static final boolean TRADE = enabled("AllowPvpItemTrade");
+		static final boolean SALE = enabled("AllowPvpItemSale");
+		static final boolean WAREHOUSE = enabled("AllowPvpItemWarehouse");
+		static final boolean FREIGHT = enabled("AllowPvpItemFreight");
+		static final boolean ATTRIBUTE_WEAPONS = enabled("AllowAttributeOnPvpWeapons");
+		static final boolean ATTRIBUTE_ARMOR = enabled("AllowAttributeOnPvpArmor");
+
+		private static Properties load()
+		{
+			final Properties properties = new Properties();
+			final Path file = Path.of(FILE);
+			if (Files.isRegularFile(file))
+			{
+				try (Reader reader = Files.newBufferedReader(file, StandardCharsets.UTF_8))
+				{
+					properties.load(reader);
+				}
+				catch (IOException e)
+				{
+					LOGGER.warning("PvpItemPermissions: " + FILE + " unreadable, native restrictions kept: " + e.getMessage());
+				}
+			}
+			return properties;
+		}
+
+		private static boolean enabled(String key)
+		{
+			return Boolean.parseBoolean(VALUES.getProperty(key, "False").trim());
+		}
+	}
+
+	private PvpItemPermissions()
+	{
+	}
+
+	private static boolean eligible(ItemTemplate template)
+	{
+		return (template != null) && template.isPvpItem() && (template.isWeapon() || template.isArmor()) && !template.isHeroItem() && !template.isQuestItem() && !template.isForNpc() && (template.getDuration() <= 0) && (template.getTime() <= 0);
+	}
+
+	public static boolean trade(ItemTemplate template)
+	{
+		return Settings.TRADE && eligible(template);
+	}
+
+	public static boolean sale(ItemTemplate template)
+	{
+		return Settings.SALE && eligible(template);
+	}
+
+	public static boolean warehouse(ItemTemplate template)
+	{
+		return Settings.WAREHOUSE && eligible(template);
+	}
+
+	public static boolean freight(ItemTemplate template)
+	{
+		return Settings.FREIGHT && eligible(template);
+	}
+
+	public static boolean augmentedTrade(Item item)
+	{
+		return (item != null) && trade(item.getTemplate());
+	}
+
+	public static boolean augmentedSale(Item item)
+	{
+		return (item != null) && sale(item.getTemplate());
+	}
+
+	public static boolean attribute(ItemTemplate item)
+	{
+		if ((!Settings.ATTRIBUTE_WEAPONS && !Settings.ATTRIBUTE_ARMOR) || (item == null) || !item.isPvpItem() || item.isHeroItem() || item.isForNpc() || item.isQuestItem() || (item.getDuration() > 0) || (item.getTime() > 0) || (item.getElementals() != null))
+		{
+			return false;
+		}
+
+		final CrystalType grade = item.getCrystalType();
+		if ((grade != CrystalType.S) && (grade != CrystalType.S80) && (grade != CrystalType.S84))
+		{
+			return false;
+		}
+
+		if (item.isWeapon())
+		{
+			return Settings.ATTRIBUTE_WEAPONS && (item.getItemType() != WeaponType.NONE) && (item.getItemType() != WeaponType.FISHINGROD);
+		}
+
+		if (item.isArmor())
+		{
+			return Settings.ATTRIBUTE_ARMOR && switch (item.getBodyPart())
+			{
+				case HEAD, CHEST, FULL_ARMOR, LEGS, GLOVES, FEET -> true;
+				default -> false;
+			};
+		}
+
+		return false;
+	}
+}
