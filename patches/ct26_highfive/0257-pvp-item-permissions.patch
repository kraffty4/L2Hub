+
+# Атрибут в постоянное PvP-оружие S, S80 и S84.
+AllowAttributeOnPvpWeapons = False
+
+# Атрибут в постоянную PvP-броню S, S80 и S84 (голова, верх, полный доспех, низ, перчатки, сапоги).
+AllowAttributeOnPvpArmor = False
