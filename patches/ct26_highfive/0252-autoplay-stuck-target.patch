+		/**
+		 * L2Hub: моб в паузе «не подойти» (AutoPlayStuckTargetSeconds или обход за препятствием) — пока не цель.
+		 */
+		private boolean isUnreachable(Player player, WorldObject target, long now)
+		{
+			final Detour detour = DETOURS.get(player);
+			return target != null && target.isMonster() && detour != null
+				&& detour.unreachable.getOrDefault(target.getObjectId(), 0L) > now;
+		}
+	
+		/**
+		 * L2Hub: автобой не может начать бой с выбранным мобом дольше AutoPlayStuckTargetSeconds — моб на паузу, цель снимается.
+		 * Стан, каст и ожидание доступного умения застреванием не считаются (AutoPlayTargetProgress). Перенос патча 0500 сопровождающего Эпилога.
+		 */
+		private boolean skipStalledTarget(Player player, Creature target, Detour detour, long now)
+		{
+			if (detour == null) return false;
+			if (!target.isMonster() || target.isAlikeDead()) { detour.progress.clear(); return false; }
+			final boolean ignored = isUnreachable(player, target, now);
+			if (!ignored && !AutoPlayTargetProgress.stalled(detour.progress, player, target, now,
+				AutoPlayConfig.AUTO_PLAY_STUCK_TARGET_SECONDS * 1000L)) return false;
+			if (!ignored) detour.unreachable.put(target.getObjectId(), now + DETOUR_PAUSE);
+			detour.targetId = 0;
+			detour.progress.clear();
+			player.stopMove(null);
+			if (player.hasAI()) player.getAI().setIntentionActive();
+			return true;
+		}
