diff --git a/dist/game/data/scripts/handlers/bypass/communityboard/L2HubKarma.java b/dist/game/data/scripts/handlers/bypass/communityboard/L2HubKarma.java
new file mode 100644
index 0000000000000000000000000000000000000000..bc7669ec8b4c20cb3007757bdf6699cb078bfd53
--- /dev/null
+++ b/dist/game/data/scripts/handlers/bypass/communityboard/L2HubKarma.java
@@ -0,0 +1,99 @@
+package handlers.bypass.communityboard;
+
+import java.util.Locale;
+
+import org.l2jmobius.gameserver.entity.actor.Player;
+import org.l2jmobius.gameserver.entity.item.enums.ItemProcessType;
+
+/**
+ * L2Hub: снятие кармы за адену на доске Alt+B. С кармой доска закрыта ({@code CommunityKarmaDisabled}), поэтому HomeBoard вместо отказа открывает эту страницу.
+ * <ul>
+ * <li>_bbshubkarma — сколько кармы и почём; цена очка — TownKarmaPrice в config/Custom/L2HubTown.ini, 0 выключает снятие.</li>
+ * <li>_bbshubkarma pay all|&lt;очки&gt; — снять всю или часть, те же запреты, что у доски, кроме самой кармы ({@link L2HubBoard#notBusy}).</li>
+ * </ul>
+ * Счётчик PK не меняется: мера за PK остаётся за квестом Repent Your Sins. С проклятым оружием карма не снимается, она вернётся с ним же.
+ */
+public final class L2HubKarma
+{
+	public static final String COMMAND = "_bbshubkarma";
+
+	private static final String KEY = "TownKarmaPrice";
+	private static final int DEFAULT_PRICE = 1000;
+
+	private L2HubKarma()
+	{
+	}
+
+	public static int price()
+	{
+		return L2HubBoard.townInt(KEY, DEFAULT_PRICE);
+	}
+
+	public static String content(Player player, String[] args)
+	{
+		final int price = price();
+		if (price <= 0)
+		{
+			return "<br><font color=\"808080\">" + L2HubBoard.tr("Снятие кармы выключено в настройках сервера (L2HubTown.ini, TownKarmaPrice).") + "</font>";
+		}
+		if ((args.length > 2) && args[1].equalsIgnoreCase("pay"))
+		{
+			pay(player, args[2], price);
+		}
+
+		final int karma = player.getKarma();
+		if (karma <= 0)
+		{
+			return "<br><font color=\"7CD37C\">" + L2HubBoard.tr("Кармы нет, доска открыта.") + "</font>";
+		}
+		final StringBuilder sb = new StringBuilder(1024);
+		sb.append("<br>").append(L2HubBoard.tr("Твоя карма: ")).append("<font color=\"LEVEL\">").append(karma).append("</font><br1>");
+		sb.append(L2HubBoard.tr("Очко кармы стоит ")).append(money(price)).append(L2HubBoard.tr(" адены, вся карма — ")).append(money((long) karma * price)).append(L2HubBoard.tr(" адены.")).append("<br1>");
+		sb.append(L2HubBoard.tr("У тебя: ")).append(money(player.getAdena())).append(L2HubBoard.tr(" адены.")).append("<br><br>");
+		sb.append(L2HubBoard.button(L2HubBoard.tr("Снять всю"), COMMAND + " pay all", 170)).append("<br>");
+		sb.append("<table width=340><tr><td width=120 align=right>").append(L2HubBoard.tr("Сколько очков:")).append("</td><td width=100><edit var=\"points\" width=90></td><td width=120>");
+		sb.append(L2HubBoard.button(L2HubBoard.tr("Снять"), COMMAND + " pay $points", 100)).append("</td></tr></table><br>");
+		sb.append("<font color=\"909090\">").append(L2HubBoard.tr("С кармой остальная доска закрыта. Счётчик PK не меняется.")).append("</font>");
+		return sb.toString();
+	}
+
+	private static void pay(Player player, String amount, int price)
+	{
+		if (!L2HubBoard.notBusy(player))
+		{
+			return;
+		}
+		if (player.isCursedWeaponEquipped())
+		{
+			player.sendMessage(L2HubBoard.tr("С проклятым оружием карма не снимается."));
+			return;
+		}
+		final int karma = player.getKarma();
+		final int points = amount.toLowerCase(Locale.ROOT).equals("all") ? karma : Math.min(number(amount), karma);
+		if (points <= 0)
+		{
+			return;
+		}
+		if (player.reduceAdena(ItemProcessType.FEE, (long) points * price, player, true))
+		{
+			player.setKarma(karma - points);
+		}
+	}
+
+	private static String money(long adena)
+	{
+		return String.format(Locale.ROOT, "%,d", adena).replace(',', ' ');
+	}
+
+	private static int number(String value)
+	{
+		try
+		{
+			return Integer.parseInt(value);
+		}
+		catch (NumberFormatException e)
+		{
+			return 0;
+		}
+	}
+}
