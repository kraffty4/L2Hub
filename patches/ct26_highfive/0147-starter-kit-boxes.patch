+	/**
+	 * Коробка набора в инвентаре: кому и на каком уровне, двойной клик, повторов нет.
+	 */
+	private static void boxes(List<Player> spare) throws Exception
+	{
+		check("boxes: level windows", (L2HubKits.boxGrade(1) == 0) && (L2HubKits.boxGrade(19) == 0) && (L2HubKits.boxGrade(20) == 1) && (L2HubKits.boxGrade(39) == 1) && (L2HubKits.boxGrade(40) == 2) && (L2HubKits.boxGrade(51) == 2) && (L2HubKits.boxGrade(52) == -1));
+		for (EventType type : new EventType[]
+		{
+			EventType.ON_PLAYER_LOGIN,
+			EventType.ON_PLAYER_LEVEL_CHANGED
+		})
+		{
+			check("boxes: listens to " + type, Containers.Global().getListeners(type).stream().anyMatch(l -> l.getOwner().getClass().getSimpleName().equals("L2HubKitBoxes")));
+		}
+		boolean handled = true;
+		for (int id : new int[]
+		{
+			8966,
+			8967,
+			8968,
+			9130,
+			9131,
+			9132
+		})
+		{
+			final IItemHandler handler = ItemHandler.getInstance().getHandler((EtcItem) ItemData.getInstance().getTemplate(id));
+			handled &= (handler != null) && handler.getClass().getSimpleName().equals("L2HubKitBox");
+		}
+		check("boxes: all six open with our handler", handled);
+
+		final Player player = pick(spare, p -> (L2HubKits.boxGrade(p.getLevel()) >= 0) && !L2HubKits.taken(p, L2HubKits.boxGrade(p.getLevel())));
+		if (player == null)
+		{
+			LOGGER.info(TAG + "boxes: no hunter of a box level.");
+			return;
+		}
+		park(player);
+		final List<long[]> moved = unload(player);
+		try
+		{
+			boxChecks(player);
+		}
+		finally
+		{
+			reload(player, moved);
+		}
+	}
+
+	private static void boxChecks(Player player)
+	{
+		final int grade = L2HubKits.boxGrade(player.getLevel());
+		final int id = L2HubKits.boxId(player, grade);
+		final String armor = L2HubKits.armor(player);
+		final String who = "boxes (" + player.getPlayerClass() + ", " + player.getLevel() + ", " + L2HubKits.kind(player) + ", " + armor + "): ";
+		final IItemHandler handler = ItemHandler.getInstance().getHandler((EtcItem) ItemData.getInstance().getTemplate(id));
+		final PlayerInventory bag = player.getInventory();
+
+		L2HubKits.giveBox(player);
+		check(who + "a hunter gets no box", bag.getInventoryItemCount(id, -1) == 0);
+		check(who + "box put", L2HubKits.offerBox(player) && (bag.getInventoryItemCount(id, -1) == 1));
+		check(who + "box only once", !L2HubKits.offerBox(player) && (bag.getInventoryItemCount(id, -1) == 1));
+
+		final List<int[]> goods = L2HubKits.goods(player, grade, armor);
+		final Map<Integer, Long> expected = new HashMap<>(counts(player, goods));
+		for (int[] good : goods)
+		{
+			expected.merge(good[0], (long) good[1], Long::sum);
+		}
+		final boolean opened = handler.onItemUse(player, bag.getItemByItemId(id), false);
+		check(who + "double click gives the kit, " + goods.size() + " kinds, and takes the box", opened && counts(player, goods).equals(expected) && L2HubKits.taken(player, grade) && (bag.getInventoryItemCount(id, -1) == 0));
+
+		player.addItem(ItemProcessType.REWARD, id, 1, player, false);
+		final boolean again = handler.onItemUse(player, bag.getItemByItemId(id), false);
+		check(who + "kit already taken: the box goes, no goods", again && counts(player, goods).equals(expected) && (bag.getInventoryItemCount(id, -1) == 0));
+		for (int[] good : goods)
+		{
+			player.destroyItemByItemId(ItemProcessType.DESTROY, good[0], good[1], player, false);
+		}
+	}
