diff --git a/dist/game/data/scripts/custom/L2HubTownBuffer/L2HubTownBuffer.java b/dist/game/data/scripts/custom/L2HubTownBuffer/L2HubTownBuffer.java
new file mode 100644
--- /dev/null
+++ b/dist/game/data/scripts/custom/L2HubTownBuffer/L2HubTownBuffer.java
@@ -0,0 +1,43 @@
+package custom.L2HubTownBuffer;
+
+import org.l2jmobius.gameserver.config.GeneralConfig;
+import org.l2jmobius.gameserver.entity.actor.Npc;
+import org.l2jmobius.gameserver.entity.actor.Player;
+import org.l2jmobius.gameserver.handler.CommunityBoardHandler;
+import org.l2jmobius.gameserver.mechanics.script.Script;
+
+/**
+ * L2Hub: баффер схем у гейткиперов (NPC 50008, мод 0003) при разговоре открывает баффер доски Alt+B ({@code _bbshubbuff}): он по-русски,
+ * на тех же скиллах SchemeBufferSkills.xml и со своими наборами, а окно самого NPC (data/html/mods/SchemeBuffer) английское.
+ * Без доски — прежнее окно. Отдельным скриптом, а не правкой SchemeBuffer в ядре: файлы Mobius при обновлении сборки остаются нетронутыми.
+ * @author L2Hub
+ */
+public class L2HubTownBuffer extends Script
+{
+	private static final int TOWN_BUFFER = 50008;
+	private static final String BOARD_BUFFER = "_bbshubbuff";
+
+	private L2HubTownBuffer()
+	{
+		addFirstTalkId(TOWN_BUFFER);
+	}
+
+	@Override
+	public String onFirstTalk(Npc npc, Player player)
+	{
+		if (GeneralConfig.ENABLE_COMMUNITY_BOARD && CommunityBoardHandler.getInstance().isCommunityBoardCommand(BOARD_BUFFER))
+		{
+			CommunityBoardHandler.getInstance().handleParseCommand(BOARD_BUFFER, player);
+		}
+		else
+		{
+			npc.showChatWindow(player);
+		}
+		return null;
+	}
+
+	public static void main(String[] args)
+	{
+		new L2HubTownBuffer();
+	}
+}
