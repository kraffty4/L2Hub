+package org.l2jmobius.gameserver.mechanics.skill;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.Comparator;
+import java.util.List;
+import java.util.Map;
+import java.util.NavigableSet;
+import java.util.TreeMap;
+import java.util.TreeSet;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.logging.Level;
+import java.util.logging.Logger;
+
+import org.l2jmobius.commons.util.ConfigReader;
+import org.l2jmobius.gameserver.data.xml.SkillData;
+import org.l2jmobius.gameserver.data.xml.SkillTreeData;
+import org.l2jmobius.gameserver.entity.actor.Player;
+import org.l2jmobius.gameserver.mechanics.skill.enums.SkillFinishType;
+import org.l2jmobius.gameserver.mechanics.skill.holders.SkillLearn;
+import org.l2jmobius.gameserver.mechanics.variables.PlayerVariables;
+import org.l2jmobius.gameserver.network.serverpackets.ShortcutInit;
+
+/**
+ * L2Hub: выбор более низкого, уже изученного уровня классового навыка (страница доски Alt+B — L2HubSkillLevels).
+ * Выбор хранится в переменной персонажа отдельно у основной профессии и каждого саба: «навык:выбранный:заработанный».
+ * Строки выученных навыков в базе не меняются (там остаётся высший изученный уровень), уровень подменяется в памяти
+ * после автоизучения ({@link #afterAutoLearn}) и при входе ({@link #entered}). Заточенные, геройские, GM-навыки,
+ * навыки предметов и трансформаций не трогаются; откаты не сбрасываются: пока любой уровень навыка в откате, смены нет.
+ * Включается ключом SkillLevelSelectionEnabled в config/Custom/SkillLevelSelection.ini (по умолчанию False);
+ * при выключенном сохранённый выбор можно только снять.
+ * Перенос мода сопровождающего Эпилога (его патч 0246 и класс SkillLevelChoice).
+ */
+public final class SkillLevelChoice
+{
+	private static final Logger LOGGER = Logger.getLogger(SkillLevelChoice.class.getName());
+	private static final String PREFIX = "L2Hub.SkillLevels.";
+	private static final boolean ENABLED = new ConfigReader("./config/Custom/SkillLevelSelection.ini").getBoolean("SkillLevelSelectionEnabled", false);
+	private static final Map<Integer, Object> LOCKS = new ConcurrentHashMap<>();
+
+	public enum Result
+	{
+		CHANGED,
+		UNCHANGED,
+		DISABLED,
+		BLOCKED,
+		NO_SKILL,
+		INVALID_LEVEL,
+		UNSUPPORTED,
+		COOLDOWN,
+		SAVE_FAILED
+	}
+
+	/**
+	 * @param selected выбранный уровень
+	 * @param earned высший изученный уровень на момент выбора
+	 */
+	public record Choice(int selected, int earned)
+	{
+	}
+
+	/**
+	 * @param id навык
+	 * @param name имя навыка
+	 * @param known уровень сейчас
+	 * @param ordinary все уровни навыка в дереве класса
+	 * @param available уровни, доступные по уровню персонажа
+	 */
+	public record View(int id, String name, int known, NavigableSet<Integer> ordinary, NavigableSet<Integer> available)
+	{
+		/**
+		 * @return уровень сейчас — обычный уровень дерева класса (не заточка и не временная версия)
+		 */
+		public boolean regular()
+		{
+			return ordinary.contains(known);
+		}
+	}
+
+	private SkillLevelChoice()
+	{
+	}
+
+	public static boolean enabled()
+	{
+		return ENABLED;
+	}
+
+	// ---------- Хранение ----------
+
+	private static Map<Integer, Choice> decode(String value)
+	{
+		final Map<Integer, Choice> result = new TreeMap<>();
+		if ((value == null) || (value.length() > 32768))
+		{
+			return result;
+		}
+		for (String token : value.split(";"))
+		{
+			if (result.size() >= 256)
+			{
+				break;
+			}
+			final String[] fields = token.split(":", -1);
+			if (fields.length != 3)
+			{
+				continue;
+			}
+			try
+			{
+				final int id = Integer.parseInt(fields[0]);
+				final int selected = Integer.parseInt(fields[1]);
+				final int earned = Integer.parseInt(fields[2]);
+				if ((id > 0) && (selected > 0) && (earned >= selected))
+				{
+					result.put(id, new Choice(selected, earned));
+				}
+			}
+			catch (NumberFormatException e)
+			{
+				// Битая запись пропускается.
+			}
+		}
+		return result;
+	}
+
+	private static String encode(Map<Integer, Choice> choices)
+	{
+		final StringBuilder sb = new StringBuilder();
+		for (Map.Entry<Integer, Choice> entry : new TreeMap<>(choices).entrySet())
+		{
+			if (!sb.isEmpty())
+			{
+				sb.append(';');
+			}
+			sb.append(entry.getKey()).append(':').append(entry.getValue().selected()).append(':').append(entry.getValue().earned());
+		}
+		return sb.toString();
+	}
+
+	private static Object lock(Player player)
+	{
+		return LOCKS.computeIfAbsent(player.getObjectId(), k -> new Object());
+	}
+
+	// ---------- Для страницы доски ----------
+
+	/**
+	 * @param player персонаж
+	 * @return сохранённый выбор текущего класса (основа или саб)
+	 */
+	public static Map<Integer, Choice> choices(Player player)
+	{
+		return decode(new Context(player).read());
+	}
+
+	/**
+	 * @param player персонаж
+	 * @param id навык
+	 * @return изученный классовый навык или null
+	 */
+	public static View view(Player player, int id)
+	{
+		return new Context(player).view(id);
+	}
+
+	/**
+	 * @param player персонаж
+	 * @return навыки, у которых можно выбрать уровень или уже есть выбор, по имени
+	 */
+	public static List<View> rows(Player player)
+	{
+		final Context context = new Context(player);
+		final Map<Integer, Choice> choices = decode(context.read());
+		final List<View> rows = new ArrayList<>();
+		for (Skill skill : player.getSkills().values())
+		{
+			final View view = context.view(skill.getId());
+			if ((view != null) && (choices.containsKey(view.id()) || (view.regular() && (view.known() > 1))))
+			{
+				rows.add(view);
+			}
+		}
+		rows.sort(Comparator.comparing(View::name, String.CASE_INSENSITIVE_ORDER).thenComparingInt(View::id));
+		return rows;
+	}
+
+	/**
+	 * @param player персонаж
+	 * @param view навык
+	 * @return уровни, которые можно выбрать: доступные по уровню персонажа и не выше изученного
+	 */
+	public static List<Integer> levels(Player player, View view)
+	{
+		final Choice choice = choices(player).get(view.id());
+		final int earned = Math.max(view.known(), choice == null ? 0 : choice.earned());
+		final List<Integer> levels = new ArrayList<>();
+		for (int level : view.available().headSet(earned, true))
+		{
+			final Skill candidate = SkillData.getInstance().getSkill(view.id(), level);
+			if ((candidate != null) && (candidate.getId() == view.id()) && (candidate.getLevel() == level))
+			{
+				levels.add(level);
+			}
+		}
+		return levels;
+	}
+
+	/**
+	 * Выбрать уровень навыка.
+	 * @param player персонаж
+	 * @param id навык
+	 * @param level уровень
+	 * @return итог
+	 */
+	public static Result select(Player player, int id, int level)
+	{
+		if (!ENABLED)
+		{
+			return Result.DISABLED;
+		}
+		synchronized (lock(player))
+		{
+			final Context context = new Context(player);
+			if (context.blocked())
+			{
+				return Result.BLOCKED;
+			}
+			final View view = context.view(id);
+			if (view == null)
+			{
+				return Result.NO_SKILL;
+			}
+			if (!view.regular())
+			{
+				return Result.UNSUPPORTED;
+			}
+			final String before = context.read();
+			final Map<Integer, Choice> choices = decode(before);
+			final Choice previous = choices.get(id);
+			final int earned = Math.min(view.ordinary().last(), Math.max(view.known(), previous == null ? 0 : previous.earned()));
+			if ((level <= 0) || (level > earned) || !view.available().contains(level))
+			{
+				return Result.INVALID_LEVEL;
+			}
+			if (context.cooling(id, earned))
+			{
+				return Result.COOLDOWN;
+			}
+			if ((previous != null) && (previous.selected() == level) && (view.known() == level))
+			{
+				return Result.UNCHANGED;
+			}
+			choices.put(id, new Choice(level, earned));
+			if (!commit(context, before, choices))
+			{
+				return Result.SAVE_FAILED;
+			}
+			try
+			{
+				if (view.known() != level)
+				{
+					context.useLevel(id, level);
+				}
+				context.refresh();
+				return Result.CHANGED;
+			}
+			catch (RuntimeException e)
+			{
+				try
+				{
+					context.save(before);
+					context.useLevel(id, view.known());
+				}
+				catch (RuntimeException rollback)
+				{
+					LOGGER.log(Level.WARNING, "SkillLevelChoice: rollback failed for " + player, rollback);
+				}
+				LOGGER.log(Level.WARNING, "SkillLevelChoice: could not apply level for " + player, e);
+				return Result.SAVE_FAILED;
+			}
+		}
+	}
+
+	/**
+	 * Снять выбор и вернуть высший изученный доступный уровень. Работает и при выключенном выборе.
+	 * @param player персонаж
+	 * @param id навык
+	 * @return итог
+	 */
+	public static Result automatic(Player player, int id)
+	{
+		synchronized (lock(player))
+		{
+			final Context context = new Context(player);
+			if (context.blocked())
+			{
+				return Result.BLOCKED;
+			}
+			final String before = context.read();
+			final Map<Integer, Choice> choices = decode(before);
+			final Choice previous = choices.get(id);
+			if (previous == null)
+			{
+				return Result.UNCHANGED;
+			}
+			final View view = context.view(id);
+			int target = 0;
+			if ((view != null) && view.regular())
+			{
+				final int earned = Math.max(view.known(), previous.earned());
+				final Integer allowed = view.available().floor(earned);
+				target = allowed == null ? view.known() : Math.max(view.known(), allowed);
+				if (context.cooling(id, earned))
+				{
+					return Result.COOLDOWN;
+				}
+			}
+			// Пропавшие, заточенные, предметные и навыки трансформации здесь не создаются и не заменяются.
+			choices.remove(id);
+			if (!commit(context, before, choices))
+			{
+				return Result.SAVE_FAILED;
+			}
+			try
+			{
+				if ((view != null) && (target > 0) && (target != view.known()))
+				{
+					context.useLevel(id, target);
+				}
+				context.refresh();
+				return Result.CHANGED;
+			}
+			catch (RuntimeException e)
+			{
+				try
+				{
+					context.save(before);
+					if ((view != null) && (target > 0))
+					{
+						context.useLevel(id, view.known());
+					}
+				}
+				catch (RuntimeException rollback)
+				{
+					LOGGER.log(Level.WARNING, "SkillLevelChoice: rollback failed for " + player, rollback);
+				}
+				LOGGER.log(Level.WARNING, "SkillLevelChoice: could not restore level for " + player, e);
+				return Result.SAVE_FAILED;
+			}
+		}
+	}
+
+	// ---------- Хуки Player ----------
+
+	/**
+	 * После штатного автоизучения: вернуть выбранные уровни. Внутри цикла изучения не вызывать.
+	 * @param player персонаж
+	 */
+	public static void afterAutoLearn(Player player)
+	{
+		if (!ENABLED || (player == null) || player.isTransformed() || !player.hasVariables())
+		{
+			return;
+		}
+		try
+		{
+			if (player.getVariables().getString(PREFIX + player.getClassIndex(), "").isBlank())
+			{
+				return;
+			}
+			synchronized (lock(player))
+			{
+				reapply(new Context(player));
+			}
+		}
+		catch (RuntimeException e)
+		{
+			LOGGER.log(Level.WARNING, "SkillLevelChoice: could not reapply levels for " + player, e);
+		}
+	}
+
+	/**
+	 * При входе живого игрока (с клиентом): вернуть выбранные уровни.
+	 * @param player персонаж
+	 */
+	public static void entered(Player player)
+	{
+		if (!ENABLED || (player == null) || player.isTransformed() || (player.getClient() == null))
+		{
+			return;
+		}
+		try
+		{
+			synchronized (lock(player))
+			{
+				final Context context = new Context(player);
+				if (reapply(context))
+				{
+					context.refresh();
+				}
+			}
+		}
+		catch (RuntimeException e)
+		{
+			LOGGER.log(Level.WARNING, "SkillLevelChoice: could not restore levels on login for " + player, e);
+		}
+	}
+
+	private static boolean reapply(Context context)
+	{
+		final String before = context.read();
+		final Map<Integer, Choice> choices = decode(before);
+		final Map<Integer, Integer> changes = new TreeMap<>();
+		for (Map.Entry<Integer, Choice> entry : choices.entrySet())
+		{
+			final int id = entry.getKey();
+			final Choice choice = entry.getValue();
+			final View view = context.view(id);
+			if ((view == null) || !view.regular())
+			{
+				continue;
+			}
+			final int earned = Math.min(view.ordinary().last(), Math.max(choice.earned(), view.known()));
+			final Integer target = view.available().floor(Math.min(choice.selected(), earned));
+			entry.setValue(new Choice(choice.selected(), earned));
+			if ((target != null) && (target != view.known()))
+			{
+				changes.put(id, target);
+			}
+		}
+		if (!encode(choices).equals(before) && !commit(context, before, choices))
+		{
+			return false;
+		}
+		boolean changed = false;
+		for (Map.Entry<Integer, Integer> entry : changes.entrySet())
+		{
+			try
+			{
+				context.useLevel(entry.getKey(), entry.getValue());
+				changed = true;
+			}
+			catch (RuntimeException e)
+			{
+				LOGGER.log(Level.WARNING, "SkillLevelChoice: could not reapply skill " + entry.getKey() + " for " + context.player, e);
+			}
+		}
+		return changed;
+	}
+
+	private static boolean commit(Context context, String before, Map<Integer, Choice> choices)
+	{
+		try
+		{
+			if (context.save(encode(choices)))
+			{
+				return true;
+			}
+		}
+		catch (RuntimeException e)
+		{
+			LOGGER.log(Level.WARNING, "SkillLevelChoice: could not save choice for " + context.player, e);
+		}
+		try
+		{
+			context.save(before);
+		}
+		catch (RuntimeException e)
+		{
+			LOGGER.log(Level.WARNING, "SkillLevelChoice: could not restore choice for " + context.player, e);
+		}
+		return false;
+	}
+
+	/**
+	 * Дерево класса персонажа на момент операции и доступ к его навыкам.
+	 */
+	private static final class Context
+	{
+		final Player player;
+		final int classIndex;
+		final int classId;
+		final String key;
+		final Map<Integer, NavigableSet<Integer>> ordinary = new TreeMap<>();
+		final Map<Integer, NavigableSet<Integer>> available = new TreeMap<>();
+
+		Context(Player player)
+		{
+			this.player = player;
+			classIndex = player.getClassIndex();
+			classId = player.getPlayerClass().getId();
+			key = PREFIX + classIndex;
+			for (SkillLearn learn : SkillTreeData.getInstance().getCompleteClassSkillTree(player.getPlayerClass()).values())
+			{
+				ordinary.computeIfAbsent(learn.getSkillId(), k -> new TreeSet<>()).add(learn.getSkillLevel());
+				if (learn.getGetLevel() <= player.getLevel())
+				{
+					available.computeIfAbsent(learn.getSkillId(), k -> new TreeSet<>()).add(learn.getSkillLevel());
+				}
+			}
+		}
+
+		String read()
+		{
+			return player.getVariables().getString(key, "");
+		}
+
+		boolean save(String value)
+		{
+			final PlayerVariables variables = player.getVariables();
+			if (value.isEmpty())
+			{
+				variables.remove(key);
+			}
+			else
+			{
+				variables.set(key, value);
+			}
+			return !variables.hasChanges() || variables.saveNow();
+		}
+
+		View view(int id)
+		{
+			final Skill skill = player.getKnownSkill(id);
+			if ((skill == null) || skill.isGMSkill() || skill.isHeroSkill() || !ordinary.containsKey(id))
+			{
+				return null;
+			}
+			return new View(id, skill.getName(), skill.getLevel(), ordinary.get(id), available.getOrDefault(id, Collections.emptyNavigableSet()));
+		}
+
+		boolean blocked()
+		{
+			return (player.getClassIndex() != classIndex) || (player.getPlayerClass().getId() != classId) || player.isChangingClass() || player.isDead() || player.isInCombat() || player.isCastingNow() || player.isInOlympiadMode() || player.isOnEvent() || player.isInDuel() || player.isInStoreMode() || player.isTeleporting() || player.isTransformed();
+		}
+
+		boolean cooling(int id, int highest)
+		{
+			for (int level : ordinary.getOrDefault(id, Collections.emptyNavigableSet()).headSet(highest, true))
+			{
+				final Skill skill = SkillData.getInstance().getSkill(id, level);
+				if ((skill != null) && player.isSkillDisabled(skill))
+				{
+					return true;
+				}
+			}
+			return false;
+		}
+
+		void useLevel(int id, int level)
+		{
+			if ((player.getClassIndex() != classIndex) || (player.getPlayerClass().getId() != classId) || player.isTransformed())
+			{
+				throw new IllegalStateException("Character class changed");
+			}
+			final Skill skill = SkillData.getInstance().getSkill(id, level);
+			final Skill previous = player.getKnownSkill(id);
+			if ((skill == null) || (skill.getId() != id) || (skill.getLevel() != level) || (previous == null))
+			{
+				throw new IllegalArgumentException("Missing learned skill level");
+			}
+			if (previous.isToggle() && player.isAffectedBySkill(id))
+			{
+				player.stopSkillEffects(SkillFinishType.REMOVED, id);
+			}
+			// В базу не пишется: там остаётся высший изученный уровень и его заточка.
+			player.addSkill(skill, false);
+			player.updateShortcuts(id, level);
+			// Пониженный пассив может срезать максимум; возврат уровня не лечит даром.
+			if (player.getCurrentHp() > player.getMaxHp())
+			{
+				player.setCurrentHp(player.getMaxHp());
+			}
+			if (player.getCurrentMp() > player.getMaxMp())
+			{
+				player.setCurrentMp(player.getMaxMp());
+			}
+			if (player.getCurrentCp() > player.getMaxCp())
+			{
+				player.setCurrentCp(player.getMaxCp());
+			}
+		}
+
+		void refresh()
+		{
+			player.sendSkillList();
+			player.sendPacket(new ShortcutInit(player));
+			player.broadcastUserInfo();
+		}
+	}
+}
