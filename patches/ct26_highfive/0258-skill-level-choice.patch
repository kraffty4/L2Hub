@@ -0,0 +1,181 @@
+package handlers.bypass.communityboard;
+
+import java.util.List;
+import java.util.Map;
+
+import org.l2jmobius.gameserver.entity.actor.Player;
+import org.l2jmobius.gameserver.mechanics.skill.SkillLevelChoice;
+import org.l2jmobius.gameserver.mechanics.skill.SkillLevelChoice.Choice;
+import org.l2jmobius.gameserver.mechanics.skill.SkillLevelChoice.Result;
+import org.l2jmobius.gameserver.mechanics.skill.SkillLevelChoice.View;
+
+/**
+ * L2Hub: уровни навыков на доске Alt+B ({@link SkillLevelChoice}), строка в разделе «Мир».
+ * <ul>
+ * <li>_bbshubskills [page &lt;n&gt;] — изученные классовые навыки выше первого уровня и навыки с выбором.</li>
+ * <li>_bbshubskills view &lt;навык&gt; — уровни навыка; set &lt;навык&gt; &lt;уровень&gt; — выбрать; auto &lt;навык&gt; — снять выбор.</li>
+ * </ul>
+ * Включается ключом SkillLevelSelectionEnabled в config/Custom/SkillLevelSelection.ini; выключенным сохранённый выбор можно только снять.
+ */
+public final class L2HubSkillLevels
+{
+	public static final String COMMAND = "_bbshubskills";
+
+	private static final int PAGE_SIZE = 8;
+
+	private L2HubSkillLevels()
+	{
+	}
+
+	/**
+	 * @param player кто открыл раздел «Мир»
+	 * @return показывать строку в «Мире»: выбор включён или у текущего класса есть сохранённый выбор
+	 */
+	public static boolean shown(Player player)
+	{
+		return SkillLevelChoice.enabled() || (player.hasVariables() && !SkillLevelChoice.choices(player).isEmpty());
+	}
+
+	public static String content(Player player, String[] args)
+	{
+		String note = "";
+		int page = 0;
+		Integer selected = null;
+		try
+		{
+			if ((args.length == 3) && args[1].equals("page"))
+			{
+				page = Math.max(0, Integer.parseInt(args[2]));
+			}
+			else if ((args.length == 3) && args[1].equals("view"))
+			{
+				selected = Integer.valueOf(args[2]);
+			}
+			else if ((args.length == 4) && args[1].equals("set"))
+			{
+				selected = Integer.valueOf(args[2]);
+				note = message(SkillLevelChoice.select(player, selected, Integer.parseInt(args[3])));
+			}
+			else if ((args.length == 3) && args[1].equals("auto"))
+			{
+				selected = Integer.valueOf(args[2]);
+				note = message(SkillLevelChoice.automatic(player, selected));
+			}
+			else if (args.length > 1)
+			{
+				note = L2HubBoard.tr("Неверная команда.");
+			}
+		}
+		catch (NumberFormatException e)
+		{
+			note = L2HubBoard.tr("Неверный номер навыка или уровня.");
+		}
+
+		final boolean active = SkillLevelChoice.enabled();
+		final StringBuilder sb = new StringBuilder(2048).append("<br>");
+		if (!note.isEmpty())
+		{
+			sb.append("<font color=\"LEVEL\">").append(note).append("</font><br><br>");
+		}
+		sb.append("<font color=\"B09878\">").append(L2HubBoard.tr("Можно вернуть ранее изученный уровень навыка. У основной профессии и каждого саба свой выбор.")).append("<br1>");
+		sb.append(L2HubBoard.tr("Выбор держится после входа и автоизучения. Откаты не сбрасываются, заточенные навыки не меняются.")).append("</font><br><br>");
+		if (!active)
+		{
+			sb.append("<font color=\"808080\">").append(L2HubBoard.tr("Новый выбор выключен в настройках сервера (SkillLevelSelection.ini). Сохранённый можно снять.")).append("</font><br><br>");
+		}
+
+		final Map<Integer, Choice> choices = SkillLevelChoice.choices(player);
+		if (selected != null)
+		{
+			return sb.append(skill(player, selected, choices.get(selected), active)).toString();
+		}
+
+		final List<View> rows = SkillLevelChoice.rows(player);
+		if (rows.isEmpty())
+		{
+			sb.append("<font color=\"808080\">").append(L2HubBoard.tr("Нет классовых навыков, у которых можно выбрать уровень.")).append("</font><br><br>");
+		}
+		final int lastPage = Math.max(0, (rows.size() - 1) / PAGE_SIZE);
+		page = Math.min(page, lastPage);
+		sb.append("<table width=500>");
+		for (View view : rows.subList(page * PAGE_SIZE, Math.min(rows.size(), (page + 1) * PAGE_SIZE)))
+		{
+			final Choice choice = choices.get(view.id());
+			sb.append("<tr><td width=330><font color=\"LEVEL\">").append(view.name()).append("</font> ").append(L2HubBoard.tr("ур. ")).append(view.known());
+			if (choice != null)
+			{
+				sb.append(" <font color=\"B09878\">(").append(L2HubBoard.tr("выбран")).append(")</font>");
+			}
+			sb.append("</td><td width=170 align=center>").append(L2HubBoard.button(L2HubBoard.tr("Выбрать уровень"), COMMAND + " view " + view.id(), 150)).append("</td></tr>");
+		}
+		sb.append("</table><br><table width=500><tr><td width=120>").append(L2HubBoard.button(L2HubBoard.tr("Назад"), L2HubBoard.WORLD, 80)).append("</td><td width=260 align=center>");
+		if (page > 0)
+		{
+			sb.append(L2HubBoard.button(L2HubBoard.tr("Пред."), COMMAND + " page " + (page - 1), 60));
+		}
+		sb.append("</td><td width=120 align=right>");
+		if (page < lastPage)
+		{
+			sb.append(L2HubBoard.button(L2HubBoard.tr("След."), COMMAND + " page " + (page + 1), 60));
+		}
+		return sb.append("</td></tr></table>").toString();
+	}
+
+	private static String skill(Player player, int id, Choice choice, boolean active)
+	{
+		final StringBuilder sb = new StringBuilder(1024);
+		final View view = SkillLevelChoice.view(player, id);
+		if (view == null)
+		{
+			sb.append("<font color=\"808080\">").append(L2HubBoard.tr("Такого изученного классового навыка нет.")).append("</font><br><br>");
+			if (choice != null)
+			{
+				sb.append(L2HubBoard.button(L2HubBoard.tr("Снять выбор"), COMMAND + " auto " + id, 160)).append("<br>");
+			}
+		}
+		else
+		{
+			sb.append("<font color=\"LEVEL\">").append(view.name()).append("</font><br1>").append(L2HubBoard.tr("Сейчас уровень ")).append(view.known()).append(".<br>");
+			if (!view.regular())
+			{
+				sb.append("<font color=\"808080\">").append(L2HubBoard.tr("Заточенный или временный навык здесь не меняется.")).append("</font><br>");
+			}
+			else if (active)
+			{
+				final List<Integer> levels = SkillLevelChoice.levels(player, view);
+				if (!levels.isEmpty())
+				{
+					final StringBuilder list = new StringBuilder();
+					for (int i = levels.size() - 1; i >= 0; i--)
+					{
+						list.append(list.isEmpty() ? "" : ";").append(levels.get(i));
+					}
+					sb.append("<br><table width=300><tr><td width=110 align=right>").append(L2HubBoard.tr("Уровень:")).append("</td><td width=90><combobox var=\"level\" list=\"").append(list).append("\" width=80></td><td width=100>");
+					sb.append(L2HubBoard.button(L2HubBoard.tr("Выбрать"), COMMAND + " set " + view.id() + " $level", 90)).append("</td></tr></table>");
+				}
+			}
+			if (choice != null)
+			{
+				sb.append("<br>").append(L2HubBoard.tr("Выбран уровень ")).append(choice.selected()).append(L2HubBoard.tr(", изучен до ")).append(choice.earned()).append(".<br1>");
+				sb.append(L2HubBoard.button(L2HubBoard.tr("Снять выбор"), COMMAND + " auto " + view.id(), 160)).append("<br>");
+			}
+		}
+		return sb.append("<br>").append(L2HubBoard.button(L2HubBoard.tr("К списку навыков"), COMMAND, 160)).toString();
+	}
+
+	private static String message(Result result)
+	{
+		return switch (result)
+		{
+			case CHANGED -> L2HubBoard.tr("Готово.");
+			case UNCHANGED -> L2HubBoard.tr("Этот уровень уже выбран.");
+			case DISABLED -> L2HubBoard.tr("Выбор уровня навыков выключен в настройках сервера.");
+			case BLOCKED -> L2HubBoard.tr("Менять уровень можно вне боя, каста, ивентов, дуэли, лавки, трансформации и Олимпиады.");
+			case NO_SKILL -> L2HubBoard.tr("Такого изученного классового навыка нет.");
+			case INVALID_LEVEL -> L2HubBoard.tr("Этот уровень недоступен или ещё не изучен.");
+			case UNSUPPORTED -> L2HubBoard.tr("Заточенный или временный навык здесь не меняется.");
+			case COOLDOWN -> L2HubBoard.tr("Сначала дождись отката навыка: смена уровня откат не сбрасывает.");
+			case SAVE_FAILED -> L2HubBoard.tr("Не удалось сохранить выбор, попробуй позже.");
+		};
+	}
+}
