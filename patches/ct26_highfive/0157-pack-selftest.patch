+		final Player live = fighter(spare, 50);
+		final Player low = fighter(spare, 47);
+		final Player high = fighter(spare, 53);
+		final Player under = fighter(spare, 46);
+		final Player liveFar = fighter(spare, 54);
+		final Player liveClose = fighter(spare, 52);
+		final List<Player> used = new ArrayList<>(List.of(far, pal, live, low, high, under, liveFar, liveClose));
+		final String open = band(script);
+		((Event) script).eventStart(null);
+		note("matching: without live players the board shows levels " + open);
+
+		// Пока живых нет, охотники сверяются друг с другом.
+		check("matching: first hunter joins", join(script, far));
+		check("matching: hunter within the gap of a hunter joins", join(script, pal));
+		check("matching: hunter 10 levels away is refused", !join(script, live));
+		check("matching: board without live players stays " + band(script), band(script).equals(open));
+
+		// Первый живой задаёт пределы, охотники не из них снимаются.
