+	private static void party(List<Player> spare) throws Exception
+	{
+		Player member = null;
+		Player leader = null;
+		for (int i = 0; (i < 40) && (member == null); i++)
+		{
+			member = hunting(spare, p -> p.isMageClass() && (p.getLevel() >= 20));
+			if (member == null)
+			{
+				Thread.sleep(3000);
+			}
+		}
+		if (member == null)
+		{
+			check("party: no mage hunting", false);
+			return;
+		}
+		final int level = member.getLevel();
+		leader = pick(spare, p -> Math.abs(p.getLevel() - level) <= 2);
+		if (leader == null)
+		{
+			check("party: no leader near level " + level, false);
+			return;
+		}
+		final Player mage = member;
+		final PhantomTemplate template = PhantomData.getInstance().getTemplate(mage.getName());
+		mage.addAdena(ItemProcessType.REWARD, 50000000, mage, false);
+		park(leader, new Location(mage.getX(), mage.getY(), mage.getZ()));
+		final PhantomCompanionManager manager = PhantomCompanionManager.getInstance();
+		for (int i = 0; (i < 30) && !mage.isInParty(); i++)
+		{
+			manager.onInvited(leader, mage, null);
+			Thread.sleep(2000);
+		}
+		check("party: " + mage.getName() + " " + mage.getPlayerClass() + " (" + level + ") joined", mage.isInParty());
+		if (!mage.isInParty())
+		{
+			return;
+		}
+
+		mage.setInvul(true);
+		final boolean supplied = waitFor(40, () -> (mage.getAutoUseSettings().getAutoManaItem() > 0) && (mana(mage) > 0));
+		check("party: mana slot " + mage.getAutoUseSettings().getAutoManaItem() + ", " + mana(mage) + " potions", supplied);
+		check("party: HP slot " + mage.getAutoUseSettings().getAutoPotionItem(), mage.getAutoUseSettings().getAutoPotionItem() > 0);
+
+		final int stock = mana(mage);
+		mage.setCurrentMp(mage.getMaxMp() * 0.1);
+		final boolean drank = waitFor(25, () -> mana(mage) < stock);
+		check("party: drinks at 10 % MP, potions " + stock + " → " + mana(mage) + ", at the spot, peace " + mage.isInsideZone(ZoneId.PEACE), drank);
+
+		// Маг под ударами кастует, а не машет рукой (при мане).
+		manager.setMode(leader, template, PhantomCompanionManager.Mode.HUNT);
+		final Monster mob = World.getNearestVisibleObjectInRange(mage, Monster.class, 1200, near -> !near.isDead() && !near.isRaid());
+		if (mob != null)
+		{
+			mob.teleToLocation(new Location(mage.getX() + 30, mage.getY(), mage.getZ()));
+			mob.addDamageHate(mage, 1, 999);
+			mob.getAI().setIntentionAttack(mage);
+		}
+		int swings = 0;
+		int casts = 0;
+		for (int i = 0; i < 150; i++)
+		{
+			mage.setCurrentMp(mage.getMaxMp());
+			swings += mage.isAttackingNow() ? 1 : 0;
+			casts += mage.isCastingNow() ? 1 : 0;
+			Thread.sleep(200);
+		}
+		note("party: mob " + (mob == null ? "none" : mob.getName()) + ", in 30 s swings " + swings + ", casts " + casts);
+		check("party: mage does not swing with MP, swings " + swings + ", casts " + casts, swings == 0);
+		check("party: mage casts, " + casts, casts > 0);
+
+		// Нет мобов и хозяин стоит — приказ сам становится «веди», а не стоять.
+		leader.teleToLocation(GIRAN);
+		mage.teleToLocation(GIRAN);
+		Thread.sleep(3000);
+		manager.setMode(leader, template, PhantomCompanionManager.Mode.HUNT);
+		final boolean led = waitFor(45, () ->
+		{
+			try
+			{
+				return companionMode(template) == PhantomCompanionManager.Mode.LEAD;
+			}
+			catch (Exception e)
+			{
+				return false;
+			}
+		});
+		check("party: empty spot turns HUNT into " + companionMode(template), led);
+
+		// Распустили — охотник снова качается один, слот маны чист.
+		manager.release(template, true);
+		final boolean clear = waitFor(90, () -> !mage.isInParty() && (mage.getAutoUseSettings().getAutoManaItem() == 0));
+		check("party: after the party mana slot " + mage.getAutoUseSettings().getAutoManaItem() + ", phase " + phase(mage), clear);
+		mage.setInvul(false);
+		leader.setInvul(false);
+		spare.add(leader);
