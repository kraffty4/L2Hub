+	private static void potions(List<Player> spare) throws Exception
+	{
+		final Player player = pick(spare, Player::isMageClass);
+		if (player == null)
+		{
+			check("potions: no mage to play", false);
+			return;
+		}
+		park(player, GIRAN);
+		if (player.getLevel() < 80)
+		{
+			player.getStat().addLevel((byte) (80 - player.getLevel()));
+		}
+		note("potions: " + player.getName() + " level " + player.getLevel() + " max MP " + (int) player.getMaxMp());
+		for (int id : MANA)
+		{
+			player.addItem(ItemProcessType.REWARD, id, 5, player, false);
+		}
+
+		// Мгновенная мана к неуязвимому не идёт (ManaHeal), а park делает его неуязвимым.
+		player.setInvul(false);
+		measure(player, 726, 100);
+		measure(player, 728, 400);
+
+		// Банка на 1000 за 5 секунд: идёт тиками и слот бафа не занимает.
+		final int full = player.getStat().getMaxBuffCount();
+		final Method buff = PhantomHunterManager.class.getDeclaredMethod("buff", Player.class);
+		buff.setAccessible(true);
+		buff.invoke(null, player);
+		for (String more : SchemeBufferTable.getInstance().getSkillTypes())
+		{
+			if (player.getEffectList().getBuffCount() >= full)
+			{
+				break;
+			}
+			for (int skillId : SchemeBufferTable.getInstance().getSkillsIdsByType(more))
+			{
+				final Skill skill = SkillData.getInstance().getSkill(skillId, 1);
+				if ((skill != null) && !skill.isDance() && (player.getEffectList().getBuffCount() < full))
+				{
+					skill.applyEffects(player, player);
+				}
+			}
+		}
+		final Set<Integer> before = new HashSet<>();
+		for (BuffInfo info : player.getEffectList().getBuffs())
+		{
+			before.add(info.getSkill().getId());
+		}
+		final int bar = player.getEffectList().getBuffCount();
+		note("potions: buff bar " + bar + " of " + full);
+
+		final int count = (int) player.getInventory().getInventoryItemCount(10153, -1);
+		player.setCurrentMp(0);
+		final boolean used = drink(player, 10153);
+		Thread.sleep(1200);
+		final int early = (int) player.getCurrentMp();
+		final BuffInfo running = player.getEffectList().getShortBuff();
+		final Set<Integer> after = new HashSet<>();
+		for (BuffInfo info : player.getEffectList().getBuffs())
+		{
+			after.add(info.getSkill().getId());
+		}
+		Thread.sleep(5300);
+		final int late = (int) player.getCurrentMp();
+		final int wanted = Math.min((int) player.getMaxMp(), 1002);
+		check("potions: 10153 used, one spent", used && ((int) player.getInventory().getInventoryItemCount(10153, -1) == (count - 1)));
+		check("potions: 10153 not at once, " + early + " MP after 1.2 s", (early > 0) && (early < 400));
+		// Сверху своё восстановление: у мага с бафами до 30 MP в секунду.
+		check("potions: 10153 gives " + late + " MP over 6.5 s, wanted about " + wanted, (late >= (wanted - 90)) && (late <= (wanted + 250)));
+		check("potions: 10153 in the short bar, " + (running == null ? null : running.getSkill().getId()), (running != null) && (running.getSkill().getId() == 10003));
+		check("potions: 10153 pushes out no buff, " + bar + " before, " + after.size() + " after", after.containsAll(before));
+		player.setInvul(false);
+	}
