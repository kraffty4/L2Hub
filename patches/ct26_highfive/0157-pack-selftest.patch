+			check("olympiad: key off, the servitor does not touch the foe (control)", !control);
+
+			PhantomHuntersConfig.HUNTER_COMBAT_FIXES = true;
+			boolean ordered = false;
+			boolean swings = false;
+			for (int i = 0; i < 40; i++)
+			{
+				drive.invoke(games, owner, ownerTemplate, System.currentTimeMillis());
+				ordered |= (servitor.getTarget() == foe) && (servitor.getAI().getIntention() == Intention.ATTACK);
+				Thread.sleep(500);
+				swings |= (servitor.getTarget() == foe) && servitor.isAttackingNow();
+			}
+			final Object brain = servitor.getAI().getIntention();
+			note("olympiad: " + servitor.getName() + " spawned " + servitor.isSpawned() + ", ordered " + ordered + ", target " + servitor.getTarget() + ", intention " + brain + ", attack target " + servitor.getAI().getAttackTarget() + ", distance " + (int) servitor.calculateDistance2D(foe) + ", moving " + servitor.isMoving() + ", attack disabled " + servitor.isAttackDisabled() + ", sees the foe " + GeoEngine.getInstance().canSeeTarget(servitor, foe) + ", has geo " + GeoEngine.getInstance().hasGeo(servitor.getX(), servitor.getY()) + ", path " + (PathFinding.getInstance().findPath(servitor.getX(), servitor.getY(), servitor.getZ(), foe.getX(), foe.getY(), foe.getZ(), servitor.getInstanceId(), false) != null));
