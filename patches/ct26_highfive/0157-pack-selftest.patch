+	private static void measure(Player player, int itemId, int gain) throws Exception
+	{
+		final int count = (int) player.getInventory().getInventoryItemCount(itemId, -1);
+		player.setCurrentMp(0);
+		final boolean used = drink(player, itemId);
+		Thread.sleep(1500);
+		final int got = (int) player.getCurrentMp();
+		check("potions: " + itemId + " gives " + got + " MP, wanted " + gain, used && (got >= gain) && (got <= (gain + 40)));
+		check("potions: " + itemId + " spent once", (int) player.getInventory().getInventoryItemCount(itemId, -1) == (count - 1));
+	}
