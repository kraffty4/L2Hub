+					cast[i].getAdena(),
+					cast[i].getExp(),
+					count(cast[i], L2HubPvpEvents.rewardScroll(level, false)),
+					count(cast[i], L2HubPvpEvents.rewardScroll(level, true)),
+					count(cast[i], L2HubPvpEvents.MEDAL_ITEM)
