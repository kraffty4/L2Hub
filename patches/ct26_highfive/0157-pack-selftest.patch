+	/** Выронить оружие у моба рядом с охотником, как при убийстве: шанс — разовый на 100 %. */
+	private static boolean dropNear(CursedWeapon weapon, Player killer)
+	{
+		final Monster mob = World.getNearestVisibleObjectInRange(killer, Monster.class, 2000, near -> !near.isDead() && !near.isRaid());
+		if (mob == null)
+		{
+			return false;
+		}
+		weapon.setDropRate(100000);
+		final boolean dropped = weapon.checkDrop(mob, killer);
+		weapon.setDropRate(1);
+		return dropped;
+	}
