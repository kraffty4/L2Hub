+		// На вершине каст добавляет только свои очки.
+		Thread.sleep(4000);
+		final long before = mob.getHating(tank);
+		final boolean again = provoke(tank, victim, aggression, mob);
+		final long gain = mob.getHating(tank) - before;
+		check("taunt on: on the top the cast adds only its points, cast " + again + ", gain " + gain, again && (gain >= aggressionPoints) && (gain <= (aggressionPoints + 400)));
+
+		// Аура: кто-то снова набил больше, моб рядом.
