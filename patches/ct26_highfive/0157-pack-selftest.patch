+	/** Оглушить настоящим эффектом стана: шанс эффекта может не пройти, потому в цикле. */
+	private static boolean stunned(Player player) throws Exception
+	{
+		final Skill skill = SkillData.getInstance().getSkill(100, 1);
+		final Monster mob = World.getNearestVisibleObjectInRange(player, Monster.class, 1500, near -> !near.isDead());
+		player.setInvul(false);
+		for (int i = 0; (i < 100) && !player.isStunned(); i++)
+		{
+			player.setCurrentHp(player.getMaxHp());
+			skill.applyEffects(mob != null ? mob : player, player);
+			Thread.sleep(100);
+		}
+		player.setCurrentHp(player.getMaxHp());
+		player.setInvul(true);
+		return player.isStunned();
+	}
