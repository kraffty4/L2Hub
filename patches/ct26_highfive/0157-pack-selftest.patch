+			for (int i = 0; (i < 60) && !hunter.isRegisteredOnEvent(); i++)
+			{
+				control.invoke(events, one, System.currentTimeMillis());
+				Thread.sleep(500);
+			}
+			check("recruit: a free hunter registers", hunter.isRegisteredOnEvent());
+			if (store == null)
+			{
+				note("recruit: no hunter in a store right now");
+			}
+			else
+			{
+				final List<Player> shop = List.of(store);
