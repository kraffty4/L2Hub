+		check(name + ": board shows " + band(script), band(script).equals("47 53"));
+		for (int i = 0; i < 9; i++)
+		{
+			final Player hunter = fighter(spare, 47 + (i % 7));
+			join(script, hunter);
+			all.add(hunter);
+		}
