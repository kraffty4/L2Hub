+	/**
+	 * Цель выбирается каждый тик: приказ доходит не мгновенно. Не дошло за 6 с — в лог, что было с обеими сторонами.
+	 */
+	private static boolean picks(Method choose, Player expected, boolean assist, boolean protect, Player helper, Player owner) throws Exception
+	{
+		final boolean found = waitFor(6, () ->
+		{
+			try
+			{
+				return choose.invoke(null, assist, protect, helper, owner) == expected;
+			}
+			catch (ReflectiveOperationException e)
+			{
+				return false;
+			}
+		});
+		if (!found)
+		{
+			note("pvp: enemy target " + expected.getTarget() + ", intention " + expected.getAI().getIntention() + ", attacking " + expected.isAttackingNow() + ", flag " + expected.getPvpFlag() + ", karma " + expected.getKarma() + ", invul " + expected.isInvul() + ", protected " + expected.isSpawnProtected() + ", attackable by helper " + expected.isAutoAttackable(helper) + " and owner " + expected.isAutoAttackable(owner) + ", seen " + GeoEngine.getInstance().canSeeTarget(helper, expected) + ", clans " + helper.getClanId() + " " + owner.getClanId() + " " + expected.getClanId() + "; owner target " + owner.getTarget() + ", intention " + owner.getAI().getIntention() + ", in combat " + owner.isInCombat() + ", distance " + (int) owner.calculateDistance2D(expected));
+		}
+		return found;
+	}
+
+	/**
+	 * Напарник в PvP: не трогает белого, защищает владельца и себя по режиму, бьёт цель владельца, если её законно бить.
+	 */
+	private static void pvpAssist(List<Player> spare) throws Exception
+	{
+		final Method choose = PhantomCompanionManager.class.getDeclaredMethod("pvpEnemy", boolean.class, boolean.class, Player.class, Player.class);
+		choose.setAccessible(true);
+		final Monster mob = wildMob(1, 40);
+		final Player helper = pick(spare, p -> !p.isCursedWeaponEquipped());
+		final Player owner = (helper == null) ? null : pick(spare, p -> !p.isCursedWeaponEquipped() && ((p.getClanId() == 0) || (p.getClanId() != helper.getClanId())));
+		final Player enemy = (owner == null) ? null : pick(spare, p -> !p.isCursedWeaponEquipped() && ((p.getClanId() == 0) || (p.getClanId() != owner.getClanId())) && ((p.getAllyId() == 0) || (p.getAllyId() != owner.getAllyId())));
+		check("pvp: found three hunters and a place", (mob != null) && (enemy != null));
+		if ((mob == null) || (enemy == null))
+		{
+			return;
+		}
+		final Location place = mob.getLocation();
+		park(helper, place);
+		park(owner, place);
+		park(enemy, place);
+		enemy.setInvul(false);
+		enemy.setCurrentHp(enemy.getMaxHp());
+		try
+		{
+			// Белый, начав бить, сам становится фиолетовым, поэтому белого проверяем до удара.
+			final Method legal = PhantomCompanionManager.class.getDeclaredMethod("isPvpEnemy", Player.class, Player.class, Creature.class);
+			legal.setAccessible(true);
+			check("pvp: a white player is no enemy", !((Boolean) legal.invoke(null, helper, owner, enemy)));
+			enemy.setTarget(owner);
+			check("pvp: a white player with the owner in target is left alone", choose.invoke(null, true, true, helper, owner) == null);
+
+			enemy.setPvpFlag(1);
+			enemy.setTarget(owner);
+			enemy.getAI().setIntentionAttack(owner);
+			check("pvp: a flagged player on the owner is hit", picks(choose, enemy, false, true, helper, owner));
+			enemy.setTarget(owner);
+			enemy.getAI().setIntentionAttack(owner);
+			check("pvp: in stay mode the owner is not defended", choose.invoke(null, false, false, helper, owner) == null);
+			enemy.setTarget(helper);
+			enemy.getAI().setIntentionAttack(helper);
+			check("pvp: in stay mode he defends himself", picks(choose, enemy, false, false, helper, owner));
+
+			enemy.abortAttack();
+			enemy.setTarget(null);
+			enemy.getAI().setIntentionIdle();
+			owner.setTarget(enemy);
+			owner.getAI().setIntentionAttack(enemy);
+			check("pvp: assists on the owner's flagged target", picks(choose, enemy, true, false, helper, owner));
+			check("pvp: no assist in stay mode", choose.invoke(null, false, false, helper, owner) == null);
+			enemy.setPvpFlag(0);
+			check("pvp: the owner's white target is not hit, no PK", choose.invoke(null, true, false, helper, owner) == null);
+		}
+		finally
+		{
+			enemy.setPvpFlag(0);
+			enemy.abortAttack();
+			enemy.setTarget(null);
+			enemy.getAI().setIntentionIdle();
+			owner.abortAttack();
+			owner.getAI().setIntentionIdle();
+			owner.setPvpFlag(0);
+			owner.setTarget(null);
+			helper.setInvul(false);
+			owner.setInvul(false);
+		}
+	}
