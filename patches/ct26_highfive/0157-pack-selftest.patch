+		scores.put(loser, 1);
+
+		final Player[] cast =
+		{
+			winner,
+			loser,
+			winnerHunter,
+			loserHunter
+		};
+		final long[][] before = new long[cast.length][];
+		for (int i = 0; i < cast.length; i++)
+		{
+			if (cast[i] != null)
+			{
+				final int level = cast[i].getLevel();
+				before[i] = new long[]
+				{
