+	/** Обычный моб этих уровней в открытом мире: живой, не рейд, не чемпион, не миньон. */
+	private static Monster wildMob(int low, int high)
+	{
+		final List<Monster> mobs = new ArrayList<>();
+		for (WorldObject object : World.getVisibleObjects())
+		{
+			if ((object instanceof Monster) && (object.getInstanceId() == 0))
+			{
+				final Monster near = (Monster) object;
+				if (!near.isDead() && !near.isRaid() && !near.isChampion() && !near.isMinion() && !near.isMovementDisabled() && !near.isInsideZone(ZoneId.PEACE) && (near.getLevel() >= low) && (near.getLevel() <= high))
+				{
+					mobs.add(near);
+				}
+			}
+		}
+		Collections.shuffle(mobs);
+		return mobs.isEmpty() ? null : mobs.get(0);
+	}
