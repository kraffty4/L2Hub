+	/** Дроп настоящим кодом шаблона: по 20000 убийств на моба при разных шансе, количестве и лимите. Убийца снят с охотников, их x2 у него нет. Только замер, в мир ничего не падает. */
+	private static void drops(List<Player> spare) throws Exception
+	{
+		final float chance = RatesConfig.RATE_DEATH_DROP_CHANCE_MULTIPLIER;
+		final float amount = RatesConfig.RATE_DEATH_DROP_AMOUNT_MULTIPLIER;
+		final int limit = RatesConfig.DROP_MAX_OCCURRENCES_NORMAL;
+		int measured = 0;
+		try
+		{
+			for (int[] band : new int[][]
+			{
+				{
+					25,
+					39
+				},
+				{
+					40,
+					59
+				},
+				{
+					60,
+					85
+				}
+			})
+			{
+				for (int i = 0; i < 20; i++)
+				{
+					final Player killer = hunting(spare, p -> (p.getLevel() >= band[0]) && (p.getLevel() <= band[1]));
+					if (killer == null)
+					{
+						Thread.sleep(3000);
+						continue;
+					}
+					final Monster mob = World.getNearestVisibleObjectInRange(killer, Monster.class, 1500, near -> !near.isDead() && !near.isRaid() && !near.isChampion() && !near.isMinion() && (Math.abs(near.getLevel() - killer.getLevel()) <= 3));
+					if (mob == null)
+					{
+						continue;
+					}
+					park(killer, new Location(killer.getX(), killer.getY(), killer.getZ()));
+					dropRun(mob, killer, 1, 10, 2);
+					dropRun(mob, killer, 1, 10, 100);
+					dropRun(mob, killer, 5, 2, 2);
+					dropRun(mob, killer, 10, 1, 2);
+					measured++;
+					break;
+				}
+			}
+		}
+		finally
+		{
+			RatesConfig.RATE_DEATH_DROP_CHANCE_MULTIPLIER = chance;
+			RatesConfig.RATE_DEATH_DROP_AMOUNT_MULTIPLIER = amount;
+			RatesConfig.DROP_MAX_OCCURRENCES_NORMAL = limit;
+		}
+		check("drops: measured mobs " + measured, measured > 0);
+	}
+
+	private static void dropRun(Monster mob, Player killer, float chance, float amount, int limit)
+	{
+		RatesConfig.RATE_DEATH_DROP_CHANCE_MULTIPLIER = chance;
+		RatesConfig.RATE_DEATH_DROP_AMOUNT_MULTIPLIER = amount;
+		RatesConfig.DROP_MAX_OCCURRENCES_NORMAL = limit;
+		final int kills = 20000;
+		int any = 0;
+		int stuff = 0;
+		int gear = 0;
+		int herbs = 0;
+		long pieces = 0;
+		for (int i = 0; i < kills; i++)
+		{
+			final List<ItemHolder> list = mob.getTemplate().calculateDrops(DropType.DROP, mob, killer);
+			boolean got = false;
+			if (list != null)
+			{
+				for (ItemHolder drop : list)
+				{
+					if (drop.getId() == 57)
+					{
+						continue;
+					}
+					final ItemTemplate item = ItemData.getInstance().getTemplate(drop.getId());
+					if (item.hasExImmediateEffect())
+					{
+						herbs++;
+						continue;
+					}
+					got = true;
+					pieces += drop.getCount();
+					if (item.isEquipable())
+					{
+						gear++;
+					}
+					else
+					{
+						stuff++;
+					}
+				}
+			}
+			any += got ? 1 : 0;
+		}
+		note("drops: " + mob.getName() + " L" + mob.getLevel() + ", killer L" + killer.getLevel() + ", chance x" + chance + ", amount x" + amount + ", limit " + limit + ": an item in " + ((any * 1000L) / kills) / 10.0 + "% of kills, materials per 100 kills " + ((stuff * 1000L) / kills) / 10.0 + ", gear per 1000 kills " + ((gear * 10000L) / kills) / 10.0 + ", pieces per 100 kills " + ((pieces * 100L) / kills) + ", herbs per 100 kills " + ((herbs * 100L) / kills));
+	}
