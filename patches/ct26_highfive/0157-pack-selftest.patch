+	/** Охотник с самым плотным окружением охотников на каче: от него всего ближе соседям бежать. */
+	private static Player crowded() throws Exception
+	{
+		final Map<?, ?> map = hunters();
+		final List<Player> hunting = new ArrayList<>();
+		for (Player player : free())
+		{
+			final Object hunter = map.get(player.getName().toLowerCase());
+			if ((hunter != null) && "HUNT".equals(String.valueOf(hunterField(hunter, "phase"))) && (hunterField(hunter, "spot") != null) && !player.isInsideZone(ZoneId.PEACE))
+			{
+				hunting.add(player);
+			}
+		}
+		Player best = null;
+		int bestCount = -1;
+		for (Player player : hunting)
+		{
+			int count = 0;
+			for (Player other : hunting)
+			{
+				if (player.calculateDistance2D(other) <= 4000)
+				{
+					count++;
+				}
+			}
+			if ((count > bestCount) && (World.getNearestVisibleObjectInRange(player, Monster.class, 2000, near -> !near.isDead() && !near.isRaid()) != null))
+			{
+				best = player;
+				bestCount = count;
+			}
+		}
+		note("cursed: hunters on spots " + hunting.size() + ", around the drop " + bestCount);
+		return best;
+	}
