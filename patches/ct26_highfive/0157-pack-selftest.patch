+		}
+		PhantomHuntersConfig.HUNTER_PVP_EVENTS = true;
+		PhantomHuntersConfig.HUNTER_PVP_EVENT_MAX = 100;
+		PhantomHuntersConfig.HUNTER_PVP_EVENT_CHANCE = 100;
+		((Event) script).eventStart(null);
+		try
+		{
+			final Player hunter = fighter(spare, 50);
