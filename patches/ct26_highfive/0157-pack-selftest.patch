+				{
+					control.invoke(events, shop, System.currentTimeMillis());
+				}
+				check("recruit: a hunter in a store does not", !store.isRegisteredOnEvent());
+			}
+		}
+		finally
+		{
+			((Event) script).eventStop();
+			PhantomHuntersConfig.HUNTER_PVP_EVENTS = enabled;
+			PhantomHuntersConfig.HUNTER_PVP_EVENT_MAX = max;
+			PhantomHuntersConfig.HUNTER_PVP_EVENT_CHANCE = chance;
+		}
+	}
