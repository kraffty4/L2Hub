+	/**
+	 * Проклятый в драке с игроками: бьющему его без флага даёт сдачи, с ключом HunterCursedAttacks нападает сам.
+	 */
+	private static void cursedFights(Player holder) throws Exception
+	{
+		final Object hunter = hunters().get(holder.getName().toLowerCase());
+		final Field enemyId = hunter.getClass().getDeclaredField("enemyId");
+		enemyId.setAccessible(true);
+		final Player striker = pick(free(), p -> (p != holder) && !p.isCursedWeaponEquipped() && (p.getActiveWeaponItem() != null) && !p.getActiveWeaponItem().isBow() && !p.getActiveWeaponItem().isCrossBow());
+		check("cursed: found a striker", striker != null);
+		if (striker == null)
+		{
+			return;
+		}
+
+		// С проклятым не дерутся те, кому 20 и меньше (PlayableAI), а охотники здесь мелкие.
+		if (striker.getLevel() <= 20)
+		{
+			striker.getStat().addLevel((byte) (30 - striker.getLevel()));
+		}
+		note("cursed: holder " + holder.getName() + " L" + holder.getLevel() + ", striker " + striker.getName() + " L" + striker.getLevel());
+
+		// Ключ выключен: соседа не трогает.
+		PhantomHuntersConfig.HUNTER_CURSED_ATTACKS = false;
+		enemyId.setInt(hunter, 0);
+		park(striker, holder.getLocation());
+		Thread.sleep(5000);
+		check("cursed: key off, leaves the neighbour alone", World.getPlayer(enemyId.getInt(hunter)) != striker);
+
+		// Бьют: отвечает, хотя у бьющего нет флага, и держит цель.
+		holder.setInvul(false);
+		striker.setTarget(holder);
+		striker.getAI().setIntentionAttack(holder);
+		// Сколько бьющий добирается до первого удара, зависит от него, а не от держателя: ответ считаем от удара. В PvP урон идёт сперва в CP.
+		Player enemy = null;
+		int hitAt = -1;
+		int answeredAt = -1;
+		int held = 0;
+		int swings = 0;
+		for (int i = 0; (i < 360) && ((answeredAt < 0) || (i < (answeredAt + 80))); i++)
+		{
+			holder.setCurrentHp(holder.getMaxHp());
+			holder.setCurrentCp(holder.getMaxCp());
+			if (striker.getAI().getIntention() != Intention.ATTACK)
+			{
+				striker.setTarget(holder);
+				striker.getAI().setIntentionAttack(holder);
+			}
+			final Player current = World.getPlayer(enemyId.getInt(hunter));
+			if ((current != null) && (hitAt < 0))
+			{
+				hitAt = i;
+			}
+			if ((current != null) && (holder.getTarget() == current))
+			{
+				enemy = current;
+				answeredAt = answeredAt < 0 ? i : answeredAt;
+				held++;
+				swings += holder.isAttackingNow() ? 1 : 0;
+			}
+			Thread.sleep(250);
+		}
+		holder.setInvul(true);
+		check("cursed: answers whoever hits, " + (enemy == null ? null : enemy.getName()) + ", flag " + (enemy == null ? 0 : enemy.getPvpFlag()) + ", first hit at " + (hitAt / 4) + " s, answered " + ((answeredAt - hitAt) / 4) + " s later, held " + held + " of 80, swinging " + swings, (enemy == striker) && (answeredAt >= 0) && ((answeredAt - hitAt) <= 40) && (held > 40) && (swings > 0));
+
+		// Ключ включён: нападает сам.
+		striker.abortAttack();
+		striker.getAI().setIntentionIdle();
+		enemyId.setInt(hunter, 0);
+		// Новичка не выбирает, и новичок на него не идёт: Mobius такую драку молча снимает, оба встали бы столбом.
+		final Player newbie = pick(free(), p -> (p != holder) && (p != striker) && (p.getLevel() <= 20) && !p.isCursedWeaponEquipped());
+		if (newbie == null)
+		{
+			note("cursed: no newbie around to check");
+		}
+		else
+		{
+			park(newbie, holder.getLocation());
+			final Method prey = PhantomHunterManager.class.getDeclaredMethod("cursedPrey", Player.class);
+			prey.setAccessible(true);
+			final Player chosen = (Player) prey.invoke(null, holder);
+			check("cursed: a newbie L" + newbie.getLevel() + " is no prey, chose " + (chosen == null ? null : chosen.getName() + " L" + chosen.getLevel()), (chosen == null) || (chosen.getLevel() > 20));
+			final Method brave = PhantomPk.class.getDeclaredMethod("strongAndBrave", Player.class, Player.class);
+			brave.setAccessible(true);
+			check("cursed: a newbie does not go for the holder", !((Boolean) brave.invoke(null, newbie, holder)));
+		}
+
+		PhantomHuntersConfig.HUNTER_CURSED_ATTACKS = true;
+		final boolean started = waitFor(20, () ->
+		{
+			try
+			{
+				return enemyId.getInt(hunter) != 0;
+			}
+			catch (IllegalAccessException e)
+			{
+				return false;
+			}
+		});
+		int attacking = 0;
+		for (int i = 0; i < 40; i++)
+		{
+			attacking += holder.isAttackingNow() ? 1 : 0;
+			Thread.sleep(250);
+		}
+		check("cursed: key on, attacks a neighbour, target " + (holder.getTarget() == null ? null : holder.getTarget().getName()) + ", swinging " + attacking, started && (holder.getTarget() instanceof Player) && (attacking > 0));
+		enemyId.setInt(hunter, 0);
+		striker.setInvul(false);
+	}
