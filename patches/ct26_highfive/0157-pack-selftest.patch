+	private static void detour(List<Player> spare) throws Exception
+	{
+		final Player player = pick(spare, p -> p.getLevel() >= 20);
+		final List<Monster> mobs = new ArrayList<>();
+		for (WorldObject object : World.getVisibleObjects())
+		{
+			if ((object instanceof Monster) && !((Monster) object).isDead() && !((Monster) object).isRaid() && (object.getInstanceId() == 0))
+			{
+				mobs.add((Monster) object);
+			}
+		}
+		Collections.shuffle(mobs);
+		final GeoEngine geo = GeoEngine.getInstance();
+		Location place = null;
+		Monster target = null;
+		SEARCH: for (Monster mob : mobs.subList(0, Math.min(mobs.size(), 4000)))
+		{
+			final List<Monster> around = World.getVisibleObjectsInRange(mob, Monster.class, 1400);
+			for (int radius : new int[]
+			{
+				250,
+				400
+			})
+			{
+				for (int i = 0; i < 16; i++)
+				{
+					final int x = mob.getX() + (int) (Math.cos(i * Math.PI / 8) * radius);
+					final int y = mob.getY() + (int) (Math.sin(i * Math.PI / 8) * radius);
+					final int z = geo.getHeight(x, y, mob.getZ());
+					if ((Math.abs(z - mob.getZ()) > 150) || geo.canSeeTarget(x, y, z, 0, mob.getX(), mob.getY(), mob.getZ(), 0))
+					{
+						continue;
+					}
+					boolean hidden = true;
+					for (Monster near : around)
+					{
+						if (geo.canSeeTarget(x, y, z, 0, near.getX(), near.getY(), near.getZ(), 0))
+						{
+							hidden = false;
+							break;
+						}
+					}
+					if (!hidden)
+					{
+						continue;
+					}
+					final List<GeoLocation> path = PathFinding.getInstance().findPath(x, y, z, mob.getX(), mob.getY(), mob.getZ(), 0, true);
+					if ((path != null) && (path.size() >= 2) && (path.size() < 12))
+					{
+						place = new Location(x, y, z);
+						target = mob;
+						break SEARCH;
+					}
+				}
+			}
+		}
+		if ((place == null) || (player == null))
+		{
+			check("detour: no place with a hidden monster found among " + mobs.size(), false);
+			return;
+		}
+		park(player, place);
+		note("detour: " + player.getName() + " at " + place + ", monster " + target.getName() + " at " + (int) player.calculateDistance2D(target));
+
+		final Class<?> task = Class.forName("org.l2jmobius.gameserver.taskmanagers.AutoPlayTaskManager$AutoPlay");
+		final Constructor<?> make = task.getDeclaredConstructor(AutoPlayTaskManager.class, Set.class);
+		make.setAccessible(true);
+		final Object autoPlay = make.newInstance(AutoPlayTaskManager.getInstance(), new HashSet<Player>());
+		final Method walk = task.getDeclaredMethod("walkAround", Player.class, int.class);
+		walk.setAccessible(true);
+
+		boolean moved = false;
+		boolean sees = false;
+		for (int i = 0; (i < 30) && !sees; i++)
+		{
+			walk.invoke(autoPlay, player, 1);
+			moved |= player.isMoving();
+			Thread.sleep(700);
+			for (Monster near : World.getVisibleObjectsInRange(player, Monster.class, 900))
+			{
+				if (!near.isDead() && geo.canSeeTarget(player, near))
+				{
+					sees = true;
+					break;
+				}
+			}
+		}
+		check("detour: starts walking around the obstacle", moved);
+		check("detour: a monster in sight after the walk, at " + place + " moved " + (int) player.calculateDistance2D(place), sees);
+		AutoPlayTaskManager.getInstance().stopAutoPlay(player);
+		player.setInvul(false);
+	}
