+		{
+			first = first == null ? each : first;
+			if ((weapon == null) && !each.isActive())
+			{
+				weapon = each;
+			}
+		}
+		if (weapon == null)
+		{
+			note("cursed: both active in the copy, ending " + first.getName());
+			first.endOfLife();
+			weapon = first;
+		}
+		final Field vanish = CursedWeapon.class.getDeclaredField("_disapearChance");
+		vanish.setAccessible(true);
+		check("cursed: never vanishes on death, chance " + vanish.getInt(weapon), vanish.getInt(weapon) == 0);
+		note("cursed: playing " + weapon.getName() + " " + weapon.getItemId());
+
+		final Player killer = crowded();
+		check("cursed: found a place", killer != null);
+		if (killer == null)
+		{
+			return;
+		}
+		check("cursed: dropped by a monster", dropNear(weapon, killer));
+		check("cursed: on the ground for the hunters, " + PhantomCompat.cursedOnGround().size(), PhantomCompat.cursedOnGround().size() == 1);
+
+		final CursedWeapon chased = weapon;
+		int mostSeekers = 0;
+		final long since = System.currentTimeMillis();
+		while (((System.currentTimeMillis() - since) < 200000) && !chased.isActivated())
+		{
+			mostSeekers = Math.max(mostSeekers, seekers());
+			Thread.sleep(500);
+		}
+		// Подобрали раньше первого замера — тоже годится: кто подобрал, проверено ниже.
+		check("cursed: seekers " + mostSeekers + " at most, limit 3", mostSeekers <= 3);
+		check("cursed: picked up in " + ((System.currentTimeMillis() - since) / 1000) + " s", chased.isActivated());
+		final Player holder = chased.getPlayer();
+		if ((holder == null) || !chased.isActivated())
+		{
+			chased.endOfLife();
+			return;
+		}
+		check("cursed: holder " + holder.getName() + " is a hunter", PhantomManager.getInstance().isPhantom(holder));
+		check("cursed: holder armed and transformed", holder.isCursedWeaponEquipped() && holder.isTransformed() && (holder.getActiveWeaponItem() != null) && (holder.getActiveWeaponItem().getId() == chased.getItemId()));
+		check("cursed: other seekers give up, " + seekers(), waitFor(20, () ->
+		{
+			try
+			{
+				return seekers() == 0;
+			}
+			catch (Exception e)
+			{
+				return false;
+			}
+		}));
+
+		// Держит: бьёт мобов, не стоит.
+		holder.setInvul(true);
+		final boolean inPhase = waitFor(15, () -> "CURSED".equals(phase(holder)));
+		check("cursed: holder phase " + phase(holder), inPhase);
+		int fought = 0;
+		int auto = 0;
+		int swings = 0;
+		for (int i = 0; i < 240; i++)
+		{
+			fought += holder.isInCombat() ? 1 : 0;
+			auto += holder.isAutoPlaying() ? 1 : 0;
+			swings += holder.isAttackingNow() ? 1 : 0;
+			Thread.sleep(250);
+		}
+		check("cursed: holder fights, in combat " + fought + " of 240, swinging " + swings + ", autoplay " + auto, (fought > 0) && (swings > 0) && (auto > 0));
+
+		cursedFights(holder);
+
+		// Рестарт сервера: облик возвращается с первого тика.
+		final Object hunter = hunters().get(holder.getName().toLowerCase());
+		final Field held = hunter.getClass().getDeclaredField("cursedHeld");
+		held.setAccessible(true);
+		holder.stopTransformation(true);
+		final boolean bare = !holder.isTransformed();
+		held.setBoolean(hunter, false);
+		check("cursed: form back after a restart, bare " + bare, bare && waitFor(20, holder::isTransformed));
+
+		// Время вышло: оружие ушло, охотник вооружён своим и снова качается.
+		chased.endOfLife();
+		check("cursed: gone at the end of life", !chased.isActive() && !holder.isCursedWeaponEquipped());
+		final boolean rearmed = waitFor(60, () -> (holder.getActiveWeaponItem() != null) && !"CURSED".equals(phase(holder)));
+		check("cursed: back to own weapon, phase " + phase(holder) + ", weapon " + (holder.getActiveWeaponItem() == null ? null : holder.getActiveWeaponItem().getName()), rearmed);
+		holder.setInvul(false);
+
+		// Смерть с оружием: выпало, следующий охотник подбирает.
+		final Player again = crowded();
+		if ((again != null) && dropNear(chased, again))
+		{
+			check("cursed: second pick up", waitFor(200, chased::isActivated));
+			final Player second = chased.getPlayer();
+			if (second != null)
+			{
+				second.setInvul(false);
+				final Monster killedBy = World.getNearestVisibleObjectInRange(second, Monster.class, 2000, near -> !near.isDead());
+				second.doDie(killedBy != null ? killedBy : second);
