+	private static void roles(List<Player> spare) throws Exception
+	{
+		final Method group = PhantomBufferSets.class.getDeclaredMethod("classGroup", Player.class);
+		group.setAccessible(true);
+		final Set<String> seen = new HashSet<>();
+		for (Player player : spare)
+		{
+			final String name = (String) group.invoke(null, player);
+			if (seen.add(name))
+			{
+				final int size = SchemeBufferTable.getInstance().getSkillsIdsByType(name).size();
+				check("roles: " + player.getName() + " " + player.getPlayerClass() + " gets " + name + " of " + size, name.startsWith("ROLE_") && name.equals("ROLE_" + PhantomBufferSets.classRole(player) + "_GROUP") && (size > 32));
+			}
+		}
+		check("roles: all six seen, " + seen, seen.size() == 6);
+
+		final Player player = pick(spare, p -> p.getLevel() >= 20);
+		park(player, GIRAN);
+		player.stopAllEffects();
+		final Method buff = PhantomHunterManager.class.getDeclaredMethod("buff", Player.class);
+		buff.setAccessible(true);
+		buff.invoke(null, player);
+		final int effects = player.getEffectList().getBuffCount() + player.getEffectList().getDanceCount();
+		check("roles: hunter wears " + effects + " buffs and dances after buff, was 32 at most", effects > 32);
+	}
