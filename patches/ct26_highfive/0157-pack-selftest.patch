+		final int mp = (int) ((victim.getCurrentMp() * 100) / victim.getMaxMp());
+		final int cp = (int) ((victim.getCurrentCp() * 100) / victim.getMaxCp());
+		check(name + ": revived with HP " + hp + "%, MP " + mp + "%, CP " + cp + "%", up && (hp >= 90) && (mp >= 90) && (cp >= 90));
+	}
