+	private static void healer(List<Player> spare) throws Exception
+	{
+		final int configured = PhantomHuntersConfig.HUNTER_PARTY_CHANCE_HEALER;
+		check("healer: chance on High Five " + configured, configured == 90);
+		Player found = null;
+		for (int i = 0; (i < 40) && (found == null); i++)
+		{
+			found = hunting(spare, p -> healerRole(p) && (spare.stream().filter(o -> !healerRole(o) && (Math.abs(o.getLevel() - p.getLevel()) <= 5)).count() >= 3));
+			if (found == null)
+			{
+				Thread.sleep(3000);
+			}
+		}
+		if (found == null)
+		{
+			note("healer: no healer on a spot with three free hunters of his level");
+			return;
+		}
+
+		final Player healer = found;
+		final PhantomTemplate template = PhantomData.getInstance().getTemplate(healer.getName());
+		final PhantomHunterParty parties = PhantomHunterParty.getInstance();
+		PhantomHuntersConfig.HUNTER_PARTY_CHANCE_HEALER = 100;
+		try
+		{
+			// Издалека: приходит сам, ведёт второй, хилер лечит.
+			partyForget();
+			final Method seek = PhantomHunterParty.class.getDeclaredMethod("seek", Player.class, long.class);
+			seek.setAccessible(true);
+			final boolean joined = (boolean) seek.invoke(parties, healer, System.currentTimeMillis());
+			check("healer: " + healer.getName() + " " + healer.getPlayerClass() + " (" + healer.getLevel() + ") joins from afar", joined && healer.isInParty());
+			if (!healer.isInParty())
+			{
+				return;
+			}
+			final Player far = healer.getParty().getLeader();
+			check("healer: " + far.getName() + " (" + far.getLevel() + ") leads, not the healer", (far != healer) && parties.isLeader(far) && !parties.isLeader(healer));
+			check("healer: phase " + phase(healer) + ", mode " + companionMode(template), "PARTY".equals(phase(healer)) && (companionMode(template) == PhantomCompanionManager.Mode.ASSIST));
+			final boolean came = waitFor(30, () -> healer.calculateDistance2D(far) <= 1500);
+			check("healer: came to the leader, distance " + (int) healer.calculateDistance2D(far), came);
+
+			// Отдых после пати: у хилера короче.
+			final long at = System.currentTimeMillis();
+			parties.check(far, false, at);
+			final long healerRest = (long) partyMemory("_restUntil").get(healer.getObjectId()) - at;
+			final long leaderRest = (long) partyMemory("_restUntil").get(far.getObjectId()) - at;
+			check("healer: rest after the party, healer " + healerRest + ", leader " + leaderRest, (healerRest == 300000) && (leaderRest == 1200000));
+
+			// Рядом: тик сам ведёт его к соседу, а не собирает свою пати.
+			final boolean back = waitFor(90, () -> !healer.isInParty() && "HUNT".equals(phase(healer)));
+			check("healer: back to hunting, phase " + phase(healer), back);
+			final Player near = hunting(spare, p -> !healerRole(p) && (Math.abs(p.getLevel() - healer.getLevel()) <= 5));
+			if (!back || (near == null))
+			{
+				note("healer: no free hunter for the neighbour step");
+				return;
+			}
+			healer.teleToLocation(new Location(near.getX() + 50, near.getY(), near.getZ()));
+			Thread.sleep(1500);
+			partyForget();
+			final boolean ticked = parties.tick(healer, template, System.currentTimeMillis());
+			final Player neighbour = healer.isInParty() ? healer.getParty().getLeader() : null;
+			check("healer: goes to the neighbour, tick " + ticked + ", leader " + (neighbour == null ? "none" : neighbour.getName()), ticked && (neighbour != null) && (neighbour != healer));
+			if (neighbour != null)
+			{
+				parties.check(neighbour, false, System.currentTimeMillis());
+			}
+
+			// Лидер пати без хилера с местом берёт его третьим.
+			final boolean again = waitFor(90, () -> !healer.isInParty() && "HUNT".equals(phase(healer)));
+			final Player lead = hunting(spare, p -> !healerRole(p) && (Math.abs(p.getLevel() - healer.getLevel()) <= 5));
+			final Player second = lead == null ? null : hunting(spare, p -> !healerRole(p) && (Math.abs(p.getLevel() - lead.getLevel()) <= 5));
+			if (!again || (second == null))
+			{
+				note("healer: no free pair for the third step");
+				return;
+			}
+			partyForget();
+			final String refused = parties.ask(lead, second, true, System.currentTimeMillis());
+			check("healer: a party without a healer, " + lead.getName() + " and " + second.getName() + ", refused " + refused, (refused == null) && parties.isLeader(lead));
+			healer.teleToLocation(new Location(lead.getX() + 50, lead.getY(), lead.getZ()));
+			Thread.sleep(1500);
+			partyForget();
+			parties.tick(healer, template, System.currentTimeMillis());
+			check("healer: joins that party as the third, members " + (lead.isInParty() ? lead.getParty().getMemberCount() : 0), lead.isInParty() && (healer.getParty() == lead.getParty()));
+			parties.check(lead, false, System.currentTimeMillis());
+		}
+		finally
+		{
+			PhantomHuntersConfig.HUNTER_PARTY_CHANCE_HEALER = configured;
+		}
+	}
