+		final long adena = player.getAdena() - before[1];
+		final long exp = player.getExp() - before[2];
+		final long armor = count(player, L2HubPvpEvents.rewardScroll(level, false)) - before[3];
+		final long weapon = count(player, L2HubPvpEvents.rewardScroll(level, true)) - before[4];
+		final long wantAdena = L2HubPvpEvents.rewardAdena(level, minutes, won);
+		final long wantExp = live ? L2HubPvpEvents.rewardExp(level, minutes, won) : 0;
+		check(who + " (" + level + ") adena +" + adena + ", wanted " + wantAdena + (won ? " and the prize" : ""), won ? adena > wantAdena || (!live && (adena == wantAdena)) : adena == wantAdena);
+		check(who + " exp +" + exp + ", wanted " + wantExp, Math.abs(exp - wantExp) <= 1);
+		final int wantScrolls = live && won ? 1 : 0;
