+	/** Охотник на каче вдали от чужих рук: туда зовём в пати. */
+	private static Player hunting(List<Player> spare, Predicate<Player> test) throws Exception
+	{
+		final Map<?, ?> map = hunters();
+		for (Player player : spare)
+		{
+			final Object hunter = map.get(player.getName().toLowerCase());
+			if ((hunter != null) && test.test(player) && "HUNT".equals(String.valueOf(hunterField(hunter, "phase"))) && (hunterField(hunter, "spot") != null) && ((int) hunterField(hunter, "enemyId") == 0) && !player.isInsideZone(ZoneId.PEACE))
+			{
+				spare.remove(player);
+				return player;
+			}
+		}
+		return null;
+	}
