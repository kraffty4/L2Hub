+		check("taunt on: the mob goes for the tank after the aura", waitFor(5, () -> mob.getAI().getAttackTarget() == tank));
+
+		mob.clearAggroList();
+		mob.getAI().setIntentionActive();
+		tank.setInvul(true);
+		victim.setInvul(true);
