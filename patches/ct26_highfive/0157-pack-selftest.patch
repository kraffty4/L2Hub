+	private static void matching(List<Player> spare) throws Exception
+	{
+		final Quest script = ScriptManager.getInstance().getScript("TvT");
+		check("matching: TvT idle before the test, " + status(script)[0], status(script)[0].equals("INACTIVE"));
+		final Player far = fighter(spare, 60);
