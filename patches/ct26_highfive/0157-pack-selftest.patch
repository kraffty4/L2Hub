+		try
+		{
+			// Как в оригинале.
+			NpcConfig.TAUNT_TAKES_TOP_HATE = false;
+			final boolean offCast = provoke(tank, victim, aggression, mob);
+			final long offHate = mob.getHating(tank);
+			check("taunt off: as in the original the cast only adds its points, cast " + offCast + ", hate " + offHate, offCast && (offHate >= aggressionPoints) && (offHate <= (aggressionPoints + 400)));
+			check("taunt off: the mob goes back to the one with more hate", waitFor(5, () -> mob.getAI().getAttackTarget() == victim));
+		}
+		finally
+		{
+			NpcConfig.TAUNT_TAKES_TOP_HATE = true;
+		}
+
+		// С ключом: снимается с первого раза и остаётся.
+		Thread.sleep(7000);
+		final boolean onCast = provoke(tank, victim, aggression, mob);
+		final long onHate = mob.getHating(tank);
+		check("taunt on: the cast takes the top and adds its points, cast " + onCast + ", hate " + onHate + " against " + mob.getHating(victim), onCast && (onHate >= ((mob.getHating(victim) + aggressionPoints) - 500)));
