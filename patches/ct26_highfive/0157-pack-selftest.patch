+
+		final Field fight = script.getClass().getDeclaredField("FIGHT_TIME");
+		fight.setAccessible(true);
+		final int minutes = fight.getInt(null);
+		final Map<Player, Integer> scores = (Map<Player, Integer>) scriptField(script, "PLAYER_SCORES");
+		final boolean teams = !"Deathmatch".equals(name);
+		final Player winner;
+		final Player loser;
+		final Player winnerHunter;
+		final Player loserHunter;
+		if (teams)
+		{
+			final List<Player> blue = team(script, "BLUE_TEAM");
+			final List<Player> red = team(script, "RED_TEAM");
