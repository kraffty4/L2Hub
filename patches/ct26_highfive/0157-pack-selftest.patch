+	/** Охотник для ивента: стоит в Гиране, снят с охоты, нужного уровня, записаться ему ничто не мешает. */
+	private static Player fighter(List<Player> spare, int level) throws Exception
+	{
+		while (true)
+		{
+			final Player player = pick(spare, p -> (p.getWeightPenalty() == 0) && !p.isInParty() && !p.isDead() && !p.isRegisteredOnEvent() && !p.isOnEvent() && !p.isTransformed() && !p.isCursedWeaponEquipped());
+			if (player == null)
+			{
+				throw new IllegalStateException("no hunter left for the event");
+			}
+			park(player, GIRAN);
+			player.setInvul(false);
+			player.getStat().addLevel((byte) (level - player.getLevel()));
+			if ((player.getLevel() == level) && (player.getWeightPenalty() == 0))
+			{
+				return player;
+			}
+		}
+	}
