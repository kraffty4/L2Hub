+	private static void companion(List<Player> spare) throws Exception
+	{
+		final Player owner = pick(spare, p -> p.getLevel() >= 40);
+		if (owner == null)
+		{
+			check("companion: no owner", false);
+			return;
+		}
+		// Вне города: в мирной зоне автобанка не пьёт.
+		final Player scout = hunting(new ArrayList<>(spare), p -> true);
+		park(owner, scout != null ? new Location(scout.getX(), scout.getY(), scout.getZ()) : owner.getLocation());
+		final PhantomCompanionManager manager = PhantomCompanionManager.getInstance();
+		PhantomTemplate template = null;
+		for (PhantomTemplate candidate : PhantomData.getInstance().getCompanions())
+		{
+			if ((candidate.getRole() == PhantomTemplate.Role.HEALER) && !manager.isCompanion(candidate))
+			{
+				template = candidate;
+				break;
+			}
+		}
+		if (template == null)
+		{
+			check("companion: no free healer", false);
+			return;
+		}
+		final String refused = manager.summon(owner, template);
+		final Player phantom = PhantomManager.getInstance().getPhantom(template);
+		check("companion: " + template.getName() + " summoned, " + refused, (refused == null) && (phantom != null));
+		if (phantom == null)
+		{
+			return;
+		}
+		final Player healer = phantom;
+		healer.setInvul(true);
+		final boolean supplied = waitFor(40, () -> (healer.getAutoUseSettings().getAutoManaItem() > 0) && (mana(healer) > 0) && (healer.getAutoUseSettings().getAutoPotionItem() > 0));
+		check("companion: slots " + healer.getAutoUseSettings().getAutoPotionItem() + " and " + healer.getAutoUseSettings().getAutoManaItem() + ", potions " + mana(healer), supplied);
+		final int stock = mana(healer);
+		healer.setCurrentMp(healer.getMaxMp() * 0.1);
+		final boolean drank = waitFor(25, () -> mana(healer) < stock);
+		check("companion: drinks at 10 % MP, potions " + stock + " → " + mana(healer) + ", peace " + healer.isInsideZone(ZoneId.PEACE), drank);
+		healer.setInvul(false);
+		owner.setInvul(false);
+		manager.release(template, true);
+	}
