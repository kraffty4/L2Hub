+			});
+			final String russianWeapons = (String) shop.invoke(null, shopper, new String[]
+			{
+				"_bbshubshop",
+				"1"
+			});
+			shopper.setLang(language);
+			check("shop: pages follow the character's language", english.contains("value=\"Weapons\"") && russian.contains("value=\"Оружие\"") && russianWeapons.contains("value=\"Без грейда\""));
+			check("shop: language button on both main pages", english.contains("bypass voice .lang") && russian.contains("bypass voice .lang"));
 		}
 
 		final Map<String, Predicate<Player>> roles = new java.util.LinkedHashMap<>();
