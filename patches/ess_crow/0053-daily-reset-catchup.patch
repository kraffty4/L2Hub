+	/**
+	 * L2Hub (малый мир): был ли между прошлым сбросом и сейчас сброс в 6:30 нужного дня (среда, 1-е число), который сервер проспал.
+	 * Минута запаса — чтобы сброс, записанный на секунду раньше 6:30, не считался пропущенным.
+	 * @param previousReset время прошлого сброса (0 — сброса ещё не было)
+	 * @param field поле Calendar (DAY_OF_WEEK, DAY_OF_MONTH)
+	 * @param value его значение
+	 * @return пропущен
+	 */
+	private static boolean missed(long previousReset, int field, int value)
+	{
+		final long now = System.currentTimeMillis();
+		final Calendar day = Calendar.getInstance();
+		day.set(Calendar.HOUR_OF_DAY, 6);
+		day.set(Calendar.MINUTE, 30);
+		day.set(Calendar.SECOND, 0);
+		day.set(Calendar.MILLISECOND, 0);
+		for (int i = 0; (i < 400) && (day.getTimeInMillis() > (previousReset + 60000)); i++)
+		{
+			if ((day.getTimeInMillis() <= (now + 60000)) && (day.get(field) == value))
+			{
+				return true;
+			}
+			day.add(Calendar.DAY_OF_MONTH, -1);
+		}
+		return false;
+	}
+	
+	/**
+	 * L2Hub (малый мир): сколько сбросов в 6:30 прошло с прошлого сброса (этот — тоже; минимум один).
+	 * @param previousReset время прошлого сброса
+	 * @return число дней, от 1 до 400
+	 */
+	private static int missedDays(long previousReset)
+	{
+		final long now = System.currentTimeMillis();
+		final Calendar day = Calendar.getInstance();
+		day.set(Calendar.HOUR_OF_DAY, 6);
+		day.set(Calendar.MINUTE, 30);
+		day.set(Calendar.SECOND, 0);
+		day.set(Calendar.MILLISECOND, 0);
+		int days = 0;
+		for (int i = 0; (i < 400) && (day.getTimeInMillis() > (previousReset + 60000)); i++)
+		{
+			if (day.getTimeInMillis() <= (now + 60000))
+			{
+				days++;
+			}
+			day.add(Calendar.DAY_OF_MONTH, -1);
+		}
+		return Math.max(1, days);
+	}
