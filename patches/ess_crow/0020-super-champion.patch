diff --git a/java/org/l2jmobius/gameserver/entity/actor/SuperChampion.java b/java/org/l2jmobius/gameserver/entity/actor/SuperChampion.java
new file mode 100644
index 0000000..aa2e179
--- /dev/null
+++ b/java/org/l2jmobius/gameserver/entity/actor/SuperChampion.java
@@ -0,0 +1,164 @@
+/*
