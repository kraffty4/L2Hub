+<?xml version="1.0" encoding="UTF-8"?>
+<!-- L2Hub: заготовки реплик фейков в городах (скрипт custom/L2HubTownFakes, генератор tools/l2hub_town_fakes.py).
+     Язык — L2HubLanguage из config/Custom/L2HubWorld.ini (ru или en; нет английской строки — русская).
+     С мозгами фейков (FakePlayerBrain) заготовка — только подсказка тона, реплику пишет модель (кроме arrive, leave и trade.* — они всегда заготовкой).
+     Ключи: idle.<роль>[.day|.evening|.night] — болтовня в общий чат; idle.seasonal — пока идёт сезонное событие;
+     trade.<роль> — объявления в торговый чат (lfp — в крик); event.<вид> — реакции на события мира; arrive и leave — пришёл и ушёл.
+     Переменные: {town} — город, {in} — «в городе», {where} — где стоит, {store} — вывеска лавки, {cls} — класс, {level} — уровень;
+     в событиях — {boss}, {blevel}, {place} (у какого города), {leader}, {event}, {text}. -->
+<list>
+	<!-- Где стоит фейк (near у места в data/L2HubTownFakes.xml). -->
+	<word key="near.gk" ru="у ГК" en="by the GK" />
+	<word key="near.wh" ru="у склада" en="by the warehouse" />
+	<word key="near.shop" ru="у лавок" en="by the shops" />
+	<word key="near.master" ru="у гильдии" en="by the guild" />
+	<word key="near.oly" ru="у олимпиады" en="by the Olympiad" />
+	<word key="near.fish" ru="у рыбаков" en="by the fishermen" />
+	<!-- Сезонные события (имя скрипта LongTimeEvent); нет в списке — имя скрипта как есть. -->
+	<word key="event.L2Day" ru="День Lineage" en="L2 Day" />
+	<word key="event.HeavyMedal" ru="медальки" en="Medal event" />
+	<word key="event.Christmas" ru="Рождество" en="Christmas" />
+	<word key="event.SavingSanta" ru="Спасение Санты" en="Saving Santa" />
+	<word key="event.FreyaCelebration" ru="праздник Фреи" en="Freya Celebration" />
+	<word key="event.GiftOfVitality" ru="Дар Виталити" en="Gift of Vitality" />
+	<word key="event.LoveYourGatekeeper" ru="Люби своего ГК" en="Love Your Gatekeeper" />
+	<word key="event.MasterOfEnchanting" ru="Мастер заточки" en="Master of Enchanting" />
+	<word key="event.TheValentineEvent" ru="День святого Валентина" en="Valentine event" />
+	<word key="event.WatermelonNinja" ru="арбузы" en="Watermelon event" />
+	<word key="event.SquashEvent" ru="тыквы" en="Squash event" />
+	<word key="event.MerrySquashmas" ru="новогодние тыквы" en="Merry Squashmas" />
+	<word key="event.ChefMonkeyEvent" ru="Шеф-обезьяна" en="Chef Monkey" />
+	<word key="event.EveTheFortuneTeller" ru="гадалка Ева" en="Eve the Fortune Teller" />
+	<word key="event.HappyHours" ru="счастливые часы" en="Happy Hours" />
+	<word key="event.LetterCollector" ru="сбор букв" en="Letter Collector" />
+	<word key="event.ThePowerOfLove" ru="Сила любви" en="The Power of Love" />
+	<word key="event.TotalRecall" ru="Тотал Рекол" en="Total Recall" />
+
+	<!-- ===== Болтовня в общий чат ===== -->
+	<lines key="idle.talker">
+		<line ru="кто знает, где сейчас лучше качаться на мой лвл?" en="anyone knows a good spot for my level?" />
+		<line ru="дроп сегодня никакой, третий час ни одной рецы" en="drop is dead today, no recipes for hours" />
+		<line ru="раньше народу было больше, эх" en="server used to be busier, eh" />
+		<line ru="кто вечером на РБ? я бы сходил" en="anyone up for a raid boss tonight?" />
+		<line ru="рейты норм, но адена улетает как вода" en="rates are fine but adena just evaporates" />
+		<line ru="опять сс кончились, пойду фармить на сосы" en="out of soulshots again, back to farming for them" />
+		<line ru="кто видел, где суперчемпы вылезают? хочу посмотреть" en="where do super champions show up? wanna see one" />
+		<line ru="этот ГК дерёт за телепорт как за крыло" en="this GK charges way too much for teleports" />
+		<line ru="кто-нибудь знает, сколько сейчас стоит заточка на оружие?" en="anyone knows the price of weapon enchant scrolls now?" />
+		<line ru="у меня сегодня всё точится в ноль, не мой день" en="every enchant fails today, not my day" />
+		<line ru="а охотники тут вообще адекватные? один меня чуть не слил" en="are the hunters here sane? one almost killed me" />
+		<line ru="скоро профа, коплю на квест" en="almost at my next class, saving for the quest" />
+	</lines>
+	<lines key="idle.talker.evening">
+		<line ru="вечер, народ подтягивается, может пати соберём?" en="evening, people are coming, party anyone?" />
+		<line ru="кто сегодня что выбил? хвастайтесь" en="what did you all drop today? show off" />
+		<line ru="ещё пару часов покачаюсь и спать" en="couple more hours of grinding and bed" />
+	</lines>
+	<lines key="idle.talker.night">
+		<line ru="ночью тут тихо, даже ГК скучает" en="so quiet at night, even the GK is bored" />
+		<line ru="кто не спит — отзовитесь" en="anyone still awake?" />
+	</lines>
+	<lines key="idle.newbie">
+		<line ru="подскажите, где тут склад?" en="where is the warehouse here?" />
+		<line ru="а квест на первую профу где берут?" en="where do I get the first class quest?" />
+		<line ru="всем привет, я первый день тут)" en="hi all, my first day here :)" />
+		<line ru="а гейткипер бесплатно телепортит новичков?" en="does the GK teleport newbies for free?" />
+		<line ru="кто даст немного адены на сс? ну пожалуйста)" en="can someone spare some adena for soulshots? pls :)" />
+		<line ru="а где тут нормальные мобы на мой лвл?" en="where are good mobs for my level?" />
+		<line ru="как сделать, чтобы сосы сами заряжались?" en="how do I make soulshots auto-use?" />
+		<line ru="я заблудился, где магазин с бронёй?" en="i'm lost, where is the armor shop?" />
+		<line ru="а что выгоднее качать, воина или мага?" en="what's better to level, fighter or mage?" />
+		<line ru="ого, а кто это там в топовом шмоте стоит?" en="whoa, who's that guy in top gear?" />
+	</lines>
+	<lines key="idle.lfp">
+		<line ru="{cls} {level} ищу пати, кто качается?" en="{cls} {level} lf party, anyone leveling?" />
+		<line ru="соло скучно, возьмите в пати" en="solo is boring, take me in a party" />
+		<line ru="может кто-то тоже ищет пати {in}?" en="anyone else looking for a party {in}?" />
+	</lines>
+	<lines key="idle.runner">
+		<line ru="фух, только с фарма, сумка битком" en="phew, back from farming, bag is full" />
+		<line ru="сс докуплю и обратно на спот" en="buying shots and back to my spot" />
+		<line ru="кто-нибудь продаёт хп банки подешевле?" en="anyone selling HP potions cheap?" />
+		<line ru="бегу-бегу, не до разговоров" en="running, no time to chat" />
+		<line ru="опять перегруз, всё на склад" en="overweight again, everything to the warehouse" />
+	</lines>
+	<lines key="idle.showoff">
+		<line ru="+16 и не жалею" en="+16 and no regrets" />
+		<line ru="кто на дуэль? ну давайте, не бойтесь" en="anyone up for a duel? come on, don't be scared" />
+		<line ru="опять заточка удалась, кто завидует — молча" en="another successful enchant, envy in silence" />
+		<line ru="как вам мой сет? полгода на него фармил" en="how's my set? farmed it for half a year" />
+		<line ru="олимпиада — для слабаков, я просто красивый" en="olympiad is for the weak, i'm just pretty" />
+		<line ru="автограф не даю, проходим" en="no autographs, move along" />
+	</lines>
+	<lines key="idle.stroller">
+		<line ru="красиво тут, люблю {town}" en="it's pretty here, i love {town}" />
+		<line ru="музыка в этом городе лучшая" en="this town has the best music" />
+		<line ru="погуляю ещё немного и на фарм" en="a little walk and then back to farming" />
+		<line ru="кто-нибудь видел котика у склада? он был тут" en="anyone seen a cat by the warehouse? it was here" />
+	</lines>
+	<lines key="idle.stroller.evening">
+		<line ru="закат тут просто огонь" en="the sunset here is amazing" />
+		<line ru="вечером {town} совсем другой" en="{town} feels different in the evening" />
+	</lines>
+	<lines key="idle.nightowl">
+		<line ru="ночью мобы злее, а дроп тот же))" en="mobs are meaner at night, same drop lol" />
+		<line ru="кто не спит? я вот не сплю" en="who's awake? i am" />
