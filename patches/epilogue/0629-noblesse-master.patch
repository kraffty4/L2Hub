+					spawn.setHeading(buffer.getHeading());
+					spawn.setAmount(1);
+					spawn.setRespawnDelay(60);
+					SpawnTable.getInstance().addSpawn(spawn);
+					spawn.init();
+					placed++;
+				}
+				catch (Exception e)
+				{
+					LOGGER.warning("L2HubTown: мастер дворянства не поставлен у " + x + ", " + y + ": " + e.getMessage());
