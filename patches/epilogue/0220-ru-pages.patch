index 0000000000000000000000000000000000000000..eacc36c2dad86c5a3f6150e26f758e4c003a74a3
--- /dev/null
+++ b/dist/game/data/lang/ru/data/scripts/quests/Q00131_BirdInACage/32264-19.html
@@ -0,0 +1,14 @@
+<html><body>Жрец Канис:<br>
+А, пресловутый Демон Белет... Так сообщает Шаманка в письме.<br>
+Она пишет, что ее вскоре должны были перевезти в твердыню Белета на Острове Хеллбаунд.<br>
+Вы спасли ее в самый последний момент!<br>
+Все могло обернуться еще худшей катастрофой...<br>
+Впрочем, судя по всему, туда увезли и нескольких других из Оракула, в том числе нескольких жрецов высокого уровня с ослабленной силой Водяного Дракона.<br>
+Когда будет созвана Эльфийская армия Иннадрила, ей, вероятно, придется провести крупную операцию по спасению.<br>
+Шаманка смогла хотя бы в общих чертах описать предполагаемое местонахождение твердыни Белета.<br>
+Теперь мне нужно заняться многими делами.<br>
+О, это одно из сокровищ Оракула - Шаманка поручила мне передать его вам с ее благодарностью.<br>
+Поговорите со мной, если вас интересует твердыня Белета на Острове Хеллбаунд...<br>
+Еще раз спасибо за всю вашу помощь.<br>
+Я буду молиться, чтобы божественные благословения пролились на ваш путь.
+</body></html>
\ No newline at end of file
diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00131_BirdInACage/32271-01.html b/dist/game/data/lang/ru/data/scripts/quests/Q00131_BirdInACage/32271-01.html
