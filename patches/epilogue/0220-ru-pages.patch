diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00046_OnceMoreInTheArmsOfTheMotherTree/30116-02.html b/dist/game/data/lang/ru/data/scripts/quests/Q00046_OnceMoreInTheArmsOfTheMotherTree/30116-02.html
