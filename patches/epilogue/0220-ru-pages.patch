diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00048_ToTheImmortalPlateau/30116-01.html b/dist/game/data/lang/ru/data/scripts/quests/Q00048_ToTheImmortalPlateau/30116-01.html
