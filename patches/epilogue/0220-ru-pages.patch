diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q10271_TheEnvelopingDarkness/32556-09.html b/dist/game/data/lang/ru/data/scripts/quests/Q10271_TheEnvelopingDarkness/32556-09.html
