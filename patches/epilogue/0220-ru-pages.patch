+</body></html>
\ No newline at end of file
diff --git a/dist/game/data/lang/ru/data/scripts/village_master/OrcChange1/32097-02.htm b/dist/game/data/lang/ru/data/scripts/village_master/OrcChange1/32097-02.htm
