@@ -0,0 +1,2 @@
+<html><body>Tablet of Vision:<br>
+Скрижаль - всего лишь обычный камень. Возвращайтесь к Главе Гильдии Охотников Бернарду.</body></html>
\ No newline at end of file
diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00084_SagaOfTheGhostSentinel/11-01.htm b/dist/game/data/lang/ru/data/scripts/quests/Q00084_SagaOfTheGhostSentinel/11-01.htm
new file mode 100644
