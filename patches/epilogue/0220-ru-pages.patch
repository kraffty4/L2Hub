+</body></html>
\ No newline at end of file
diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00194_SevenSignsMammonsContract/32572-01.html b/dist/game/data/lang/ru/data/scripts/quests/Q00194_SevenSignsMammonsContract/32572-01.html
