diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00070_SagaOfThePhoenixKnight/0-01.htm b/dist/game/data/lang/ru/data/scripts/quests/Q00070_SagaOfThePhoenixKnight/0-01.htm
