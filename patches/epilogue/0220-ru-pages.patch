diff --git a/dist/game/data/lang/ru/data/scripts/ai/areas/Gracia/AI/NPC/Lekon/32557-01.html b/dist/game/data/lang/ru/data/scripts/ai/areas/Gracia/AI/NPC/Lekon/32557-01.html
