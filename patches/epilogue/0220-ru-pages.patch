diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00611_AllianceWithVarkaSilenos/31378-24.html b/dist/game/data/lang/ru/data/scripts/quests/Q00611_AllianceWithVarkaSilenos/31378-24.html
