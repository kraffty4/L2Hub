diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00335_TheSongOfTheHunter/30744-10b.html b/dist/game/data/lang/ru/data/scripts/quests/Q00335_TheSongOfTheHunter/30744-10b.html
