\ No newline at end of file
diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00080_SagaOfTheWindRider/0-010.htm b/dist/game/data/lang/ru/data/scripts/quests/Q00080_SagaOfTheWindRider/0-010.htm
