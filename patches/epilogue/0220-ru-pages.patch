diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00194_SevenSignsMammonsContract/32573-06.html b/dist/game/data/lang/ru/data/scripts/quests/Q00194_SevenSignsMammonsContract/32573-06.html
