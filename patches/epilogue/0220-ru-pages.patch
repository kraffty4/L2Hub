diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00357_WarehouseKeepersAmbition/30686-09.html b/dist/game/data/lang/ru/data/scripts/quests/Q00357_WarehouseKeepersAmbition/30686-09.html
