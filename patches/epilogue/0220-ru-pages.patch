diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00708_PathToBecomingALordGludio/35100-00a.html b/dist/game/data/lang/ru/data/scripts/quests/Q00708_PathToBecomingALordGludio/35100-00a.html
