diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00614_SlayTheEnemyCommanderVarka/31377-02.htm b/dist/game/data/lang/ru/data/scripts/quests/Q00614_SlayTheEnemyCommanderVarka/31377-02.htm
