diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00098_SagaOfTheShillienSaint/5-02.htm b/dist/game/data/lang/ru/data/scripts/quests/Q00098_SagaOfTheShillienSaint/5-02.htm
