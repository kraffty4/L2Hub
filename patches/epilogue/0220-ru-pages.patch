diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00123_TheLeaderAndTheFollower/31961-03.htm b/dist/game/data/lang/ru/data/scripts/quests/Q00123_TheLeaderAndTheFollower/31961-03.htm
