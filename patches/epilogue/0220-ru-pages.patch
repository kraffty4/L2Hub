\ No newline at end of file
diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00065_CertifiedSoulBreaker/32138-03.html b/dist/game/data/lang/ru/data/scripts/quests/Q00065_CertifiedSoulBreaker/32138-03.html
