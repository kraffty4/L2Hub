+<a action="bypass Script Q00175_TheWayOfTheWarrior 32138-13.html">Показать ему когти.</a>
+</body></html>
\ No newline at end of file
diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00175_TheWayOfTheWarrior/32138-13.html b/dist/game/data/lang/ru/data/scripts/quests/Q00175_TheWayOfTheWarrior/32138-13.html
