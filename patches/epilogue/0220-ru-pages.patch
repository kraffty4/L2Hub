@@ -0,0 +1,3 @@
+<html><body>Боевой Маг Артиус:<br>
+(Вы уже выполнили этот квест.)
+</body></html>
diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q10272_LightFragment/32560-01.htm b/dist/game/data/lang/ru/data/scripts/quests/Q10272_LightFragment/32560-01.htm
