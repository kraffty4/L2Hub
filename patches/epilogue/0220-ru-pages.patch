diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00071_SagaOfEvasTemplar/0-02.htm b/dist/game/data/lang/ru/data/scripts/quests/Q00071_SagaOfEvasTemplar/0-02.htm
