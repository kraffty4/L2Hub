diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00503_PursuitOfClanAmbition/30760-03.html b/dist/game/data/lang/ru/data/scripts/quests/Q00503_PursuitOfClanAmbition/30760-03.html
