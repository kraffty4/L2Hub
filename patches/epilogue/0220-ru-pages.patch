\ No newline at end of file
diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00037_MakeFormalWear/31627-02.html b/dist/game/data/lang/ru/data/scripts/quests/Q00037_MakeFormalWear/31627-02.html
