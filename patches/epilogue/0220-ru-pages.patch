@@ -0,0 +1,3 @@
+<html><body>Tablet of Vision:<br>
+Приближаясь, вы ощущаете чье-то присутствие.<br>
+Это не ваш бой.</body></html>
\ No newline at end of file
diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00076_SagaOfTheGrandKhavatari/10-05.htm b/dist/game/data/lang/ru/data/scripts/quests/Q00076_SagaOfTheGrandKhavatari/10-05.htm
