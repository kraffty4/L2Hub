diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00625_TheFinestIngredientsPart2/31521-04.htm b/dist/game/data/lang/ru/data/scripts/quests/Q00625_TheFinestIngredientsPart2/31521-04.htm
