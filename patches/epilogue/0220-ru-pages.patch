diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00095_SagaOfTheHellKnight/2-01.htm b/dist/game/data/lang/ru/data/scripts/quests/Q00095_SagaOfTheHellKnight/2-01.htm
