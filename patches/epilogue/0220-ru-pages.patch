diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00030_ChestCaughtWithABaitOfFire/30629-01.htm b/dist/game/data/lang/ru/data/scripts/quests/Q00030_ChestCaughtWithABaitOfFire/30629-01.htm
