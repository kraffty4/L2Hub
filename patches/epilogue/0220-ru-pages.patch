+</body></html>
\ No newline at end of file
diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00615_MagicalPowerOfFirePart1/31379-01.html b/dist/game/data/lang/ru/data/scripts/quests/Q00615_MagicalPowerOfFirePart1/31379-01.html
