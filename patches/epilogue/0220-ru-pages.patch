diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00116_BeyondTheHillsOfWinter/30535-01.htm b/dist/game/data/lang/ru/data/scripts/quests/Q00116_BeyondTheHillsOfWinter/30535-01.htm
