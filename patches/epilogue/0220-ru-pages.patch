@@ -0,0 +1,4 @@
+<html><body>Таинственный Волшебник:<br>
+О чем вы?<br>
+<a action="bypass Script Q00024_InhabitantsOfTheForestOfTheDead 31522-03.html">"Взгляните на это!"</a>
+</body></html>
\ No newline at end of file
diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00024_InhabitantsOfTheForestOfTheDead/31522-03.html b/dist/game/data/lang/ru/data/scripts/quests/Q00024_InhabitantsOfTheForestOfTheDead/31522-03.html
new file mode 100644
index 0000000000000000000000000000000000000000..f7b1f9a39eebf53bea072e119f42264526318e05
