+</body></html>
\ No newline at end of file
diff --git a/dist/game/data/lang/ru/data/scripts/ai/areas/Hellbound/AI/NPC/Hude/32298-04b.htm b/dist/game/data/lang/ru/data/scripts/ai/areas/Hellbound/AI/NPC/Hude/32298-04b.htm
