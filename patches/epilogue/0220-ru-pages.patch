\ No newline at end of file
diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00336_CoinsOfMagic/30200-52.html b/dist/game/data/lang/ru/data/scripts/quests/Q00336_CoinsOfMagic/30200-52.html
new file mode 100644
