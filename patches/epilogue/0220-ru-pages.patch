@@ -0,0 +1,3 @@
+<html><body>Вождь Энку Кепра:<br>
+Я никогда не сдамся! Моя стража порежет тебя на ленты! Посмотрим, из чего ты сделан!
+</body></html>
\ No newline at end of file
diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00220_TestimonyOfGlory/30616-06.html b/dist/game/data/lang/ru/data/scripts/quests/Q00220_TestimonyOfGlory/30616-06.html
