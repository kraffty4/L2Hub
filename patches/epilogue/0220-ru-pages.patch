diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00097_SagaOfTheShillienTemplar/1-02.htm b/dist/game/data/lang/ru/data/scripts/quests/Q00097_SagaOfTheShillienTemplar/1-02.htm
