+</body></html>
\ No newline at end of file
diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00011_SecretMeetingWithKetraOrcs/31296-01.htm b/dist/game/data/lang/ru/data/scripts/quests/Q00011_SecretMeetingWithKetraOrcs/31296-01.htm
