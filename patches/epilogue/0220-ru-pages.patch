@@ -0,0 +1,2 @@
+<html><body>Tablet of Vision:<br>
+Общаться с этой скрижалью бесполезно. Навестите Продавца Амулетов Хакрана в городе Руна.</body></html>
\ No newline at end of file
diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00076_SagaOfTheGrandKhavatari/11-01.htm b/dist/game/data/lang/ru/data/scripts/quests/Q00076_SagaOfTheGrandKhavatari/11-01.htm
new file mode 100644
