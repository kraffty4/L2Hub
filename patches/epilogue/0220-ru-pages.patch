diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00094_SagaOfTheSoultaker/0-02.htm b/dist/game/data/lang/ru/data/scripts/quests/Q00094_SagaOfTheSoultaker/0-02.htm
