--- /dev/null
+++ b/dist/game/data/lang/ru/data/scripts/ai/areas/Hellbound/AI/NPC/Budenka/Budenka-07.html
@@ -0,0 +1,3 @@
+<html><body>Буденка:<br>
+Эй, у вас уже довольно высокая репутация в гильдии. Как поживаете?
+</body></html>
\ No newline at end of file
diff --git a/dist/game/data/lang/ru/data/scripts/ai/areas/Hellbound/AI/NPC/Buron/32345-01.htm b/dist/game/data/lang/ru/data/scripts/ai/areas/Hellbound/AI/NPC/Buron/32345-01.htm
