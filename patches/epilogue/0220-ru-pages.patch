diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00246_PossessorOfAPreciousSoul3/30721-02.htm b/dist/game/data/lang/ru/data/scripts/quests/Q00246_PossessorOfAPreciousSoul3/30721-02.htm
