diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q10271_TheEnvelopingDarkness/32560-04.htm b/dist/game/data/lang/ru/data/scripts/quests/Q10271_TheEnvelopingDarkness/32560-04.htm
