diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00307_ControlDeviceOfTheGiants/32711-03.htm b/dist/game/data/lang/ru/data/scripts/quests/Q00307_ControlDeviceOfTheGiants/32711-03.htm
