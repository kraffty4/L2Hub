diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00708_PathToBecomingALordGludio/35100-01.html b/dist/game/data/lang/ru/data/scripts/quests/Q00708_PathToBecomingALordGludio/35100-01.html
