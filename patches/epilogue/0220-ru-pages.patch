diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00048_ToTheImmortalPlateau/30097-14.html b/dist/game/data/lang/ru/data/scripts/quests/Q00048_ToTheImmortalPlateau/30097-14.html
