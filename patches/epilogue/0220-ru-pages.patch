diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00238_SuccessFailureOfBusiness/32641-03.html b/dist/game/data/lang/ru/data/scripts/quests/Q00238_SuccessFailureOfBusiness/32641-03.html
