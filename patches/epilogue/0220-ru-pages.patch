diff --git a/dist/game/data/lang/ru/data/scripts/ai/areas/Gracia/AI/NPC/Klemis/32734-01.html b/dist/game/data/lang/ru/data/scripts/ai/areas/Gracia/AI/NPC/Klemis/32734-01.html
