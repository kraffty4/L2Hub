diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q10269_ToTheSeedOfDestruction/32526-01.html b/dist/game/data/lang/ru/data/scripts/quests/Q10269_ToTheSeedOfDestruction/32526-01.html
