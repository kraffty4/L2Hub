+</body></html>
\ No newline at end of file
diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00504_CompetitionForTheBanditStronghold/35437-03.htm b/dist/game/data/lang/ru/data/scripts/quests/Q00504_CompetitionForTheBanditStronghold/35437-03.htm
