@@ -0,0 +1,3 @@
+<html><body>Аркения:<br>
+Прошу, умоляю вас. Поторопитесь. Когда тетрархи узнают...
+</body></html>
\ No newline at end of file
diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00411_PathOfTheAssassin/30419-08.html b/dist/game/data/lang/ru/data/scripts/quests/Q00411_PathOfTheAssassin/30419-08.html
new file mode 100644
