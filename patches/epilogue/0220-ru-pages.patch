index 0000000000000000000000000000000000000000..a7b2d01d303e480e0b1974f68f330a386481dffc
--- /dev/null
+++ b/dist/game/data/lang/ru/data/html/default/31544.htm
@@ -0,0 +1,10 @@
+<html><body>Нафф:<br>
+Слышали о звере, что таится в краю горячих источников?<br>
+Ледяной Император Бумбаламп, он же король йети!<br>
+Говорят, он ест людей живьем!<br>
+Какой ужас.<br>
+Он прожорлив и может умять целую семью за один присест!<br>
+Не понимаю, почему его до сих пор никто не убил!<br>
+<a action="bypass npc_%objectId%_Chat 1">"Чем полезны горячие источники?"</a><br>
+<a action="bypass Script">Квест</a>
+</body></html>
\ No newline at end of file
diff --git a/dist/game/data/lang/ru/data/html/default/31545-1.htm b/dist/game/data/lang/ru/data/html/default/31545-1.htm
