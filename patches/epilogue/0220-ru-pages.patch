\ No newline at end of file
diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q10275_ContainingTheAttributePower/32326-07.html b/dist/game/data/lang/ru/data/scripts/quests/Q10275_ContainingTheAttributePower/32326-07.html
