+</body></html>
\ No newline at end of file
diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00694_BreakThroughTheHallOfSuffering/32603-02.html b/dist/game/data/lang/ru/data/scripts/quests/Q00694_BreakThroughTheHallOfSuffering/32603-02.html
