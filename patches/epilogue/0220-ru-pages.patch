diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00093_SagaOfTheSpectralMaster/3-05.htm b/dist/game/data/lang/ru/data/scripts/quests/Q00093_SagaOfTheSpectralMaster/3-05.htm
