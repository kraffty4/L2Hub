diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00615_MagicalPowerOfFirePart1/31379-03.html b/dist/game/data/lang/ru/data/scripts/quests/Q00615_MagicalPowerOfFirePart1/31379-03.html
