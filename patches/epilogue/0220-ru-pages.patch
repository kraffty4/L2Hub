\ No newline at end of file
diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00074_SagaOfTheDreadnought/0-05.htm b/dist/game/data/lang/ru/data/scripts/quests/Q00074_SagaOfTheDreadnought/0-05.htm
