diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00311_ExpulsionOfEvilSpirits/32655-01.htm b/dist/game/data/lang/ru/data/scripts/quests/Q00311_ExpulsionOfEvilSpirits/32655-01.htm
