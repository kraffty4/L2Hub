index 0000000000000000000000000000000000000000..725a12d899069abbaed083a2caa4a242b5f7569f
--- /dev/null
+++ b/dist/game/data/lang/ru/data/scripts/quests/Q00368_TrespassingIntoTheHolyGround/30926-01.htm
@@ -0,0 +1,7 @@
+<html><body>Жрица Рестина:<br>
+Вы слышали о <font color="LEVEL">Сад Евы</font>? Там порой можно застать отдыхающую саму богиню.<br>
+Она не любит, когда ее беспокоят, поэтому ее сад находится в самой глубине моря, а попасть туда можно только через сложный лабиринт.<br>
+Недавно в ее святилище вторглись <font color="LEVEL">те, кто желает ей зла</font>. Сейчас ее там нет, и мы, ее жрецы и стражи, изо всех сил пытаемся изгнать захватчиков. Но эта задача нам не по силам.<br>
+Мы привлекаем посторонних, чтобы их победить. Поможете нам?<br>
+<a action="bypass Script Q00368_TrespassingIntoTheHolyGround 30926-02.htm">"Я помогу."</a>
+</body></html>
\ No newline at end of file
diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00368_TrespassingIntoTheHolyGround/30926-02.htm b/dist/game/data/lang/ru/data/scripts/quests/Q00368_TrespassingIntoTheHolyGround/30926-02.htm
new file mode 100644
index 0000000000000000000000000000000000000000..af6cc4ed336d0b4e3d3cf728d69452442f5f37b9
--- /dev/null
+++ b/dist/game/data/lang/ru/data/scripts/quests/Q00368_TrespassingIntoTheHolyGround/30926-02.htm
@@ -0,0 +1,4 @@
+<html><body>Жрица Рестина:<br>
+Спасибо. Вы должны знать, что посторонним входить в Сад Евы запрещено. Мы нарушаем правила, но время отчаянное.<br>
+Отправляйтесь в <font color="LEVEL">Сад Евы</font> и убейте <font color="LEVEL">Blade Stakato, Blade Stakato Worker, Blade Stakato Warrior и Blade Stakato Drone</font>. В доказательство победы принесите их <font color="LEVEL">клыки</font>. Вы будете хорошо вознаграждены за труды.
+</body></html>
\ No newline at end of file
diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00368_TrespassingIntoTheHolyGround/30926-03.html b/dist/game/data/lang/ru/data/scripts/quests/Q00368_TrespassingIntoTheHolyGround/30926-03.html
