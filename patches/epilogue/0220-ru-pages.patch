diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q10280_MutatedKaneusSchuttgart/31981-01.htm b/dist/game/data/lang/ru/data/scripts/quests/Q10280_MutatedKaneusSchuttgart/31981-01.htm
