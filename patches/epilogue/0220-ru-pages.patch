diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00123_TheLeaderAndTheFollower/31961-02.htm b/dist/game/data/lang/ru/data/scripts/quests/Q00123_TheLeaderAndTheFollower/31961-02.htm
