diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00004_LongLiveThePaagrioLord/30578-00.htm b/dist/game/data/lang/ru/data/scripts/quests/Q00004_LongLiveThePaagrioLord/30578-00.htm
