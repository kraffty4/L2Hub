+</body></html>
\ No newline at end of file
diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00417_PathOfTheScavenger/30524-04.htm b/dist/game/data/lang/ru/data/scripts/quests/Q00417_PathOfTheScavenger/30524-04.htm
