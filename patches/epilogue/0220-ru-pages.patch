diff --git a/dist/game/data/lang/ru/data/scripts/ai/areas/Hellbound/AI/NPC/Falk/32297-02.htm b/dist/game/data/lang/ru/data/scripts/ai/areas/Hellbound/AI/NPC/Falk/32297-02.htm
