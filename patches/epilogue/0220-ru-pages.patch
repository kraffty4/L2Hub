diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00072_SagaOfTheSwordMuse/9-01.htm b/dist/game/data/lang/ru/data/scripts/quests/Q00072_SagaOfTheSwordMuse/9-01.htm
