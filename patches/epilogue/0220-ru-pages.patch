\ No newline at end of file
diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00087_SagaOfEvasSaint/1-05.htm b/dist/game/data/lang/ru/data/scripts/quests/Q00087_SagaOfEvasSaint/1-05.htm
