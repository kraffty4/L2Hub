\ No newline at end of file
diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00220_TestimonyOfGlory/30616-03.html b/dist/game/data/lang/ru/data/scripts/quests/Q00220_TestimonyOfGlory/30616-03.html
