diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00079_SagaOfTheAdventurer/0-01.htm b/dist/game/data/lang/ru/data/scripts/quests/Q00079_SagaOfTheAdventurer/0-01.htm
