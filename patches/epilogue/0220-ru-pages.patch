diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00661_MakingTheHarvestGroundsSafe/30210-04.html b/dist/game/data/lang/ru/data/scripts/quests/Q00661_MakingTheHarvestGroundsSafe/30210-04.html
