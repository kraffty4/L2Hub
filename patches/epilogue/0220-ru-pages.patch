@@ -0,0 +1,3 @@
+<html><body>Буденка:<br>
+Скоро узнаете, я уверен. Ха-ха!
+</body></html>
\ No newline at end of file
diff --git a/dist/game/data/lang/ru/data/scripts/ai/areas/Hellbound/AI/NPC/Budenka/Budenka-03.html b/dist/game/data/lang/ru/data/scripts/ai/areas/Hellbound/AI/NPC/Budenka/Budenka-03.html
