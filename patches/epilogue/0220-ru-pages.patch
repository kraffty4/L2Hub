@@ -0,0 +1,3 @@
+<html><body>Трискель:<br>
+Вы поистине жалки! Не хандрите, бегите скорее!
+</body></html>
\ No newline at end of file
diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00411_PathOfTheAssassin/30416-09.html b/dist/game/data/lang/ru/data/scripts/quests/Q00411_PathOfTheAssassin/30416-09.html
new file mode 100644
