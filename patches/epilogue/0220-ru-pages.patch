diff --git a/dist/game/data/lang/ru/data/scripts/ai/areas/Hellbound/AI/Zones/TowerOfNaia/32370-03a.htm b/dist/game/data/lang/ru/data/scripts/ai/areas/Hellbound/AI/Zones/TowerOfNaia/32370-03a.htm
