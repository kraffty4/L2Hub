diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00193_SevenSignsDyingMessage/30191-01.htm b/dist/game/data/lang/ru/data/scripts/quests/Q00193_SevenSignsDyingMessage/30191-01.htm
new file mode 100644
