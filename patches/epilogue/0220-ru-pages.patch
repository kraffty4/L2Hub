@@ -0,0 +1,3 @@
+<html><body>Трискель:<br>
+Жалкое создание! Не заставляйте Аркению ждать!
+</body></html>
\ No newline at end of file
diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00411_PathOfTheAssassin/30416-08.html b/dist/game/data/lang/ru/data/scripts/quests/Q00411_PathOfTheAssassin/30416-08.html
