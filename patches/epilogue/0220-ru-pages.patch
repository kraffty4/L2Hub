diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00246_PossessorOfAPreciousSoul3/31741-01.htm b/dist/game/data/lang/ru/data/scripts/quests/Q00246_PossessorOfAPreciousSoul3/31741-01.htm
