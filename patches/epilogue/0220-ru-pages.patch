diff --git a/dist/game/data/lang/ru/data/scripts/ai/areas/Hellbound/AI/Zones/TullyWorkshop/32372-01b.htm b/dist/game/data/lang/ru/data/scripts/ai/areas/Hellbound/AI/Zones/TullyWorkshop/32372-01b.htm
