diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00216_TrialOfTheGuildsman/30103-06.htm b/dist/game/data/lang/ru/data/scripts/quests/Q00216_TrialOfTheGuildsman/30103-06.htm
