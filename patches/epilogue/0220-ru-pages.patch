+<tr><td><button value="Saving Santa's Hat" action="bypass -h Script SavingSanta SavingSantaHat" width=136 height=20 back="L2UI_ct1.button_df" fore="L2UI_ct1.button_df"></td><td>50000 аден</td></tr>
