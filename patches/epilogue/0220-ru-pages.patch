diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00627_HeartInSearchOfPower/31518-01.htm b/dist/game/data/lang/ru/data/scripts/quests/Q00627_HeartInSearchOfPower/31518-01.htm
