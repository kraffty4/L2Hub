diff --git a/dist/game/data/lang/ru/data/scripts/ai/areas/Hellbound/AI/NPC/Hude/32298-03.htm b/dist/game/data/lang/ru/data/scripts/ai/areas/Hellbound/AI/NPC/Hude/32298-03.htm
