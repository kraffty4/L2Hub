+</body></html>
\ No newline at end of file
diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00625_TheFinestIngredientsPart2/31521-03.htm b/dist/game/data/lang/ru/data/scripts/quests/Q00625_TheFinestIngredientsPart2/31521-03.htm
