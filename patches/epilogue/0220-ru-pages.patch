diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00143_FallenAngelRequestOfDusk/32369-04.html b/dist/game/data/lang/ru/data/scripts/quests/Q00143_FallenAngelRequestOfDusk/32369-04.html
