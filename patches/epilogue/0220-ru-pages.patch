diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00367_ElectrifyingRecharge/30673-01.htm b/dist/game/data/lang/ru/data/scripts/quests/Q00367_ElectrifyingRecharge/30673-01.htm
