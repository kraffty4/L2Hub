\ No newline at end of file
diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00086_SagaOfTheHierophant/4-06.htm b/dist/game/data/lang/ru/data/scripts/quests/Q00086_SagaOfTheHierophant/4-06.htm
