@@ -0,0 +1,3 @@
+<html><body>Пиотур:<br>
+<font color="LEVEL">Семена, в которых обитает благословение Мафра</font>... Это будет ваш Жетон Плодородных Земель.
+</body></html>
\ No newline at end of file
diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00221_TestimonyOfProsperity/30597-04.html b/dist/game/data/lang/ru/data/scripts/quests/Q00221_TestimonyOfProsperity/30597-04.html
new file mode 100644
index 0000000000000000000000000000000000000000..65ab4b5755b3b90c3821e0050f2acaf5086e350b
