+</body></html>
\ No newline at end of file
diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00049_TheRoadHome/30097-14.html b/dist/game/data/lang/ru/data/scripts/quests/Q00049_TheRoadHome/30097-14.html
