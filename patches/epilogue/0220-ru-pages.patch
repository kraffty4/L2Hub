+</body></html>
\ No newline at end of file
diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00650_ABrokenDream/32054-01.htm b/dist/game/data/lang/ru/data/scripts/quests/Q00650_ABrokenDream/32054-01.htm
