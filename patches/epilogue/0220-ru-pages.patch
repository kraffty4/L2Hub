diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q10276_MutatedKaneusGludio/30344-01.htm b/dist/game/data/lang/ru/data/scripts/quests/Q10276_MutatedKaneusGludio/30344-01.htm
