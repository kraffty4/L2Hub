diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00649_ALooterAndARailroadMan/32052-01.htm b/dist/game/data/lang/ru/data/scripts/quests/Q00649_ALooterAndARailroadMan/32052-01.htm
