diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00694_BreakThroughTheHallOfSuffering/32603-01.htm b/dist/game/data/lang/ru/data/scripts/quests/Q00694_BreakThroughTheHallOfSuffering/32603-01.htm
