--- /dev/null
+++ b/dist/game/data/lang/ru/data/scripts/ai/areas/Hellbound/AI/NPC/Jude/32356-01.htm
@@ -0,0 +1,4 @@
+<html><body>Джуд:<br>
+Новоприбывшие? Откуда вы родом?<br>
+<a action="bypass Script">Квест.</a>
+</body></html>
diff --git a/dist/game/data/lang/ru/data/scripts/ai/areas/Hellbound/AI/NPC/Jude/32356-01a.htm b/dist/game/data/lang/ru/data/scripts/ai/areas/Hellbound/AI/NPC/Jude/32356-01a.htm
