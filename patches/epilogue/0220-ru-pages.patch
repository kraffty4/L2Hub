--- /dev/null
+++ b/dist/game/data/lang/ru/data/scripts/ai/areas/Hellbound/AI/NPC/Buron/32345-lowlvl.htm
@@ -0,0 +1,4 @@
+<html><body>Бурон:<br>
+Не могу вам доверять. Чужак!<br>
+<a action="bypass Script Buron 32345-01.htm">Назад.</a>
+</body></html>
\ No newline at end of file
