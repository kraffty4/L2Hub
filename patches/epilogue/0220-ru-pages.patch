\ No newline at end of file
diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00083_SagaOfTheMoonlightSentinel/10-05.htm b/dist/game/data/lang/ru/data/scripts/quests/Q00083_SagaOfTheMoonlightSentinel/10-05.htm
