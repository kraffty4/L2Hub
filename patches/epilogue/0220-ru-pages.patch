+</body></html>
\ No newline at end of file
diff --git a/dist/game/data/lang/ru/data/html/trainer/30034-noteach.htm b/dist/game/data/lang/ru/data/html/trainer/30034-noteach.htm
new file mode 100644
index 0000000000000000000000000000000000000000..8c1a18f8fc478a7d5acd520e36de9e111a5d0de4
