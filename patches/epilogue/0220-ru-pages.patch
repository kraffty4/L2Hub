diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00079_SagaOfTheAdventurer/10-05.htm b/dist/game/data/lang/ru/data/scripts/quests/Q00079_SagaOfTheAdventurer/10-05.htm
