index 0000000000000000000000000000000000000000..313a8f0759f868223bc34e42febeb122f313f191
--- /dev/null
+++ b/dist/game/data/lang/ru/data/scripts/quests/Q00121_PavelTheGiant/32041-01.html
@@ -0,0 +1,7 @@
+<html><body>Собирательница Юми:<br>
+Что привело вас сюда?<br>
+А, вас прислал Ньюир? Я рада, что вы пришли. Я вас ждала.<br>
+Как там старина? Мог бы и еды с вами передать. Неужели это так много? Право слово.<br>
+Ладно, неважно. Поговорим о деле.<br>
+<a action="bypass Script Q00121_PavelTheGiant 32041-02.html">Спросить, что нужно сделать.</a>
+</body></html>
\ No newline at end of file
diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00121_PavelTheGiant/32041-02.html b/dist/game/data/lang/ru/data/scripts/quests/Q00121_PavelTheGiant/32041-02.html
