+</body></html>
\ No newline at end of file
diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00618_IntoTheFlame/31271-01.html b/dist/game/data/lang/ru/data/scripts/quests/Q00618_IntoTheFlame/31271-01.html
