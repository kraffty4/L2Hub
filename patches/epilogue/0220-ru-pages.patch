diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00194_SevenSignsMammonsContract/32572-07.html b/dist/game/data/lang/ru/data/scripts/quests/Q00194_SevenSignsMammonsContract/32572-07.html
