diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00068_SagaOfTheSoulHound/11-01.htm b/dist/game/data/lang/ru/data/scripts/quests/Q00068_SagaOfTheSoulHound/11-01.htm
