+</body></html>
\ No newline at end of file
diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00372_LegacyOfInsolence/30929-01.html b/dist/game/data/lang/ru/data/scripts/quests/Q00372_LegacyOfInsolence/30929-01.html
