diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00115_TheOtherSideOfTruth/32018-05.html b/dist/game/data/lang/ru/data/scripts/quests/Q00115_TheOtherSideOfTruth/32018-05.html
