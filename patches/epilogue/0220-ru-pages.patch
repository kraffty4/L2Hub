diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00196_SevenSignsSealOfTheEmperor/30969-01.htm b/dist/game/data/lang/ru/data/scripts/quests/Q00196_SevenSignsSealOfTheEmperor/30969-01.htm
