index 0000000000000000000000000000000000000000..54bdfe11933c89842ab1e27b9101b7eaa3cf1fe7
--- /dev/null
+++ b/dist/game/data/lang/ru/data/scripts/quests/Q00378_GrandFeast/30594-01.htm
@@ -0,0 +1,6 @@
+<html><body>Начальник Склада Ранспо:<br>
+Я работаю кладовщиком на этом самом месте почти 40 лет! Могу честно сказать, что построил это место своими руками. Я пожертвовал юностью и вложил в него всю страсть!<br>
+Некоторое время назад я получил уведомление от совета старейшин союза гильдий в Шутгарте. Скоро сюда приедет инспектор из Гильдии Железных Врат. Он приезжает посмотреть на мой склад, потому что производительность в Дионе в этом году так высока. Если все пройдет хорошо, меня вполне могут повысить до старейшины!<br>
+Когда приедет инспектор, я должен почтить его великим пиром... Но я не знаю, с чего начать! Я так взволнован! Мне нужна помощь такого искателя приключений, как вы. Разумеется, вас хорошо наградят. Что скажете? Поможете мне?<br>
+<a action="bypass Script Q00378_GrandFeast 30594-02.htm">"Помогу."</a>
+</body></html>
\ No newline at end of file
diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00378_GrandFeast/30594-02.htm b/dist/game/data/lang/ru/data/scripts/quests/Q00378_GrandFeast/30594-02.htm
