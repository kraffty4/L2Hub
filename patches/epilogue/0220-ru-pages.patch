@@ -0,0 +1,3 @@
+<html><body>Церштерер Марсела:<br>
+Для обмена на предмет нужно собрать не менее 50 когтей монстров.
+</body></html>
\ No newline at end of file
diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00281_HeadForTheHills/32173-11.html b/dist/game/data/lang/ru/data/scripts/quests/Q00281_HeadForTheHills/32173-11.html
new file mode 100644
