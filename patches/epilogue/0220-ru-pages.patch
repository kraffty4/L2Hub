+</body></html>
\ No newline at end of file
diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00004_LongLiveThePaagrioLord/30562-02.html b/dist/game/data/lang/ru/data/scripts/quests/Q00004_LongLiveThePaagrioLord/30562-02.html
