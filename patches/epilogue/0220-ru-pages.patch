+</body></html>
\ No newline at end of file
diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00102_SeaOfSporesFever/30221-01.html b/dist/game/data/lang/ru/data/scripts/quests/Q00102_SeaOfSporesFever/30221-01.html
