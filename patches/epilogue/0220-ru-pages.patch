diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00344_1000YearsTheEndOfLamentation/30623-01.html b/dist/game/data/lang/ru/data/scripts/quests/Q00344_1000YearsTheEndOfLamentation/30623-01.html
