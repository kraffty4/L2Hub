@@ -0,0 +1,3 @@
+<html><body>Инженер Лекон:<br>
+Предмет вас устраивает? Тогда идите к Боевому Магу Артиусу.
+</body></html>
diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q10272_LightFragment/32559-01.html b/dist/game/data/lang/ru/data/scripts/quests/Q10272_LightFragment/32559-01.html
