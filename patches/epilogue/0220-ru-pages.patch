@@ -0,0 +1,3 @@
+<html><body>Жрец Адониус:<br>
+<font color="LEVEL">Верховная Жрица Левиан</font> ждет вас. Она скажет, что вам нужно сделать.
+</body></html>
\ No newline at end of file
diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00340_SubjugationOfLizardmen/30375-06.html b/dist/game/data/lang/ru/data/scripts/quests/Q00340_SubjugationOfLizardmen/30375-06.html
