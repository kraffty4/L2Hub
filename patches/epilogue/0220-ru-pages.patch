diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00071_SagaOfEvasTemplar/1-01.htm b/dist/game/data/lang/ru/data/scripts/quests/Q00071_SagaOfEvasTemplar/1-01.htm
