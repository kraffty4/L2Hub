index 0000000000000000000000000000000000000000..066b0b70ed51a32ec8e60f86010c94cf2c7a83d5
--- /dev/null
+++ b/dist/game/data/lang/ru/data/html/default/31615.htm
@@ -0,0 +1,6 @@
+<html><body>Отшельник:<br>
+Да пребудет с вами благословение Евы...<br>
+Вы мой преемник?<br>
+Ох, когда же кончится мое бдение... Я так устал...<br>
+<a action="bypass Script">Квест</a>
+</body></html>
\ No newline at end of file
diff --git a/dist/game/data/lang/ru/data/html/default/31616.htm b/dist/game/data/lang/ru/data/html/default/31616.htm
