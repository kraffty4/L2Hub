diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00711_PathToBecomingALordInnadril/30969-02.html b/dist/game/data/lang/ru/data/scripts/quests/Q00711_PathToBecomingALordInnadril/30969-02.html
