diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00175_TheWayOfTheWarrior/32138-03.htm b/dist/game/data/lang/ru/data/scripts/quests/Q00175_TheWayOfTheWarrior/32138-03.htm
