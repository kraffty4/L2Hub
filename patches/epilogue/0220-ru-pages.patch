@@ -0,0 +1,3 @@
+<html><body>Хьюд:<br>
+Нигде их не вижу. Не вздумайте меня обманывать!
+</body></html>
\ No newline at end of file
diff --git a/dist/game/data/lang/ru/data/scripts/ai/areas/Hellbound/AI/NPC/Hude/32298-05.htm b/dist/game/data/lang/ru/data/scripts/ai/areas/Hellbound/AI/NPC/Hude/32298-05.htm
