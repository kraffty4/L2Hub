index 0000000000000000000000000000000000000000..c8fa65a849d6261b926f228cf1d79cc668650fdc
--- /dev/null
+++ b/dist/game/data/lang/ru/data/html/default/31589.htm
@@ -0,0 +1,5 @@
+<html><body>Дух Тотема Дуда-Мара:<br>
+ Пусть глаза мои и потускнели, я вижу больше, чем ты можешь вообразить...<br>
+Паутина Дуда-Мара охватывает все измерения времени и пространства! Все события, даже те, что творятся далеко, мне подвластны.<br>
+<a action="bypass Script">Квест</a>
+</body></html>
\ No newline at end of file
diff --git a/dist/game/data/lang/ru/data/html/default/31592.htm b/dist/game/data/lang/ru/data/html/default/31592.htm
