diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00118_ToLeadAndBeLed/30298-02.htm b/dist/game/data/lang/ru/data/scripts/quests/Q00118_ToLeadAndBeLed/30298-02.htm
