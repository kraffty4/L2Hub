diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00192_SevenSignsSeriesOfDoubt/30191-02.html b/dist/game/data/lang/ru/data/scripts/quests/Q00192_SevenSignsSeriesOfDoubt/30191-02.html
