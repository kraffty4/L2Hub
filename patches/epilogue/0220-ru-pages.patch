diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00096_SagaOfTheSpectralDancer/3-01.htm b/dist/game/data/lang/ru/data/scripts/quests/Q00096_SagaOfTheSpectralDancer/3-01.htm
