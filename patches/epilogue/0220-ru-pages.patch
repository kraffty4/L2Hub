+++ b/dist/game/data/lang/ru/data/html/trainer/31971.htm
@@ -0,0 +1,7 @@
+<html><body>Магистр Отилло:<br>
+А-а-а! Что еще?! О, вы ко мне? Что ж, смейтесь на здоровье. Я работал над заклинанием, которое сделает тело гибким, как резина. Как видите, вышло скорее наоборот. Что ж, такова природа опытов, а? Без риска нет награды.<br>
+Может, хотите попробовать? Что худшего может случиться?<br>
+<a action="bypass -h npc_%objectId%_SkillList">Изучить умения.</a><br>
+<a action="bypass npc_%objectId%_Link common/skill_enchant_help.htm">Спросить об улучшении умений.</a><br>
+<a action="bypass Script">Квест</a>
+</body></html>
\ No newline at end of file
diff --git a/dist/game/data/lang/ru/data/html/trainer/31972-noteach.htm b/dist/game/data/lang/ru/data/html/trainer/31972-noteach.htm
new file mode 100644
