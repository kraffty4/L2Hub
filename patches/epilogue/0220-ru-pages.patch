+</body></html>
diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00620_FourGoblets/31454-05.html b/dist/game/data/lang/ru/data/scripts/quests/Q00620_FourGoblets/31454-05.html
new file mode 100644
