diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00011_SecretMeetingWithKetraOrcs/31256-03.html b/dist/game/data/lang/ru/data/scripts/quests/Q00011_SecretMeetingWithKetraOrcs/31256-03.html
