@@ -0,0 +1,3 @@
+<html><body>Чейрен:<br>
+Я на вас рассчитываю! Не подведите нас!
+</body></html>
\ No newline at end of file
diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00312_TakeAdvantageOfTheCrisis/30535-00.htm b/dist/game/data/lang/ru/data/scripts/quests/Q00312_TakeAdvantageOfTheCrisis/30535-00.htm
