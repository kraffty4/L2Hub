diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00009_IntoTheCityOfHumans/30571-01.html b/dist/game/data/lang/ru/data/scripts/quests/Q00009_IntoTheCityOfHumans/30571-01.html
new file mode 100644
