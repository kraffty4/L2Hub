+++ b/dist/game/data/lang/ru/data/html/default/31614.htm
@@ -0,0 +1,4 @@
+<html><body>Верховный Призыватель Радисс:<br>
+Хотя я прожил больше 1,000 лет, меня до сих пор терзают незавершенные дела... Пока Ева не заберет мою душу, я буду стремиться исполнить свои чаяния...<br>
+<a action="bypass Script">Квест</a>
+</body></html>
\ No newline at end of file
diff --git a/dist/game/data/lang/ru/data/html/default/31615.htm b/dist/game/data/lang/ru/data/html/default/31615.htm
