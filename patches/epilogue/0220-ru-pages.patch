\ No newline at end of file
diff --git a/dist/game/data/lang/ru/data/scripts/village_master/ElfHumanClericChange2/30120-10.htm b/dist/game/data/lang/ru/data/scripts/village_master/ElfHumanClericChange2/30120-10.htm
