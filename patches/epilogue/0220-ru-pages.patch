diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00356_DigUpTheSeaOfSpores/30717-01.htm b/dist/game/data/lang/ru/data/scripts/quests/Q00356_DigUpTheSeaOfSpores/30717-01.htm
