+</body></html>
\ No newline at end of file
diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00691_MatrasSuspiciousRequest/32245-11.html b/dist/game/data/lang/ru/data/scripts/quests/Q00691_MatrasSuspiciousRequest/32245-11.html
