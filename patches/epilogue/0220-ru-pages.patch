diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00091_SagaOfTheArcanaLord/0-02.htm b/dist/game/data/lang/ru/data/scripts/quests/Q00091_SagaOfTheArcanaLord/0-02.htm
new file mode 100644
