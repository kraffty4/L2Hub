diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00029_ChestCaughtWithABaitOfEarth/30909-01.htm b/dist/game/data/lang/ru/data/scripts/quests/Q00029_ChestCaughtWithABaitOfEarth/30909-01.htm
