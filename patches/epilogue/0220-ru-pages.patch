\ No newline at end of file
diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00316_DestroyPlagueCarriers/30155-08.html b/dist/game/data/lang/ru/data/scripts/quests/Q00316_DestroyPlagueCarriers/30155-08.html
new file mode 100644
