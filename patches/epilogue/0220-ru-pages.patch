diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00081_SagaOfTheGhostHunter/11-01.htm b/dist/game/data/lang/ru/data/scripts/quests/Q00081_SagaOfTheGhostHunter/11-01.htm
