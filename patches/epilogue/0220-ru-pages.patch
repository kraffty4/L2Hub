+</body></html>
\ No newline at end of file
diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00175_TheWayOfTheWarrior/32133-05.html b/dist/game/data/lang/ru/data/scripts/quests/Q00175_TheWayOfTheWarrior/32133-05.html
