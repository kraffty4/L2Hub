diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00335_TheSongOfTheHunter/30744-10f.html b/dist/game/data/lang/ru/data/scripts/quests/Q00335_TheSongOfTheHunter/30744-10f.html
