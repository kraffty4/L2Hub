diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00293_TheHiddenVeins/30539-01.html b/dist/game/data/lang/ru/data/scripts/quests/Q00293_TheHiddenVeins/30539-01.html
new file mode 100644
