diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00611_AllianceWithVarkaSilenos/31378-01.htm b/dist/game/data/lang/ru/data/scripts/quests/Q00611_AllianceWithVarkaSilenos/31378-01.htm
