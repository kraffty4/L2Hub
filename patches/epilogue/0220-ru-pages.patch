diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00029_ChestCaughtWithABaitOfEarth/31574-04.htm b/dist/game/data/lang/ru/data/scripts/quests/Q00029_ChestCaughtWithABaitOfEarth/31574-04.htm
