+</body></html>
\ No newline at end of file
diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00236_SeedsOfChaos/31522-07b.html b/dist/game/data/lang/ru/data/scripts/quests/Q00236_SeedsOfChaos/31522-07b.html
new file mode 100644
index 0000000000000000000000000000000000000000..30fd2fdea0ed5e59ab50b1ba7d68294ec1bfe144
--- /dev/null
