diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00221_TestimonyOfProsperity/30104-04d.html b/dist/game/data/lang/ru/data/scripts/quests/Q00221_TestimonyOfProsperity/30104-04d.html
