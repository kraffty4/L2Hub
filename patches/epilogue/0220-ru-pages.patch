\ No newline at end of file
diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00175_TheWayOfTheWarrior/32138-01.htm b/dist/game/data/lang/ru/data/scripts/quests/Q00175_TheWayOfTheWarrior/32138-01.htm
