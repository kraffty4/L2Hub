+<a action="bypass Script Q00141_ShadowFoxPart3 30894-11.html">"Какой?"</a>
+</body></html>
\ No newline at end of file
diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00141_ShadowFoxPart3/30894-11.html b/dist/game/data/lang/ru/data/scripts/quests/Q00141_ShadowFoxPart3/30894-11.html
