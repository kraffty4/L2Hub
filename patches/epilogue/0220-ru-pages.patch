\ No newline at end of file
diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00174_SupplyCheck/32173-04.html b/dist/game/data/lang/ru/data/scripts/quests/Q00174_SupplyCheck/32173-04.html
