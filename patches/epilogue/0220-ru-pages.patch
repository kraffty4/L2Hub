+</body></html>
\ No newline at end of file
diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00606_BattleAgainstVarkaSilenos/31370-06.html b/dist/game/data/lang/ru/data/scripts/quests/Q00606_BattleAgainstVarkaSilenos/31370-06.html
