\ No newline at end of file
diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00097_SagaOfTheShillienTemplar/1-05.htm b/dist/game/data/lang/ru/data/scripts/quests/Q00097_SagaOfTheShillienTemplar/1-05.htm
