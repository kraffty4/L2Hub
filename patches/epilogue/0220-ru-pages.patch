diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00115_TheOtherSideOfTruth/32020-23.html b/dist/game/data/lang/ru/data/scripts/quests/Q00115_TheOtherSideOfTruth/32020-23.html
