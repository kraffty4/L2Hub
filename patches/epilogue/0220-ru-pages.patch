+</body></html>
\ No newline at end of file
diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00617_GatherTheFlames/32049-01.html b/dist/game/data/lang/ru/data/scripts/quests/Q00617_GatherTheFlames/32049-01.html
