diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00216_TrialOfTheGuildsman/30103-09.html b/dist/game/data/lang/ru/data/scripts/quests/Q00216_TrialOfTheGuildsman/30103-09.html
