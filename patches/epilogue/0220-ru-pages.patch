diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00092_SagaOfTheElementalMaster/1-06.htm b/dist/game/data/lang/ru/data/scripts/quests/Q00092_SagaOfTheElementalMaster/1-06.htm
