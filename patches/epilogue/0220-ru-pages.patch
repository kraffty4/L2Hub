diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00096_SagaOfTheSpectralDancer/11-02.htm b/dist/game/data/lang/ru/data/scripts/quests/Q00096_SagaOfTheSpectralDancer/11-02.htm
