@@ -0,0 +1,3 @@
+<html><body>Tablet of Vision:<br>
+Скрижаль неподвижна и темна.<br>
+Вам нужно поговорить с Эриком вон там.</body></html>
\ No newline at end of file
diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00070_SagaOfThePhoenixKnight/10-04.htm b/dist/game/data/lang/ru/data/scripts/quests/Q00070_SagaOfThePhoenixKnight/10-04.htm
new file mode 100644
