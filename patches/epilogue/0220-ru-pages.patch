\ No newline at end of file
diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00078_SagaOfTheDoomcryer/0-01.htm b/dist/game/data/lang/ru/data/scripts/quests/Q00078_SagaOfTheDoomcryer/0-01.htm
new file mode 100644
