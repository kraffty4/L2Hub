+<td align="center">Ранг 2</td>
+<td>Лучшие 10%</td>
+<td align="center">80 очк.</td>
+</tr>
+<tr>
+<td align="center">Ранг 3</td>
+<td>Лучшие 25%</td>
+<td align="center">55 очк.</td>
+</tr>
+<tr>
+<td align="center">Ранг 4</td>
+<td>Лучшие 50%</td>
+<td align="center">35 очк.</td>
+</tr>
+<tr>
+<td align="center">Ранг 5</td>
+<td>Лучшие 100%</td>
+<td align="center">20 очк.</td>
+</tr>
+</table>
