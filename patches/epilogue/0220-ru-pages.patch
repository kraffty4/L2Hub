\ No newline at end of file
diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00077_SagaOfTheDominator/2-03.htm b/dist/game/data/lang/ru/data/scripts/quests/Q00077_SagaOfTheDominator/2-03.htm
