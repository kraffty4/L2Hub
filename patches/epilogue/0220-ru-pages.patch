diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00386_StolenDignity/30843-11.html b/dist/game/data/lang/ru/data/scripts/quests/Q00386_StolenDignity/30843-11.html
new file mode 100644
index 0000000000000000000000000000000000000000..d3adef05d98d706ca75bf8a29b11c693f2149992
--- /dev/null
+++ b/dist/game/data/lang/ru/data/scripts/quests/Q00386_StolenDignity/30843-11.html
@@ -0,0 +1,4 @@
+<html><body>Кладовщик Ромп:<br>
+Ну? Похоже, Руда Инферниума у вас совсем мало. Это все, что вы принесли? <br>
+Прошу, вернитесь и соберите больше, прежде чем снова приходить ко мне.
+</body></html>
\ No newline at end of file
diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00386_StolenDignity/30843-12.html b/dist/game/data/lang/ru/data/scripts/quests/Q00386_StolenDignity/30843-12.html
