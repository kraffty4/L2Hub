--- /dev/null
+++ b/dist/game/data/lang/ru/data/scripts/quests/Q00415_PathOfTheOrcMonk/31979-02.html
@@ -0,0 +1,6 @@
+<html><body><title>Геукеу Кабарта</title><br>
+<center>Что такое Геукеу Кабарта?<br>
+<a action="bypass Script Q00415_PathOfTheOrcMonk 31979-03.html">Сказка </a><br>
+<a action="bypass Script Q00415_PathOfTheOrcMonk 31979-04.html">Гармония</a><br>
+<a action="bypass Script Q00415_PathOfTheOrcMonk 31979-04.html">Применение</a></center>
+</body></html>
\ No newline at end of file
diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00415_PathOfTheOrcMonk/31979-03.html b/dist/game/data/lang/ru/data/scripts/quests/Q00415_PathOfTheOrcMonk/31979-03.html
new file mode 100644
