diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00136_MoreThanMeetsTheEye/30832-03.htm b/dist/game/data/lang/ru/data/scripts/quests/Q00136_MoreThanMeetsTheEye/30832-03.htm
