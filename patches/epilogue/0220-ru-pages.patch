@@ -0,0 +1,3 @@
+<html><body>Стражник Ксабер:<br>
+Я получил предмет. Прошу, передайте Свону, что завтра я пришлю к нему человека.
+</body></html>
diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00364_JovialAccordion/30075-02.html b/dist/game/data/lang/ru/data/scripts/quests/Q00364_JovialAccordion/30075-02.html
new file mode 100644
