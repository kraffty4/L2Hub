diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00092_SagaOfTheElementalMaster/10-04.htm b/dist/game/data/lang/ru/data/scripts/quests/Q00092_SagaOfTheElementalMaster/10-04.htm
