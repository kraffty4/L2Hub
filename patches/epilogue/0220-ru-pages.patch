\ No newline at end of file
diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00231_TestOfTheMaestro/30556-06.html b/dist/game/data/lang/ru/data/scripts/quests/Q00231_TestOfTheMaestro/30556-06.html
