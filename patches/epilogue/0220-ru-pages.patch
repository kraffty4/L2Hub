diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00711_PathToBecomingALordInnadril/35316-08.html b/dist/game/data/lang/ru/data/scripts/quests/Q00711_PathToBecomingALordInnadril/35316-08.html
