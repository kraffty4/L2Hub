diff --git a/dist/game/data/lang/ru/data/scripts/village_master/FirstClassTransferTalk/30154_elven_knight_01.html b/dist/game/data/lang/ru/data/scripts/village_master/FirstClassTransferTalk/30154_elven_knight_01.html
