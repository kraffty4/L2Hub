diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00659_IdRatherBeCollectingFairyBreath/30634-06.html b/dist/game/data/lang/ru/data/scripts/quests/Q00659_IdRatherBeCollectingFairyBreath/30634-06.html
