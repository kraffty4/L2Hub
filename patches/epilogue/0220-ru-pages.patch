+</body></html>
\ No newline at end of file
diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00043_HelpTheSister/30829-00.htm b/dist/game/data/lang/ru/data/scripts/quests/Q00043_HelpTheSister/30829-00.htm
