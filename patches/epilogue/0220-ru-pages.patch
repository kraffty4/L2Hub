diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00024_InhabitantsOfTheForestOfTheDead/31389-08.html b/dist/game/data/lang/ru/data/scripts/quests/Q00024_InhabitantsOfTheForestOfTheDead/31389-08.html
