\ No newline at end of file
diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00713_PathToBecomingALordAden/30857-03.html b/dist/game/data/lang/ru/data/scripts/quests/Q00713_PathToBecomingALordAden/30857-03.html
