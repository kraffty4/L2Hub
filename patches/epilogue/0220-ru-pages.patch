diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00335_TheSongOfTheHunter/30744-01.htm b/dist/game/data/lang/ru/data/scripts/quests/Q00335_TheSongOfTheHunter/30744-01.htm
