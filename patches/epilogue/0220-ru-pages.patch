\ No newline at end of file
diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00089_SagaOfTheMysticMuse/9-04.htm b/dist/game/data/lang/ru/data/scripts/quests/Q00089_SagaOfTheMysticMuse/9-04.htm
