diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00604_DaimonTheWhiteEyedPart2/31683-01.htm b/dist/game/data/lang/ru/data/scripts/quests/Q00604_DaimonTheWhiteEyedPart2/31683-01.htm
