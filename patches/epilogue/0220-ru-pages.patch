diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00096_SagaOfTheSpectralDancer/2-06.htm b/dist/game/data/lang/ru/data/scripts/quests/Q00096_SagaOfTheSpectralDancer/2-06.htm
