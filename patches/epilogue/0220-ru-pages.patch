@@ -0,0 +1,3 @@
+<html><body>Кузнец Хильда:<br>
+Отнесите Вакуалит <font color="LEVEL">Кляйну</font>.
+</body></html>
\ No newline at end of file
diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00618_IntoTheFlame/31540-01.html b/dist/game/data/lang/ru/data/scripts/quests/Q00618_IntoTheFlame/31540-01.html
