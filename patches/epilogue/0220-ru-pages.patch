diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00081_SagaOfTheGhostHunter/10-06.htm b/dist/game/data/lang/ru/data/scripts/quests/Q00081_SagaOfTheGhostHunter/10-06.htm
