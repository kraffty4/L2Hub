diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q10271_TheEnvelopingDarkness/32556-02.html b/dist/game/data/lang/ru/data/scripts/quests/Q10271_TheEnvelopingDarkness/32556-02.html
