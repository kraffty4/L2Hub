+</body></html>
\ No newline at end of file
diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00174_SupplyCheck/32173-06.html b/dist/game/data/lang/ru/data/scripts/quests/Q00174_SupplyCheck/32173-06.html
new file mode 100644
