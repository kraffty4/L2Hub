+</body></html>
\ No newline at end of file
diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00220_TestimonyOfGlory/30617-06.html b/dist/game/data/lang/ru/data/scripts/quests/Q00220_TestimonyOfGlory/30617-06.html
