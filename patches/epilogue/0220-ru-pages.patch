@@ -0,0 +1,2 @@
+<html><body>Tablet of Vision:<br>
+Таркай кричит, и дух тотема-ящера нападает.</body></html>
\ No newline at end of file
diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00078_SagaOfTheDoomcryer/10-03.htm b/dist/game/data/lang/ru/data/scripts/quests/Q00078_SagaOfTheDoomcryer/10-03.htm
