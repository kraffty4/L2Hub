diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00027_ChestCaughtWithABaitOfWind/31570-03.htm b/dist/game/data/lang/ru/data/scripts/quests/Q00027_ChestCaughtWithABaitOfWind/31570-03.htm
