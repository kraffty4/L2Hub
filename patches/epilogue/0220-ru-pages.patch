diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00504_CompetitionForTheBanditStronghold/35437-01.htm b/dist/game/data/lang/ru/data/scripts/quests/Q00504_CompetitionForTheBanditStronghold/35437-01.htm
