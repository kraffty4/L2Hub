+<td width=80 align=center><button action="bypass -h npc_%objectId%_bid $bidprice" value="Подтвердить" width=80 height=27 back="L2UI_CT1.Button_DF_Down" fore="L2UI_CT1.Button_DF"></td>
+</tr>
+</table>
+</body></html>
