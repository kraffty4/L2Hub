diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00098_SagaOfTheShillienSaint/4-05.htm b/dist/game/data/lang/ru/data/scripts/quests/Q00098_SagaOfTheShillienSaint/4-05.htm
