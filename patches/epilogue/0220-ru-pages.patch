+</body></html>
\ No newline at end of file
diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00017_LightAndDarkness/31517-04.html b/dist/game/data/lang/ru/data/scripts/quests/Q00017_LightAndDarkness/31517-04.html
