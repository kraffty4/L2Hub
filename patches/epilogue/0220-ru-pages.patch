diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00511_AwlUnderFoot/FortressWarden-06.htm b/dist/game/data/lang/ru/data/scripts/quests/Q00511_AwlUnderFoot/FortressWarden-06.htm
