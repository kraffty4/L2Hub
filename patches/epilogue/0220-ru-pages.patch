diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00142_FallenAngelRequestOfDawn/30612-03.html b/dist/game/data/lang/ru/data/scripts/quests/Q00142_FallenAngelRequestOfDawn/30612-03.html
