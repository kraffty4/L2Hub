diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00691_MatrasSuspiciousRequest/32245-10.html b/dist/game/data/lang/ru/data/scripts/quests/Q00691_MatrasSuspiciousRequest/32245-10.html
