@@ -0,0 +1,6 @@
+<html><body>Пьяница Трифф:<br>
+Ик! Ха-ха!<br>
+Глоток за море, глоток за меня!<br>
+Глоток за меня, глоток за море!<br>
+<a action="bypass Script">Квест</a>
+</body></html>
\ No newline at end of file
diff --git a/dist/game/data/lang/ru/data/html/default/30612.htm b/dist/game/data/lang/ru/data/html/default/30612.htm
