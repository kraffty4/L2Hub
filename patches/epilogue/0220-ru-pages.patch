@@ -0,0 +1,3 @@
+<html><body>Tablet of Vision:<br>
+Когда вы приближаетесь к скрижали, Камень Общения светится.<br>
+<a action="bypass -h Script Q00076_SagaOfTheGrandKhavatari 10-2">Вступить в общение с Tablet of Vision.</a></body></html>
\ No newline at end of file
diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00076_SagaOfTheGrandKhavatari/10-06.htm b/dist/game/data/lang/ru/data/scripts/quests/Q00076_SagaOfTheGrandKhavatari/10-06.htm
new file mode 100644
