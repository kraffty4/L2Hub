diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00612_BattleAgainstKetraOrcs/31377-01.htm b/dist/game/data/lang/ru/data/scripts/quests/Q00612_BattleAgainstKetraOrcs/31377-01.htm
