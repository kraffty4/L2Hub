+</body></html>
\ No newline at end of file
diff --git a/dist/game/data/lang/ru/data/scripts/ai/others/FortressSiegeManager/FortressSiegeManager-18.html b/dist/game/data/lang/ru/data/scripts/ai/others/FortressSiegeManager/FortressSiegeManager-18.html
