@@ -0,0 +1,4 @@
+<html><body>Музыкант Барбадо:<br>
+Все равно спасибо, но мне это ни к чему.<br>
+Если это все, позвольте мне удалиться? Мне нужно репетировать. 
+</body></html>
diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00363_SorrowfulSoundOfFlute/30959-03.html b/dist/game/data/lang/ru/data/scripts/quests/Q00363_SorrowfulSoundOfFlute/30959-03.html
