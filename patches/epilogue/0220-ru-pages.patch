diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00414_PathOfTheOrcRaider/30570-07b.html b/dist/game/data/lang/ru/data/scripts/quests/Q00414_PathOfTheOrcRaider/30570-07b.html
