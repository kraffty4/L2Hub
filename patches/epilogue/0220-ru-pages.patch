diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00066_CertifiedArbalester/30458-06.html b/dist/game/data/lang/ru/data/scripts/quests/Q00066_CertifiedArbalester/30458-06.html
new file mode 100644
