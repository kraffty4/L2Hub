index 0000000000000000000000000000000000000000..4044e7377ac5a38c9219162f6ef312b3ead1d18a
--- /dev/null
+++ b/dist/game/data/lang/ru/data/html/default/31594.htm
@@ -0,0 +1,6 @@
+<html><body>Главный Инспектор Монд:<br>
+Хм... Ничего не вижу подозрительного... Следующую счетную книгу, пожалуйста! Чего так долго? Быстрее!<br>
+Проклятье...! Так я не закончу, даже если просижу всю ночь!<br>
+А, посетитель? Простите. У нас ревизия, и тут сущий дурдом! Спасибо за терпение.<br>
+<a action="bypass Script">Квест</a>
+</body></html>
\ No newline at end of file
diff --git a/dist/game/data/lang/ru/data/html/default/31596.htm b/dist/game/data/lang/ru/data/html/default/31596.htm
