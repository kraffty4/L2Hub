diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00710_PathToBecomingALordGiran/30879-02.html b/dist/game/data/lang/ru/data/scripts/quests/Q00710_PathToBecomingALordGiran/30879-02.html
