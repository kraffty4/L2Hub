\ No newline at end of file
diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00335_TheSongOfTheHunter/30744-12.html b/dist/game/data/lang/ru/data/scripts/quests/Q00335_TheSongOfTheHunter/30744-12.html
