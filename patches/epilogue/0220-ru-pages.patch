\ No newline at end of file
diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00327_RecoverTheFarmland/30034-05.html b/dist/game/data/lang/ru/data/scripts/quests/Q00327_RecoverTheFarmland/30034-05.html
