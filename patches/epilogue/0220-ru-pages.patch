+</body></html>
\ No newline at end of file
diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00613_ProveYourCourageVarka/31377-04.htm b/dist/game/data/lang/ru/data/scripts/quests/Q00613_ProveYourCourageVarka/31377-04.htm
