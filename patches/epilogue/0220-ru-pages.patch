+</body></html>
\ No newline at end of file
diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00709_PathToBecomingALordDion/31418-02.html b/dist/game/data/lang/ru/data/scripts/quests/Q00709_PathToBecomingALordDion/31418-02.html
