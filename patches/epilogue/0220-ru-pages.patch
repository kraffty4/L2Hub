@@ -0,0 +1,6 @@
+<html><body>Венди:<br>
+Думаю, он увидел в вас силу воли и глубокую мудрость.<br>
+Теперь, когда у меня есть эта его частица, я кое-что узнала из сведений, что он передал.<br>
+Сейчас расскажу.<br>
+<a action="bypass Script Q00120_PavelsLastResearch 32047-31.html">Слушать.</a>
+</body></html>
\ No newline at end of file
diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00120_PavelsLastResearch/32047-31.html b/dist/game/data/lang/ru/data/scripts/quests/Q00120_PavelsLastResearch/32047-31.html
