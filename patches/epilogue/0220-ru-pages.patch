diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00240_ImTheOnlyOneYouCanTrust/32640-0.htm b/dist/game/data/lang/ru/data/scripts/quests/Q00240_ImTheOnlyOneYouCanTrust/32640-0.htm
