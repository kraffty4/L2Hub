diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00093_SagaOfTheSpectralMaster/0-01.htm b/dist/game/data/lang/ru/data/scripts/quests/Q00093_SagaOfTheSpectralMaster/0-01.htm
