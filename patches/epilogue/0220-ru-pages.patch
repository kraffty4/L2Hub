+</body></html>
\ No newline at end of file
diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00216_TrialOfTheGuildsman/30210-04.html b/dist/game/data/lang/ru/data/scripts/quests/Q00216_TrialOfTheGuildsman/30210-04.html
