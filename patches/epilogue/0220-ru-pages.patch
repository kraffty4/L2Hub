diff --git a/dist/game/data/lang/ru/data/scripts/ai/others/FortressSiegeManager/FortressSiegeManager-21.html b/dist/game/data/lang/ru/data/scripts/ai/others/FortressSiegeManager/FortressSiegeManager-21.html
