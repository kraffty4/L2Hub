diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00710_PathToBecomingALordGiran/30511-01.html b/dist/game/data/lang/ru/data/scripts/quests/Q00710_PathToBecomingALordGiran/30511-01.html
