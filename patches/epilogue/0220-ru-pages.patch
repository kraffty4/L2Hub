diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00316_DestroyPlagueCarriers/30155-09.html b/dist/game/data/lang/ru/data/scripts/quests/Q00316_DestroyPlagueCarriers/30155-09.html
