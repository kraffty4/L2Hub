diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00067_SagaOfTheDoombringer/10-01.htm b/dist/game/data/lang/ru/data/scripts/quests/Q00067_SagaOfTheDoombringer/10-01.htm
