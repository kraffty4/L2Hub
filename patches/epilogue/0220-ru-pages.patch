\ No newline at end of file
diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00085_SagaOfTheCardinal/10-04.htm b/dist/game/data/lang/ru/data/scripts/quests/Q00085_SagaOfTheCardinal/10-04.htm
