index 0000000000000000000000000000000000000000..65eb0039e261e9a4cd12a728545acbdbf2b95adf
--- /dev/null
+++ b/dist/game/data/lang/ru/data/html/default/30556.htm
@@ -0,0 +1,5 @@
+<html><body>Мастер Тома:<br>
+Кто вы?<br>
+С незнакомцами не разговариваю... Проходите!<br>
+<a action="bypass Script">Квест</a>
+</body></html>
\ No newline at end of file
diff --git a/dist/game/data/lang/ru/data/html/default/30557.htm b/dist/game/data/lang/ru/data/html/default/30557.htm
