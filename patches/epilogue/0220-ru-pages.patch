diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00356_DigUpTheSeaOfSpores/30717-07.html b/dist/game/data/lang/ru/data/scripts/quests/Q00356_DigUpTheSeaOfSpores/30717-07.html
