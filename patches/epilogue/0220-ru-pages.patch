@@ -0,0 +1,3 @@
+<html><body>Музыкант Барбадо:<br>
+Я репетирую. Прошу, не мешайте.
+</body></html>
diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00364_JovialAccordion/30060-01.html b/dist/game/data/lang/ru/data/scripts/quests/Q00364_JovialAccordion/30060-01.html
