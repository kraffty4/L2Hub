diff --git a/dist/game/data/lang/ru/data/scripts/ai/areas/Hellbound/AI/Zones/TullyWorkshop/32370-01e.htm b/dist/game/data/lang/ru/data/scripts/ai/areas/Hellbound/AI/Zones/TullyWorkshop/32370-01e.htm
