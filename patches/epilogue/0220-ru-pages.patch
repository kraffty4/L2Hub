\ No newline at end of file
diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00072_SagaOfTheSwordMuse/0-05.htm b/dist/game/data/lang/ru/data/scripts/quests/Q00072_SagaOfTheSwordMuse/0-05.htm
