diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00129_PailakaDevilsLegacy/32508-02.htm b/dist/game/data/lang/ru/data/scripts/quests/Q00129_PailakaDevilsLegacy/32508-02.htm
