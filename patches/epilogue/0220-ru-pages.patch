index 0000000000000000000000000000000000000000..0a952501701ad4a3f73d752985f643b3258addef
--- /dev/null
+++ b/dist/game/data/lang/ru/data/scripts/quests/Q00129_PailakaDevilsLegacy/32508-02.htm
