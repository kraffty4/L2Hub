diff --git a/dist/game/data/lang/ru/data/scripts/quests/Q00095_SagaOfTheHellKnight/11-01.htm b/dist/game/data/lang/ru/data/scripts/quests/Q00095_SagaOfTheHellKnight/11-01.htm
