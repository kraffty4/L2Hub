+
+	private static String spotBands()
+	{
+		final StringBuilder sb = new StringBuilder(2048);
+		sb.append("<font color=\"B09878\">").append(tr("Выбери уровень мобов: откроется список мест, телепорт — кнопкой в строке.")).append("</font><br><br>");
+		sb.append("<table width=420><tr>");
+		for (int i = 0; i < SPOT_BANDS.length; i++)
+		{
+			if ((i > 0) && ((i % 3) == 0))
+			{
+				sb.append("</tr><tr>");
+			}
+			sb.append("<td align=center>").append(button(spotBand(SPOT_BANDS[i]) + " (" + spotsOf(SPOT_BANDS[i]).size() + ")", SPOTS + " " + SPOT_BANDS[i], 125)).append("</td>");
+		}
+		return sb.append("</tr></table>").toString();
+	}
+
+	private static String spotBand(int from)
+	{
+		final int to = spotBandEnd(from);
+		return to == Integer.MAX_VALUE ? from + "+" : from + "-" + to;
+	}
+
+	private static int spotBandEnd(int from)
+	{
+		for (int band : SPOT_BANDS)
+		{
+			if (band > from)
+			{
+				return band;
+			}
+		}
+		return Integer.MAX_VALUE;
+	}
+
+	/**
+	 * Споты полосы уровней, номера в {@link HuntSpotData#getSpots}: одно имя и один разброс уровней — одна строка, самая людная по мобам (в файле таких групп спавна сотни).
+	 */
+	private static List<Integer> spotsOf(int from)
+	{
+		final List<HuntSpotData.HuntSpot> all = HuntSpotData.getInstance().getSpots();
+		final int to = spotBandEnd(from);
+		final Map<String, Integer> best = new HashMap<>();
+		for (int i = 0; i < all.size(); i++)
+		{
+			final HuntSpotData.HuntSpot spot = all.get(i);
+			if ((spot.level >= from) && (spot.level < to))
+			{
+				final String key = spot.name + "|" + spot.min + "|" + spot.max;
+				final Integer old = best.get(key);
+				if ((old == null) || (spot.mobs > all.get(old).mobs))
+				{
+					best.put(key, i);
+				}
+			}
+		}
+		final List<Integer> list = new ArrayList<>(best.values());
+		list.sort(Comparator.<Integer> comparingInt(i -> all.get(i).level).thenComparing(i -> all.get(i).name).thenComparingInt(i -> i));
+		return list;
+	}
+
+	private static String spotList(int from, int pageNo)
+	{
+		final List<HuntSpotData.HuntSpot> all = HuntSpotData.getInstance().getSpots();
+		final List<Integer> list = spotsOf(from);
+		final int pages = Math.max(1, (list.size() + SPOT_PAGE - 1) / SPOT_PAGE);
+		final int current = Math.max(0, Math.min(pageNo, pages - 1));
+		final StringBuilder sb = new StringBuilder(4096);
+		sb.append(button(tr("К уровням"), SPOTS, 110)).append("<br><font color=\"LEVEL\">").append(tr("Мобы ")).append(spotBand(from)).append("</font><br>");
+		if (list.isEmpty())
+		{
+			return sb.append("<font color=\"808080\">").append(tr("На этих уровнях мест нет.")).append("</font>").toString();
+		}
+
+		sb.append("<table width=520><tr><td width=320><font color=\"LEVEL\">").append(tr("Место")).append("</font></td><td width=60><font color=\"LEVEL\">").append(tr("Ур.")).append("</font></td><td width=50><font color=\"LEVEL\">").append(tr("Мобов")).append("</font></td><td width=90></td></tr></table>");
+		sb.append("<img src=\"L2UI.SquareGray\" width=520 height=1>");
+		for (int index : list.subList(current * SPOT_PAGE, Math.min(list.size(), (current + 1) * SPOT_PAGE)))
+		{
+			final HuntSpotData.HuntSpot spot = all.get(index);
+			sb.append("<table width=520><tr><td width=320>").append(spotName(spot.name)).append("</td><td width=60>").append(spot.min).append('-').append(spot.max).append("</td><td width=50>").append(spot.mobs).append("</td><td width=90>");
+			sb.append(button(tr("Телепорт"), SPOTS + " go " + index + " " + from + " " + current, 80)).append("</td></tr></table>");
+		}
+		sb.append("<img src=\"L2UI.SquareGray\" width=520 height=1><br>");
+		if (pages > 1)
+		{
+			sb.append("<table width=300><tr><td width=100>").append(current > 0 ? button(tr("Назад"), SPOTS + " " + from + " " + (current - 1), 60) : "").append("</td>");
+			sb.append("<td width=100 align=center>").append(current + 1).append(" / ").append(pages).append("</td>");
+			sb.append("<td width=100 align=right>").append((current + 1) < pages ? button(tr("Дальше"), SPOTS + " " + from + " " + (current + 1), 60) : "").append("</td></tr></table><br>");
+		}
+		if (CommunityBoardConfig.COMMUNITYBOARD_TELEPORT_PRICE > 0)
+		{
+			sb.append("<font color=\"808080\">").append(tr("Цена телепорта: ")).append(CommunityBoardConfig.COMMUNITYBOARD_TELEPORT_PRICE).append("</font>");
+		}
+		return sb.toString();
+	}
+
+	private static String spotName(String name)
+	{
+		String result = name;
+		if (L2HUB_ENGLISH)
+		{
+			for (String[] side : COMPASS_EN)
+			{
+				result = result.replace(side[0], side[1]);
+			}
+		}
