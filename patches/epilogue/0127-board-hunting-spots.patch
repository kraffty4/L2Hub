+	/**
+	 * Цена и запреты как у телепорта доски (_bbsteleport в HomeBoard, config/Custom/CommunityBoard.ini); как и окно охотников, из тюрьмы и инстанса не выпускает.
+	 */
+	private static boolean spotTeleport(Player player, int index)
+	{
+		final List<HuntSpotData.HuntSpot> all = HuntSpotData.getInstance().getSpots();
+		if ((index < 0) || (index >= all.size()) || !canUse(player))
+		{
+			return false;
+		}
+		if (!CommunityBoardConfig.COMMUNITYBOARD_ENABLE_TELEPORTS)
+		{
+			player.sendMessage(tr("Телепорт доски выключен в настройках сервера (CommunityBoard.ini, CommunityEnableTeleports)."));
+			return false;
+		}
+		if (player.isJailed() || (player.getInstanceId() != 0))
+		{
+			player.sendMessage(tr("Отсюда телепорт не работает."));
+			return false;
+		}
+		final int price = CommunityBoardConfig.COMMUNITYBOARD_TELEPORT_PRICE;
+		if (player.getInventory().getInventoryItemCount(CommunityBoardConfig.COMMUNITYBOARD_CURRENCY, -1) < price)
+		{
+			player.sendMessage(tr("Не хватает денег на телепорт."));
+			return false;
+		}
+
+		player.disableAllSkills();
+		player.sendPacket(new ShowBoard());
+		if (price > 0)
+		{
+			player.destroyItemByItemId(ItemProcessType.FEE, CommunityBoardConfig.COMMUNITYBOARD_CURRENCY, price, player, true);
+		}
+		player.setIn7sDungeon(false);
+		player.teleToLocation(all.get(index).entry, 0);
+		ThreadPool.schedule(player::enableAllSkills, 3000);
+		return true;
+	}
