index 0000000000000000000000000000000000000000..97e2837dafa24323abcfe6665b5f66c4051048a5
--- /dev/null
+++ b/java/org/l2jmobius/gameserver/entity/actor/SuperChampion.java
@@ -0,0 +1,145 @@
+/*
