+	 */
+	public static int bandHigh(Set<Player> registered, int ceiling)
+	{
+		int high = ceiling;
+		for (Player other : registered)
+		{
+			if ((LEVEL_GAP > 0) && live(other))
+			{
+				high = Math.min(high, other.getLevel() + LEVEL_GAP);
+			}
+		}
+		return high;
+	}
+
+	/** Средний моб на уровне: столбец из {@link #MOBS} между соседними десятками. */
+	private static double mob(int level, int column)
+	{
+		if (level <= MOBS[0][0])
+		{
+			return MOBS[0][column];
+		}
+		for (int i = 1; i < MOBS.length; i++)
+		{
+			if (level <= MOBS[i][0])
+			{
+				final double part = (double) (level - MOBS[i - 1][0]) / (MOBS[i][0] - MOBS[i - 1][0]);
+				return MOBS[i - 1][column] + ((MOBS[i][column] - MOBS[i - 1][column]) * part);
+			}
+		}
+		return MOBS[MOBS.length - 1][column];
+	}
+
+	private static double rewardMobs(int minutes, boolean winner)
+	{
+		return ((double) REWARD_MOBS * minutes * (winner ? REWARD_WINNER_FACTOR : 1)) / REWARD_MINUTES;
+	}
+
+	/**
+	 * @param level уровень
