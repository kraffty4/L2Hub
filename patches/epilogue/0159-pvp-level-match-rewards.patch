+	 */
+	public static void finish(Set<Player> participants, Collection<Player> winners, Map<Player, Integer> scores, int minutes, int instanceId)
+	{
+		if (REWARD_MOBS <= 0)
+		{
+			return;
+		}
+		final int top = scores.values().stream().mapToInt(Integer::intValue).max().orElse(0);
+		for (Player player : participants)
+		{
+			if ((player == null) || (player.getInstanceId() != instanceId))
+			{
+				continue;
+			}
+			final boolean winner = winners.contains(player);
+			final int level = player.getLevel();
+			final long adena = rewardAdena(level, minutes, winner);
+			player.addAdena(ItemProcessType.REWARD, adena, player, true);
+			if (!live(player))
+			{
+				continue;
+			}
+			final long exp = rewardExp(level, minutes, winner);
+			player.addExpAndSp(exp, rewardMobs(minutes, winner) * mob(level, 2) * RatesConfig.RATE_SP);
+			player.sendMessage(PhantomText.tr("Награда за ивент: ") + adena + PhantomText.tr(" адены и ") + exp + PhantomText.tr(" опыта."));
+			if (REWARD_SCROLLS)
+			{
+				final int armor = winner ? rewardScroll(level, false) : 0;
+				if (armor > 0)
+				{
+					player.addItem(ItemProcessType.REWARD, armor, 1, player, true);
+				}
+				final int weapon = (top > 0) && (scores.getOrDefault(player, 0) == top) ? rewardScroll(level, true) : 0;
