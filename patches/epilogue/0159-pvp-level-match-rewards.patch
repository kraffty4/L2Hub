+	 */
+	public static int bandLow(Set<Player> registered, int floor)
+	{
+		int low = floor;
+		for (Player other : registered)
+		{
+			if ((LEVEL_GAP > 0) && live(other))
+			{
+				low = Math.max(low, other.getLevel() - LEVEL_GAP);
