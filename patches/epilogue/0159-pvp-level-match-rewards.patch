+	 * @param player кто записался
+	 */
+	public static void admitted(Quest script, Set<Player> registered, Player player)
+	{
+		if ((LEVEL_GAP <= 0) || !live(player))
+		{
+			return;
+		}
+		for (Player other : registered)
+		{
+			if (!live(other) && (Math.abs(other.getLevel() - player.getLevel()) > LEVEL_GAP))
+			{
+				script.onEvent("CancelParticipation", null, other);
+			}
+		}
+	}
+
+	/**
