+	public static long rewardAdena(int level, int minutes, boolean winner)
+	{
+		final Float rate = RatesConfig.RATE_DROP_AMOUNT_BY_ID == null ? null : RatesConfig.RATE_DROP_AMOUNT_BY_ID.get(57);
+		return (long) (rewardMobs(minutes, winner) * mob(level, 3) * (rate != null ? rate : RatesConfig.RATE_DEATH_DROP_AMOUNT_MULTIPLIER));
+	}
+
+	/**
+	 * @param level уровень
