+	 */
+	public static long rewardExp(int level, int minutes, boolean winner)
+	{
+		return (long) (rewardMobs(minutes, winner) * mob(level, 1) * RatesConfig.RATE_XP);
+	}
+
+	/**
+	 * Свиток по уровню.
+	 * @param level уровень
+	 * @param weapon на оружие, иначе на броню
+	 * @return предмет или 0, если ниже D
+	 */
+	public static int rewardScroll(int level, boolean weapon)
+	{
+		for (int[] row : SCROLLS)
+		{
+			if (level >= row[0])
+			{
+				return row[weapon ? 1 : 2];
+			}
+		}
+		return 0;
+	}
+
+	/**
+	 * @return кто победил в командном ивенте; ничья — никто
+	 */
+	public static Collection<Player> teamWinners(Set<Player> blue, Set<Player> red, boolean forfeit, int blueScore, int redScore)
+	{
+		if (forfeit)
+		{
+			return blue.isEmpty() && !red.isEmpty() ? red : blue;
+		}
+		return blueScore > redScore ? blue : redScore > blueScore ? red : Set.of();
+	}
+
+	/**
+	 * Конец ивента: награда всем, кто дошёл до конца боя, сверх того, что скрипт даёт победителю. Охотникам только адена: уровнем они идут своим ходом.
+	 * @param participants участники
+	 * @param winners победители
