+				{
+					player.addItem(ItemProcessType.REWARD, weapon, 1, player, true);
+				}
+			}
+			LOGGER.info("L2HubPvpEvents: " + player.getName() + " (" + level + ") gets " + adena + " adena and " + exp + " exp" + (winner ? ", winner" : "") + ".");
+		}
+	}
