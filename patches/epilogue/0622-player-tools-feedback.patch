+	/** Однократный перенос только наших неизменённых ярлыков, без стирания чужих ячеек. */
+	private void cleanServiceBar(Player player)
+	{
+		if (player.getVariables().getBoolean("L2HubServiceBarV2", false)) { return; }
+		final java.util.Set<Integer> owned = new java.util.HashSet<>();
+		for (Macro macro : player.getMacros().getAllMacroses().values())
+		{
+			final Macro preset = _macroPresets.get(macro.getId());
+			if (preset == null || macro.getId() < 10100 || macro.getId() > 10131 || macro.getCommands().size() != 1) { continue; }
+			final String command = macro.getCommands().getFirst().getCmd();
+			if ((macro.getName().equals(preset.getName()) && command.equals(preset.getCommands().getFirst().getCmd()))
+				|| macro.getId() == 10113 && macro.getName().equals("Автопоты вкл") && command.equals(".apon")
+				|| macro.getId() == 10106 && macro.getName().equals("Автобой") && command.equals(".play"))
+			{ owned.add(macro.getId()); player.registerMacro(preset); }
+		}
+		for (Shortcut shortcut : new ArrayList<>(player.getAllShortcuts()))
+		{
+			if (shortcut.getType() == ShortcutType.MACRO && owned.contains(shortcut.getId())) { player.deleteShortcut(shortcut.getSlot(), shortcut.getPage()); }
+		}
+		final int[] ids = {10105,10104,10103,10102,10101,10100,10113,10115};
+		for (int slot = 0; slot < ids.length; slot++)
+		{
+			final Macro macro = _macroPresets.get(ids[slot]);
+			if (player.getShortcut(slot, 1) != null || !isAvailable(macro)) { continue; }
+			if (!owned.contains(ids[slot]) && player.getMacros().getAllMacroses().containsKey(ids[slot])) { continue; }
+			if (!player.getMacros().getAllMacroses().containsKey(ids[slot])) { if (player.getMacros().getAllMacroses().size() >= MAX_MACROS) { continue; } player.registerMacro(macro); }
+			final Shortcut shortcut = new Shortcut(slot, 1, ShortcutType.MACRO, ids[slot], -1, 1);
+			player.registerShortcut(shortcut); player.sendPacket(new ShortcutRegister(shortcut));
+		}
+		player.getVariables().set("L2HubServiceBarV2", true);
+		player.sendPacket(new org.l2jmobius.gameserver.network.serverpackets.ShortcutInit(player));
+	}
+
