+	/**
+	 * L2Hub: место скилла на странице: сначала очередь атак, за ней выбранные бафы, потом остальное.
+	 * @param player чья страница
+	 * @param skill скилл
+	 * @return чем меньше, тем выше
+	 */
+	private static int queuePlace(Player player, Skill skill)
+	{
+		final int place = player.getAutoUseSettings().getAutoSkills().indexOf(skill.getId());
+		if (place >= 0)
+		{
+			return place;
+		}
+
+		return player.getAutoUseSettings().getAutoBuffs().contains(skill.getId()) ? 1000 : 2000;
+	}
+
+	/**
+	 * L2Hub: сдвинуть атаку в очереди автобоя. Порядок сохраняется при выходе из игры.
+	 * @param player чья очередь
+	 * @param skillId скилл
+	 * @param step -1 вверх, 1 вниз
+	 */
+	private static void moveInQueue(Player player, Integer skillId, int step)
+	{
+		final List<Integer> queue = player.getAutoUseSettings().getAutoSkills();
+		final int from = queue.indexOf(skillId);
+		final int to = from + step;
+		if ((from >= 0) && (to >= 0) && (to < queue.size()))
+		{
+			queue.set(from, queue.get(to));
+			queue.set(to, skillId);
+			player.getAutoUseSettings().resetSkillOrder();
+		}
+	}
+
