diff --git a/dist/game/data/scripts/handlers/bypass/communityboard/L2HubKits.java b/dist/game/data/scripts/handlers/bypass/communityboard/L2HubKits.java
new file mode 100644
index 0000000000000000000000000000000000000000..257c4303fa4479067596feed6171c05f6856c6f2
--- /dev/null
+++ b/dist/game/data/scripts/handlers/bypass/communityboard/L2HubKits.java
@@ -0,0 +1,307 @@
+package handlers.bypass.communityboard;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+
+import org.l2jmobius.gameserver.data.xml.ItemData;
+import org.l2jmobius.gameserver.entity.actor.Player;
+import org.l2jmobius.gameserver.entity.item.ItemTemplate;
+import org.l2jmobius.gameserver.entity.item.enums.ItemProcessType;
+import org.l2jmobius.gameserver.mechanics.variables.PlayerVariables;
+
+/**
+ * L2Hub: стартовые наборы на доске Alt+B (кнопка на первой странице GM-шопа, выключатель TownStarterKits в config/Custom/L2HubTown.ini).
+ * <ul>
+ * <li>Бесплатно, один раз на персонажа на каждый грейд: NG с любого уровня, D с 20-го, C с 40-го (переменная персонажа L2HubKit_&lt;грейд&gt;).</li>
+ * <li>Тип брони выбирает игрок, оружие и 1000 сосок — по классу; лук и арбалет получают ещё 1000 снарядов.</li>
+ * <li>Охотники наборы не берут: сюда ведёт только кнопка доски.</li>
+ * </ul>
+ */
+public final class L2HubKits
+{
+	public static final String COMMAND = "_bbshubkits";
+	public static final String KEY = "TownStarterKits";
+	public static final String[] GRADES =
+	{
+		"ng",
+		"d",
+		"c"
+	};
+
+	private static final String[] GRADE_TITLES =
+	{
+		"Без грейда",
+		"D-грейд",
+		"C-грейд"
+	};
+	private static final int[] MIN_LEVEL =
+	{
+		1,
+		20,
+		40
+	};
+	private static final int SHOTS_COUNT = 1000;
+	private static final int[] SHOTS =
+	{
+		1835,
+		1463,
+		1464
+	};
+	private static final int[] MAGE_SHOTS =
+	{
+		3947,
+		3948,
+		3949
+	};
+	private static final int[] ARROWS =
+	{
+		17,
+		1341,
+		1342
+	};
+	private static final int[] BOLTS =
+	{
+		17, // на NG арбалетов нет: лук и стрелы
+		9633,
+		9634
+	};
+	private static final int[] SHIELDS =
+	{
+		625,
+		2493,
+		2497
+	};
+	private static final int[][] JEWELS =
+	{
+		{ 909, 846, 846, 878, 878 },
+		{ 914, 851, 851, 882, 882 },
+		{ 919, 857, 857, 888, 888 }
+	};
+	private static final int[][] HEAVY =
+	{
+		{ 26, 34, 1148, 51, 39 },
+		{ 352, 2378, 2411, 2449, 2425 },
+		{ 356, 2414, 2462, 2438 }
+	};
+	private static final int[][] LIGHT =
+	{
+		{ 27, 33, 1148, 51, 39 },
+		{ 395, 417, 2424, 2448, 2411 },
+		{ 401, 2437, 2461, 2414 }
+	};
+	private static final int[][] ROBE =
+	{
+		{ 431, 1148, 51, 39 },
+		{ 437, 470, 2450, 2411, 2424 },
+		{ 442, 473, 2463, 603, 2414 }
+	};
+	private static final Map<String, int[]> WEAPONS = Map.ofEntries( //
+		Map.entry("SWORD", new int[] { 68, 2499, 135 }), //
+		Map.entry("BIGSWORD", new int[] { 5284, 70, 5286 }), //
+		Map.entry("DUAL", new int[] { 5284, 2529, 2572 }), //
+		Map.entry("BLUNT", new int[] { 87, 159, 2503 }), //
+		Map.entry("POLE", new int[] { 16, 297, 299 }), //
+		Map.entry("DAGGER", new int[] { 219, 225, 228 }), //
+		Map.entry("BOW", new int[] { 273, 280, 286 }), //
+		Map.entry("FIST", new int[] { 257, 262, 266 }), //
+		Map.entry("MAGIC", new int[] { 177, 188, 206 }), //
+		Map.entry("ANCIENT", new int[] { 5284, 9226, 9296 }), //
+		Map.entry("RAPIER", new int[] { 68, 9225, 9292 }), //
+		Map.entry("CROSSBOW", new int[] { 273, 9227, 9300 }));
+
+	private L2HubKits()
+	{
+	}
+
+	/**
+	 * _bbshubkits [take &lt;ng|d|c&gt; &lt;heavy|light|robe&gt;]
+	 * @param player кто открыл
+	 * @param args команда доски
+	 * @return содержимое страницы
+	 */
+	public static String content(Player player, String[] args)
+	{
+		if ((args.length > 3) && args[1].equalsIgnoreCase("take") && L2HubBoard.canUse(player))
+		{
+			final String error = take(player, grade(args[2]), args[3].toLowerCase(Locale.ROOT));
+			player.sendMessage(error != null ? error : L2HubBoard.tr("Набор выдан, он в инвентаре."));
+		}
+
+		final String kind = kind(player);
+		final StringBuilder sb = new StringBuilder(4096);
+		sb.append("<table width=520><tr><td width=520><font color=\"B09878\">").append(L2HubBoard.tr("Бесплатно, один раз на персонажа на каждый грейд. Внутри оружие по классу, броня на выбор, бижутерия и 1000 сосок.")).append("</font></td></tr></table><br>");
+		sb.append("<img src=\"L2UI.SquareGray\" width=520 height=1>");
+		for (int grade = 0; grade < GRADES.length; grade++)
+		{
+			sb.append("<table width=520><tr><td width=110><font color=\"LEVEL\">").append(L2HubBoard.tr(GRADE_TITLES[grade])).append("</font><br1><font color=\"808080\">").append(grade == 0 ? L2HubBoard.tr("с любого уровня") : L2HubBoard.tr("с ") + MIN_LEVEL[grade] + L2HubBoard.tr("-го уровня")).append("</font></td>");
+			sb.append("<td width=190>").append(name(WEAPONS.get(kind)[grade])).append("<br1><font color=\"808080\">").append(name(shots(player, grade))).append(" x").append(SHOTS_COUNT).append("</font></td>");
+			if (taken(player, grade))
+			{
+				sb.append("<td width=220 align=center><font color=\"808080\">").append(L2HubBoard.tr("Уже получен")).append("</font></td>");
+			}
+			else if (player.getLevel() < MIN_LEVEL[grade])
+			{
+				sb.append("<td width=220 align=center><font color=\"808080\">").append(L2HubBoard.tr("Рано")).append("</font></td>");
+			}
+			else
+			{
+				sb.append("<td width=73>").append(kamael(kind) ? "" : L2HubBoard.button(L2HubBoard.tr("Тяжёлая"), COMMAND + " take " + GRADES[grade] + " heavy", 70)).append("</td>");
+				sb.append("<td width=73>").append(L2HubBoard.button(L2HubBoard.tr("Лёгкая"), COMMAND + " take " + GRADES[grade] + " light", 70)).append("</td>");
+				sb.append("<td width=74>").append(kamael(kind) ? "" : L2HubBoard.button(L2HubBoard.tr("Роба"), COMMAND + " take " + GRADES[grade] + " robe", 70)).append("</td>");
+			}
+			sb.append("</tr></table><img src=\"L2UI.SquareGray\" width=520 height=1>");
+		}
+		return sb.toString();
+	}
+
+	/**
+	 * Выдать набор.
+	 * @param player кому
+	 * @param grade номер в {@link #GRADES}
+	 * @param armor heavy, light или robe
+	 * @return текст отказа или null, если выдан
+	 */
+	public static String take(Player player, int grade, String armor)
+	{
+		final List<int[]> goods = goods(player, grade, armor);
+		if (goods == null)
+		{
+			return L2HubBoard.tr("Такого набора нет.");
+		}
+		if (player.getLevel() < MIN_LEVEL[grade])
+		{
+			return L2HubBoard.tr("Этот набор — с ") + MIN_LEVEL[grade] + L2HubBoard.tr("-го уровня.");
+		}
+		if (taken(player, grade))
+		{
+			return L2HubBoard.tr("Этот набор ты уже получил.");
+		}
+
+		long weight = 0;
+		for (int[] good : goods)
+		{
+			final ItemTemplate template = ItemData.getInstance().getTemplate(good[0]);
+			weight += (long) template.getWeight() * good[1];
+		}
+		if (!player.getInventory().validateCapacity(goods.size()) || !player.getInventory().validateWeight(weight))
+		{
+			return L2HubBoard.tr("Не хватает места или слишком тяжело: разгрузись и возьми снова.");
+		}
+
+		final PlayerVariables variables = player.getVariables();
+		variables.set(variable(grade), true);
+		variables.storeMe();
+		for (int[] good : goods)
+		{
+			player.addItem(ItemProcessType.REWARD, good[0], good[1], player, true);
+		}
+		return null;
+	}
+
+	/**
+	 * Что лежит в наборе: пары «вещь, количество».
+	 * @param player кому
+	 * @param grade номер в {@link #GRADES}
+	 * @param armor heavy, light или robe
+	 * @return список или null, если такого набора нет (камаэлям только лёгкая броня)
+	 */
+	public static List<int[]> goods(Player player, int grade, String armor)
+	{
+		if ((grade < 0) || (grade >= GRADES.length))
+		{
+			return null;
+		}
+		final String kind = kind(player);
+		final int[][] table = armor.equals("light") ? LIGHT : kamael(kind) ? null : armor.equals("heavy") ? HEAVY : armor.equals("robe") ? ROBE : null;
+		if (table == null)
+		{
+			return null;
+		}
+
+		final List<int[]> out = new ArrayList<>();
+		out.add(new int[] { WEAPONS.get(kind)[grade], 1 });
+		if (kind.equals("SWORD") || kind.equals("BLUNT"))
+		{
+			out.add(new int[] { SHIELDS[grade], 1 });
+		}
+		for (int id : table[grade])
+		{
+			out.add(new int[] { id, 1 });
+		}
+		for (int id : JEWELS[grade])
+		{
+			out.add(new int[] { id, 1 });
+		}
+		out.add(new int[] { shots(player, grade), SHOTS_COUNT });
+		if (kind.equals("BOW"))
+		{
+			out.add(new int[] { ARROWS[grade], SHOTS_COUNT });
+		}
+		else if (kind.equals("CROSSBOW"))
+		{
+			out.add(new int[] { BOLTS[grade], SHOTS_COUNT });
+		}
+		return out;
+	}
+
+	public static boolean taken(Player player, int grade)
+	{
+		return player.getVariables().getBoolean(variable(grade), false);
+	}
+
+	public static String kind(Player player)
+	{
+		if (player.isMageClass())
+		{
+			return "MAGIC";
+		}
+		return switch (player.getPlayerClass().getId())
+		{
+			case 2, 88, 21, 100, 34, 107 -> "DUAL";
+			case 3, 89 -> "POLE";
+			case 1, 44, 45, 46, 113 -> "BIGSWORD";
+			case 47, 48, 114 -> "FIST";
+			case 53, 54, 55, 117, 56, 57, 118 -> "BLUNT";
+			case 7, 8, 93, 22, 23, 101, 35, 36, 108 -> "DAGGER";
+			case 9, 92, 24, 102, 37, 109 -> "BOW";
+			case 123, 125, 127, 131, 128, 132 -> "ANCIENT";
+			case 124, 126, 129, 133, 135, 136 -> "RAPIER";
+			case 130, 134 -> "CROSSBOW";
+			default -> "SWORD";
+		};
+	}
+
+	private static boolean kamael(String kind)
+	{
+		return kind.equals("ANCIENT") || kind.equals("RAPIER") || kind.equals("CROSSBOW");
+	}
+
+	private static int shots(Player player, int grade)
+	{
+		return player.isMageClass() ? MAGE_SHOTS[grade] : SHOTS[grade];
+	}
+
+	private static int grade(String name)
+	{
+		for (int i = 0; i < GRADES.length; i++)
+		{
+			if (GRADES[i].equalsIgnoreCase(name))
+			{
+				return i;
+			}
+		}
+		return -1;
+	}
+
+	private static String variable(int grade)
+	{
+		return "L2HubKit_" + GRADES[grade];
+	}
+
+	private static String name(int id)
+	{
+		return ItemData.getInstance().getTemplate(id).getName();
+	}
+}
