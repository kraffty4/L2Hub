+# ---------------------------------------------------------------------------
+# L2Hub: календарь сезонных событий Mobius (data/scripts/events), как у Interlude
+# ---------------------------------------------------------------------------
+# У Mobius даты событий в config.xml — прошлые годы, поэтому они выключены («has passed... Ignored»).
+# Здесь — окно каждого события (ключ — папка события):
+#   дд ММ-дд ММ            — каждый год; конец не позже начала — окно переходит через Новый год
+#                            («01 12-01 01» — весь декабрь с 31-м, «01 01-01 01» — весь год);
+#   дд ММ гггг-дд ММ гггг  — один раз;
+#   Off                    — выключено;
+#   пусто                  — как в config.xml события.
+# Конец окна — начало указанного дня: чтобы захватить 31 декабря, конец — «01 01». Новое окно действует со следующего
+# запуска сервера.
+# По умолчанию события идут по году одно за другим, без пересечений: всегда одно (docs/WORLD.md, раздел 2).
+
+# Календарь целиком: False — всё как в config.xml событий (у Mobius — выключено).
+# Default: True
+Enabled = True
+
+# Saving Santa: Санта и его помощники в городах, подарки и мини-игра с Сантой.
+SavingSanta = 01 01-14 02
+
+# Valentine Event: валентинки и шоколад — обмен на подарки у NPC события.
+TheValentineEvent = 15 02-31 03
+
+# L2 Day: буквы с монстров — слова NCSOFT, CHRONICLE, LINEAGE II у менеджеров в стартовых деревнях.
+L2Day = 01 04-15 05
+
+# Gift of Vitality: NPC события в городах — бафы и подарки.
+GiftOfVitality = 16 05-30 06
+
+# Watermelon Ninja: семена с монстров — вырастить арбуз и разбить за награду.
+WatermelonNinja = 01 07-14 08
+
+# Heavy Medal: медали с монстров — значки у кота Roy, «орёл или решка» на улучшение значка.
+HeavyMedal = 15 08-30 09
+
+# Love Your Gatekeeper: превращение в гейткипера и награды у NPC события.
+LoveYourGatekeeper = 01 10-14 11
+
+# Master of Enchanting: посох мастера и свитки события — награды за заточку.
+MasterOfEnchanting = 15 11-01 01
