+# Множитель регенерации HP синего чемпиона.
+ChampionBlueHpRegen = 1.0
+
+# Множитель опыта и SP синего чемпиона.
+ChampionBlueRewardsExpSp = 2.0
+
+# Множитель шанса обычного дропа синего чемпиона.
+ChampionBlueRewardsChance = 2.0
+
+# Множитель количества обычного дропа синего чемпиона.
+ChampionBlueRewardsAmount = 1.0
+
+# Множитель шанса адены и печатей синего чемпиона.
+ChampionBlueAdenasRewardsChance = 1.0
+
+# Множитель количества адены и печатей синего чемпиона.
+ChampionBlueAdenasRewardsAmount = 1.0
+
+# Множитель P. Atk и M. Atk синего чемпиона.
+ChampionBlueAtk = 1.0
+
+# Множитель скорости атаки и каста синего чемпиона.
+ChampionBlueSpdAtk = 1.0
+
+# Предметы-награды синего чемпиона: id,количество через ; (пусто — без наград).
+ChampionBlueRewardItems =
