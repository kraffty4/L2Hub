 # ---------------------------------------------------------------------------
 # Champion mobs - Turn random mobs into Champions
 # ---------------------------------------------------------------------------
+# L2Hub: два уровня чемпионов. Ключи Champion* — красные (сильные), ChampionBlue* — синие
+# (слабые, блок в конце файла). Включение, пассивность, аура, уровни мобов, шансы
+# предметов-наград, виталити и инстансы — общие для обоих уровней.
 
 # Enable/Disable Champion Mob System.
-ChampionEnable = False
+ChampionEnable = True
 
 # Force Champion mobs to be passive?
 # To leave champion mobs to default/Aggressive, set to False.
 # To set all champion mobs to Passive, set True.
 ChampionPassive = False
 
-# % chance for a mob to became champion (0 to disable).
-ChampionFrequency = 5
+# Шанс красного чемпиона, % (0 — выключить). Допускаются дробные: 0.5.
+# Сначала бросается шанс красного, затем синего: всего чемпионов ChampionFrequency + ChampionBlueFrequency.
+ChampionFrequency = 1
 
-# Title of all Champion Mobs.
-ChampionTitle = Champion
+# Титул красного чемпиона.
+ChampionTitle = Elite Champion
 
-# Red aura for Champion Mobs.
+# Аура под чемпионами: у красных красная, у синих синяя.
 ChampionAura = True
 
 # Min and max levels allowed for a mob to be a Champion mob.
 ChampionMinLevel = 20
-ChampionMaxLevel = 70
+ChampionMaxLevel = 85
 
-# Hp multiplier for Champion mobs.
-ChampionHp = 8
+# Множитель HP красного чемпиона.
+ChampionHp = 4
 
-# Hp Regen Multiplier for Champion mobs.
+# Множитель регенерации HP красного чемпиона.
 ChampionHpRegen = 1.0
 
-# Exp/Sp rewards multiplier for Champion mobs.
-ChampionRewardsExpSp = 8.0
+# Множитель опыта и SP красного чемпиона.
+ChampionRewardsExpSp = 4.0
 
-# Standard rewards chance multiplier for Champion mobs.
-ChampionRewardsChance = 8.0
+# Множитель шанса обычного дропа красного чемпиона.
+ChampionRewardsChance = 4.0
 
-# Standard rewards amount multiplier for Champion mobs.
+# Множитель количества обычного дропа красного чемпиона.
 ChampionRewardsAmount = 1.0
 
-# Adena & Seal Stone rewards chance multiplier for Champion mobs.
+# Множитель шанса адены и печатей красного чемпиона.
 ChampionAdenasRewardsChance = 1.0
 
-# Adena & Seal Stone rewards amount multiplier for Champion mobs.
+# Множитель количества адены и печатей красного чемпиона.
 ChampionAdenasRewardsAmount = 1.0
 
-# P. Attack and M. Attack bonus for Champion mobs.
+# Множитель P. Atk и M. Atk красного чемпиона.
 ChampionAtk = 1.0
 
-# Physical/Magical Attack Speed bonus for Champion mobs.
+# Множитель скорости атаки и каста красного чемпиона.
 ChampionSpdAtk = 1.0
 
-# Specified id and amount of reward a player will receive if they are awarded the item.
-# Separated by ; 
+# Предметы-награды красного чемпиона: id,количество через ; (пусто — без наград).
 # Example: 6393,1;57,5000
 ChampionRewardItems = 6393,1
 
@@ -74,3 +77,43 @@ ChampionEnableVitality = False
 # Enable spawning of the champions in instances
 # Default = False
 ChampionEnableInInstances = False
+
+# ---------------------------------------------------------------------------
+# Синие чемпионы (L2Hub) — слабый уровень
+# ---------------------------------------------------------------------------
+
+# Шанс синего чемпиона, % (0 — выключить). Допускаются дробные: 0.5.
+ChampionBlueFrequency = 5
+
+# Титул синего чемпиона.
