+package org.l2jmobius.gameserver.data.xml;
+
+import java.io.File;
+import java.util.Map;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.logging.Logger;
+
+import org.w3c.dom.Document;
+
+import org.l2jmobius.commons.util.IXmlReader;
+import org.l2jmobius.gameserver.config.custom.MultilingualSupportConfig;
+import org.l2jmobius.gameserver.entity.actor.Player;
+import org.l2jmobius.gameserver.util.StatSet;
+
+/**
+ * L2Hub: названия точек телепорта на языке игрока — data/lang/&lt;язык&gt;/TeleportNameLocalisation.xml, как NpcNameLocalisation.<br>
+ * Ключ — английское название из data/teleporters; чего нет в файле, остаётся по-английски. Там же имя предмета платы по id.
+ * Файл собирает tools/teleport_names.py из tools/ru_pages/teleport_names.tsv (docs/RU_PAGES.md, «Список телепортов»).
+ * @author L2Hub
+ */
+public class TeleportNameLocalisationData implements IXmlReader
+{
+	private static final Logger LOGGER = Logger.getLogger(TeleportNameLocalisationData.class.getName());
+
+	private static final Map<String, Map<String, String>> NAMES = new ConcurrentHashMap<>();
+	private static final Map<String, Map<Integer, String>> ITEMS = new ConcurrentHashMap<>();
+	private String _lang;
+
+	protected TeleportNameLocalisationData()
+	{
+		load();
+	}
+
+	@Override
+	public synchronized void load()
+	{
+		NAMES.clear();
+		ITEMS.clear();
+		if (!MultilingualSupportConfig.MULTILANG_ENABLE)
+		{
+			return;
+		}
+
+		for (String lang : MultilingualSupportConfig.MULTILANG_ALLOWED)
+		{
+			final String path = "data/lang/" + lang + "/TeleportNameLocalisation.xml";
+			if (!new File(path).isFile())
+			{
+				continue;
+			}
+
+			NAMES.put(lang, new ConcurrentHashMap<>());
+			ITEMS.put(lang, new ConcurrentHashMap<>());
+			_lang = lang;
+			parseDatapackFile(path);
+			LOGGER.info(getClass().getSimpleName() + ": Loaded " + NAMES.get(lang).size() + " teleport names for [" + lang + "].");
+		}
+	}
+
+	@Override
+	public void parseDocument(Document document, File file)
+	{
+		forEach(document, "list", listNode ->
+		{
+			forEach(listNode, "location", node ->
+			{
+				final StatSet set = new StatSet(parseAttributes(node));
+				NAMES.get(_lang).put(set.getString("name"), set.getString("translation"));
+			});
+			forEach(listNode, "item", node ->
+			{
+				final StatSet set = new StatSet(parseAttributes(node));
+				ITEMS.get(_lang).put(set.getInt("id"), set.getString("name"));
+			});
+		});
+	}
+
+	/**
+	 * @param player кому показывается список
+	 * @param name название из data/teleporters
+	 * @return название на языке игрока или то же, если перевода нет
+	 */
+	public String getName(Player player, String name)
+	{
+		final Map<String, String> names = (name == null) || (player == null) || (player.getLang() == null) ? null : NAMES.get(player.getLang());
+		final String translation = names == null ? null : names.get(name);
+		return translation == null ? name : translation;
+	}
+
+	/**
+	 * @param player кому показывается список
+	 * @param itemId предмет платы
+	 * @param name имя предмета из датапака
+	 * @return имя предмета платы на языке игрока или то же, если перевода нет
+	 */
+	public String getItemName(Player player, int itemId, String name)
+	{
+		final Map<Integer, String> items = (player == null) || (player.getLang() == null) ? null : ITEMS.get(player.getLang());
+		final String translation = items == null ? null : items.get(itemId);
+		return translation == null ? name : translation;
+	}
+
+	public static TeleportNameLocalisationData getInstance()
+	{
+		return SingletonHolder.INSTANCE;
+	}
+
+	private static class SingletonHolder
+	{
+		protected static final TeleportNameLocalisationData INSTANCE = new TeleportNameLocalisationData();
+	}
+}
