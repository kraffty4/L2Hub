+	/** Quiet reuse check before invoking handlers that report cooldown failures to chat. */
+	private static boolean usePotion(Player player, Item item)
+	{
+		if ((item == null) || (item.getCount() <= 0) || (player.getItemRemainingReuseTime(item.getObjectId()) > 0) || (player.getReuseDelayOnGroup(item.getSharedReuseGroup()) > 0))
+		{
+			return false;
+		}
+		final SkillHolder[] skills = item.getEtcItem().getSkills();
+		if (skills != null)
+		{
+			for (SkillHolder holder : skills)
+			{
+				if (holder == null)
+				{
+					continue;
+				}
+				final Skill skill = holder.getSkill();
+				if ((skill != null) && (player.isSkillDisabled(skill) || (player.getSkillRemainingReuseTime(skill.getReuseHashCode()) > 0)))
+				{
+					return false;
+				}
+			}
+		}
+		final var handler = ItemHandler.getInstance().getHandler(item.getEtcItem());
+		if ((handler == null) || !handler.onItemUse(player, item, false))
+		{
+			return false;
+		}
+		if (item.getReuseDelay() > 0)
+		{
+			player.addTimeStampItem(item, item.getReuseDelay());
+		}
+		return true;
 	}
 	
