+  else if(raid.members.remove(id)){
+   final ConsumerEventListener listener=raid.armor.remove(id);if(listener!=null)player.removeListener(listener);
+   LOGGER.info("PhantomRaid: "+player.getName()+" leaves an autonomous raid for a clan invitation.");
+  }
+  return true;
+ }
