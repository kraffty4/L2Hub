+		final int[] xs = { -88000, -83760, -79600, -75648 };
+		final int[] ys = { -252637, -249762, -246951, -244290, -241490, -238825 };
+		for (int row = 0; row < ys.length; row++)
+		{
+			for (int col = 0; col < xs.length; col++)
+			{
+				// В последнем ряду только два стадиона: всего их 22.
+				if (((row < (ys.length - 1)) || (col < 2)) && (x == (xs[col] + 1200)) && (y == ys[row]))
+				{
+					return true;
+				}
+			}
+		}
+
+		return false;
+	}
