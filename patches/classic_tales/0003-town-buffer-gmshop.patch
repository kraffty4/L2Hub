+# ---------------------------------------------------------------------------
+# L2Hub: баффер и GM-шоп у гейткиперов городов
+# ---------------------------------------------------------------------------
+# NPC стоят рядом с гейткиперами 13 городов (data/spawns/Custom/L2HubTownNpcs.xml, расставляет tools/town_npcs.py).
+# False — NPC не появляются. Новое значение действует со следующего запуска гейм-сервера.
+
+# Баффер (50008): бафы на максимальном уровне и на 3 часа.
+# Default: True
+TownBuffer = True
+
+# GM-шоп (50010): расходники и снаряжение за адену.
+# Default: True
+TownGmShop = True
