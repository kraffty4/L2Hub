+package custom.L2HubTown;
+
+import org.l2jmobius.commons.util.ConfigReader;
+import org.l2jmobius.gameserver.entity.spawns.SpawnGroup;
+import org.l2jmobius.gameserver.entity.spawns.SpawnTemplate;
+import org.l2jmobius.gameserver.mechanics.script.Script;
+
+/**
+ * L2Hub: выключатели баффера и GM-шопа у гейткиперов городов.<br>
+ * NPC лежат в группах TownBuffer и TownGmShop спавна L2HubTownNpcs (data/spawns/Custom/L2HubTownNpcs.xml), которые сам Mobius не спавнит.
+ * Здесь спавнятся группы, включённые в config/Custom/L2HubTown.ini (имя группы — ключ). Новое значение действует со следующего запуска гейм-сервера.
+ */
+public class L2HubTown extends Script
+{
+	private static final String CONFIG_FILE = "./config/Custom/L2HubTown.ini";
+	
+	private L2HubTown()
+	{
+	}
+	
+	@Override
+	public void onSpawnActivate(SpawnTemplate template)
+	{
+		final ConfigReader config = new ConfigReader(CONFIG_FILE);
+		for (SpawnGroup group : template.getGroups())
+		{
+			if (group.getName() == null)
+			{
+				continue;
+			}
+			
+			if (!config.getBoolean(group.getName(), true))
+			{
+				LOGGER.info(getName() + ": " + group.getName() + " is turned off in L2HubTown.ini.");
+				continue;
+			}
+			
+			group.spawnAll();
+			LOGGER.info(getName() + ": " + group.getName() + " spawned " + group.getSpawns().stream().mapToInt(spawn -> spawn.getSpawnedNpcs().size()).sum() + " NPC.");
+		}
+	}
+	
+	public static void main(String[] args)
+	{
+		new L2HubTown();
+	}
+}
