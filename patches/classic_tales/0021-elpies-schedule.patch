+# ---------------------------------------------------------------------------
+# Elpies (custom/events/Elpies): нашествие кроликов-эльпи в городе
+# ---------------------------------------------------------------------------
+# 100 кроликов, скиллами по ним не бьют; с каждого падают расходники (зелья, благословлённые свитки телепорта и
+# воскрешения, Giant's Codex) и кристаллы. Город — ближайший к живому игроку из Aden, Dion, Gludin, Hunters Village,
+# Oren (у Mobius — случайный). Расписание Mobius в config.xml скрипта закомментировано — здесь своё; GM запускает и так.
+# Default: True
+Elpies = True
+
+# Крон «минуты часы день месяц день_недели», как schedule у Mobius; пусто — только командой GM.
+ElpiesSchedule = 30 */4 * * *
+
+# Длительность нашествия, мин (у Mobius — 2: одиночке не успеть даже добежать).
+# Default: 10
+ElpiesMinutes = 10
+
+# Старт по расписанию только при живом игроке в мире (с клиентом; фантомы и офлайн-торговцы не считаются).
+# Default: True
+ElpiesOnlyWithPlayers = True
