+# ---------------------------------------------------------------------------
+# L2Hub: самопроверка модов (data/scripts/custom/L2HubSelfTest)
+# ---------------------------------------------------------------------------
+# Через минуту после старта сервер сверяет моды L2Hub без игрока (только чтение): баффер и GM-шоп у гейткиперов,
+# бафы на максимуме и на 3 часа, чемпионов, доску Alt+B, .buddy и .hunters, .daily и .raid, окно моба, фантомов.
+# Итог — в лог и в log/L2HubSelfTest.json (его показывает лаунчер в «Проверить всё»).
+# Default: True
+Enabled = True
