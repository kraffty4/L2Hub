+# ---------------------------------------------------------------------------
+# L2Hub: календарь сезонных событий Mobius (data/scripts/events)
+# ---------------------------------------------------------------------------
+# У Mobius даты событий в config.xml — 2017–2022, поэтому почти все выключены («has passed... Ignored»).
+# Здесь — окно каждого события (ключ — папка события):
+#   дд ММ-дд ММ            — каждый год; конец не позже начала — окно переходит через Новый год
+#                            («01 12-01 01» — весь декабрь с 31-м, «01 01-01 01» — весь год);
+#   дд ММ гггг-дд ММ гггг  — один раз;
+#   Off                    — выключено;
+#   пусто или нет ключа    — как в config.xml события.
+# Конец окна — начало указанного дня: чтобы захватить 31 декабря, конец — «01 01». Новое окно действует со следующего
+# запуска сервера.
+# По умолчанию (предложение агента, 2026-10-21): круглый год — сбор букв, плюс одно событие на сезон.
+
+# Календарь целиком: False — всё как в config.xml событий.
+# Default: True
+Enabled = True
+
+# Сбор букв: буквы с монстров (по 1%) — слова на награды. У Mobius и так до 2034 — круглый год.
+LetterCollector = 01 01-01 01
+
+# Happy Hours: Ориана, монеты Сиби и знаки Рыцарей Балтуса — снабжение рыцарей.
+HappyHours = 01 01-01 02
+
+# The Power of Love: любовное зелье с монстров (30%) — у Коко Брауни.
+ThePowerOfLove = 01 02-01 03
+
+# Chef Monkey: бананы с монстров для Шеф-повара Обезьянки.
+ChefMonkeyEvent = 01 03-01 04
+
+# Ева-предсказательница: гадание у управляющего событием.
+EveTheFortuneTeller = 01 04-01 06
+
+# Watermelon Ninja: нектар с монстров (10%) — арбузы у Кота Ориона, из арбузов — награды.
+WatermelonNinja = 01 06-01 09
+
+# Squash: нектар с монстров (50%) — тыквы у Кота Ориона.
+SquashEvent = 01 09-01 11
+
+# Total Recall: зомби-лорд Шкроул.
+TotalRecall = 01 11-01 12
+
+# Merry Squashmas: снежный нектар с монстров (50%) — у Деда Мороза.
+MerrySquashmas = 01 12-01 01
