+	/**
+	 * L2Hub: окно события из config/Custom/L2HubEvents.ini — «дд ММ-дд ММ» (каждый год; конец не позже начала — через Новый год),
+	 * «дд ММ гггг-дд ММ гггг» или Off.<br>
+	 * Нет файла, Enabled = False, нет ключа или значение не по формату — окно из config.xml события, как в Mobius.
+	 * @param name имя скрипта события (папка в data/scripts/events)
+	 * @return окно, «Off» или {@code null}
+	 */
+	private static String l2hubCalendar(String name)
+	{
+		final File file = new File("./config/Custom/L2HubEvents.ini");
+		if (!file.isFile())
+		{
+			return null;
+		}
+		
+		final Properties properties = new Properties();
+		try (Reader reader = Files.newBufferedReader(file.toPath(), StandardCharsets.UTF_8))
+		{
+			properties.load(reader);
+		}
+		catch (Exception e)
+		{
+			LOGGER.warning("L2HubEvents.ini: " + e.getMessage());
+			return null;
+		}
+		
+		if ("false".equalsIgnoreCase(properties.getProperty("Enabled", "True").trim()))
+		{
+			return null;
+		}
+		
+		final String value = properties.getProperty(name, "").trim();
+		if (value.equalsIgnoreCase("off") || (value.length() == 21))
+		{
+			return value;
+		}
+		
+		if (value.length() == 11)
+		{
+			return l2hubAnnual(name, value);
+		}
+		
+		if (!value.isEmpty())
+		{
+			LOGGER.warning("L2HubEvents.ini: " + name + " = " + value + " — not «dd MM-dd MM» or «dd MM yyyy-dd MM yyyy», using config.xml.");
+		}
+		return null;
+	}
+	
+	/**
+	 * L2Hub: ежегодное окно «дд ММ-дд ММ» → «дд ММ гггг-дд ММ гггг». Конец — начало указанного дня, как у Mobius; конец не позже
+	 * начала — окно переходит через Новый год: «01 12-01 01» — весь декабрь с 31-м, «01 01-01 01» — весь год.
+	 * @param name имя скрипта события
+	 * @param value окно «дд ММ-дд ММ»
+	 * @return окно с годами или {@code null}, если даты не разобрать
+	 */
+	private static String l2hubAnnual(String name, String value)
+	{
+		try
+		{
+			final String[] parts = value.split("-");
+			final LocalDate today = LocalDate.now();
+			LocalDate start = LocalDate.parse(parts[0].trim() + " " + today.getYear(), DATE_FORMAT);
+			LocalDate end = LocalDate.parse(parts[1].trim() + " " + today.getYear(), DATE_FORMAT);
+			if (!end.isAfter(start))
+			{
+				// Через Новый год: сегодня ещё до конца — окно началось в прошлом году, иначе кончится в следующем.
+				if (today.isBefore(end))
+				{
+					start = start.minusYears(1);
+				}
+				else
+				{
+					end = end.plusYears(1);
+				}
+			}
+			return start.format(DATE_FORMAT) + "-" + end.format(DATE_FORMAT);
+		}
+		catch (Exception e)
+		{
+			LOGGER.warning("L2HubEvents.ini: " + name + " = " + value + " — " + e.getMessage() + ", using config.xml.");
+			return null;
+		}
+	}
