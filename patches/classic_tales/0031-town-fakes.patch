+<?xml version="1.0" encoding="UTF-8"?>
+<!-- L2Hub: заготовки реплик фейков в городах (скрипт custom/L2HubTownFakes, генератор tools/l2hub_town_fakes.py).
+     Язык — L2HubLanguage из config/Custom/L2HubWorld.ini (ru или en; нет английской строки — русская).
+     С мозгами фейков (FakePlayerBrain) заготовка — только подсказка тона, реплику пишет модель (кроме arrive, leave и trade.* — они всегда заготовкой).
+     Ключи: idle.<роль>[.day|.evening|.night] — болтовня в общий чат; idle.seasonal — пока идёт сезонное событие;
+     trade.<роль> — объявления в торговый чат (lfp — в крик); event.<вид> — реакции на события мира; arrive и leave — пришёл и ушёл.
+     Переменные: {town} — город, {in} — «в городе», {where} — где стоит, {store} — вывеска лавки, {cls} — класс, {level} — уровень;
+     в событиях — {boss}, {blevel}, {place} (у какого города), {leader}, {event}, {text}. -->
+<list>
+	<!-- Где стоит фейк (near у места в data/L2HubTownFakes.xml). -->
+	<word key="near.gk" ru="у ГК" en="by the GK" />
+	<word key="near.wh" ru="у склада" en="by the warehouse" />
+	<word key="near.shop" ru="у лавок" en="by the shops" />
+	<word key="near.master" ru="у гильдии" en="by the guild" />
+	<word key="near.oly" ru="у олимпиады" en="by the Olympiad" />
+	<word key="near.fish" ru="у рыбаков" en="by the fishermen" />
+	<word key="near.square" ru="на площади" en="on the square" />
+	<word key="market.up" ru="цена на рынке выросла на" en="market price is up" />
+	<word key="market.down" ru="цена на рынке упала на" en="market price is down" />
+	<word key="market.short" ru="дефицит, цена выросла на" en="shortage, price is up" />
+	<!-- Сезонные события (имя скрипта LongTimeEvent); нет в списке — имя скрипта как есть. -->
+	<word key="event.L2Day" ru="День Lineage" en="L2 Day" />
+	<word key="event.HeavyMedal" ru="медальки" en="Medal event" />
+	<word key="event.Christmas" ru="Рождество" en="Christmas" />
+	<word key="event.SavingSanta" ru="Спасение Санты" en="Saving Santa" />
+	<word key="event.FreyaCelebration" ru="праздник Фреи" en="Freya Celebration" />
+	<word key="event.GiftOfVitality" ru="Дар Виталити" en="Gift of Vitality" />
+	<word key="event.LoveYourGatekeeper" ru="Люби своего ГК" en="Love Your Gatekeeper" />
+	<word key="event.MasterOfEnchanting" ru="Мастер заточки" en="Master of Enchanting" />
+	<word key="event.TheValentineEvent" ru="День святого Валентина" en="Valentine event" />
+	<word key="event.WatermelonNinja" ru="арбузы" en="Watermelon event" />
+	<word key="event.SquashEvent" ru="тыквы" en="Squash event" />
+	<word key="event.MerrySquashmas" ru="новогодние тыквы" en="Merry Squashmas" />
