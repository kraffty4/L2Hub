+		ThreadPool.scheduleAtFixedRate(L2HubWorldInfo::writeStatus, 30000, STATUS_PERIOD);
+		LOGGER.info("L2HubWorldInfo: .world — мир сейчас (суперчемпионы, сезонные события, расписание ивентов), " + STATUS_FILE + " раз в минуту.");
+	}
