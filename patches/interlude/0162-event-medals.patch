@@ -72,6 +72,9 @@ public class L2HubPvpEvents
 	private static final int REWARD_MOBS = tvt("PvpRewardMobs", 0, 0, 1000);
 	private static final int REWARD_WINNER_FACTOR = tvt("PvpRewardWinnerFactor", 2, 1, 10);
 	private static final boolean REWARD_SCROLLS = "true".equalsIgnoreCase(config().getProperty("PvpRewardScrolls", "False").trim());
+	private static final int REWARD_MEDALS = tvt("PvpRewardMedals", 0, 0, 1000);
+	/** Медаль за ивент: её меняют на странице ивентов Alt+B. */
+	public static final int MEDAL_ITEM = tvt("PvpRewardMedalItem", 6393, 1, Integer.MAX_VALUE);
 	private static final int REWARD_MINUTES = 20;
 	// @formatter:off
 	/** Средний моб High Five без рейтов, медианы датапака по десяткам уровней: уровень, опыт, SP, адена. */
@@ -436,6 +439,20 @@ public class L2HubPvpEvents
 		return 0;
 	}
 
+	/**
+	 * @param minutes сколько минут идёт бой этого ивента
+	 * @param winner победитель
+	 * @return медали живому игроку за ивент, 0 — медали выключены
+	 */
+	public static int rewardMedals(int minutes, boolean winner)
+	{
+		if (REWARD_MEDALS <= 0)
+		{
+			return 0;
+		}
+		return Math.max(1, (int) Math.round(((double) REWARD_MEDALS * minutes * (winner ? REWARD_WINNER_FACTOR : 1)) / REWARD_MINUTES));
+	}
+
 	/**
 	 * @return кто победил в командном ивенте; ничья — никто
 	 */
