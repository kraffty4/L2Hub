+				player.addItem(ItemProcessType.REWARD, MEDAL_ITEM, medals, player, true);
+			}
+			LOGGER.info("L2HubPvpEvents: " + player.getName() + " (" + level + ") gets " + adena + " adena, " + exp + " exp and " + medals + " medals" + (winner ? ", winner" : "") + ".");
 		}
