+package custom.L2HubMacros;
+
+import org.l2jmobius.gameserver.data.xml.InitialShortcutData;
+import org.l2jmobius.gameserver.entity.actor.Player;
+import org.l2jmobius.gameserver.managers.phantom.PhantomManager;
+import org.l2jmobius.gameserver.mechanics.events.Containers;
+import org.l2jmobius.gameserver.mechanics.events.EventType;
+import org.l2jmobius.gameserver.mechanics.events.holders.actor.player.OnPlayerLogin;
+import org.l2jmobius.gameserver.mechanics.events.listeners.ConsumerEventListener;
+
+/**
+ * L2Hub: макросы команд живым игрокам при входе: тем, кто создан раньше, и после включения команды в настройках ({@link InitialShortcutData#giveMissingMacros}).
+ * @author L2Hub
+ */
+public class L2HubMacros
+{
+	private static final L2HubMacros OWNER = new L2HubMacros();
+
+	public static void main(String[] args)
+	{
+		Containers.Global().addListener(new ConsumerEventListener(Containers.Global(), EventType.ON_PLAYER_LOGIN, (OnPlayerLogin event) -> give(event.getPlayer()), OWNER));
+	}
+
+	private static void give(Player player)
+	{
+		if (!PhantomManager.getInstance().isPhantom(player))
+		{
+			InitialShortcutData.getInstance().giveMissingMacros(player);
+		}
+	}
+}
