+	private static void clan(Player player, List<Player> spare) throws Exception
+	{
+		if (player == null)
+		{
+			check("clan: no clanless hunter to play", false);
+			return;
+		}
+		park(player);
+		final String form = L2HubBoard.clan(player, new String[]
+		{
+			"_bbshubclan"
+		});
+		Files.writeString(Path.of("./log/L2HubBoardClanForm.html"), form);
+		check("clan: form for the clanless", form.contains("create $clan_name"));
+
+		for (String[] bad : new String[][]
+		{
+			{ "_bbshubclan", "create" },
+			{ "_bbshubclan", "create", "two", "words" },
+			{ "_bbshubclan", "create", "bad!name" },
+			{ "_bbshubclan", "create", "x" },
+			{ "_bbshubclan", "create", "abcdefghijklmnopq" }
+		})
+		{
+			L2HubBoard.clan(player, bad);
+			check("clan: refused " + String.join(" ", bad), player.getClan() == null);
+		}
+
+		final Player young = pick(spare, p -> (p.getClan() == null) && (p.getLevel() < 10));
+		if (young != null)
+		{
+			park(young);
+			L2HubBoard.clan(young, new String[]
+			{
+				"_bbshubclan",
+				"create",
+				"L2HubBoardYoung"
+			});
+			check("clan: level " + young.getLevel() + " refused", young.getClan() == null);
+		}
+
+		final String name = "L2HubBoard" + (System.currentTimeMillis() % 100000);
+		final String page = L2HubBoard.clan(player, new String[]
+		{
+			"_bbshubclan",
+			"create",
+			name
+		});
+		final Clan clan = player.getClan();
+		check("clan: created " + name + ", leader", (clan != null) && clan.getName().equals(name) && player.isClanLeader());
+		check("clan: form is gone", !page.contains("create $clan_name"));
+		if (clan == null)
+		{
+			return;
+		}
+		L2HubBoard.clan(player, new String[]
+		{
+			"_bbshubclan",
+			"create",
+			name + "2"
+		});
+		check("clan: second clan refused", (player.getClan() == clan) && (ClanTable.getInstance().getClanByName(name + "2") == null));
+
+		final Field entries = MultisellData.class.getDeclaredField("_entries");
+		entries.setAccessible(true);
+		check("clan items: list " + CLAN_LIST + " is loaded", ((Map<?, ?>) entries.get(MultisellData.getInstance())).containsKey(CLAN_LIST));
+		player.setSp(100000000L);
+		clan.changeLevel(2);
+		for (int[] step : new int[][]
+		{
+			{ 3, 1419 },
+			{ 4, 3874 },
+			{ 5, 3870 }
+		})
+		{
+			final boolean empty = !clan.levelUpClan(player);
+			player.addItem(ItemProcessType.QUEST, step[1], 1, player, false);
+			final boolean up = clan.levelUpClan(player);
+			check("clan items: level " + step[0] + " needs " + ItemData.getInstance().getTemplate(step[1]).getName(), empty && up && (clan.getLevel() == step[0]) && (player.getInventory().getInventoryItemCount(step[1], -1) == 0));
+		}
+		ClanTable.getInstance().destroyClan(clan.getId());
+		check("clan: test clan dissolved", ClanTable.getInstance().getClanByName(name) == null);
+	}
+
+	private static void kits(List<Player> spare) throws Exception
+	{
+		check("handlers of the new commands", (CommunityBoardHandler.getInstance().getHandler("_bbshubspots") != null) && (CommunityBoardHandler.getInstance().getHandler(L2HubKits.COMMAND) != null));
+		final Player shopper = pick(spare, p -> p.getLevel() >= 20);
+		if (shopper != null)
+		{
+			park(shopper);
+			final Method shop = L2HubBoard.class.getDeclaredMethod("shop", Player.class, String[].class);
+			shop.setAccessible(true);
+			final String page = (String) shop.invoke(null, shopper, new String[]
+			{
+				"_bbshubshop"
+			});
+			Files.writeString(Path.of("./log/L2HubBoardShop.html"), page);
+			check("shop: first page " + page.length() + " chars has kits and clan items", page.contains("bypass " + L2HubKits.COMMAND + "\"") && page.contains("_bbshubshop ms " + CLAN_LIST + " 0"));
+		}
+
+		final Map<String, Predicate<Player>> roles = new java.util.LinkedHashMap<>();
+		roles.put("fighter", p -> L2HubKits.kind(p).equals("SWORD") || L2HubKits.kind(p).equals("BLUNT"));
+		roles.put("mage", p -> p.isMageClass() && (p.getLevel() >= 40));
+		roles.put("archer", p -> L2HubKits.kind(p).equals("BOW"));
+		roles.put("dagger", p -> L2HubKits.kind(p).equals("DAGGER") && (p.getLevel() >= 40));
+		roles.put("kamael", p -> L2HubKits.kind(p).equals("CROSSBOW") || L2HubKits.kind(p).equals("ANCIENT") || L2HubKits.kind(p).equals("RAPIER"));
+		roles.put("twohand", p -> L2HubKits.kind(p).equals("BIGSWORD") || L2HubKits.kind(p).equals("POLE") || L2HubKits.kind(p).equals("DUAL") || L2HubKits.kind(p).equals("FIST"));
+		roles.put("young", p -> p.getLevel() < 20);
+		for (Map.Entry<String, Predicate<Player>> role : roles.entrySet())
+		{
+			final Player player = pick(spare, role.getValue());
+			if (player == null)
+			{
+				LOGGER.info(TAG + "kits: no hunter for " + role.getKey() + ".");
+				continue;
+			}
+			park(player);
+			kit(role.getKey(), player, "light");
+		}
+
+		// Самый тяжёлый набор на самом слабом по весу.
+		final Player weakest = spare.stream().filter(p -> (p.getLevel() >= 40) && (L2HubKits.goods(p, 0, "heavy") != null)).min(Comparator.comparingInt(Player::getMaxLoad)).orElse(null);
+		if (weakest == null)
+		{
+			LOGGER.info(TAG + "kits: no hunter for weakest.");
+			return;
+		}
+		spare.remove(weakest);
+		park(weakest);
+		kit("weakest", weakest, "heavy");
+	}
+
+	/**
+	 * Охотник приходит со своей сумкой, на копии мира она бывает забита. Наборы проверяются на разгруженном, вещи возвращаются.
+	 */
+	private static void kit(String role, Player player, String armor) throws Exception
+	{
+		final String who = "kits " + role + " (" + player.getPlayerClass() + ", " + player.getLevel() + ", " + L2HubKits.kind(player) + "): ";
+		final PlayerInventory bag = player.getInventory();
+		final int slots = bag.getNonQuestSize();
+		final int load = bag.getTotalWeight();
+		final List<long[]> moved = unload(player);
+		LOGGER.info(TAG + who + "bag " + slots + " of " + player.getInventoryLimit() + " slots, weight " + load + " of " + player.getMaxLoad() + "; unloaded " + moved.size() + ": " + bag.getNonQuestSize() + " slots, weight " + bag.getTotalWeight() + "; ng " + armor + " kit needs " + L2HubKits.goods(player, 0, armor).size() + " slots, weight " + weight(L2HubKits.goods(player, 0, armor)) + ".");
+		try
+		{
+			kitChecks(who, role, player, armor);
+		}
+		finally
+		{
+			reload(player, moved);
+			check(who + "bag back: " + bag.getNonQuestSize() + " slots, weight " + bag.getTotalWeight(), (bag.getNonQuestSize() == slots) && (bag.getTotalWeight() == load));
+		}
+	}
+
+	/**
+	 * Вынести на склад всё, что не надето, кроме адены и квестового.
+	 * @param player охотник в роли игрока
+	 * @return что вынесено: objectId, itemId, количество, стакается ли
+	 */
+	private static List<long[]> unload(Player player)
+	{
+		final List<long[]> moved = new ArrayList<>();
+		for (Item item : new ArrayList<>(player.getInventory().getItems()))
+		{
+			if (item.isEquipped() || item.isQuestItem() || (item.getId() == Inventory.ADENA_ID))
+			{
+				continue;
+			}
+			moved.add(new long[]
+			{
+				item.getObjectId(),
+				item.getId(),
+				item.getCount(),
+				item.isStackable() ? 1 : 0
+			});
+			player.getInventory().transferItem(ItemProcessType.TRANSFER, item.getObjectId(), item.getCount(), player.getWarehouse(), player, null);
+		}
+		return moved;
+	}
+
+	private static void reload(Player player, List<long[]> moved)
+	{
+		for (long[] entry : moved)
+		{
+			// Стопка на складе могла слиться с прежней и сменить objectId: её ищем по itemId, штуки — по objectId.
+			final Item item = entry[3] != 0 ? player.getWarehouse().getItemByItemId((int) entry[1]) : player.getWarehouse().getItemByObjectId((int) entry[0]);
+			if (item != null)
+			{
+				player.getWarehouse().transferItem(ItemProcessType.TRANSFER, item.getObjectId(), entry[2], player.getInventory(), player, null);
+			}
+		}
+	}
+
+	private static long weight(List<int[]> goods)
+	{
+		long weight = 0;
+		for (int[] good : goods)
+		{
+			weight += (long) ItemData.getInstance().getTemplate(good[0]).getWeight() * good[1];
+		}
+		return weight;
+	}
+
+	private static void kitChecks(String who, String role, Player player, String armor) throws Exception
+	{
+		final String page = L2HubKits.content(player, new String[]
+		{
+			L2HubKits.COMMAND
+		});
+		Files.writeString(Path.of("./log/L2HubBoardKits_" + role + ".html"), page);
+		check(who + "page " + page.length() + " chars", page.length() < PAGE_LIMIT);
+		overload(who, player, armor);
+		for (int grade = 0; grade < L2HubKits.GRADES.length; grade++)
+		{
+			final List<int[]> goods = L2HubKits.goods(player, grade, armor);
+			for (int[] good : goods)
+			{
+				if (ItemData.getInstance().getTemplate(good[0]) == null)
+				{
+					check(who + "no item " + good[0], false);
+				}
+			}
+			final Map<Integer, Long> before = counts(player, goods);
+			final boolean low = player.getLevel() < new int[]
+			{
+				1,
+				20,
+				40
+			}[grade];
+			final String answer = L2HubKits.take(player, grade, armor);
+			if (low)
+			{
+				check(who + L2HubKits.GRADES[grade] + " refused for the level", (answer != null) && !L2HubKits.taken(player, grade) && counts(player, goods).equals(before));
+				continue;
+			}
+			final Map<Integer, Long> expected = new HashMap<>(before);
+			for (int[] good : goods)
+			{
+				expected.merge(good[0], (long) good[1], Long::sum);
+			}
+			check(who + L2HubKits.GRADES[grade] + " given, " + goods.size() + " kinds: " + answer, (answer == null) && counts(player, goods).equals(expected) && L2HubKits.taken(player, grade));
+			final String again = L2HubKits.take(player, grade, armor);
+			check(who + L2HubKits.GRADES[grade] + " only once", (again != null) && counts(player, goods).equals(expected));
+			// Убрать выданное, иначе следующий грейд упрётся в вес: отказ по весу проверяет overload.
+			for (int[] good : goods)
+			{
+				player.destroyItemByItemId(ItemProcessType.DESTROY, good[0], good[1], player, false);
+			}
+		}
+
+		final boolean kamael = L2HubKits.kind(player).equals("ANCIENT") || L2HubKits.kind(player).equals("RAPIER") || L2HubKits.kind(player).equals("CROSSBOW");
