+	/**
+	 * Перегруженному набор не выдаётся, вещи не появляются, флаг «взял» не ставится: набор можно взять, разгрузившись.
+	 * @param who начало строки проверки
+	 * @param player охотник в роли игрока
+	 * @param armor тип брони
+	 */
+	private static void overload(String who, Player player, String armor)
+	{
+		final PlayerInventory bag = player.getInventory();
+		final List<int[]> goods = L2HubKits.goods(player, 0, armor);
+		final long weight = weight(goods);
+		int heaviest = goods.get(0)[0];
+		for (int[] good : goods)
+		{
+			if (ItemData.getInstance().getTemplate(good[0]).getWeight() > ItemData.getInstance().getTemplate(heaviest).getWeight())
+			{
+				heaviest = good[0];
+			}
+		}
+		final int slots = bag.getNonQuestSize();
+		final int load = bag.getTotalWeight();
+		// Пока оба условия верны, в сумке есть слот: сверх предела addItem бросил бы вещь на землю (AutoLootSlotLimit), и снять её было бы нечем.
+		int added = 0;
+		while (bag.validateWeight(weight) && bag.validateCapacity(goods.size()))
+		{
+			player.addItem(ItemProcessType.QUEST, heaviest, 1, player, false);
+			added++;
+		}
+		final String by = bag.validateWeight(weight) ? "slots" : "weight";
+		final Map<Integer, Long> before = counts(player, goods);
+		final String answer = L2HubKits.take(player, 0, armor);
+		check(who + "overloaded by " + by + " with " + added + " pieces: refused, nothing given, not marked: " + answer, (answer != null) && !L2HubKits.taken(player, 0) && counts(player, goods).equals(before));
+		player.destroyItemByItemId(ItemProcessType.DESTROY, heaviest, added, player, false);
+		check(who + "overload removed: " + bag.getNonQuestSize() + " slots, weight " + bag.getTotalWeight(), (bag.getNonQuestSize() == slots) && (bag.getTotalWeight() == load));
+	}
+
+	private static Map<Integer, Long> counts(Player player, List<int[]> goods)
+	{
+		final Map<Integer, Long> out = new HashMap<>();
+		for (int[] good : goods)
+		{
+			out.put(good[0], player.getInventory().getInventoryItemCount(good[0], -1));
+		}
+		return out;
+	}
