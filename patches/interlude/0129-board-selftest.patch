+/**
+ * L2Hub: самопроверка доски Alt+B на High Five, только на копии базы: {@code HuntersSelfTest = L2HUBBOARD} в PhantomHunters.ini.<br>
+ * Охотник играет игрока: страницы и телепорт спотов, создание клана и прокачка его предметами Clan Items, стартовые наборы по классам. Страницы — в log/, итог — строки в логе.
+ * @author L2Hub
+ */
+public class L2HubBoardTest
+{
+	private static final Logger LOGGER = Logger.getLogger(L2HubBoardTest.class.getName());
+	private static final String TAG = "L2HubBoardTest: SelfTest L2HUBBOARD: ";
+	private static final Location GIRAN = new Location(83400, 147943, -3404);
+	private static final int PAGE_LIMIT = 16250;
+	private static final int CLAN_LIST = 50040008;
+	private static final int[] BANDS =
+	{
+		1,
+		10,
+		20,
+		30,
+		40,
+		50,
+		60,
+		70,
+		80
+	};
+	private static final Pattern GO = Pattern.compile("_bbshubspots go (\\d+) ");
+	private static final long STARTED = System.currentTimeMillis();
+	private static int _ok;
+	private static int _wrong;
+
+	public static void main(String[] args)
+	{
+		if ("L2HUBBOARD".equalsIgnoreCase(PhantomHuntersConfig.HUNTERS_SELF_TEST))
+		{
+			ThreadPool.schedule(L2HubBoardTest::start, 60000);
+		}
+	}
+
+	private static void start()
+	{
+		if ((free().size() < 100) && ((System.currentTimeMillis() - STARTED) < (7 * 60000L)))
+		{
+			ThreadPool.schedule(L2HubBoardTest::start, 15000);
+			return;
+		}
+		try
+		{
+			final List<Player> spare = free();
+			LOGGER.info(TAG + "free hunters " + spare.size() + ".");
+			spots(pick(spare, p -> p.getLevel() >= 20));
+			clan(pick(spare, p -> (p.getClan() == null) && (p.getLevel() >= 10)), spare);
+			kits(spare);
+			LOGGER.info(TAG + "done: " + _ok + " ok, " + _wrong + " wrong.");
+		}
+		catch (Throwable e)
+		{
+			LOGGER.log(Level.WARNING, TAG + "failed: " + e, e);
+		}
+	}
+
+	private static void check(String what, boolean good)
+	{
+		if (good)
+		{
+			_ok++;
+			LOGGER.info(TAG + "ok " + what);
+		}
+		else
+		{
+			_wrong++;
+			LOGGER.warning(TAG + "WRONG " + what);
+		}
+	}
+
+	private static List<Player> free()
+	{
+		final List<Player> out = new ArrayList<>();
+		for (Player p : World.getPlayers())
+		{
+			if (PhantomManager.getInstance().isPhantom(p) && !p.isDead() && !p.isRegisteredOnEvent() && !p.isOnEvent() && !p.isInOlympiadMode() && !p.isInStoreMode() && !p.isInParty())
+			{
+				out.add(p);
+			}
+		}
+		Collections.shuffle(out);
+		return out;
+	}
+
+	private static Player pick(List<Player> spare, Predicate<Player> test)
+	{
+		for (Player p : spare)
+		{
+			if (test.test(p))
+			{
+				spare.remove(p);
+				return p;
+			}
+		}
+		return null;
+	}
+
+	/**
+	 * Снять с охотников (иначе уйдёт качаться) и поставить в мирном Гиране.
+	 */
+	private static void park(Player player) throws Exception
+	{
+		final Field hunters = PhantomHunterManager.class.getDeclaredField("_hunters");
+		hunters.setAccessible(true);
+		((Map<?, ?>) hunters.get(PhantomHunterManager.getInstance())).remove(player.getName().toLowerCase());
+		AutoPlayTaskManager.getInstance().stopAutoPlay(player);
+		player.stopMove(null);
+		player.abortAttack();
+		player.abortCast();
+		player.setTarget(null);
+		player.setPvpFlag(0);
+		player.setKarma(0);
+		if (player.isSitting())
+		{
+			player.standUp(); // сидячему SitDownTask ставит паралич до вставания
+			Thread.sleep(3000);
+		}
+		player.teleToLocation(GIRAN);
+		for (int i = 0; (i < 40) && player.isInCombat(); i++)
+		{
+			Thread.sleep(500);
+		}
+		Thread.sleep(500);
+	}
+
+	private static void spots(Player player) throws Exception
+	{
+		if (player == null)
+		{
+			check("spots: no hunter to play", false);
+			return;
+		}
+		park(player);
+		final String bands = L2HubBoard.spots(player, new String[]
+		{
+			"_bbshubspots"
+		});
+		Files.writeString(Path.of("./log/L2HubBoardSpots.html"), bands);
+		check("spots: bands page " + bands.length() + " chars", (bands.length() < PAGE_LIMIT) && bands.contains("_bbshubspots 20") && bands.contains("80+"));
+
+		int rows = 0;
+		int longest = 0;
+		int maxRows = 0;
+		int pagesTotal = 0;
+		String sample = null;
+		final Map<String, Integer> names = new HashMap<>();
+		for (int band : BANDS)
+		{
+			for (int page = 0;; page++)
+			{
+				final String html = L2HubBoard.spots(player, new String[]
+				{
+					"_bbshubspots",
+					String.valueOf(band),
+					String.valueOf(page)
+				});
+				longest = Math.max(longest, html.length());
+				pagesTotal++;
+				final Matcher m = GO.matcher(html);
+				int onPage = 0;
+				while (m.find())
+				{
+					onPage++;
+					names.merge(m.group(1), 1, Integer::sum);
+				}
+				rows += onPage;
+				maxRows = Math.max(maxRows, onPage);
+				if ((band == 20) && (page == 0))
+				{
+					sample = html;
+				}
+				if (!html.contains("_bbshubspots " + band + " " + (page + 1)))
+				{
+					break;
+				}
+			}
+		}
+		Files.writeString(Path.of("./log/L2HubBoardSpotsList.html"), sample);
+		final int all = HuntSpotData.getInstance().getSpots().size();
+		check("spots: " + pagesTotal + " pages, " + rows + " rows of " + all + " spots, longest page " + longest + " chars, at most " + maxRows + " rows", (longest < PAGE_LIMIT) && (maxRows <= 10) && (rows > 0) && (rows <= all));
+		check("spots: every row once, across pages", names.values().stream().allMatch(c -> c == 1));
+
+		final Matcher first = GO.matcher(sample);
+		first.find();
+		final int index = Integer.parseInt(first.group(1));
+		final Location entry = HuntSpotData.getInstance().getSpots().get(index).entry;
+		final String[] go =
+		{
+			"_bbshubspots",
+			"go",
+			String.valueOf(index),
+			"20",
+			"0"
+		};
+
+		player.setKarma(100);
+		final String refused = L2HubBoard.spots(player, go);
+		check("spots: karma keeps you here", (refused != null) && (player.calculateDistance3D(GIRAN) < 500));
+		player.setKarma(0);
+
+		final String past = L2HubBoard.spots(player, new String[]
+		{
+			"_bbshubspots",
+			"go",
+			"999999",
+			"20",
+			"0"
+		});
+		check("spots: bad number keeps you here", (past != null) && (player.calculateDistance3D(GIRAN) < 500));
+
+		final long adena = player.getAdena();
+		final String flew = L2HubBoard.spots(player, go);
+		check("spots: teleport at " + player.getX() + "," + player.getY() + " to " + entry.getX() + "," + entry.getY(), (flew == null) && (player.calculateDistance2D(entry) < 300));
+		check("spots: fee as the board, adena " + adena + " -> " + player.getAdena(), player.getAdena() == adena);
+		final Field disabled = Creature.class.getDeclaredField("_allSkillsDisabled");
+		disabled.setAccessible(true);
+		check("spots: skills blocked for the flight", disabled.getBoolean(player));
+		Thread.sleep(3500);
+		check("spots: skills back after the flight, stunned " + player.isStunned() + ", sleeping " + player.isSleeping() + ", paralyzed " + player.isParalyzed() + ", sitting " + player.isSitting(), !disabled.getBoolean(player));
+		player.teleToLocation(GIRAN);
+	}
