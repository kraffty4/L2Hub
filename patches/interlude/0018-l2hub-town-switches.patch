+package custom.L2HubTown;
+
+import java.io.Reader;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.Paths;
+import java.util.ArrayList;
+import java.util.Properties;
+import java.util.logging.Logger;
+
+import org.l2jmobius.commons.threads.ThreadPool;
+import org.l2jmobius.gameserver.data.SpawnTable;
+import org.l2jmobius.gameserver.entity.actor.Npc;
+import org.l2jmobius.gameserver.entity.spawns.Spawn;
+
+/**
+ * L2Hub: выключатели городских NPC мода 0003 (config/Custom/L2HubTown.ini): {@code TownBuffer} — схем-баффер (50008), {@code TownGmShop} — GM-шоп (50010)
+ * у гейткиперов (спавн — data/spawns/Custom/L2HubTownNpcs.xml). Выключено — NPC убираются из мира, когда спавны загружены (спавны поднимаются после скриптов);
+ * баффер и GM-шоп на доске Alt+B тогда тоже отвечают «выключен» (L2HubBoard читает тот же файл). Применяется при старте гейма — ключи правит окно лаунчера
+ * («Настройки сервера», режимы «Хардкор» и другие).
+ * @author L2Hub
+ */
+public class L2HubTown
+{
+	private static final Logger LOGGER = Logger.getLogger(L2HubTown.class.getName());
+	private static final Path CONFIG = Paths.get("./config/Custom/L2HubTown.ini");
+	private static final int TOWN_BUFFER = 50008;
+	private static final int TOWN_SHOP = 50010;
+	private static final long FIRST_DELAY = 15_000;
+	private static final long RETRY_DELAY = 15_000;
+	private static final int ATTEMPTS = 20;
+
+	private final boolean _buffer;
+	private final boolean _shop;
+
+	private L2HubTown(boolean buffer, boolean shop)
+	{
+		_buffer = buffer;
+		_shop = shop;
+		ThreadPool.schedule(() -> run(1), FIRST_DELAY);
+	}
+
+	private void run(int attempt)
+	{
+		final SpawnTable table = SpawnTable.getInstance();
+		if ((table.getSpawnCount(TOWN_BUFFER) == 0) && (table.getSpawnCount(TOWN_SHOP) == 0) && (attempt < ATTEMPTS))
+		{
+			ThreadPool.schedule(() -> run(attempt + 1), RETRY_DELAY);
+			return;
+		}
+		if (!_buffer)
+		{
+			LOGGER.info("L2HubTown: TownBuffer = False — баффер у гейткиперов убран: " + remove(TOWN_BUFFER) + " NPC.");
+		}
+		if (!_shop)
+		{
+			LOGGER.info("L2HubTown: TownGmShop = False — GM-шоп у гейткиперов убран: " + remove(TOWN_SHOP) + " NPC.");
+		}
+	}
+
+	private static int remove(int npcId)
+	{
+		int removed = 0;
+		for (Spawn spawn : new ArrayList<>(SpawnTable.getInstance().getSpawns(npcId)))
+		{
+			spawn.stopRespawn();
+			for (Npc npc : new ArrayList<>(spawn.getSpawnedNpcs()))
+			{
+				npc.deleteMe();
+				removed++;
+			}
+			SpawnTable.getInstance().removeSpawn(spawn);
+		}
+		return removed;
+	}
+
+	/**
+	 * @param key TownBuffer или TownGmShop
+	 * @return включено (нет файла или ключа — включено)
+	 */
+	public static boolean isOn(String key)
+	{
+		if (!Files.isRegularFile(CONFIG))
+		{
+			return true;
+		}
+		try (Reader reader = Files.newBufferedReader(CONFIG, StandardCharsets.UTF_8))
+		{
+			final Properties properties = new Properties();
+			properties.load(reader);
+			return !"false".equalsIgnoreCase(properties.getProperty(key, "True").trim());
+		}
+		catch (Exception e)
+		{
+			return true;
+		}
+	}
+
+	public static void main(String[] args)
+	{
+		final boolean buffer = isOn("TownBuffer");
+		final boolean shop = isOn("TownGmShop");
+		if (!buffer || !shop)
+		{
+			new L2HubTown(buffer, shop);
+		}
+	}
+}
