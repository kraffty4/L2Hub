diff --git a/dist/game/config/Custom/L2HubEvents.ini b/dist/game/config/Custom/L2HubEvents.ini
new file mode 100644
index 0000000000000000000000000000000000000000..8098f4451b766c260b194e1ee1c3e54a901d1880
--- /dev/null
+++ b/dist/game/config/Custom/L2HubEvents.ini
@@ -0,0 +1,27 @@
+# ---------------------------------------------------------------------------
+# L2Hub: календарь сезонных событий Mobius (data/scripts/events)
+# ---------------------------------------------------------------------------
+# У Mobius даты событий в config.xml — 2006–2016, поэтому они выключены («has passed... Ignored»).
+# Здесь — окно каждого события (ключ — папка события):
+#   дд ММ-дд ММ            — каждый год; конец не позже начала — окно переходит через Новый год
+#                            («01 12-01 01» — весь декабрь с 31-м, «01 01-01 01» — весь год);
+#   дд ММ гггг-дд ММ гггг  — один раз;
+#   Off                    — выключено;
+#   пусто                  — как в config.xml события.
+# Конец окна — начало указанного дня: чтобы захватить 31 декабря, конец — «01 01». Новое окно действует со следующего
+# запуска сервера.
+# По умолчанию круглый год идёт одно событие: Heavy Medal (январь–апрель), L2 Day (май–ноябрь), Рождество (декабрь).
+
+# Календарь целиком: False — всё как в config.xml событий (у Mobius — выключено).
+# Default: True
+Enabled = True
+
+# Heavy Medal: медали с монстров (45%, блестящие — 5%) — значки у котов события (Roy) в городах, «орёл или решка» на улучшение значка.
+HeavyMedal = 01 01-01 05
+
+# L2 Day: буквы с монстров (по 1%) — слова NCSOFT, CHRONICLE, LINEAGE II у менеджеров в стартовых деревнях:
+# шляпы, свитки, лайфстоуны 76-го уровня, малый шанс на бижутерию РБ (Queen Ant, Orfen, Core).
+L2Day = 01 05-01 12
+
+# Рождество: части ёлки и эхо-кристаллы с колядками с монстров — подарки у ученика Санты в городах.
+Christmas = 01 12-01 01
