+					}
+				}
+			}
+		}
+		final boolean ok = (kinds.getOrDefault(GmShopEnchantPolicy.Kind.NORMAL, 0) > 0) && (kinds.getOrDefault(GmShopEnchantPolicy.Kind.BLESSED, 0) > 0) && (lists > 0) && banned.isEmpty();
+		return new Check("", ok, tr("ограничение — ") + onOff(enabled) + tr("; свитков по видам: ") + kinds + tr("; списков GM-шопа ") + lists + (banned.isEmpty() ? tr(", запрещённых товаров в них нет") : tr(", запрещённые товары: ") + banned));
+	}
