+# ---------------------------------------------------------------------------
+# GM-шоп: виды свитков заточки (L2Hub, патч 0415; перенос 0508 сопровождающего Эпилога)
+# ---------------------------------------------------------------------------
+# Правило действует на GM-шоп: multisell NPC, Alt+B и GM buylist; покупка проверяется повторно до оплаты.
+# Строка обмена скрывается целиком, если хоть один выдаваемый свиток запрещён. Свиток-ингредиент не запрещается.
+# Шансы заточки, дроп и уже имеющиеся у игроков свитки не меняются. Применяется после перезапуска игрового сервера.
+# Настройка через L2Hub: Настройки сервера -> Кастом сервера -> Свитки заточки в GM-шопе.
+
+# Ограничить виды свитков. False — GM-шоп продаёт все свитки, как раньше (флаги ниже не действуют).
+# Обычные и благословенные свитки продаются всегда.
+# Default: False
+GmShopEnchantPolicyEnabled = False
+
+# Разрешить отдельные виды при включённом ограничении.
+# Кристальные (Crystal Scroll).
+GmShopAllowCrystalScrolls = False
+# Улучшенные (с прибавкой к шансу).
+GmShopAllowEnhancedScrolls = False
+# Древние (Ancient Crystal Scroll).
+GmShopAllowAncientScrolls = False
+# Божественные (Divine Scroll).
+GmShopAllowDivineScrolls = False
+# Особые и событийные (для отдельных предметов, со сниженным шансом, без шаблона заточки).
+GmShopAllowSpecialScrolls = False
