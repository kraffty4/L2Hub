+		final Properties properties = new Properties();
+		try (Reader reader = Files.newBufferedReader(ini, StandardCharsets.UTF_8))
+		{
+			properties.load(reader);
+		}
+		final boolean enabled = Boolean.parseBoolean(properties.getProperty("GmShopEnchantPolicyEnabled", "False").trim());
+		final Map<GmShopEnchantPolicy.Kind, Integer> kinds = new java.util.EnumMap<>(GmShopEnchantPolicy.Kind.class);
+		for (EnchantScroll scroll : EnchantItemData.getInstance().getScrolls())
+		{
+			kinds.merge(GmShopEnchantPolicy.kind(scroll.getId()), 1, Integer::sum);
+		}
+		final Field field = MultisellData.class.getDeclaredField("_entries");
+		field.setAccessible(true);
+		final Map<Integer, ListContainer> entries = (Map<Integer, ListContainer>) field.get(MultisellData.getInstance());
+		int lists = 0;
+		final Set<Integer> banned = new TreeSet<>();
+		for (ListContainer list : entries.values())
+		{
+			if (!GmShopEnchantPolicy.applies(list, null))
+			{
+				continue;
+			}
+			lists++;
+			for (org.l2jmobius.gameserver.mechanics.multisell.Entry entry : list.getEntries())
+			{
