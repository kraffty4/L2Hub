+				final int y = buffer.getY() + (int) Math.round(((t[0] * uy) + (t[1] * ux)) * gap * t[2]);
+				final int z = GeoEngine.getInstance().getHeight(x, y, buffer.getZ());
+				if (Math.abs(z - buffer.getZ()) > 32)
