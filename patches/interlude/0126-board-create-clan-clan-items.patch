+			+ "<tr><td align=center><edit var=\"clan_name\" width=180 height=20></td></tr>" //
+			+ "<tr><td align=center>" + button(tr("Создать клан"), CLAN_RECRUIT + " create $clan_name", 145) + "</td></tr></table><br>";
+	}
