+	// ---------- Клан ----------
+
+	/**
+	 * _bbshubclan [create &lt;имя&gt;] | действия набора ({@link PhantomClanBoard}). Бесклановому сверху форма создания клана: те же проверки, что у гранд-мастера (VillageMaster, create_clan), всё остальное решает {@link ClanTable#createClan}.
+	 * @param player кто открыл
+	 * @param args команда доски
+	 * @return содержимое страницы
+	 */
+	public static String clan(Player player, String[] args)
+	{
+		if (!canUse(player))
+		{
+			return PhantomClanBoard.busy();
+		}
+
+		String[] rest = args;
+		if ((args.length > 1) && args[1].equalsIgnoreCase("create"))
+		{
+			if (args.length < 3)
+			{
+				player.sendPacket(SystemMessageId.PLEASE_CREATE_YOUR_CLAN_NAME);
+			}
+			else if ((args.length > 3) || !ServerConfig.CLAN_NAME_TEMPLATE_PATTERN.matcher(args[2]).matches())
+			{
+				player.sendPacket(SystemMessageId.CLAN_NAME_IS_INVALID);
+			}
+			else
+			{
+				ClanTable.getInstance().createClan(player, args[2]);
+			}
+			rest = new String[]
+			{
+				args[0]
+			};
+		}
+
+		final String content = PhantomClanBoard.getInstance().recruit(player, rest);
+		return player.getClan() != null ? content : clanForm() + content;
+	}
+
