+	/**
+	 * L2Hub: свой крон из L2HubEvents.ini (Elpies = True, ElpiesSchedule) — тем же таймером «Schedule…», что расписание config.xml.
+	 */
+	private void l2hubSchedule()
+	{
+		final Properties config = l2hubConfig();
+		final String pattern = config.getProperty("ElpiesSchedule", "").trim();
+		if (!"true".equalsIgnoreCase(config.getProperty("Elpies", "False").trim()) || pattern.isEmpty())
+		{
+			return;
+		}
+		
+		try
+		{
+			final SchedulingPattern schedulingPattern = new SchedulingPattern(pattern);
+			final StatSet params = new StatSet();
+			params.set("Name", getName());
+			params.set("SchedulingPattern", pattern);
+			final long delay = schedulingPattern.getDelayToNextFromNow();
+			getTimers().addTimer("ScheduleL2Hub", params, delay + 5000, null, null);
+			LOGGER.info("Event " + getName() + " scheduled at " + TimeUtil.getDateTimeString(System.currentTimeMillis() + delay));
+		}
+		catch (Exception e)
+		{
+			LOGGER.warning(getName() + ": ElpiesSchedule = " + pattern + " — не крон: " + e.getMessage());
+		}
+	}
+	
+	private static Properties l2hubConfig()
+	{
+		final Properties properties = new Properties();
+		if (Files.isRegularFile(L2HUB_CONFIG))
+		{
+			try (Reader reader = Files.newBufferedReader(L2HUB_CONFIG, StandardCharsets.UTF_8))
+			{
+				properties.load(reader);
+			}
+			catch (Exception e)
+			{
+				LOGGER.warning("Elpies: " + L2HUB_CONFIG + ": " + e.getMessage());
+			}
+		}
+		return properties;
+	}
+	
+	private static int l2hubMinutes(Properties config)
+	{
+		try
+		{
+			return Math.max(1, Integer.parseInt(config.getProperty("ElpiesMinutes", "10").trim()));
+		}
+		catch (NumberFormatException e)
+		{
+			return EVENT_DURATION_MINUTES;
+		}
+	}
+	
+	/**
+	 * @return случайный живой игрок (с клиентом, не офлайн-торговец; фантомы не в счёт) или null
+	 */
+	private static Player livePlayer()
+	{
+		final List<Player> players = new ArrayList<>();
+		for (Player player : World.getPlayers())
+		{
+			if ((player.getClient() != null) && !player.getClient().isDetached() && !player.isInOfflineMode())
+			{
+				players.add(player);
+			}
+		}
+		return players.isEmpty() ? null : players.get(getRandom(players.size()));
+	}
+	
+	private static EventLocation nearest(Player player)
+	{
+		EventLocation best = null;
+		long bestDistance = Long.MAX_VALUE;
+		for (EventLocation loc : EventLocation.values())
+		{
+			final long dx = ((loc._minX + loc._maxX) / 2) - player.getX();
+			final long dy = ((loc._minY + loc._maxY) / 2) - player.getY();
+			if (((dx * dx) + (dy * dy)) < bestDistance)
+			{
+				bestDistance = (dx * dx) + (dy * dy);
+				best = loc;
+			}
+		}
+		return best;
+	}
+	
