+	/**
+	 * L2Hub: follow ловит только Exception. Error вылетает мимо сброса флага _working, и задача до перезапуска сервера выходит первой же строкой:
+	 * к дальней цели каст больше не идёт, потому что ход к ней начинает только эта задача, а след ошибки уходит в stderr. Ошибка одного персонажа
+	 * снимает со слежения только его (AI вернёт его на следующей мысли), и причина попадает в журнал.
+	 */
+	private void followAll(Map<Creature, Integer> creatures)
+	{
+		for (Entry<Creature, Integer> entry : creatures.entrySet())
+		{
+			try
+			{
+				follow(entry.getKey(), entry.getValue());
+			}
+			catch (Throwable t)
+			{
+				remove(entry.getKey());
+				report(entry.getKey(), t);
+			}
+		}
+	}
+	
+	private static void report(Creature creature, Throwable t)
+	{
+		if (REPORTS.getAndIncrement() >= MAX_REPORTS)
+		{
+			return;
+		}
+		
+		final StringBuilder frames = new StringBuilder();
+		final StackTraceElement[] stack = t.getStackTrace();
+		for (int i = 0; i < Math.min(stack.length, REPORT_FRAMES); i++)
+		{
+			frames.append("\n\tat ").append(stack[i]);
+		}
+		
+		LOGGER.warning(CreatureFollowTaskManager.class.getSimpleName() + ": " + t + " on " + creature + ", stack depth " + stack.length + frames);
 	}
 	
