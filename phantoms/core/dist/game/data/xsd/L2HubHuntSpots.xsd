<?xml version="1.0" encoding="UTF-8"?>
<!-- L2Hub: споты охотников-фантомов (data/L2HubHuntSpots.xml, пишет tools/fake_players.py). -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">
	<xs:element name="list">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="spot" maxOccurs="unbounded" minOccurs="0">
					<xs:complexType>
						<!-- level — медианный уровень мобов, min/max — разброс, x/y/z — точка входа по геодате, radius — поводок охоты. -->
						<xs:attribute name="level" type="xs:positiveInteger" use="required" />
						<xs:attribute name="min" type="xs:positiveInteger" use="required" />
						<xs:attribute name="max" type="xs:positiveInteger" use="required" />
						<xs:attribute name="region" type="xs:token" use="required" />
						<xs:attribute name="name" type="xs:string" use="required" />
						<xs:attribute name="x" type="xs:integer" use="required" />
						<xs:attribute name="y" type="xs:integer" use="required" />
						<xs:attribute name="z" type="xs:integer" use="required" />
						<xs:attribute name="radius" type="xs:positiveInteger" use="required" />
						<xs:attribute name="mobs" type="xs:positiveInteger" use="required" />
					</xs:complexType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
</xs:schema>
